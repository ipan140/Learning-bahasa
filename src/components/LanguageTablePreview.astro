---
import { defaultLanguageTables } from '../data/languages';
const hiragana = defaultLanguageTables[0];
---

<div class="p-4 sm:p-5 font-mono select-text bg-canvas">
  <div class="flex items-center justify-between pb-3 mb-3 border-b border-rule">
    <div>
      <span class="text-[11px] text-smoke uppercase tracking-wider">[Preview Tabel]</span>
      <h3 class="text-[16px] font-bold text-ink">{hiragana.title}</h3>
    </div>
    <a href="/belajar" class="btn btn-secondary btn-s text-[12px]">Semua Bahasa -&gt;</a>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full border-collapse border border-ink text-center text-[13px] sm:text-[14px]">
      <tbody>
        {hiragana.grid.slice(0, 5).map((row) => (
          <tr>
            {row.map((cell) => (
              <td class="border border-ink p-2 sm:p-2.5 hover:bg-tint transition-colors">
                {cell ? (
                  <div class="flex items-center justify-center gap-1">
                    <span class="text-steel">{cell.romaji}</span>
                    <span class="text-smoke select-none">=</span>
                    <span class="text-ink font-bold text-[16px]">{cell.char}</span>
                  </div>
                ) : null}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="mt-4 pt-3 border-t border-rule flex items-center justify-between text-[12px] text-smoke">
    <span>Tersedia: Jepang, Korea, Arab, Rusia, Yunani, dll.</span>
    <a href="/belajar" class="link">Buka Halaman Lengkap -&gt;</a>
  </div>
</div>
