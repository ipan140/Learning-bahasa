---
// AuthModal.astro - Modal Login, Registrasi, & Edit Profil Pengguna
---

<dialog id="auth-modal" class="m-auto backdrop:bg-black/60 p-0 bg-canvas text-ink border border-rule w-[92vw] max-w-[440px] shadow-2xl">
  <div class="p-5 sm:p-6 flex flex-col gap-4">
    
    <!-- Header Modal -->
    <div class="flex items-start justify-between pb-3 border-b border-rule">
      <div>
        <h2 id="auth-modal-title" class="text-[18px] font-bold tracking-tight text-ink">Masuk ke Akun</h2>
        <p class="text-[12px] text-steel mt-0.5" id="auth-modal-subtitle">
          Simpan target belajar dan integrasikan data antar-perangkat Anda.
        </p>
      </div>
      <button 
        type="button" 
        id="auth-modal-close" 
        class="text-xs font-mono px-2 py-1 border border-rule hover:bg-smoke/10 text-smoke hover:text-ink transition-colors shrink-0 ml-3" 
        aria-label="Tutup Modal"
      >
        [x]
      </button>
    </div>

    <!-- Alert / Notifikasi Box -->
    <div id="auth-alert" class="hidden text-xs p-3 border font-mono"></div>

    <!-- ============================================== -->
    <!-- VIEW 1: PROFIL SAAT USER SUDAH LOGIN           -->
    <!-- ============================================== -->
    <div id="auth-view-logged-in" class="hidden flex flex-col gap-4">
      
      <!-- Card Identitas Pengguna -->
      <div class="p-4 bg-tint/60 border border-rule flex flex-col gap-3">
        <div class="flex items-center gap-3.5">
          <!-- Avatar Container -->
          <div class="relative size-14 shrink-0 rounded-full border border-rule overflow-hidden bg-ink text-canvas font-bold text-lg flex items-center justify-center select-none" id="auth-avatar-box">
            <img id="auth-avatar-img" class="hidden size-full object-cover" alt="Foto Profil" />
            <span id="auth-avatar-letter">U</span>
          </div>

          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-1.5">
              <span class="inline-block w-2 h-2 rounded-full bg-ok animate-pulse"></span>
              <span class="text-[11px] font-mono text-ok font-semibold uppercase">Akun Aktif</span>
            </div>
            <p class="text-[15px] font-bold text-ink truncate mt-0.5" id="auth-display-name-label">Nama Pengguna</p>
            <p class="text-[12px] text-steel truncate" id="auth-user-email">user@email.com</p>
          </div>
        </div>

        <!-- Form Edit Nama & Foto Profil -->
        <div class="pt-3 border-t border-rule space-y-3">
          <div>
            <label for="auth-input-name" class="block text-[11px] font-mono text-smoke uppercase tracking-wider mb-1">
              Ubah Nama Tampilan
            </label>
            <input 
              type="text" 
              id="auth-input-name" 
              placeholder="Ketik nama Anda (misal: Ivano Rossi)..." 
              class="w-full text-[13px] px-3 py-2 bg-canvas border border-rule focus:border-ink focus:outline-none text-ink font-mono"
            />
          </div>

          <!-- Pilihan Avatar Preset / Upload Foto -->
          <div>
            <label class="block text-[11px] font-mono text-smoke uppercase tracking-wider mb-1.5">
              Pilih Avatar / Unggah Foto
            </label>
            <div class="flex items-center gap-2 flex-wrap">
              <!-- Preset Avatar Emojis -->
              <div class="flex items-center gap-1" id="avatar-preset-chips">
                <button type="button" data-avatar="🧑‍🎓" class="size-8 text-[15px] border border-rule bg-canvas hover:border-ink flex items-center justify-center transition-colors" title="Pilih avatar pelajar">🧑‍🎓</button>
                <button type="button" data-avatar="🌍" class="size-8 text-[15px] border border-rule bg-canvas hover:border-ink flex items-center justify-center transition-colors" title="Pilih avatar globe">🌍</button>
                <button type="button" data-avatar="⚡" class="size-8 text-[15px] border border-rule bg-canvas hover:border-ink flex items-center justify-center transition-colors" title="Pilih avatar kilat">⚡</button>
                <button type="button" data-avatar="📖" class="size-8 text-[15px] border border-rule bg-canvas hover:border-ink flex items-center justify-center transition-colors" title="Pilih avatar buku">📖</button>
                <button type="button" data-avatar="🌟" class="size-8 text-[15px] border border-rule bg-canvas hover:border-ink flex items-center justify-center transition-colors" title="Pilih avatar bintang">🌟</button>
                <button type="button" data-avatar="🦊" class="size-8 text-[15px] border border-rule bg-canvas hover:border-ink flex items-center justify-center transition-colors" title="Pilih avatar rubah">🦊</button>
              </div>

              <!-- Upload Custom Image -->
              <label class="px-2.5 py-1 text-[11px] font-mono border border-rule hover:border-ink text-steel hover:text-ink cursor-pointer bg-canvas inline-flex items-center gap-1 transition-colors">
                📷 Upload Foto
                <input type="file" id="auth-avatar-file-input" accept="image/*" class="hidden" />
              </label>
            </div>
          </div>

          <button type="button" id="btn-save-profile" class="btn btn-secondary btn-s w-full justify-center text-[12px] font-mono">
            💾 Simpan Perubahan Profil
          </button>
        </div>
      </div>

      <!-- Ringkasan Materi Tersimpan di Cloud -->
      <div class="p-4 border border-rule flex flex-col gap-3">
        <span class="text-[11px] font-mono text-smoke uppercase tracking-wider">Integrasi Data Tersimpan</span>
        <div class="flex items-center justify-between mb-1">
          <span class="text-[11px] font-mono text-smoke uppercase tracking-wider">Statistik Belajar Anda</span>
          <span id="sync-streak-badge" class="px-2 py-0.5 text-[10px] font-mono font-bold bg-badge/15 text-badge border border-badge/30">🔥 Aktif Belajar</span>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center">
          <div class="p-2.5 bg-smoke/5 border border-rule">
            <div class="text-[20px] font-bold font-mono text-ink" id="sync-target-count">0</div>
            <div class="text-[11px] text-steel mt-0.5">Target Negara</div>
          </div>
          <div class="p-2.5 bg-smoke/5 border border-rule">
            <div class="text-[20px] font-bold font-mono text-ink" id="sync-table-count">0</div>
            <div class="text-[11px] text-steel mt-0.5">Tabel Kustom</div>
          </div>
          <div class="p-2.5 bg-smoke/5 border border-rule">
            <div class="text-[20px] font-bold font-mono text-ok" id="sync-memorized-count">0</div>
            <div class="text-[11px] text-steel mt-0.5">Huruf Hafal</div>
          </div>
          <div class="p-2.5 bg-smoke/5 border border-rule">
            <div class="text-[20px] font-bold font-mono text-ink" id="sync-phrase-count">0</div>
            <div class="text-[11px] text-steel mt-0.5">Koleksi Frasa</div>
          </div>
        </div>

        <button type="button" id="btn-force-sync" class="btn btn-secondary btn-s w-full justify-center text-[12px] font-mono">
          ⚡ Sinkronkan Data Sekarang
        </button>
      </div>

      <div class="pt-2 border-t border-rule flex justify-end">
        <button type="button" id="btn-logout" class="btn btn-primary btn-s w-full justify-center">
          Keluar dari Akun (Logout)
        </button>
      </div>
    </div>

    <!-- ============================================== -->
    <!-- VIEW 2: FORMULIR LOGIN & DAFTAR (BELUM LOGIN)  -->
    <!-- ============================================== -->
    <div id="auth-view-logged-out" class="flex flex-col gap-4">
      
      <!-- Tab Pilihan: Masuk / Daftar -->
      <div class="flex border-b border-rule">
        <button 
          type="button" 
          id="tab-login" 
          class="flex-1 pb-2.5 text-[13px] font-semibold text-center border-b-2 border-cta text-ink transition-colors"
        >
          Masuk
        </button>
        <button 
          type="button" 
          id="tab-register" 
          class="flex-1 pb-2.5 text-[13px] font-semibold text-center border-b-2 border-transparent text-smoke hover:text-ink transition-colors"
        >
          Daftar Akun
        </button>
      </div>

      <!-- Form Otentikasi -->
      <form id="auth-form" class="flex flex-col gap-3.5">
        <div>
          <label for="auth-email" class="block text-[11px] font-mono text-smoke mb-1 uppercase tracking-wider">
            Email
          </label>
          <input 
            type="email" 
            id="auth-email" 
            required 
            autocomplete="email"
            placeholder="nama@email.com" 
            class="w-full text-[13px] px-3.5 py-2.5 bg-canvas border border-rule focus:border-ink focus:outline-none text-ink placeholder:text-smoke/60"
          />
        </div>

        <div>
          <div class="flex items-center justify-between mb-1">
            <label for="auth-password" class="block text-[11px] font-mono text-smoke uppercase tracking-wider">
              Kata Sandi
            </label>
            <span id="password-hint" class="text-[11px] text-smoke hidden">Minimal 6 karakter</span>
          </div>
          <div class="relative flex items-center">
            <input 
              type="password" 
              id="auth-password" 
              required 
              minlength="6"
              autocomplete="current-password"
              placeholder="Masukkan kata sandi..." 
              class="w-full text-[13px] px-3.5 py-2.5 pr-10 bg-canvas border border-rule focus:border-ink focus:outline-none text-ink placeholder:text-smoke/60"
            />
            <button 
              type="button" 
              id="btn-toggle-password" 
              class="absolute right-2.5 text-smoke hover:text-ink text-sm p-1 cursor-pointer select-none focus:outline-none"
              title="Tampilkan / Sembunyikan Kata Sandi"
              aria-label="Lihat kata sandi"
            >
              👁️
            </button>
          </div>
        </div>

        <button 
          type="submit" 
          id="auth-submit-btn" 
          class="btn btn-primary w-full justify-center py-2.5 mt-1 font-semibold text-[13px]"
        >
          Masuk ke Akun
        </button>
      </form>

      <!-- Footer Info -->
      <p class="text-[12px] text-steel text-center leading-relaxed pt-2 border-t border-rule" id="auth-footer-text">
        Belum memiliki akun? 
        <button type="button" id="link-to-register" class="text-link hover:underline font-semibold ml-1">
          Daftar sekarang
        </button>
      </p>
    </div>

  </div>
</dialog>

<script>
  import {
    getSupabase,
    isSupabaseConfigured,
    getCurrentUser,
    signUpWithEmail,
    signInWithEmail,
    signOutUser,
    updateUserProfile,
    fetchUserTargetsFromCloud,
    addTargetToCloud,
    removeTargetFromCloud,
    batchSyncTargetsToCloud,
    fetchUserCustomTablesFromCloud,
    fetchUserProgressFromCloud,
    saveUserProgressToCloud,
    saveCustomTableToCloud,
    deleteCustomTableFromCloud,
    fetchUserPhrasesFromCloud,
    saveUserPhrasesToCloud
  } from '../lib/supabase';

  let currentAuthMode: 'login' | 'register' = 'login';
  let activeUser: any = null;
  let currentAvatarUrl: string = '';

  const modal = document.getElementById('auth-modal') as HTMLDialogElement | null;
  const modalTitle = document.getElementById('auth-modal-title');
  const modalSubtitle = document.getElementById('auth-modal-subtitle');
  const alertBox = document.getElementById('auth-alert');
  const viewLoggedIn = document.getElementById('auth-view-logged-in');
  const viewLoggedOut = document.getElementById('auth-view-logged-out');

  const tabLogin = document.getElementById('tab-login');
  const tabRegister = document.getElementById('tab-register');
  const authForm = document.getElementById('auth-form') as HTMLFormElement | null;
  const authSubmitBtn = document.getElementById('auth-submit-btn');
  const passwordHint = document.getElementById('password-hint');
  const footerText = document.getElementById('auth-footer-text');
  const linkToRegister = document.getElementById('link-to-register');

  const userEmailDisplay = document.getElementById('auth-user-email');
  const displayNameLabel = document.getElementById('auth-display-name-label');
  const inputName = document.getElementById('auth-input-name') as HTMLInputElement | null;
  const avatarLetter = document.getElementById('auth-avatar-letter');
  const avatarImg = document.getElementById('auth-avatar-img') as HTMLImageElement | null;
  const avatarFileInput = document.getElementById('auth-avatar-file-input') as HTMLInputElement | null;
  const btnSaveProfile = document.getElementById('btn-save-profile');
  const presetChips = document.querySelectorAll('#avatar-preset-chips button');

  const syncTargetCount = document.getElementById('sync-target-count');
  const syncTableCount = document.getElementById('sync-table-count');
  const syncMemorizedCount = document.getElementById('sync-memorized-count');
  const syncPhraseCount = document.getElementById('sync-phrase-count');
  const syncStreakBadge = document.getElementById('sync-streak-badge');
  const syncCharCount = document.getElementById('sync-char-count');

  function showAlert(msg: string, type: 'error' | 'success' | 'info' = 'info') {
    if (!alertBox) return;
    alertBox.textContent = msg;
    alertBox.className = 'text-xs p-3 border font-mono block';
    if (type === 'error') {
      alertBox.classList.add('bg-red-500/10', 'border-red-500/40', 'text-red-500');
    } else if (type === 'success') {
      alertBox.classList.add('bg-ok/10', 'border-ok/40', 'text-ok');
    } else {
      alertBox.classList.add('bg-cta/10', 'border-cta/40', 'text-ink');
    }
  }

  function hideAlert() {
    if (!alertBox) return;
    alertBox.className = 'hidden';
  }

  function setAvatarDisplay(avatar: string, fallbackInitial: string) {
    if (!avatarLetter || !avatarImg) return;
    if (avatar && (avatar.startsWith('data:image') || avatar.startsWith('http'))) {
      avatarImg.src = avatar;
      avatarImg.classList.remove('hidden');
      avatarLetter.classList.add('hidden');
    } else if (avatar && avatar.length <= 4) {
      // Emoji avatar
      avatarImg.classList.add('hidden');
      avatarLetter.textContent = avatar;
      avatarLetter.classList.remove('hidden');
    } else {
      avatarImg.classList.add('hidden');
      avatarLetter.textContent = fallbackInitial;
      avatarLetter.classList.remove('hidden');
    }
  }

  function switchAuthTab(mode: 'login' | 'register') {
    currentAuthMode = mode;
    hideAlert();
    if (mode === 'login') {
      if (modalTitle) modalTitle.textContent = 'Masuk ke Akun';
      if (modalSubtitle) modalSubtitle.textContent = 'Simpan target belajar dan integrasikan data antar-perangkat Anda.';
      tabLogin?.classList.add('border-cta', 'text-ink');
      tabLogin?.classList.remove('border-transparent', 'text-smoke');
      tabRegister?.classList.remove('border-cta', 'text-ink');
      tabRegister?.classList.add('border-transparent', 'text-smoke');
      if (authSubmitBtn) authSubmitBtn.textContent = 'Masuk ke Akun';
      passwordHint?.classList.add('hidden');
      if (footerText) {
        footerText.innerHTML = `Belum memiliki akun? <button type="button" id="link-to-register" class="text-link hover:underline font-semibold ml-1">Daftar sekarang</button>`;
        document.getElementById('link-to-register')?.addEventListener('click', () => switchAuthTab('register'));
      }
    } else {
      if (modalTitle) modalTitle.textContent = 'Daftar Akun Baru';
      if (modalSubtitle) modalSubtitle.textContent = 'Buat akun gratis untuk menyimpan progres belajar Anda selamanya.';
      tabRegister?.classList.add('border-cta', 'text-ink');
      tabRegister?.classList.remove('border-transparent', 'text-smoke');
      tabLogin?.classList.remove('border-cta', 'text-ink');
      tabLogin?.classList.add('border-transparent', 'text-smoke');
      if (authSubmitBtn) authSubmitBtn.textContent = 'Buat Akun Saya';
      passwordHint?.classList.remove('hidden');
      if (footerText) {
        footerText.innerHTML = `Sudah punya akun? <button type="button" id="link-to-login" class="text-link hover:underline font-semibold ml-1">Masuk di sini</button>`;
        document.getElementById('link-to-login')?.addEventListener('click', () => switchAuthTab('login'));
      }
    }
  }

  // Update visual tombol status user di header web
  function updateHeaderAuthButton(user: any) {
    const dot = document.getElementById('auth-status-dot');
    const label = document.getElementById('auth-trigger-label');
    const mobileBtn = document.getElementById('auth-trigger-btn-mobile');

    if (user) {
      if (dot) dot.className = 'inline-block w-2 h-2 rounded-full bg-ok';
      const customName = user.user_metadata?.display_name || localStorage.getItem('user_display_name');
      const nameToShow = customName || (user.email ? user.email.split('@')[0] : 'Akun');
      if (label) label.textContent = nameToShow;
      if (mobileBtn) mobileBtn.textContent = `🟢 Akun: ${nameToShow}`;
    } else {
      if (dot) dot.className = 'inline-block w-2 h-2 rounded-full bg-smoke';
      if (label) label.textContent = 'Masuk';
      if (mobileBtn) mobileBtn.textContent = 'Masuk ke Akun';
    }
  }

  // Pengecekan status login user
  async function checkAuthState() {
    try {
      const user = await getCurrentUser();
      activeUser = user;
      updateHeaderAuthButton(user);

      if (user) {
        viewLoggedIn?.classList.remove('hidden');
        viewLoggedOut?.classList.add('hidden');
        if (modalTitle) modalTitle.textContent = 'Profil Pengguna';
        if (modalSubtitle) modalSubtitle.textContent = 'Kelola foto profil, nama tampilan, dan status integrasi cloud Anda.';
        if (userEmailDisplay) userEmailDisplay.textContent = user.email || '-';

        const customName = user.user_metadata?.display_name || localStorage.getItem('user_display_name') || '';
        const savedAvatar = user.user_metadata?.avatar_url || localStorage.getItem('user_avatar_url') || '';
        currentAvatarUrl = savedAvatar;

        const initial = (user.email || 'U').charAt(0).toUpperCase();
        if (displayNameLabel) displayNameLabel.textContent = customName || (user.email ? user.email.split('@')[0] : 'Pengguna');
        if (inputName) inputName.value = customName;

        setAvatarDisplay(savedAvatar, initial);
        updateSyncStats(user.id);
      } else {
        viewLoggedIn?.classList.add('hidden');
        viewLoggedOut?.classList.remove('hidden');
        switchAuthTab(currentAuthMode);
      }
    } catch (err) {
      console.warn('Auth check failed:', err);
    }
  }

  // Preset Emoji Avatar selection
  presetChips.forEach(chip => {
    chip.addEventListener('click', () => {
      const emoji = chip.getAttribute('data-avatar');
      if (!emoji) return;
      currentAvatarUrl = emoji;
      setAvatarDisplay(emoji, (activeUser?.email || 'U').charAt(0).toUpperCase());
      showAlert(`Avatar dipilih: ${emoji}. Klik "Simpan Perubahan Profil" untuk menyimpan.`, 'info');
    });
  });

  // Custom File Avatar Upload (Image File)
  avatarFileInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    if (file.size > 2 * 1024 * 1024) {
      showAlert('Ukuran gambar maksimal 2MB.', 'error');
      return;
    }

    const reader = new FileReader();
    reader.onload = (evt) => {
      const base64 = evt.target?.result as string;
      currentAvatarUrl = base64;
      setAvatarDisplay(base64, (activeUser?.email || 'U').charAt(0).toUpperCase());
      showAlert('Foto profil dimuat! Klik "Simpan Perubahan Profil" untuk menyimpan.', 'info');
    };
    reader.readAsDataURL(file);
  });

  // Simpan Nama & Foto Profil
  btnSaveProfile?.addEventListener('click', async () => {
    if (!activeUser) return;
    const name = inputName?.value.trim() || '';

    showAlert('Menyimpan perubahan profil...', 'info');
    try {
      localStorage.setItem('user_display_name', name);
      if (currentAvatarUrl) {
        localStorage.setItem('user_avatar_url', currentAvatarUrl);
      }

      await updateUserProfile(name, currentAvatarUrl);

      if (displayNameLabel) displayNameLabel.textContent = name || activeUser.email.split('@')[0];
      updateHeaderAuthButton({
        ...activeUser,
        user_metadata: { ...activeUser.user_metadata, display_name: name, avatar_url: currentAvatarUrl }
      });

      showAlert('✓ Profil berhasil diperbarui!', 'success');
    } catch (err: any) {
      showAlert('Gagal menyimpan profil: ' + (err.message || 'Terjadi kesalahan'), 'error');
    }
  });

  async function updateSyncStats(userId: string) {
    try {
      const cloudTargets = await fetchUserTargetsFromCloud(userId);
      const cloudTables = await fetchUserCustomTablesFromCloud(userId);
      const cloudProgress = await fetchUserProgressFromCloud(userId);
      const cloudPhrases = await fetchUserPhrasesFromCloud(userId);

      if (syncTargetCount) syncTargetCount.textContent = String(cloudTargets.length);
      if (syncTableCount) syncTableCount.textContent = String(cloudTables.length);

      // Hitung total huruf hafal (dari cloud atau localStorage)
      let totalMemorized = 0;
      const progressSource = (cloudProgress && Object.keys(cloudProgress).length > 0) 
        ? cloudProgress 
        : JSON.parse(localStorage.getItem('user_study_progress_map') || '{}');
      Object.values(progressSource).forEach((chars: any) => {
        if (Array.isArray(chars)) totalMemorized += chars.length;
      });
      if (syncMemorizedCount) syncMemorizedCount.textContent = String(totalMemorized);

      // Hitung total koleksi frasa (dari cloud atau localStorage)
      let totalPhrases = 0;
      const phrasesSource = (cloudPhrases && Object.keys(cloudPhrases).length > 0)
        ? cloudPhrases
        : JSON.parse(localStorage.getItem('user_custom_phrases_map') || '{}');
      Object.values(phrasesSource).forEach((langObj: any) => {
        const cats = Array.isArray(langObj) ? langObj : (langObj?.categories || []);
        cats.forEach((c: any) => {
          if (Array.isArray(c?.items)) totalPhrases += c.items.length;
        });
      });
      if (syncPhraseCount) syncPhraseCount.textContent = String(totalPhrases);

      if (syncStreakBadge) {
        syncStreakBadge.textContent = totalMemorized > 0 ? '🔥 Aktif Belajar' : '🌱 Baru Mulai';
      }

      window.dispatchEvent(new CustomEvent('supabase-data-loaded', {
        detail: { targets: cloudTargets, tables: cloudTables, progress: cloudProgress, phrases: cloudPhrases }
      }));
    } catch (err) {
      console.error('Update sync stats failed:', err);
    }
  }

  // Sinkronisasi penuh lokal -> cloud
  async function performFullSync() {
    if (!activeUser) return;
    showAlert('Mengintegrasikan data belajar Anda...', 'info');

    try {
      // 1. Sinkronkan target negara
      const localTargets: string[] = JSON.parse(localStorage.getItem('target_countries') || '[]');
      if (localTargets.length > 0) {
        await batchSyncTargetsToCloud(activeUser.id, localTargets);
      }

      // 2. Sinkronkan tabel custom
      const localTables: any[] = JSON.parse(localStorage.getItem('custom_character_tables') || '[]');
      for (const t of localTables) {
        await saveCustomTableToCloud(activeUser.id, t);
      }

      // 3. Sinkronkan progres hafalan huruf
      const localProgress: Record<string, string[]> = JSON.parse(localStorage.getItem('user_study_progress_map') || '{}');
      for (const tableId of Object.keys(localProgress)) {
        await saveUserProgressToCloud(activeUser.id, tableId, localProgress[tableId]);
      }

      // 4. Sinkronkan koleksi frasa kustom
      const localPhrases: Record<string, any> = JSON.parse(localStorage.getItem('user_custom_phrases_map') || '{}');
      for (const langId of Object.keys(localPhrases)) {
        const cats = localPhrases[langId]?.categories || [];
        if (cats.length > 0) {
          await saveUserPhrasesToCloud(activeUser.id, langId, cats);
        }
      }

      showAlert('✓ Seluruh data & materi berhasil terintegrasi!', 'success');
      await updateSyncStats(activeUser.id);
    } catch (err: any) {
      showAlert('Gagal sinkronisasi: ' + (err.message || 'Terjadi kesalahan'), 'error');
    }
  }

  // Event Listeners Tab
  tabLogin?.addEventListener('click', () => switchAuthTab('login'));
  tabRegister?.addEventListener('click', () => switchAuthTab('register'));
  linkToRegister?.addEventListener('click', () => switchAuthTab('register'));

  // Toggle Password Visibility (Lihat / Sembunyikan Kata Sandi)
  const btnTogglePassword = document.getElementById('btn-toggle-password');
  const authPasswordInput = document.getElementById('auth-password') as HTMLInputElement | null;

  btnTogglePassword?.addEventListener('click', () => {
    if (!authPasswordInput) return;
    const isPassword = authPasswordInput.type === 'password';
    authPasswordInput.type = isPassword ? 'text' : 'password';
    if (btnTogglePassword) {
      btnTogglePassword.textContent = isPassword ? '🙈' : '👁️';
      btnTogglePassword.title = isPassword ? 'Sembunyikan Kata Sandi' : 'Tampilkan Kata Sandi';
    }
  });

  // ========================================================
  // RATE LIMITING & SECURITY COOLDOWN
  // ========================================================
  const AUTH_LOCKOUT_KEY = 'auth_login_lockout_until';
  const AUTH_ATTEMPTS_KEY = 'auth_failed_attempts';
  const MAX_FAILED_ATTEMPTS = 5;
  let lockoutIntervalTimer: any = null;

  function getLockoutRemainingMs(): number {
    const lockoutUntil = parseInt(localStorage.getItem(AUTH_LOCKOUT_KEY) || '0', 10);
    return Math.max(0, lockoutUntil - Date.now());
  }

  function getFailedAttempts(): number {
    return parseInt(localStorage.getItem(AUTH_ATTEMPTS_KEY) || '0', 10);
  }

  function checkAndApplyLockout(): boolean {
    const remainingMs = getLockoutRemainingMs();
    if (remainingMs > 0) {
      startLockoutCountdown(Math.ceil(remainingMs / 1000));
      return true;
    }
    return false;
  }

  function triggerLockout(durationSecs: number, reasonText?: string) {
    const lockoutUntil = Date.now() + (durationSecs * 1000);
    localStorage.setItem(AUTH_LOCKOUT_KEY, String(lockoutUntil));
    startLockoutCountdown(durationSecs, reasonText);
  }

  function startLockoutCountdown(totalSecs: number, reasonText?: string) {
    if (lockoutIntervalTimer) clearInterval(lockoutIntervalTimer);

    if (authSubmitBtn) {
      authSubmitBtn.setAttribute('disabled', 'true');
    }

    let remaining = totalSecs;
    const updateCountdown = () => {
      if (remaining <= 0) {
        clearInterval(lockoutIntervalTimer);
        lockoutIntervalTimer = null;
        localStorage.removeItem(AUTH_LOCKOUT_KEY);
        localStorage.removeItem(AUTH_ATTEMPTS_KEY);
        if (authSubmitBtn) {
          authSubmitBtn.removeAttribute('disabled');
          authSubmitBtn.textContent = currentAuthMode === 'login' ? 'Masuk ke Akun' : 'Buat Akun Saya';
        }
        hideAlert();
        return;
      }

      if (authSubmitBtn) {
        authSubmitBtn.setAttribute('disabled', 'true');
        authSubmitBtn.textContent = `⏳ Tunggu ${remaining}s...`;
      }
      const msg = reasonText 
        ? `${reasonText} Silakan tunggu ${remaining} detik.`
        : `Terlalu banyak percobaan masuk yang salah (5x). Demi keamanan akun Anda, silakan tunggu ${remaining} detik sebelum mencoba lagi.`;
      showAlert(msg, 'error');
      remaining--;
    };

    updateCountdown();
    lockoutIntervalTimer = setInterval(updateCountdown, 1000);
  }

  function clearLockout() {
    if (lockoutIntervalTimer) {
      clearInterval(lockoutIntervalTimer);
      lockoutIntervalTimer = null;
    }
    localStorage.removeItem(AUTH_LOCKOUT_KEY);
    localStorage.removeItem(AUTH_ATTEMPTS_KEY);
    if (authSubmitBtn) {
      authSubmitBtn.removeAttribute('disabled');
      authSubmitBtn.textContent = currentAuthMode === 'login' ? 'Masuk ke Akun' : 'Buat Akun Saya';
    }
  }

  // Trigger buka modal dari header desktop & mobile
  document.getElementById('auth-trigger-btn')?.addEventListener('click', () => {
    hideAlert();
    checkAuthState();
    checkAndApplyLockout();
    modal?.showModal();
  });
  document.getElementById('auth-trigger-btn-mobile')?.addEventListener('click', () => {
    const mobileMenu = document.querySelector<HTMLDialogElement>('dialog.mobile-menu');
    mobileMenu?.close();
    hideAlert();
    checkAuthState();
    checkAndApplyLockout();
    modal?.showModal();
  });

  document.getElementById('auth-modal-close')?.addEventListener('click', () => modal?.close());

  // Submit Login / Register
  authForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideAlert();

    if (checkAndApplyLockout()) {
      return;
    }

    if (!isSupabaseConfigured()) {
      showAlert('Layanan integrasi akun belum terhubung. Pastikan env telah diset dan di-redeploy di Vercel.', 'error');
      return;
    }

    const email = (document.getElementById('auth-email') as HTMLInputElement)?.value.trim();
    const password = (document.getElementById('auth-password') as HTMLInputElement)?.value;

    if (!email || !password) return;

    if (authSubmitBtn) {
      authSubmitBtn.setAttribute('disabled', 'true');
      authSubmitBtn.textContent = 'Memproses...';
    }

    try {
      if (currentAuthMode === 'login') {
        const { error } = await signInWithEmail(email, password);
        if (error) throw error;
        clearLockout();
        showAlert('✓ Berhasil masuk! Menghubungkan materi belajar...', 'success');
        await checkAuthState();
        await performFullSync();
        setTimeout(() => modal?.close(), 900);
      } else {
        const { error } = await signUpWithEmail(email, password);
        if (error) throw error;
        showAlert('✓ Pendaftaran berhasil! Silakan periksa email Anda jika konfirmasi aktif, atau langsung masuk.', 'success');
        switchAuthTab('login');
      }
    } catch (err: any) {
      let msg = err.message || 'Terjadi kesalahan saat menghubungi server.';
      const isRateLimit = msg.toLowerCase().includes('rate limit') || msg.toLowerCase().includes('over_email_send_rate_limit') || err.status === 429;

      if (isRateLimit) {
        triggerLockout(60, 'Batas percobaan dari penyedia autentikasi tercapai (Rate Limit).');
        return;
      }

      if (currentAuthMode === 'login') {
        const attempts = getFailedAttempts() + 1;
        localStorage.setItem(AUTH_ATTEMPTS_KEY, String(attempts));

        if (attempts >= MAX_FAILED_ATTEMPTS) {
          triggerLockout(30);
          return;
        }

        if (msg.includes('Invalid login credentials')) {
          const sisa = MAX_FAILED_ATTEMPTS - attempts;
          msg = `Email atau kata sandi salah. Percobaan tersisa: ${sisa}x sebelum jeda keamanan.`;
        }
      }

      if (msg.includes('fetch') || msg.includes('Failed to fetch') || err.name === 'AuthRetryableFetchError') {
        msg = 'Tidak dapat terhubung ke server autentikasi. Pastikan koneksi internet stabil atau coba beberapa saat lagi.';
      } else if (msg.includes('Email not confirmed')) {
        msg = 'Email belum dikonfirmasi. Silakan buka email Anda untuk konfirmasi aktivasi akun.';
      } else if (msg.includes('User already registered')) {
        msg = 'Email ini sudah terdaftar. Silakan pilih tab "Masuk" untuk masuk ke akun Anda.';
      }

      showAlert(msg, 'error');
    } finally {
      if (!getLockoutRemainingMs() && authSubmitBtn) {
        authSubmitBtn.removeAttribute('disabled');
        authSubmitBtn.textContent = currentAuthMode === 'login' ? 'Masuk ke Akun' : 'Buat Akun Saya';
      }
    }
  });

  // Tombol Logout
  document.getElementById('btn-logout')?.addEventListener('click', async () => {
    await signOutUser();
    activeUser = null;
    showAlert('Anda telah keluar dari akun.', 'info');
    await checkAuthState();
    setTimeout(() => modal?.close(), 600);
  });

  // Tombol Force Sync
  document.getElementById('btn-force-sync')?.addEventListener('click', performFullSync);

  // Sync event: toggle target negara
  window.addEventListener('user-target-toggled', async (e: any) => {
    if (!activeUser) return;
    const { countryId, isAdded } = e.detail || {};
    if (!countryId) return;

    try {
      if (isAdded) {
        await addTargetToCloud(activeUser.id, countryId);
      } else {
        await removeTargetFromCloud(activeUser.id, countryId);
      }
      updateSyncStats(activeUser.id);
    } catch (err) {
      console.warn('Gagal sinkronkan target:', err);
    }
  });

  // Sync event: simpan tabel kustom
  window.addEventListener('custom-table-saved', async (e: any) => {
    if (!activeUser) return;
    const table = e.detail?.table;
    if (!table) return;

    try {
      await saveCustomTableToCloud(activeUser.id, table);
      updateSyncStats(activeUser.id);
    } catch (err) {
      console.warn('Gagal sinkronkan tabel kustom:', err);
    }
  });

  // Sync event: hapus tabel kustom
  window.addEventListener('custom-table-deleted', async (e: any) => {
    if (!activeUser) return;
    const tableId = e.detail?.tableId;
    if (!tableId) return;

    try {
      await deleteCustomTableFromCloud(activeUser.id, tableId);
      updateSyncStats(activeUser.id);
    } catch (err) {
      console.warn('Gagal hapus tabel kustom:', err);
    }
  });

  // Listen auth state change
  const sb = getSupabase();
  if (sb) {
    sb.auth.onAuthStateChange((_event, session) => {
      activeUser = session?.user || null;
      updateHeaderAuthButton(activeUser);
    });
  }

  // Inisialisasi saat modal dibuka
  checkAuthState();
</script>
