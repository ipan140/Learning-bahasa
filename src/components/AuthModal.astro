  function resolveCanonicalCountryId(raw: any): string | null {
    if (!raw) return null;
    const str = String(raw).trim().toLowerCase();
    const found = worldCountries.find(c => 
      c.id.toLowerCase() === str || 
      c.code.toLowerCase() === str || 
      c.name.toLowerCase() === str || 
      (c.nativeName && c.nativeName.toLowerCase() === str)
    );
    if (found) return found.id;

    const aliases: Record<string, string> = {
      'jerman': 'de',
      'jepang': 'jp',
      'korea': 'kr',
      'korea selatan': 'kr',
      'south korea': 'kr',
      'arab': 'sa',
      'arab saudi': 'sa',
      'saudi arabia': 'sa',
      'rusia': 'ru',
      'russia': 'ru',
      'prancis': 'fr',
      'france': 'fr',
      'spanyol': 'es',
      'spain': 'es',
      'inggris': 'gb',
      'united kingdom': 'gb',
      'china': 'cn',
      'tiongkok': 'cn',
      'belanda': 'nl',
      'netherlands': 'nl',
      'italia': 'it',
      'italy': 'it',
      'turki': 'tr',
      'turkey': 'tr',
      'mesir': 'eg',
      'egypt': 'eg',
      'yunani': 'gr',
      'greece': 'gr'
    };
    return aliases[str] || null;
  }

