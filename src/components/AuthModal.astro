    }
    if (labelGoogle) {
      labelGoogle.textContent = 'Membuka Google Sign-In...';
    }

    try {
      // 1. Jika di mode Supabase lengkap (misal di Vercel), gunakan alur OAuth Supabase bawaan
      if (isSupabaseConfigured() && !isGoBackendMode()) {
        const { error } = await signInWithGoogle();
        if (error) throw error;
        return;
      }

      // 2. Untuk Backend Lokal: Jalankan Google Identity Services Popup langsung
      showAlert('Menghubungkan ke Google Sign-In...', 'info');
      await loadGoogleScript();

      const googleObj = (window as any).google;
      if (!googleObj?.accounts?.oauth2) {
        throw new Error('Google OAuth SDK belum siap. Silakan klik lagi.');
      }

      const tokenClient = googleObj.accounts.oauth2.initTokenClient({
        client_id: GOOGLE_CLIENT_ID,
        scope: 'email profile openid',
        callback: async (tokenResponse: any) => {
          if (btnGoogle) btnGoogle.removeAttribute('disabled');
          if (labelGoogle) labelGoogle.textContent = 'Lanjutkan dengan Google';

          if (tokenResponse.error) {
            showAlert('Login Google dibatalkan atau terjadi kendala: ' + (tokenResponse.error_description || tokenResponse.error), 'error');
            return;
          }

          if (tokenResponse.access_token) {
            showAlert('Mengambil data akun Google Anda...', 'info');
            try {
              const userinfoRes = await fetch('https://www.googleapis.com/oauth2/v3/userinfo', {
                headers: { Authorization: `Bearer ${tokenResponse.access_token}` },
              });
              const googleProfile = await userinfoRes.json();

              if (!googleProfile.email) {
                throw new Error('Gagal membaca alamat email dari akun Google.');
              }

              // Masuk / Buat akun di Backend Go lokal
              const { data, error } = await signInWithGoogleBackend({
                email: googleProfile.email,
                displayName: googleProfile.name || googleProfile.given_name || googleProfile.email.split('@')[0],
                avatarUrl: googleProfile.picture || '',
              });

              if (error) throw error;

              const loggedUser = data?.user;
              if (loggedUser) {
                activeUser = loggedUser;
                updateHeaderAuthButton(loggedUser);
              }

              clearLockout();
              showAlert(`✓ Berhasil masuk sebagai ${googleProfile.name || googleProfile.email}! Menghubungkan data belajar...`, 'success');
              await checkAuthState(loggedUser);
              await performFullSync();
              setTimeout(() => modal?.close(), 900);
            } catch (err: any) {
              showAlert('Gagal sinkronisasi profil Google: ' + (err.message || 'Terjadi kesalahan'), 'error');
            }
          }
        },
      });

      tokenClient.requestAccessToken({ prompt: 'consent' });
    } catch (err: any) {
      if (btnGoogle) btnGoogle.removeAttribute('disabled');
      if (labelGoogle) labelGoogle.textContent = 'Lanjutkan dengan Google';
      showAlert('Gagal menghubungkan Google: ' + (err.message || 'Silakan coba lagi beberapa saat lagi.'), 'error');
    }
  });

  // Tombol Logout
  document.getElementById('btn-logout')?.addEventListener('click', async () => {
    await signOutUser();
    activeUser = null;
    showAlert('Anda telah keluar dari akun.', 'info');
    await checkAuthState(null);
    setTimeout(() => modal?.close(), 600);
  });

  // Tombol Force Sync
  document.getElementById('btn-force-sync')?.addEventListener('click', performFullSync);

  // Sync event: toggle target negara
  window.addEventListener('user-target-toggled', async (e: any) => {
    if (!activeUser) return;
    const { countryId, isAdded } = e.detail || {};
    if (!countryId) return;

    try {
      if (isAdded) {
        await addTargetToCloud(activeUser.id, countryId);
      } else {
        await removeTargetFromCloud(activeUser.id, countryId);
      }
      updateSyncStats(activeUser.id);
    } catch (err) {
      console.warn('Gagal sinkronkan target:', err);
    }
  });

  // Sync event: simpan tabel kustom
  window.addEventListener('custom-table-saved', async (e: any) => {
    if (!activeUser) return;
    const table = e.detail?.table;
    if (!table) return;

    try {
      await saveCustomTableToCloud(activeUser.id, table);
      updateSyncStats(activeUser.id);
    } catch (err) {
      console.warn('Gagal sinkronkan tabel kustom:', err);
    }
  });

  // Sync event: hapus tabel kustom
  window.addEventListener('custom-table-deleted', async (e: any) => {
    if (!activeUser) return;
    const tableId = e.detail?.tableId;
    if (!tableId) return;

    try {
      await deleteCustomTableFromCloud(activeUser.id, tableId);
      updateSyncStats(activeUser.id);
    } catch (err) {
      console.warn('Gagal hapus tabel kustom:', err);
    }
  });

  // Listen auth state change
  const sb = getSupabase();
  if (sb) {
    sb.auth.onAuthStateChange((_event, session) => {
      activeUser = session?.user || null;
      updateHeaderAuthButton(activeUser);
    });
  }

  // Inisialisasi saat modal dibuka
  checkAuthState();
</script>
