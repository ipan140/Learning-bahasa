---
import { site } from '../data/site';
import Logo from './Logo.astro';
---

<footer class="border-t border-rule bg-canvas">
  <div class="frame px-6 pt-16 pb-10 max-md:px-5 max-md:pt-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-x-8 lg:gap-x-10 gap-y-10">
      <div class="sm:col-span-2">
        <Logo />
        <p class="mt-4 text-[13px] text-smoke max-w-[32ch] leading-[1.5]">{site.description}</p>
        <p class="mt-5 text-[13px] text-steel flex items-center gap-2"><span class="size-2 rounded-full bg-ok" aria-hidden="true"></span> Sistem berjalan normal</p>
      </div>
      {site.footer.map((col) => (
        <div>
          <p class="label">{col.title}</p>
          <ul class="mt-4 space-y-3 text-[13px]">
            {col.links.map(([label, href]) => <li><a href={href} class="text-steel hover:text-ink">{label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-14 pt-5 border-t border-rule text-[12px] text-smoke flex flex-wrap justify-between gap-3">
      <span>&copy; {new Date().getFullYear()} {site.name}. Aplikasi Belajar Mandiri.</span>
      <span>Aksara Teks &middot; Audio Web Speech</span>
    </div>
  </div>
</footer>
