---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdLeaderboard from '../components/AdLeaderboard.astro';
import AdSquare from '../components/AdSquare.astro';
import AdNative from '../components/AdNative.astro';
import { site } from '../data/site';

interface Props { title?: string; description?: string; image?: string; footer?: boolean; header?: boolean; type?: 'website' | 'article'; showAds?: boolean }
const { title, description = site.description, image = '/og.png', footer = true, header = true, type = 'website', showAds = true } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name}: ${site.description.split('.')[0]}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(image, Astro.site ?? site.url).href;
const jsonLd = { '@context': 'https://schema.org', '@type': 'Organization', name: site.name, url: site.url, logo: new URL('/logo-learning-bahasa.jpg', site.url).href };
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/jpeg" href="/logo-learning-bahasa.jpg" />
    <link rel="shortcut icon" href="/logo-learning-bahasa.jpg" />
    <link rel="apple-touch-icon" href="/logo-learning-bahasa.jpg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#4C2365" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem('theme') ?? 'light'; } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[70] btn btn-inverse btn-s">Skip to content</a>
    {header ? <Header /> : <slot name="header" />}

    {showAds && (
      <aside class="border-b border-rule bg-canvas" aria-label="Sponsor Atas">
        <div class="frame px-4 py-2 flex justify-center">
          <AdLeaderboard />
        </div>
      </aside>
    )}

    <main id="main">
      <slot />
    </main>

    {showAds && (
      <>
        <aside class="border-t border-rule bg-canvas py-8" aria-label="Sponsor Bawah">
          <div class="frame px-4 flex flex-col items-center justify-center gap-8">
            <AdSquare />
            <AdNative />
          </div>
        </aside>

        <script is:inline data-cfasync="false" src="https://bauval.org/14/41032622d0139395045eb7f4a0091449"></script>
        <script is:inline data-cfasync="false" src="https://abscloud.org/1/aaed6edc55d82140a3b352fd6c876a1f"></script>
        <script is:inline data-cfasync="false" src="https://araplhn.org/4/1baa1d9c858703801c6e954279a0db94"></script>
      </>
    )}
    {footer && <Footer />}

    <script is:inline>
      if ('serviceWorker' in navigator && window.location.protocol === 'https:') {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
