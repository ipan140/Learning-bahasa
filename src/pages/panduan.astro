<!-- SheetJS for instant template generation -->
<script is:inline src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>

<script>
  // Filter Categories & Search Bar Logic
  const searchInput = document.getElementById('faq-search-input') as HTMLInputElement | null;
  const searchClearBtn = document.getElementById('faq-search-clear') as HTMLButtonElement | null;
  const counterEl = document.getElementById('faq-match-counter');
  const chipButtons = document.querySelectorAll('.faq-chip');
  const faqCards = document.querySelectorAll('.faq-card') as NodeListOf<HTMLDetailsElement>;

  let currentCategory = 'all';

  function filterFaq() {
    const query = (searchInput?.value || '').trim().toLowerCase();
    if (searchClearBtn) {
      searchClearBtn.classList.toggle('hidden', query.length === 0);
    }

    let matchCount = 0;

    faqCards.forEach(card => {
      const cardCategory = card.getAttribute('data-category') || '';
      const cardText = (card.innerText || '').toLowerCase();

      const matchesCat = currentCategory === 'all' || cardCategory === currentCategory;
      const matchesQuery = query === '' || cardText.includes(query);

      if (matchesCat && matchesQuery) {
        card.classList.remove('hidden');
        matchCount++;
        // Auto-open if searching
        if (query.length > 1) {
          card.open = true;
        }
      } else {
        card.classList.add('hidden');
      }
    });

    if (counterEl) {
      counterEl.textContent = `Menampilkan ${matchCount} dari ${faqCards.length} Panduan`;
    }
  }

  searchInput?.addEventListener('input', filterFaq);

  searchClearBtn?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      filterFaq();
      searchInput.focus();
    }
  });

  chipButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      chipButtons.forEach(b => {
        b.classList.remove('border-ink', 'bg-ink', 'text-canvas', 'font-bold');
        b.classList.add('border-rule', 'bg-canvas', 'text-steel');
      });
      btn.classList.remove('border-rule', 'bg-canvas', 'text-steel');
      btn.classList.add('border-ink', 'bg-ink', 'text-canvas', 'font-bold');

      currentCategory = btn.getAttribute('data-cat') || 'all';
      filterFaq();
    });
  });

  // Handle URL hash jumping (e.g. /panduan#excel or /panduan#audio)
  function handleHash() {
    const hash = window.location.hash.replace('#', '');
    if (!hash) return;
    const targetEl = document.getElementById(hash) as HTMLDetailsElement | null;
    if (targetEl && targetEl.classList.contains('faq-card')) {
      targetEl.open = true;
      targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      targetEl.classList.add('ring-2', 'ring-cta');
      setTimeout(() => targetEl.classList.remove('ring-2', 'ring-cta'), 2000);
    }
  }

  window.addEventListener('load', handleHash);
  window.addEventListener('hashchange', handleHash);

  // Template Excel Downloaders using SheetJS
  function exportExcelFile(fileName: string, data: any[], sheetName: string) {
    if (typeof (window as any).XLSX === 'undefined') {
      alert('Modul Excel sedang dimuat, silakan coba sesaat lagi.');
      return;
    }
    const ws = (window as any).XLSX.utils.json_to_sheet(data);
    const wb = (window as any).XLSX.utils.book_new();
    (window as any).XLSX.utils.book_append_sheet(wb, ws, sheetName);
    (window as any).XLSX.writeFile(wb, fileName);
  }

  // 1. Template Aksara (2 Kolom)
  document.getElementById('btn-dl-template-aksara')?.addEventListener('click', () => {
    const dummyAksara = [
      { 'Romaji / Cara Baca': 'A', 'Karakter / Aksara Asli': 'あ' },
      { 'Romaji / Cara Baca': 'I', 'Karakter / Aksara Asli': 'い' },
      { 'Romaji / Cara Baca': 'U', 'Karakter / Aksara Asli': 'う' },
      { 'Romaji / Cara Baca': 'E', 'Karakter / Aksara Asli': 'え' },
      { 'Romaji / Cara Baca': 'O', 'Karakter / Aksara Asli': 'お' },
      { 'Romaji / Cara Baca': 'Ka', 'Karakter / Aksara Asli': 'か' },
      { 'Romaji / Cara Baca': 'Ki', 'Karakter / Aksara Asli': 'き' },
      { 'Romaji / Cara Baca': 'Ku', 'Karakter / Aksara Asli': 'く' },
      { 'Romaji / Cara Baca': 'Ke', 'Karakter / Aksara Asli': 'け' },
      { 'Romaji / Cara Baca': 'Ko', 'Karakter / Aksara Asli': 'こ' }
    ];
    exportExcelFile('template-tabel-aksara-kustom.xlsx', dummyAksara, 'Tabel Aksara');
  });

  // 2. Template Frasa (3 Kolom)
  document.getElementById('btn-dl-template-frasa')?.addEventListener('click', () => {
    const dummyFrasa = [
      { 'Frasa Asli': 'ありがとう', 'Cara Baca': 'Arigatou gozaimasu', 'Arti Bahasa Indonesia': 'Terima kasih' },
      { 'Frasa Asli': 'こんにちは', 'Cara Baca': 'Konnichiwa', 'Arti Bahasa Indonesia': 'Selamat siang / Halo' },
      { 'Frasa Asli': 'すみません', 'Cara Baca': 'Sumimasen', 'Arti Bahasa Indonesia': 'Permisi / Maaf' },
      { 'Frasa Asli': 'おはよう', 'Cara Baca': 'Ohayou gozaimasu', 'Arti Bahasa Indonesia': 'Selamat pagi' },
      { 'Frasa Asli': 'さようなら', 'Cara Baca': 'Sayounara', 'Arti Bahasa Indonesia': 'Selamat tinggal' }
    ];
    exportExcelFile('template-kumpulan-frasa.xlsx', dummyFrasa, 'Kumpulan Frasa');
  });

  // 3. Sampel 250 Negara
  document.getElementById('btn-dl-template-negara')?.addEventListener('click', () => {
    const dummyNegara = [
      { 'Kode': 'JP', 'Bendera': '🇯🇵', 'Nama Negara': 'Jepang', 'Bahasa Resmi': 'Jepang', 'Ibukota': 'Tokyo', 'Kawasan': 'Asia', 'Target Belajar': 'YA', 'Catatan': 'Target JLPT N4 tahun ini' },
      { 'Kode': 'DE', 'Bendera': '🇩🇪', 'Nama Negara': 'Jerman', 'Bahasa Resmi': 'Jerman', 'Ibukota': 'Berlin', 'Kawasan': 'Eropa', 'Target Belajar': 'YA', 'Catatan': 'Persiapan kuliah S2' },
      { 'Kode': 'KR', 'Bendera': '🇰🇷', 'Nama Negara': 'Korea Selatan', 'Bahasa Resmi': 'Korea', 'Ibukota': 'Seoul', 'Kawasan': 'Asia', 'Target Belajar': 'TIDAK', 'Catatan': '' },
      { 'Kode': 'SA', 'Bendera': '🇸🇦', 'Nama Negara': 'Arab Saudi', 'Bahasa Resmi': 'Arab', 'Ibukota': 'Riyadh', 'Kawasan': 'Timur Tengah', 'Target Belajar': 'YA', 'Catatan': 'Belajar qawaid & hijaiyah' },
      { 'Kode': 'FR', 'Bendera': '🇫🇷', 'Nama Negara': 'Prancis', 'Bahasa Resmi': 'Prancis', 'Ibukota': 'Paris', 'Kawasan': 'Eropa', 'Target Belajar': 'TIDAK', 'Catatan': '' }
    ];
    exportExcelFile('sampel-target-250-negara.xlsx', dummyNegara, 'Target 250 Negara');
  });
</script>
