---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import { 
  FileSpreadsheet, 
  Download, 
  Upload, 
  Volume2, 
  Plus, 
  Globe, 
  Layers, 
  HelpCircle, 
  Search, 
  Sparkles, 
  Cloud, 
  Edit3, 
  ChevronDown, 
  BookOpen, 
  Check, 
  X,
  Gauge,
  Flame,
  ArrowRight
} from 'lucide-astro';
---

<Base 
  title="Panduan Lengkap & FAQ - Belajar Bahasa & 250 Negara" 
  description="Dokumentasi resmi dan panduan penggunaan seluruh fitur: format impor/ekspor Excel, pembuatan tabel kustom bahasa dunia, audio Google Speech, flashcard, dan sinkronisasi cloud."
>
  <Section top={false} inner="px-6 pt-12 pb-18 lg:pt-16 lg:pb-24 max-md:px-5">
    <div class="w-full">
      
      <!-- Header / Hero Panduan -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-rule">
        <div>
          <p class="label"><b>[00]</b> pusat panduan &amp; dokumentasi fitur</p>
          <h1 class="mt-3 text-[clamp(28px,3.8vw,46px)] leading-[1.08] font-bold tracking-[-0.035em] text-ink">
            Panduan Lengkap &amp; FAQ Sistem
          </h1>
          <p class="mt-3 max-w-[65ch] text-[15px] leading-[1.6] text-steel">
            Tutorial langkah demi langkah untuk memaksimalkan seluruh fitur platform: manipulasi file spreadsheet Excel, pembuatan tabel kustom bahasa global apa saja, pengaturan suara pengucapan asli, hingga sinkronisasi data cloud.
          </p>
        </div>

        <div class="flex items-center gap-2.5 flex-wrap shrink-0">
          <a href="/belajar" class="btn btn-primary btn-s font-mono text-[13px] inline-flex items-center gap-1.5">
            <BookOpen class="size-3.5 inline" /> Buka Studio Aksara
          </a>
          <a href="/katalog" class="btn btn-secondary btn-s font-mono text-[13px] inline-flex items-center gap-1.5">
            <Globe class="size-3.5 inline text-steel" /> Katalog 250 Negara
          </a>
        </div>
      </div>

      <!-- Quick Template Download Banner -->
      <div class="mt-8 p-5 sm:p-6 border-2 border-ink bg-canvas shadow-sm space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-rule pb-3">
          <div class="flex items-center gap-2.5">
            <FileSpreadsheet class="size-5 text-cta shrink-0" />
            <div>
              <h2 class="text-[16px] font-bold text-ink">Unduh Berkas Template Excel (.xlsx) Siap Pakai</h2>
              <p class="text-xs text-steel mt-0.5">Format file spreadsheet standar yang siap Anda isi dan unggah langsung ke sistem.</p>
            </div>
          </div>
          <span class="text-[11px] font-mono px-2 py-0.5 border border-rule text-smoke bg-tint uppercase">Format Otomatis</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 pt-1">
          <!-- Template 1: Aksara -->
          <button 
            type="button" 
            id="btn-dl-template-aksara" 
            class="p-3.5 border border-rule bg-tint/30 hover:border-ink hover:bg-tint text-left transition-colors cursor-pointer group flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between text-xs font-mono font-bold text-ink mb-1">
                <span class="flex items-center gap-1.5"><FileSpreadsheet class="size-3.5 text-cta" /> Template Tabel Aksara</span>
                <span class="text-[10px] text-smoke uppercase">2 Kolom</span>
              </div>
              <p class="text-[11.5px] text-steel">Kolom [Cara Baca / Romaji] dan [Karakter Asli]. Cocok untuk abjad, angka, atau aksara.</p>
            </div>
            <div class="mt-3 pt-2 border-t border-rule/50 flex items-center justify-between text-[11px] font-mono text-ink font-bold">
              <span>Unduh .XLSX</span>
              <Download class="size-3.5 text-steel group-hover:text-ink transition-transform group-hover:translate-y-0.5" />
            </div>
          </button>

          <!-- Template 2: Frasa -->
          <button 
            type="button" 
            id="btn-dl-template-frasa" 
            class="p-3.5 border border-rule bg-tint/30 hover:border-ink hover:bg-tint text-left transition-colors cursor-pointer group flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between text-xs font-mono font-bold text-ink mb-1">
                <span class="flex items-center gap-1.5"><FileSpreadsheet class="size-3.5 text-cta" /> Template Kumpulan Frasa</span>
                <span class="text-[10px] text-smoke uppercase">3 Kolom</span>
              </div>
              <p class="text-[11.5px] text-steel">Kolom [Frasa Asli], [Cara Baca / Transliterasi], dan [Arti Bahasa Indonesia].</p>
            </div>
            <div class="mt-3 pt-2 border-t border-rule/50 flex items-center justify-between text-[11px] font-mono text-ink font-bold">
              <span>Unduh .XLSX</span>
              <Download class="size-3.5 text-steel group-hover:text-ink transition-transform group-hover:translate-y-0.5" />
            </div>
          </button>

          <!-- Template 3: 250 Negara -->
          <button 
            type="button" 
            id="btn-dl-template-negara" 
            class="p-3.5 border border-rule bg-tint/30 hover:border-ink hover:bg-tint text-left transition-colors cursor-pointer group flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between text-xs font-mono font-bold text-ink mb-1">
                <span class="flex items-center gap-1.5"><Globe class="size-3.5 text-badge" /> Sampel 250 Negara</span>
                <span class="text-[10px] text-smoke uppercase">Lengkap</span>
              </div>
              <p class="text-[11.5px] text-steel">Data sampel negara dengan kode, bendera, bahasa, ibukota, kawasan, dan catatan.</p>
            </div>
            <div class="mt-3 pt-2 border-t border-rule/50 flex items-center justify-between text-[11px] font-mono text-ink font-bold">
              <span>Unduh .XLSX</span>
              <Download class="size-3.5 text-steel group-hover:text-ink transition-transform group-hover:translate-y-0.5" />
            </div>
          </button>
        </div>
      </div>

      <!-- Search & Category Filters -->
      <div class="mt-8 space-y-4">
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 p-3.5 border border-rule bg-canvas">
          <div class="flex items-center gap-2.5 flex-1 min-w-0">
            <Search class="size-4 text-steel shrink-0" />
            <input 
              type="text" 
              id="faq-search-input" 
              placeholder="Cari topik panduan (misal: excel, impor, suara, bcp-47, kuis, cloud)..." 
              class="w-full text-xs sm:text-[13px] bg-transparent text-ink placeholder:text-smoke outline-none font-mono"
            />
            <button 
              type="button" 
              id="faq-search-clear" 
              class="text-xs font-mono text-smoke hover:text-ink px-1.5 py-0.5 border border-rule hidden cursor-pointer"
            >
              ✕
            </button>
          </div>
          <span id="faq-match-counter" class="text-[11px] font-mono text-smoke shrink-0 self-end sm:self-auto">
            Menampilkan 7 Panduan
          </span>
        </div>

        <!-- Category Filter Chips -->
        <div class="flex items-center gap-1.5 overflow-x-auto scrollbar-none pb-1 text-xs font-mono" id="faq-filter-chips">
          <button type="button" class="faq-chip px-3 py-1.5 border-2 border-ink bg-ink text-canvas font-bold cursor-pointer shrink-0" data-cat="all">
            Semua Panduan
          </button>
          <button type="button" class="faq-chip px-3 py-1.5 border border-rule bg-canvas text-steel hover:text-ink hover:border-ink cursor-pointer shrink-0" data-cat="excel">
            📊 Impor &amp; Ekspor Excel
          </button>
          <button type="button" class="faq-chip px-3 py-1.5 border border-rule bg-canvas text-steel hover:text-ink hover:border-ink cursor-pointer shrink-0" data-cat="kustom">
            🌐 Tabel Kustom &amp; Aksara
          </button>
          <button type="button" class="faq-chip px-3 py-1.5 border border-rule bg-canvas text-steel hover:text-ink hover:border-ink cursor-pointer shrink-0" data-cat="audio">
            🔊 Suara TTS Google
          </button>
          <button type="button" class="faq-chip px-3 py-1.5 border border-rule bg-canvas text-steel hover:text-ink hover:border-ink cursor-pointer shrink-0" data-cat="latihan">
            🎴 Flashcard &amp; Kuis
          </button>
          <button type="button" class="faq-chip px-3 py-1.5 border border-rule bg-canvas text-steel hover:text-ink hover:border-ink cursor-pointer shrink-0" data-cat="katalog">
            🗺️ Katalog 250 Negara
          </button>
          <button type="button" class="faq-chip px-3 py-1.5 border border-rule bg-canvas text-steel hover:text-ink hover:border-ink cursor-pointer shrink-0" data-cat="cloud">
            ☁️ Sinkronisasi Cloud
          </button>
        </div>
      </div>

      <!-- FAQ Articles & Guides List -->
      <div class="mt-6 space-y-4 max-w-4xl" id="faq-items-wrapper">
        
        <!-- PANDUAN 1: EXCEL IMPORT EXPORT -->
        <details id="excel" class="faq-card group border border-rule bg-canvas open:border-ink transition-colors shadow-xs" data-category="excel" open>
          <summary class="p-4 sm:p-5 cursor-pointer list-none flex items-center justify-between gap-3 select-none font-bold text-[15px] sm:text-[16px] text-ink hover:bg-tint/40">
            <span class="flex items-center gap-2.5">
              <span class="size-7 rounded-none bg-tint border border-rule flex items-center justify-center text-cta shrink-0 font-mono text-xs">
                <FileSpreadsheet class="size-4" />
              </span>
              <span>1. Format &amp; Tata Cara Impor / Ekspor Excel (.xlsx, .csv)</span>
            </span>
            <ChevronDown class="size-4 text-smoke shrink-0 transition-transform duration-200 group-open:rotate-180" />
          </summary>
          <div class="px-5 pb-5 pt-1 text-[13px] sm:text-[14px] text-steel border-t border-rule/50 space-y-4 leading-relaxed font-sans">
            <p>
              Platform mendukung pengolahan berkas spreadsheet secara dua arah. Anda dapat mengunggah catatan aksara atau kosakata yang sudah Anda miliki di Excel, maupun mengekspor data hasil belajar ke format <code>.xlsx</code>.
            </p>

            <div class="space-y-3">
              <h4 class="font-bold text-ink text-sm flex items-center gap-2">
                <span class="size-2 bg-cta inline-block"></span> A. Format Tabel Aksara / Huruf (2 Kolom)
              </h4>
              <p class="text-xs text-smoke">File spreadsheet minimal memiliki 2 kolom (header opsional):</p>
              <div class="border border-rule bg-tint/30 p-3 font-mono text-xs">
                <table class="w-full text-left">
                  <thead>
                    <tr class="border-b border-rule text-smoke">
                      <th class="py-1 px-2">Kolom A (Romaji / Cara Baca)</th>
                      <th class="py-1 px-2">Kolom B (Aksara / Huruf Asli)</th>
                    </tr>
                  </thead>
                  <tbody class="text-ink">
                    <tr class="border-b border-rule/40"><td class="py-1 px-2">A</td><td class="py-1 px-2 font-bold">あ</td></tr>
                    <tr class="border-b border-rule/40"><td class="py-1 px-2">I</td><td class="py-1 px-2 font-bold">い</td></tr>
                    <tr class="border-b border-rule/40"><td class="py-1 px-2">Alif</td><td class="py-1 px-2 font-bold">ا</td></tr>
                    <tr><td class="py-1 px-2">Ba</td><td class="py-1 px-2 font-bold">ب</td></tr>
                  </tbody>
                </table>
              </div>
              <p class="text-xs text-steel">
                <strong>Cara Unggah:</strong> Masuk ke halaman <a href="/belajar#buat-tabel" class="text-ink font-bold underline">Studio Belajar</a> &gt; Buka <strong>"+ Buat Tabel Kustom"</strong> &gt; Klik tombol <strong>"Pilih File Excel / CSV"</strong>. Seluruh baris akan langsung terisi ke formulir.
              </p>
            </div>

            <div class="space-y-3 pt-2 border-t border-rule/40">
              <h4 class="font-bold text-ink text-sm flex items-center gap-2">
                <span class="size-2 bg-cta inline-block"></span> B. Format Kumpulan Frasa (3 Kolom)
              </h4>
              <p class="text-xs text-smoke">Format file untuk mengimpor banyak frasa percakapan sekaligus:</p>
              <div class="border border-rule bg-tint/30 p-3 font-mono text-xs">
                <table class="w-full text-left">
                  <thead>
                    <tr class="border-b border-rule text-smoke">
                      <th class="py-1 px-2">Kolom A (Frasa Asli)</th>
                      <th class="py-1 px-2">Kolom B (Cara Baca)</th>
                      <th class="py-1 px-2">Kolom C (Arti Indonesia)</th>
                    </tr>
                  </thead>
                  <tbody class="text-ink">
                    <tr class="border-b border-rule/40">
                      <td class="py-1 px-2 font-bold">ありがとう</td>
                      <td class="py-1 px-2">Arigatou gozaimasu</td>
                      <td class="py-1 px-2">Terima kasih</td>
                    </tr>
                    <tr class="border-b border-rule/40">
                      <td class="py-1 px-2 font-bold">Guten Morgen</td>
                      <td class="py-1 px-2">Guten Morgen</td>
                      <td class="py-1 px-2">Selamat pagi</td>
                    </tr>
                    <tr>
                      <td class="py-1 px-2 font-bold">شكراً</td>
                      <td class="py-1 px-2">Syukran</td>
                      <td class="py-1 px-2">Terima kasih</td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <p class="text-xs text-steel">
                <strong>Cara Unggah:</strong> Di Studio Belajar &gt; Tab <strong>"Frasa Sehari-hari"</strong> &gt; Klik <strong>"+ Tambah Frasa"</strong> &gt; Pilih tombol <strong>"Unggah File"</strong> atau beralih ke <strong>"Massal →"</strong>.
              </p>
            </div>

            <div class="space-y-2 pt-2 border-t border-rule/40">
              <h4 class="font-bold text-ink text-sm flex items-center gap-2">
                <span class="size-2 bg-cta inline-block"></span> C. Ekspor Data ke Excel
              </h4>
              <p class="text-xs text-steel">
                Di halaman <a href="/katalog" class="text-ink font-bold underline">Katalog 250 Negara</a>, klik tombol <strong>"Ekspor (.xlsx)"</strong> pada toolbar atas untuk mengunduh database 250 negara lengkap beserta data target belajar dan catatan motivasi Anda.
              </p>
            </div>
          </div>
        </details>

        <!-- PANDUAN 2: CUSTOM TABLE & GLOBAL LANGUAGES -->
        <details id="kustom" class="faq-card group border border-rule bg-canvas open:border-ink transition-colors shadow-xs" data-category="kustom">
          <summary class="p-4 sm:p-5 cursor-pointer list-none flex items-center justify-between gap-3 select-none font-bold text-[15px] sm:text-[16px] text-ink hover:bg-tint/40">
            <span class="flex items-center gap-2.5">
              <span class="size-7 rounded-none bg-tint border border-rule flex items-center justify-center text-ink shrink-0 font-mono text-xs">
                <Plus class="size-4" />
              </span>
              <span>2. Membuat Tabel Materi Kustom untuk Bahasa Apa Saja di Dunia</span>
            </span>
            <ChevronDown class="size-4 text-smoke shrink-0 transition-transform duration-200 group-open:rotate-180" />
          </summary>
          <div class="px-5 pb-5 pt-1 text-[13px] sm:text-[14px] text-steel border-t border-rule/50 space-y-3.5 leading-relaxed">
            <p>
              Aplikasi ini tidak membatasi Anda pada bahasa-bahasa bawaan saja. Anda dapat membuat materi dan grid interaktif untuk aksara daerah, bahasa klasik, maupun bahasa modern apa pun di dunia (misal: Aksara Jawa Hanacaraka, Sunda, Batak, Sanskerta/Hindi, Cyrillic Rusia, Yunani, Ibrani, Tagalog, dll.).
            </p>
            <ol class="list-decimal pl-5 space-y-2 text-steel text-xs sm:text-[13px]">
              <li>Buka formulir <a href="/belajar#buat-tabel" class="text-ink font-bold underline">"+ Buat Tabel Sendiri"</a>.</li>
              <li>Isi <strong>Nama Bahasa</strong> (contoh: <em>"Aksara Jawa (Hanacaraka)"</em>) dan <strong>Judul Tabel</strong> (contoh: <em>"Tabel 20 Huruf Legena"</em>).</li>
              <li>
                <strong>Pengaturan Suara Pengucapan:</strong> Pilih dari 35+ bahasa global atau ketik kode bahasa kustom standar BCP-47 seperti <code>jv-ID</code> (Jawa), <code>su-ID</code> (Sunda), <code>es-MX</code> (Spanyol Meksiko), <code>zh-HK</code> (Kanton). Anda dapat menekan tombol <strong>"Coba Dengar"</strong> untuk memastikan suara bekerja di perangkat Anda.
              </li>
              <li>
                <strong>Isi Huruf:</strong> Masukkan teks dalam format baris <code>Romaji = Karakter</code> atau unggah file spreadsheet Excel.
              </li>
              <li>Klik <strong>"Simpan &amp; Tampilkan Tabel"</strong>. Tabel baru Anda langsung tampil di studio, tersimpan di memori browser, dan tersinkron ke cloud Supabase secara otomatis saat Anda login.</li>
            </ol>
          </div>
        </details>

        <!-- PANDUAN 3: AUDIO & GOOGLE SPEECH -->
        <details id="audio" class="faq-card group border border-rule bg-canvas open:border-ink transition-colors shadow-xs" data-category="audio">
          <summary class="p-4 sm:p-5 cursor-pointer list-none flex items-center justify-between gap-3 select-none font-bold text-[15px] sm:text-[16px] text-ink hover:bg-tint/40">
            <span class="flex items-center gap-2.5">
              <span class="size-7 rounded-none bg-tint border border-rule flex items-center justify-center text-ok shrink-0 font-mono text-xs">
                <Volume2 class="size-4" />
              </span>
              <span>3. Pengaturan Audio Google Speech &amp; Pelafalan Asli (TTS)</span>
            </span>
            <ChevronDown class="size-4 text-smoke shrink-0 transition-transform duration-200 group-open:rotate-180" />
          </summary>
          <div class="px-5 pb-5 pt-1 text-[13px] sm:text-[14px] text-steel border-t border-rule/50 space-y-3.5 leading-relaxed">
            <p>
              Mesin audio Studio Belajar terintegrasi langsung dengan standar <strong>Web Speech API</strong> peramban dan memprioritaskan suara resmi Google TTS berkualitas tinggi dengan fallback audio online:
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 font-mono text-xs text-ink pt-1">
              <div class="p-3 border border-rule bg-tint/30">
                <span class="font-bold text-ink block mb-1">Mendengar Huruf:</span>
                <span class="text-steel">Klik atau ketuk kotak aksara mana saja di tabel untuk mendengar suara lafalnya secara instan.</span>
              </div>
              <div class="p-3 border border-rule bg-tint/30">
                <span class="font-bold text-ink block mb-1">Pengatur Kecepatan:</span>
                <span class="text-steel">Klik tombol <em>Speed</em> di toolbar atas untuk beralih antara 0.5x, 0.75x, 1.0x (normal), hingga 2.0x.</span>
              </div>
              <div class="p-3 border border-rule bg-tint/30">
                <span class="font-bold text-ink block mb-1">Putar Urut Otomatis:</span>
                <span class="text-steel">Klik tombol <em>Putar Urut</em> untuk memutar seluruh abjad dalam tabel tanpa henti secara berurutan.</span>
              </div>
            </div>
          </div>
        </details>

        <!-- PANDUAN 4: FLASHCARD & QUIZ -->
        <details id="latihan" class="faq-card group border border-rule bg-canvas open:border-ink transition-colors shadow-xs" data-category="latihan">
          <summary class="p-4 sm:p-5 cursor-pointer list-none flex items-center justify-between gap-3 select-none font-bold text-[15px] sm:text-[16px] text-ink hover:bg-tint/40">
            <span class="flex items-center gap-2.5">
              <span class="size-7 rounded-none bg-tint border border-rule flex items-center justify-center text-badge shrink-0 font-mono text-xs">
                <Layers class="size-4" />
              </span>
              <span>4. Mode Latihan Hafalan: Flashcard Dua Sisi &amp; Kuis Pilihan Ganda</span>
            </span>
            <ChevronDown class="size-4 text-smoke shrink-0 transition-transform duration-200 group-open:rotate-180" />
          </summary>
          <div class="px-5 pb-5 pt-1 text-[13px] sm:text-[14px] text-steel border-t border-rule/50 space-y-3.5 leading-relaxed">
            <p>
              Untuk menguji ketajaman memori Anda setelah mempelajari tabel aksara, gunakan tab <strong>"Latihan &amp; Kuis"</strong> di halaman Studio Belajar:
            </p>
            <ul class="list-disc pl-5 space-y-2 text-steel text-xs sm:text-[13px]">
              <li>
                <strong>Flashcard Interaktif:</strong> Menampilkan aksara tunggal dalam ukuran besar. Sentuh atau klik kartu untuk membalik dan memeriksa cara baca transliterasi beserta pelafalan suaranya. Anda dapat menandai tombol <em>"Tandai Hafal"</em> untuk memantau persentase penguasaan materi.
              </li>
              <li>
                <strong>Kuis Pilihan Ganda:</strong> Sistem mengacak urutan huruf dan menampilkan 4 opsi jawaban cara baca. Uji seberapa cepat Anda dapat mengenali karakter dengan penghitung skor akurat.
              </li>
            </ul>
          </div>
        </details>

        <!-- PANDUAN 5: EDIT MODE & DEDUP CLEANER -->
        <details id="edit-cleaner" class="faq-card group border border-rule bg-canvas open:border-ink transition-colors shadow-xs" data-category="kustom">
          <summary class="p-4 sm:p-5 cursor-pointer list-none flex items-center justify-between gap-3 select-none font-bold text-[15px] sm:text-[16px] text-ink hover:bg-tint/40">
            <span class="flex items-center gap-2.5">
              <span class="size-7 rounded-none bg-tint border border-rule flex items-center justify-center text-cta shrink-0 font-mono text-xs">
                <Edit3 class="size-4" />
              </span>
              <span>5. Mode Edit Aksara &amp; Pembersih Huruf Dobel Otomatis</span>
            </span>
            <ChevronDown class="size-4 text-smoke shrink-0 transition-transform duration-200 group-open:rotate-180" />
          </summary>
          <div class="px-5 pb-5 pt-1 text-[13px] sm:text-[14px] text-steel border-t border-rule/50 space-y-3.5 leading-relaxed">
            <p>
              Studio Belajar memiliki editor in-place yang intuitif untuk mengorganisir karakter aksara:
            </p>
            <ul class="list-disc pl-5 space-y-2 text-steel text-xs sm:text-[13px]">
              <li>
                <strong>Mode Edit Aksara:</strong> Klik tombol <em>"Mode Edit Aksara"</em> di atas tabel. Setiap kotak aksara akan memunculkan icon pensil untuk mengedit teks dan tanda silang merah [✕] untuk menghapus huruf.
              </li>
              <li>
                <strong>Hapus Huruf Dobel Otomatis:</strong> Saat mengimpor daftar kosakata panjang dari spreadsheet, sering kali terdapat huruf yang duplikat. Cukup klik tombol <strong>"Hapus Huruf Dobel Otomatis"</strong> (<Sparkles class="size-3.5 inline text-badge" />), dan algoritma sistem akan membersihkan duplikasi tanpa mengubah susunan tabel.
              </li>
              <li>
