    // Web Speech Synthesis
    let cachedVoices: SpeechSynthesisVoice[] = [];
    function loadVoices() {
      if ('speechSynthesis' in window) {
        cachedVoices = window.speechSynthesis.getVoices();
      }
    }
    if ('speechSynthesis' in window) {
      loadVoices();
      window.speechSynthesis.onvoiceschanged = loadVoices;
    }

    function speakText(text: string, lang?: string) {
      if (!isAudioEnabled || !text) return;
      const langCode = lang ? lang.split('-')[0].toLowerCase() : 'ja';

      if ('speechSynthesis' in window) {
        try {
          window.speechSynthesis.cancel();
          const utter = new SpeechSynthesisUtterance(text);
          if (lang) utter.lang = lang;
          utter.rate = currentAudioRate;

          const voices = cachedVoices.length ? cachedVoices : window.speechSynthesis.getVoices();
          const googleVoice = voices.find(v => 
            (v.lang.toLowerCase().startsWith(langCode) || v.lang.toLowerCase() === (lang || '').toLowerCase()) && 
            v.name.toLowerCase().includes('google')
          );
          const naturalVoice = voices.find(v => 
            (v.lang.toLowerCase().startsWith(langCode) || v.lang.toLowerCase() === (lang || '').toLowerCase()) && 
            (v.name.toLowerCase().includes('natural') || v.name.toLowerCase().includes('online'))
          );
          const matchedVoice = voices.find(v => 
            v.lang.toLowerCase().startsWith(langCode) || v.lang.toLowerCase() === (lang || '').toLowerCase()
          );

          if (googleVoice) utter.voice = googleVoice;
          else if (naturalVoice) utter.voice = naturalVoice;
          else if (matchedVoice) utter.voice = matchedVoice;

          utter.onerror = () => {
            try {
              const audioUrl = `https://translate.google.com/translate_tts?ie=UTF-8&client=tw-ob&tl=${langCode}&q=${encodeURIComponent(text)}`;
              const audio = new Audio(audioUrl);
              audio.playbackRate = currentAudioRate;
              audio.play().catch(() => {});
            } catch {}
          };

          window.speechSynthesis.speak(utter);
          return;
        } catch {}
      }

      // Fallback
      try {
        const audioUrl = `https://translate.google.com/translate_tts?ie=UTF-8&client=tw-ob&tl=${langCode}&q=${encodeURIComponent(text)}`;
        const audio = new Audio(audioUrl);
        audio.playbackRate = currentAudioRate;
        audio.play().catch(() => {});
      } catch {}
    }

    // Toggle Audio Speed: 0.5x, 0.75x, 1.0x (default), 1.25x, 1.5x, 2.0x
    const SPEED_LEVELS = [0.5, 0.75, 1.0, 1.25, 1.5, 2.0];
    toggleSpeedBtn?.addEventListener('click', () => {
      const currIdx = SPEED_LEVELS.indexOf(currentAudioRate);
      const nextIdx = (currIdx + 1) % SPEED_LEVELS.length;
      currentAudioRate = SPEED_LEVELS[nextIdx];
      if (speedStatusLabel) {
        speedStatusLabel.textContent = `${currentAudioRate}x`;
      }
      const label = currentAudioRate === 1.0 
        ? '(Normal / Default)' 
        : currentAudioRate < 1.0 
          ? '(Lambat)' 
          : '(Cepat)';
      showToast(`Kecepatan audio: ${currentAudioRate}x ${label}`);
      if (currentUser) {
        saveUserPreferencesToCloud(currentUser.id, { audioSpeed: currentAudioRate, isAudioEnabled: isAudioEnabled }).catch(() => {});
      }
