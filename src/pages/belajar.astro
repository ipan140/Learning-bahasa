      viewerContainer?.classList.toggle('hidden', mode !== 'table');
      flashcardContainer?.classList.toggle('hidden', mode !== 'flashcard');
      phrasesContainer?.classList.toggle('hidden', mode !== 'phrases');

      if (mode === 'flashcard') {
