              html += `<span class="absolute top-1 left-7 text-[8px] font-bold text-red-500 bg-red-500/10 px-1 border border-red-500/40 select-none leading-tight" title="Huruf kembar/dobel di tabel">DOBEL</span>`;
            }
            html += `<button type="button" class="btn-cell-edit absolute top-1 left-1 w-5 h-5 flex items-center justify-center text-[10px] bg-canvas border border-rule hover:border-ink text-ink font-bold z-10 cursor-pointer shadow-sm" data-row="${rIdx}" data-col="${cIdx}" title="Edit karakter ini"><svg class="size-3 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg></button>`;
            html += `<button type="button" class="btn-cell-delete absolute top-1 right-1 w-5 h-5 flex items-center justify-center text-[11px] bg-canvas border border-red-500 text-red-500 hover:bg-red-500 hover:text-white font-bold z-10 cursor-pointer shadow-sm" data-row="${rIdx}" data-col="${cIdx}" data-char="${cell.char}" title="Hapus karakter ini"><svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>`;
          } else if (isMemorized) {
            html += `<span class="absolute top-1 right-1 text-ok select-none flex items-center justify-center" title="Sudah Hafal"><svg class="size-3 text-ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>`;
          }

          html += `<div class="flex items-center justify-center gap-1.5 sm:gap-2 text-[15px] sm:text-[18px] ${isEditModeActive ? 'pt-2' : ''}">`;
          if (cell.romaji) {
            html += `<span class="text-steel font-normal">${cell.romaji}</span>`;
            html += `<span class="text-smoke select-none">=</span>`;
          }
          html += `<span class="text-ink font-bold text-[18px] sm:text-[22px] tracking-wide">${cell.char}</span>`;
          html += `</div>`;
          html += `</td>`;
        });
        html += '</tr>';
      });

      html += '</tbody></table>';
      if (gridWrapper) gridWrapper.innerHTML = html;

      // Cell Edit & Delete button listeners
      if (isEditModeActive) {
        gridWrapper?.querySelectorAll('.btn-cell-delete').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const rIdx = parseInt(btn.getAttribute('data-row') || '-1');
            const cIdx = parseInt(btn.getAttribute('data-col') || '-1');
            const ch = btn.getAttribute('data-char') || '';
            if (rIdx >= 0 && cIdx >= 0) {
              const table = ensureCustomTableForEditing();
              if (table && table.grid && table.grid[rIdx]) {
                table.grid[rIdx][cIdx] = null;
                table.grid = table.grid.filter((r: any[]) => r.some((c: any) => c !== null));
                saveCustomTablesToStorage();
                if (currentUser) {
                  saveCustomTableToCloud(currentUser.id, table).catch(() => {});
                }
                renderCurrentTable();
                updateProgressUI();
                showToast(`✓ Huruf "${ch}" berhasil dihapus dari tabel!`);
              }
            }
          });
        });

        gridWrapper?.querySelectorAll('.btn-cell-edit').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const rIdx = parseInt(btn.getAttribute('data-row') || '-1');
            const cIdx = parseInt(btn.getAttribute('data-col') || '-1');
            const allTables = getAllTables();
            const curr = allTables.find(t => t.id === currentTableId);
            const cell = curr?.grid?.[rIdx]?.[cIdx];
            if (cell) {
              openCharModal(rIdx, cIdx, cell.char, cell.romaji || '');
            }
          });
        });
      }

      // Normal click to hear audio or copy
      const cells = gridWrapper?.querySelectorAll('td[data-char]') || [];
      cells.forEach(td => {
        td.addEventListener('click', (e) => {
          if (isEditModeActive && ((e.target as HTMLElement).closest('.btn-cell-delete') || (e.target as HTMLElement).closest('.btn-cell-edit'))) {
            return;
          }
          const char = td.getAttribute('data-char') || '';
          const lang = td.getAttribute('data-lang') || '';
          const romaji = td.getAttribute('data-romaji') || '';
          speakText(char, lang);
          navigator.clipboard?.writeText(char).catch(() => {});
          showToast(`Karakter "${char}" (${romaji}) disalin ke clipboard!`);
        });
      });
    }

    // Toggle Audio
    toggleAudioBtn?.addEventListener('click', () => {
      isAudioEnabled = !isAudioEnabled;
      if (audioStatusLabel) {
        audioStatusLabel.textContent = isAudioEnabled ? 'AKTIF' : 'NONAKTIF';
        audioStatusLabel.className = isAudioEnabled ? 'text-ok font-bold' : 'text-smoke font-bold';
      }
      const iconAudio = document.getElementById('icon-audio-toggle');
      if (iconAudio) {
        iconAudio.outerHTML = isAudioEnabled 
          ? '<svg class="size-3.5 inline text-ok" id="icon-audio-toggle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>'
          : '<svg class="size-3.5 inline text-smoke" id="icon-audio-toggle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="22" x2="16" y1="9" y2="15"/><line x1="16" x2="22" y1="9" y2="15"/></svg>';
      }
      showToast(isAudioEnabled ? 'Suara pelafalan diaktifkan' : 'Suara pelafalan dinonaktifkan');
      if (currentUser) {
        saveUserPreferencesToCloud(currentUser.id, { audioSpeed: currentAudioRate, isAudioEnabled: isAudioEnabled }).catch(() => {});
      }
    });

    // Copy All Table Text
    copyAllBtn?.addEventListener('click', () => {
      if (isUnaddedState) {
        showToast('Aksara ini belum ditambahkan, buat tabel terlebih dahulu.');
        return;
      }
      const allTables = getAllTables();
      const currentTable = allTables.find(t => t.id === currentTableId);
      if (!currentTable) return;

      const lines = currentTable.grid.map((row: any[]) => {
        return row.map(cell => cell ? (cell.romaji ? `${cell.romaji}=${cell.char}` : cell.char) : '-').join('\t');
      }).join('\n');

      navigator.clipboard?.writeText(lines).catch(() => {});
      showToast(`Teks tabel "${currentTable.name}" disalin ke clipboard!`);
    });

    // Print / Export PDF
    document.getElementById('print-table-btn')?.addEventListener('click', () => {
      if (isUnaddedState) {
        showToast('Aksara ini belum ditambahkan, buat tabel terlebih dahulu.');
        return;
      }
      window.print();
    });

    // Search input (debounced for fluid performance)
    let searchDebounceTimer: any = null;
    searchInput?.addEventListener('input', (e) => {
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = setTimeout(() => {
        tableSearchQuery = (e.target as HTMLInputElement).value;
        if (isUnaddedState && tableSearchQuery) {
          isUnaddedState = false;
          currentTableId = defaultTables[0]?.id || '';
          renderTabs();
        }
        renderCurrentTable();
      }, 100);
    });

    // Creator Modal triggers
    // DYNAMIC SPEECH VOICE MANAGER & SYSTEM VOICE DETECTOR
    const formVoiceSelect = document.getElementById('form-voice') as HTMLSelectElement | null;
    const formVoiceSystemOptgroup = document.getElementById('form-voice-system-optgroup');
    const formVoiceCustomOptgroup = document.getElementById('form-voice-custom-optgroup');
    const formVoiceCustomPanel = document.getElementById('form-voice-custom-panel');
    const inputCustomVoiceCode = document.getElementById('input-custom-voice-code') as HTMLInputElement | null;
    const inputCustomVoiceLabel = document.getElementById('input-custom-voice-label') as HTMLInputElement | null;
    const btnSaveCustomVoicePreset = document.getElementById('btn-save-custom-voice-preset');
    const btnTestCreatorVoice = document.getElementById('btn-test-creator-voice');

    let userCustomVoicePresets: Array<{ code: string, label: string }> = JSON.parse(localStorage.getItem('user_custom_voice_presets') || '[]');

    function renderCustomVoicePresets() {
      if (!formVoiceCustomOptgroup) return;
      formVoiceCustomOptgroup.innerHTML = userCustomVoicePresets.map(p => 
        `<option value="${p.code}">★ ${p.label || p.code} (${p.code})</option>`
      ).join('');
    }

    function populateSystemVoices() {
      if (!formVoiceSystemOptgroup || !('speechSynthesis' in window)) return;
      const voices = window.speechSynthesis.getVoices();
      if (!voices.length) return;

      const seen = new Set<string>();
      const optionsHtml: string[] = [];

      voices.forEach(v => {
        const key = `${v.lang}-${v.name}`;
        if (seen.has(key)) return;
        seen.add(key);
        optionsHtml.push(`<option value="${v.lang}">[Perangkat] ${v.name} (${v.lang})</option>`);
      });

      formVoiceSystemOptgroup.innerHTML = optionsHtml.slice(0, 40).join('');
    }

    populateSystemVoices();
    renderCustomVoicePresets();
    if ('speechSynthesis' in window) {
      window.speechSynthesis.onvoiceschanged = () => {
        loadVoices();
        populateSystemVoices();
      };
    }

    formVoiceSelect?.addEventListener('change', () => {
      if (formVoiceSelect.value === '__custom__') {
        formVoiceCustomPanel?.classList.remove('hidden');
        inputCustomVoiceCode?.focus();
      } else {
        formVoiceCustomPanel?.classList.add('hidden');
      }
    });

    btnSaveCustomVoicePreset?.addEventListener('click', () => {
      const code = inputCustomVoiceCode?.value.trim();
      const label = inputCustomVoiceLabel?.value.trim() || code;
      if (!code) {
        showToast('Ketik kode bahasa standar (misal: jv-ID, su-ID, es-MX)!');
        return;
      }

      userCustomVoicePresets = userCustomVoicePresets.filter(p => p.code !== code);
      userCustomVoicePresets.push({ code, label: label || code });
      localStorage.setItem('user_custom_voice_presets', JSON.stringify(userCustomVoicePresets));

      renderCustomVoicePresets();
      if (formVoiceSelect) {
        formVoiceSelect.value = code;
      }
      formVoiceCustomPanel?.classList.add('hidden');
      showToast(`✓ Preset suara "${label}" berhasil disimpan!`);
    });

    btnTestCreatorVoice?.addEventListener('click', () => {
      let voiceCode = formVoiceSelect?.value || 'id-ID';
      if (voiceCode === '__custom__') {
        voiceCode = inputCustomVoiceCode?.value.trim() || 'id-ID';
      }

      const samplePhrases: Record<string, string> = {
        'id': 'Halo! Selamat datang di studio belajar aksara.',
        'ja': 'こんにちは！日本語の音声テストです。',
        'ko': '안녕하세요! 한국어 음성 테스트입니다.',
        'ar': 'مرحباً! هذا اختبار الصوت العربي.',
        'zh': '你好！这是中文语音测试。',
        'en': 'Hello! This is an audio speech test.',
        'de': 'Hallo! Dies ist ein deutscher Sprachtest.',
        'fr': 'Bonjour! Ceci est un test vocal en français.',
        'es': '¡Hola! Esta es una prueba de voz en español.',
        'ru': 'Привет! Это проверка русской речи.',
        'it': 'Ciao! Questo è un test vocale in italiano.',
        'nl': 'Hallo! Dit is een Nederlandse spraaktest.',
        'th': 'สวัสดี! นี่คือการทดสอบเสียงภาษาไทย',
        'vi': 'Xin chào! Đây là bài kiểm tra giọng nói tiếng Việt.'
      };

      const prefix = voiceCode.split('-')[0].toLowerCase();
      const sampleText = samplePhrases[prefix] || `Tes suara untuk bahasa ${voiceCode}.`;

      speakText(sampleText, voiceCode);
      showToast(`🔊 Memutar sampel suara (${voiceCode})...`);
    });

    function openCreator(isEdit = false) {
      if (!isEdit) {
        editingTableId = null;
        if (creatorModalTitle) creatorModalTitle.textContent = 'Buat Tabel / Materi Bahasa Baru';
        if (creatorSubmitBtn) creatorSubmitBtn.textContent = 'Simpan & Tampilkan Tabel';
      }
      creatorModal?.classList.remove('hidden');
      document.getElementById('buat-tabel')?.scrollIntoView({ behavior: 'smooth' });
    }
    function closeCreator() {
      creatorModal?.classList.add('hidden');
    }

    openCreatorBtn?.addEventListener('click', () => openCreator(false));
    openCreatorTopBtn?.addEventListener('click', () => openCreator(false));
    closeCreatorBtn?.addEventListener('click', closeCreator);
    cancelCreatorBtn?.addEventListener('click', closeCreator);

    // Edit full custom table button
    editCustomTableBtn?.addEventListener('click', () => {
      const allTables = getAllTables();
      const currentTable = allTables.find(t => t.id === currentTableId);
      if (!currentTable) return;

      editingTableId = currentTable.id;
      if (creatorModalTitle) creatorModalTitle.textContent = `Edit Tabel: ${currentTable.name}`;
      if (creatorSubmitBtn) creatorSubmitBtn.textContent = 'Simpan Perubahan Tabel';

      const formName = document.getElementById('form-name') as HTMLInputElement | null;
      const formTitle = document.getElementById('form-title') as HTMLInputElement | null;
      const formDesc = document.getElementById('form-desc') as HTMLInputElement | null;
      const formVoice = document.getElementById('form-voice') as HTMLSelectElement | null;

      if (formName) formName.value = currentTable.name;
      if (formTitle) formTitle.value = currentTable.title;
      if (formDesc) formDesc.value = currentTable.description || '';
      if (formVoice && currentTable.voiceLang) {
        const exists = Array.from(formVoice.options).some(o => o.value === currentTable.voiceLang);
        if (!exists) {
          const opt = document.createElement('option');
          opt.value = currentTable.voiceLang;
          opt.textContent = `★ ${currentTable.voiceLang} (Preset)`;
          formVoiceCustomOptgroup?.appendChild(opt);
        }
        formVoice.value = currentTable.voiceLang;
      }

      if (formText) {
        formText.value = currentTable.grid.map((row: any[]) => {
          return row.map(c => c ? (c.romaji ? `${c.romaji} = ${c.char}` : c.char) : '-').join(' | ');
        }).join('\n');
      }

      renderCreatorPreview();
      openCreator(true);
    });

    if (createTarget) {
      const formName = document.getElementById('form-name') as HTMLInputElement | null;
      const formTitle = document.getElementById('form-title') as HTMLInputElement | null;
      const formVoice = document.getElementById('form-voice') as HTMLSelectElement | null;
      if (formName) formName.value = createTarget;
      if (formTitle) formTitle.value = `Tabel Aksara / Kosakata ${createTarget}`;
      if (formVoice && voiceTarget) formVoice.value = voiceTarget;
    }

    loadSampleBtn?.addEventListener('click', () => {
      const sample = `A = あ | I = い | U = う | E = え | O = お
Ka = か | Ki = き | Ku = く | Ke = け | Ko = こ
Sa = さ | Shi = し | Su = す | Se = せ | So = そ
Ta = た | Chi = ち | Tsu = つ | Te = て | To = と`;
      if (formText) formText.value = sample;
      renderCreatorPreview();
    });

    creatorForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = (document.getElementById('form-name') as HTMLInputElement)?.value.trim();
      const title = (document.getElementById('form-title') as HTMLInputElement)?.value.trim();
      const desc = (document.getElementById('form-desc') as HTMLInputElement)?.value.trim();
      let voice = (document.getElementById('form-voice') as HTMLSelectElement)?.value || 'id-ID';
      if (voice === '__custom__') {
        voice = (document.getElementById('input-custom-voice-code') as HTMLInputElement)?.value.trim() || 'id-ID';
      }
      const text = formText?.value.trim() || '';

      if (!name || !title || !text) return;
      const grid = parseTextToGrid(text);
      if (grid.length === 0) {
        showToast('Format teks tidak menghasilkan data tabel!');
        return;
      }

      if (editingTableId) {
        const existingIdx = customTables.findIndex(c => c.id === editingTableId);
        if (existingIdx !== -1) {
          customTables[existingIdx].name = name;
          customTables[existingIdx].title = title;
          customTables[existingIdx].description = desc || 'Tabel aksara kustom buatan Anda.';
          customTables[existingIdx].voiceLang = voice;
          customTables[existingIdx].grid = grid;
          
          saveCustomTablesToStorage();
          if (currentUser) {
            try {
              await saveCustomTableToCloud(currentUser.id, customTables[existingIdx]);
            } catch {}
          }
          currentTableId = editingTableId;
          editingTableId = null;
          closeCreator();
          renderTabs();
          renderCurrentTable();
          updateProgressUI();
          showToast(`✓ Tabel "${name}" berhasil diperbarui!`);
          document.getElementById('area-belajar')?.scrollIntoView({ behavior: 'smooth' });
          return;
        }
      }

      const newId = 'custom-' + Date.now();
      const newTable = {
        id: newId,
        name: name,
        flag: '✨',
        category: 'custom',
        badge: 'Tabel Pengguna',
        title: title,
        description: desc || 'Tabel aksara kustom buatan Anda.',
        voiceLang: voice,
        grid: grid
      };

      customTables.push(newTable);
      saveCustomTablesToStorage();

      if (currentUser) {
        try {
          await saveCustomTableToCloud(currentUser.id, newTable);
        } catch {}
      }

      currentTableId = newId;
      isUnaddedState = false;
      closeCreator();
      renderTabs();
      renderCurrentTable();
      updateProgressUI();
      showToast(`✓ Tabel "${name}" berhasil dibuat dan disimpan!`);
      document.getElementById('area-belajar')?.scrollIntoView({ behavior: 'smooth' });
    });

    deleteTableBtn?.addEventListener('click', async () => {
      const isCustom = customTables.some(c => c.id === currentTableId);
      if (!isCustom) return;

      const ok = await showRetroConfirm({
        title: 'Hapus Tabel Aksara Kustom',
        message: 'Yakin ingin menghapus tabel aksara kustom ini? Seluruh data karakter dan riwayat belajar di tabel ini akan dihapus permanen.',
        danger: true,
        confirmText: 'Hapus Tabel'
      });

      if (ok) {
        const deletedId = currentTableId;
        customTables = customTables.filter(c => c.id !== deletedId);
        saveCustomTablesToStorage();

        if (currentUser) {
          try {
            await deleteCustomTableFromCloud(currentUser.id, deletedId);
          } catch {}
        }

        currentTableId = defaultTables[0]?.id || '';
        renderTabs();
        renderCurrentTable();
        updateProgressUI();
        showToast('Tabel kustom berhasil dihapus.');
      }
    });

    // Cloud initialization
    async function initUserCloudData() {
      try {
        currentUser = await getCurrentUser();
        if (currentUser) {
          // 1. Fetch user custom tables
          const cloudTables = await fetchUserCustomTablesFromCloud(currentUser.id);
          if (cloudTables && cloudTables.length > 0) {
            const existingIds = new Set(customTables.map(t => t.id));
            let added = false;
            cloudTables.forEach((t: any) => {
              if (!existingIds.has(t.id)) {
                customTables.push({
                  id: t.id,
                  name: t.name,
                  flag: '✨',
                  category: 'custom',
                  badge: 'Tabel Pengguna (Cloud)',
                  title: t.name,
                  description: t.description || '',
                  voiceLang: t.script || 'en-US',
                  grid: t.rows || []
                });
                added = true;
              }
            });
            if (added) {
              saveCustomTablesToStorage();
              renderTabs();
              renderCurrentTable();
            }
          }

          // 2. Fetch user study progress from Supabase
          const cloudProgress = await fetchUserProgressFromCloud(currentUser.id);
          if (cloudProgress && Object.keys(cloudProgress).length > 0) {
            Object.assign(userProgressMap, cloudProgress);
            localStorage.setItem('user_study_progress_map', JSON.stringify(userProgressMap));
            updateProgressUI();
            renderCurrentTable();
          }

          // 3. Fetch user custom phrases from Supabase
          const cloudPhrases = await fetchUserPhrasesFromCloud(currentUser.id);
          if (cloudPhrases && Object.keys(cloudPhrases).length > 0) {
            Object.keys(cloudPhrases).forEach(langId => {
              userPhrasesMap[langId] = {
                categories: cloudPhrases[langId]
              };
            });
            localStorage.setItem('user_custom_phrases_map', JSON.stringify(userPhrasesMap));
            if (currentViewMode === 'phrases') renderPhrases();
          }
        }
      } catch (err) {
        console.warn('Init user cloud data error:', err);
      }
    }

    window.addEventListener('supabase-data-loaded', () => {
      initUserCloudData();
    });

    // Initial render
    renderTabs();
    renderCurrentTable();
    updateProgressUI();
    initUserCloudData();

    if (initialMode === 'phrases') {
      switchViewMode('phrases');
    } else if (initialMode === 'flashcard') {
      switchViewMode('flashcard');
    }
  }
</script>

