    btnFinishEditMode?.addEventListener('click', () => {
      isEditModeActive = false;
      updateEditModeUI();
      renderCurrentTable();
      showToast('✓ Selesai mengedit tabel.');
    });

    // Auto Deduplication: cleans all characters appearing > 1 time
    btnAutoDedup?.addEventListener('click', () => {
      const allTables = getAllTables();
      const curr = allTables.find(t => t.id === currentTableId);
      if (!curr) return;

      const charCounts: Record<string, number> = {};
      curr.grid.forEach((row: any[]) => {
        row.forEach((cell: any) => {
          if (cell && cell.char) {
            charCounts[cell.char] = (charCounts[cell.char] || 0) + 1;
          }
        });
      });

      const duplicateChars = Object.keys(charCounts).filter(ch => charCounts[ch] > 1);
      if (duplicateChars.length === 0) {
        showToast('Tidak ada karakter dobel di tabel ini.');
        return;
      }

      if (confirm(`Ditemukan ${duplicateChars.length} aksara kembar/dobel (${duplicateChars.slice(0, 5).join(', ')}...). Hapus semua kemunculan duplikatnya secara otomatis?`)) {
        const table = ensureCustomTableForEditing();
        const seen = new Set<string>();
        let removedCount = 0;

        table.grid.forEach((row: any[], rIdx: number) => {
          row.forEach((cell: any, cIdx: number) => {
            if (cell && cell.char) {
              if (seen.has(cell.char)) {
                table.grid[rIdx][cIdx] = null;
                removedCount++;
              } else {
                seen.add(cell.char);
              }
            }
          });
        });

        table.grid = table.grid.filter((row: any[]) => row.some((c: any) => c !== null));

        saveCustomTablesToStorage();
        if (currentUser) {
          saveCustomTableToCloud(currentUser.id, table).catch(() => {});
        }
        renderCurrentTable();
        updateProgressUI();
        showToast(`Berhasil menghapus ${removedCount} karakter dobel!`);
      }
    });

