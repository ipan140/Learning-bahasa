    function updateFlashcardCard() {
      const cells = getCurrentTableCells();
      if (cells.length === 0) return;
      if (fcIndex >= cells.length) fcIndex = 0;
      const cell = cells[fcIndex];

      fcIsFlipped = false;
      fcCardFront?.classList.remove('hidden');
      fcCardBack?.classList.add('hidden');

      if (fcCharDisplay) fcCharDisplay.textContent = cell.char;
      if (fcRomajiDisplay) fcRomajiDisplay.textContent = cell.romaji || '(Tanpa Romaji)';
      if (fcCharSubdisplay) fcCharSubdisplay.textContent = cell.char;
      if (fcCardCounter) fcCardCounter.textContent = `Kartu ${fcIndex + 1} dari ${cells.length}`;

      const memorized = userProgressMap[currentTableId] || [];
      const isMem = memorized.includes(cell.char);
      if (fcCardStatus) {
        fcCardStatus.textContent = isMem ? '✓ SUDAH HAFAL' : '';
