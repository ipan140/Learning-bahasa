---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import { defaultLanguageTables } from '../data/languages';
import { languagePhrasesData } from '../data/phrases';
---

<Base 
  title="Studio Belajar Aksara & Huruf Bahasa - Belajar Bahasa" 
  description="Tabel interaktif aksara bahasa: Jepang (Hiragana & Katakana), Jerman, Korea (Hangul), Arab (Hijaiyah), Mandarin, Thai, dan lainnya dengan audio lafal asli, flashcard latihan, dan sinkronisasi cloud."
>
  
  <!-- [01] MAIN APP: Area Belajar Aksara -->
  <Section id="area-belajar" top={false} inner="px-6 pt-12 pb-18 lg:pt-16 lg:pb-22 max-md:px-5">
    <div class="w-full">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-rule">
        <div>
          <p class="label"><b>[01]</b> studio belajar interaktif</p>
          <h1 class="mt-3 text-[clamp(28px,3.8vw,46px)] leading-[1.08] font-bold tracking-[-0.035em] text-ink">
            Tabel Huruf &amp; Aksara Bahasa
          </h1>
          <p class="mt-3 max-w-[65ch] text-[15px] leading-[1.6] text-steel">
            Pilih aksara bahasa di bawah ini. Anda dapat belajar menggunakan tabel interaktif, berlatih dengan kartu flashcard &amp; kuis, atau mempelajari frasa percakapan penting sehari-hari.
          </p>
        </div>
        <div class="flex items-center gap-2.5 shrink-0 flex-wrap">
          <a href="/katalog" class="btn btn-secondary btn-s font-mono text-[13px]">
            🌍 Katalog 250 Negara →
          </a>
          <button type="button" id="open-creator-top-btn" class="btn btn-primary btn-s font-mono text-[13px]">
            + Buat Tabel
          </button>
        </div>
      </div>
    </div>

    <!-- App Data Container -->
    <div 
      id="main-app" 
      class="mt-8"
      data-defaults={JSON.stringify(defaultLanguageTables)}
      data-phrases={JSON.stringify(languagePhrasesData)}
    >

      <!-- Notification Toast -->
      <div id="toast" class="hidden mb-6 px-4 py-2.5 text-[13px] border border-ok text-ok bg-canvas flex items-center justify-between font-mono">
        <span id="toast-message">Berhasil disimpan!</span>
        <button type="button" id="toast-close" class="text-smoke hover:text-ink font-bold ml-4">✕</button>
      </div>

      <!-- ========================================== -->
      <!-- SECTION TABEL AKSARA & HURUF               -->
      <!-- ========================================== -->
      <div id="section-tables" class="space-y-6">
        
        <!-- Language Switcher Bar -->
        <div class="p-4 sm:p-5 border border-rule bg-canvas shadow-sm space-y-3.5">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <span class="label font-bold text-ink">PILIH AKSARA BAHASA:</span>
            <!-- Category Chips Filter -->
            <div class="flex items-center gap-1.5 text-[12px] font-mono overflow-x-auto pb-1 scrollbar-none" id="category-filter-chips">
              <button type="button" data-cat="all" class="px-3 py-1 border border-ink bg-ink text-canvas font-bold whitespace-nowrap">Semua</button>
              <button type="button" data-cat="Asia" class="px-3 py-1 border border-rule text-steel hover:text-ink hover:border-ink whitespace-nowrap">Asia</button>
              <button type="button" data-cat="Eropa" class="px-3 py-1 border border-rule text-steel hover:text-ink hover:border-ink whitespace-nowrap">Eropa</button>
              <button type="button" data-cat="Timur Tengah" class="px-3 py-1 border border-rule text-steel hover:text-ink hover:border-ink whitespace-nowrap">Timur Tengah</button>
              <button type="button" data-cat="custom" class="px-3 py-1 border border-rule text-steel hover:text-ink hover:border-ink whitespace-nowrap">Kustom</button>
            </div>
          </div>

          <!-- Buttons Container (Responsive grid) -->
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2 pt-1" id="tab-bar">
            <!-- Rendered by client script -->
          </div>
        </div>

        <!-- Mode Switcher Tabs (Tabel, Flashcard, Frasa Penting) -->
        <div class="flex items-center gap-2 border-b border-rule pb-2 overflow-x-auto scrollbar-none">
          <button 
            type="button" 
            id="btn-mode-table" 
            class="px-4 py-2 font-mono text-[13px] border border-ink bg-ink text-canvas font-bold whitespace-nowrap transition-colors"
          >
            📑 Mode Tabel Aksara
          </button>
          <button 
            type="button" 
            id="btn-mode-flashcard" 
            class="px-4 py-2 font-mono text-[13px] border border-rule bg-canvas text-steel hover:text-ink hover:border-ink whitespace-nowrap transition-colors"
          >
            🎴 Mode Flashcard &amp; Latihan
          </button>
          <button 
            type="button" 
            id="btn-mode-phrases" 
            class="px-4 py-2 font-mono text-[13px] border border-rule bg-canvas text-steel hover:text-ink hover:border-ink whitespace-nowrap transition-colors"
          >
            💬 Frasa Dasar Sehari-hari
          </button>
        </div>

        <!-- Progress Tracker Banner -->
        <div id="study-progress-box" class="p-4 border border-rule bg-smoke/5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs font-mono">
          <div class="flex items-center gap-2.5 flex-wrap">
            <span class="font-bold text-ink uppercase tracking-wider">Progres Hafalan:</span>
            <span id="progress-count-label" class="text-ok font-bold">0 / 0 Huruf</span>
            <span id="progress-percent-label" class="text-smoke">(0%)</span>
          </div>
          <div class="flex items-center gap-3 w-full sm:w-auto">
            <div class="flex-1 sm:w-48 h-2.5 bg-rule overflow-hidden">
              <div id="progress-fill-bar" class="h-full bg-ok transition-all duration-300" style="width: 0%"></div>
            </div>
            <button 
              type="button" 
              id="btn-reset-progress" 
              class="text-smoke hover:text-red-500 text-[11px] underline shrink-0 transition-colors"
              title="Reset tanda hafalan pada bahasa ini"
            >
              Reset
            </button>
          </div>
        </div>

        <!-- Action & Search Toolbar -->
        <div class="flex flex-wrap items-center justify-between gap-4 p-4 border border-rule bg-canvas">
          <div class="flex items-center gap-3 flex-1 min-w-[240px]">
            <span class="text-smoke text-[13px] font-mono select-none">CARI:</span>
            <input 
              type="text" 
              id="search-input" 
              placeholder="Cari huruf atau romaji (misal: Ka, あ, Ä, ㄱ)..." 
              class="w-full max-w-sm px-3.5 py-2 text-[14px] bg-tint border border-rule text-ink outline-none focus:border-ink font-mono"
            />
          </div>
          <div class="flex items-center gap-2 flex-wrap text-[13px]">
            <button 
              type="button" 
              id="toggle-audio-btn" 
              class="btn btn-secondary btn-s"
              title="Aktifkan/Nonaktifkan Suara Pengucapan"
            >
              🔊 Suara: <span id="audio-status-label" class="text-ok font-bold">AKTIF</span>
            </button>
            <button 
              type="button" 
              id="toggle-speed-btn" 
              class="btn btn-secondary btn-s font-mono"
              title="Atur Kecepatan Suara: 0.75x (Lambat) atau 1.0x (Normal)"
            >
              🐢 Speed: <span id="speed-status-label" class="text-ink font-bold">1.0x</span>
            </button>
            <button 
              type="button" 
              id="copy-all-btn" 
              class="btn btn-secondary btn-s"
              title="Salin seluruh isi tabel ke clipboard"
            >
              📋 Salin Teks
            </button>
            <button 
              type="button" 
              id="open-creator-btn" 
              class="btn btn-primary btn-s"
            >
              + Buat Tabel Sendiri
            </button>
          </div>
        </div>

        <!-- ============================================== -->
        <!-- VIEW 1: TABEL LENGKAP                          -->
        <!-- ============================================== -->
        <div id="viewer-container" class="border border-rule bg-canvas p-5 sm:p-6 shadow-sm">
          <!-- Table Title & Description -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-rule pb-4 mb-6">
            <div>
              <div class="flex items-center gap-3 flex-wrap">
                <span id="table-badge" class="px-2.5 py-1 text-[11px] font-mono border border-rule text-smoke uppercase tracking-wider bg-tint">Hiragana Dasar</span>
                <h2 id="table-title" class="text-[22px] sm:text-[26px] font-bold text-ink tracking-tight">
                  A. Tabel Huruf Hiragana Dasar
                </h2>
              </div>
              <p id="table-description" class="mt-1.5 text-[14px] text-steel">
                Aksara fonetik utama dalam bahasa Jepang.
              </p>
            </div>
            <div id="custom-table-actions" class="hidden items-center gap-2 shrink-0">
              <button type="button" id="delete-table-btn" class="px-3 py-1.5 text-[12px] font-mono border border-rule text-smoke hover:text-red-500 hover:border-red-500 transition-colors">
                ✕ Hapus Tabel Ini
              </button>
            </div>
          </div>

          <!-- The Text Grid / Table -->
          <div class="w-full overflow-x-auto pb-4">
            <div id="table-grid-wrapper" class="inline-block min-w-full align-middle">
              <!-- Table will be rendered here -->
            </div>
          </div>

          <!-- Instructions footer -->
          <div class="mt-6 p-4 border border-dashed border-rule text-[13px] text-smoke flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-tint/30">
            <span>💡 <strong>Tips:</strong> Klik kotak huruf untuk mendengar audio asli &amp; salin karakter. Huruf bergaris hijau menandakan sudah Anda tandai hafal.</span>
            <span class="font-mono text-[12px]">Format: [Romaji/Cara Baca] = [Aksara]</span>
          </div>
        </div>

        <!-- ============================================== -->
        <!-- VIEW 2: FLASHCARD & LATIHAN HAFALAN            -->
        <!-- ============================================== -->
        <div id="flashcard-container" class="hidden border border-rule bg-canvas p-6 sm:p-8 shadow-sm">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-rule pb-4 mb-6">
            <div>
              <span class="px-2.5 py-1 text-[11px] font-mono border border-rule text-smoke uppercase tracking-wider bg-tint">Mode Latihan</span>
              <h2 class="text-[22px] sm:text-[24px] font-bold text-ink tracking-tight mt-1">
                Latihan Hafalan Huruf &amp; Aksara
              </h2>
              <p class="text-[13px] text-steel mt-0.5">
                Uji ingatan Anda. Balik kartu untuk memeriksa bacaan atau uji dengan kuis pilihan ganda.
              </p>
            </div>

            <!-- Toggle Flashcard vs Kuis -->
            <div class="flex items-center gap-1.5 text-[12px] font-mono shrink-0">
              <button type="button" id="btn-fc-type-card" class="px-3 py-1.5 border border-ink bg-ink text-canvas font-bold">
                🎴 Flashcard
              </button>
              <button type="button" id="btn-fc-type-quiz" class="px-3 py-1.5 border border-rule bg-canvas text-steel hover:text-ink hover:border-ink">
                🎯 Kuis Pilihan Ganda
              </button>
            </div>
          </div>

          <!-- 2A. Kartu Flashcard -->
          <div id="fc-card-subview" class="max-w-md mx-auto flex flex-col items-center">
            <div class="w-full flex items-center justify-between text-xs font-mono text-smoke mb-3">
              <span id="fc-card-counter">Kartu 1 dari 46</span>
              <span id="fc-card-status" class="text-ok font-bold"></span>
            </div>

            <!-- Big Flip Card -->
            <div 
              id="fc-flashcard" 
              class="w-full min-h-[260px] p-8 border-2 border-ink bg-canvas hover:bg-smoke/5 cursor-pointer flex flex-col items-center justify-center text-center transition-all select-none shadow-md relative"
              title="Klik untuk membalik kartu"
            >
              <span class="absolute top-3 right-3 text-[11px] font-mono text-smoke">🔄 Klik untuk balik</span>
              
              <!-- Front Side (Karakter Besar) -->
              <div id="fc-card-front" class="flex flex-col items-center justify-center">
                <span id="fc-char-display" class="text-[68px] sm:text-[80px] font-bold text-ink leading-none">あ</span>
                <span class="text-xs text-smoke font-mono mt-4">Tebak cara baca aksara ini...</span>
              </div>

              <!-- Back Side (Romaji & Audio) -->
              <div id="fc-card-back" class="hidden flex flex-col items-center justify-center">
                <span id="fc-romaji-display" class="text-[32px] sm:text-[40px] font-bold text-ink leading-tight">A</span>
                <span id="fc-char-subdisplay" class="text-[20px] text-steel font-mono mt-1">あ</span>
                <button type="button" id="btn-fc-speak" class="mt-4 btn btn-secondary btn-s font-mono text-xs">
                  🔊 Dengarkan Lafal
                </button>
              </div>
            </div>

            <!-- Action Buttons: Belum vs Sudah Hafal -->
            <div class="w-full grid grid-cols-2 gap-3 mt-5">
              <button 
                type="button" 
                id="btn-fc-unmemorized" 
                class="py-3 px-4 border border-rule bg-canvas hover:border-red-500 hover:text-red-500 text-steel font-mono text-[13px] font-bold text-center transition-colors"
              >
                ↺ Belum Hafal
              </button>
              <button 
                type="button" 
                id="btn-fc-memorized" 
                class="py-3 px-4 border border-ok bg-ok/10 hover:bg-ok text-ok hover:text-canvas font-mono text-[13px] font-bold text-center transition-colors shadow-sm"
              >
                ✓ Sudah Hafal!
              </button>
            </div>

            <!-- Navigation Controls -->
            <div class="w-full flex items-center justify-between gap-2 mt-5 pt-4 border-t border-rule text-xs font-mono">
              <button type="button" id="btn-fc-prev" class="px-3 py-1.5 border border-rule hover:border-ink text-steel hover:text-ink">
                ← Sebelumnya
              </button>
              <button type="button" id="btn-fc-random" class="px-3 py-1.5 border border-rule hover:border-ink text-steel hover:text-ink">
                🎲 Acak Huruf
              </button>
              <button type="button" id="btn-fc-next" class="px-3 py-1.5 border border-rule hover:border-ink text-steel hover:text-ink">
                Selanjutnya →
              </button>
            </div>
          </div>

          <!-- 2B. Kuis Pilihan Ganda -->
          <div id="fc-quiz-subview" class="hidden max-w-md mx-auto flex flex-col items-center">
            <div class="w-full flex items-center justify-between text-xs font-mono text-smoke mb-3">
              <span>Pertanyaan Soal</span>
              <span id="quiz-score-badge" class="text-ink font-bold">Skor: 0</span>
            </div>

            <div class="w-full p-8 border-2 border-ink bg-canvas flex flex-col items-center justify-center text-center shadow-md">
              <span class="text-xs text-smoke font-mono mb-2 uppercase tracking-wider">Bagaimana cara membaca aksara ini?</span>
              <span id="quiz-question-char" class="text-[72px] font-bold text-ink leading-none">あ</span>
            </div>

            <div id="quiz-feedback" class="h-6 mt-3 text-xs font-mono font-bold text-center"></div>

            <!-- 4 Multiple Choice Options -->
            <div id="quiz-options-grid" class="w-full grid grid-cols-2 gap-3 mt-3">
              <!-- Rendered by JS -->
            </div>

            <button type="button" id="btn-quiz-next-question" class="w-full mt-4 btn btn-primary py-2.5 font-mono text-xs justify-center hidden">
              Soal Berikutnya →
            </button>
          </div>
        </div>

        <!-- ============================================== -->
        <!-- VIEW 3: FRASA DASAR SEHARI-HARI                -->
        <!-- ============================================== -->
        <div id="phrases-container" class="hidden border border-rule bg-canvas p-5 sm:p-6 shadow-sm space-y-6">
          <div class="border-b border-rule pb-4">
            <span class="px-2.5 py-1 text-[11px] font-mono border border-rule text-smoke uppercase tracking-wider bg-tint">Survival Phrases</span>
            <h2 id="phrases-title" class="text-[22px] sm:text-[24px] font-bold text-ink tracking-tight mt-1">
              Frasa Penting Sehari-hari
            </h2>
            <p class="text-[13px] text-steel mt-0.5">
              Kosakata dasar yang wajib diketahui: salam, ucapan terima kasih, dan angka 1 sampai 10 dengan tombol audio asli.
            </p>
          </div>

          <div id="phrases-content-wrapper" class="space-y-6">
            <!-- Rendered by client script -->
          </div>
        </div>

      </div>
    </div>
  </Section>

  <!-- ========================================== -->
  <!-- CUSTOM TABLE CREATOR MODAL                 -->
  <!-- ========================================== -->
  <div id="buat-tabel" class="frame px-6 max-md:px-5">
    <div id="creator-modal" class="hidden my-8 p-6 sm:p-8 border-2 border-ink bg-canvas shadow-2xl">
      <div class="flex items-center justify-between border-b border-rule pb-4 mb-6">
        <div>
          <h3 class="text-[22px] font-bold text-ink">Buat Tabel / Materi Bahasa Baru</h3>
          <p class="text-[13px] text-steel mt-1">
            Tambahkan materi atau bahasa apa saja dengan format teks bebas, atau <strong>impor langsung dari file Excel/Spreadsheet</strong> Anda.
          </p>
        </div>
        <button type="button" id="close-creator-btn" class="btn btn-secondary btn-s shrink-0">✕ Tutup</button>
      </div>

      <form id="creator-form" class="space-y-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="form-name" class="block text-[13px] font-mono text-steel mb-1.5">Nama Bahasa / Kategori *</label>
            <input 
              type="text" 
              id="form-name" 
              required 
              placeholder="Misal: Mandarin (Hanzi), Jerman, dll." 
              class="w-full px-3.5 py-2.5 text-[14px] bg-tint border border-rule text-ink outline-none focus:border-ink font-mono"
            />
          </div>
          <div>
            <label for="form-title" class="block text-[13px] font-mono text-steel mb-1.5">Judul Tabel *</label>
            <input 
              type="text" 
              id="form-title" 
              required 
              placeholder="Misal: Tabel Angka 1-10, Tabel Aksara Khusus" 
              class="w-full px-3.5 py-2.5 text-[14px] bg-tint border border-rule text-ink outline-none focus:border-ink font-mono"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="form-desc" class="block text-[13px] font-mono text-steel mb-1.5">Keterangan Singkat</label>
            <input 
              type="text" 
              id="form-desc" 
              placeholder="Keterangan singkat materi belajar ini..." 
              class="w-full px-3.5 py-2.5 text-[14px] bg-tint border border-rule text-ink outline-none focus:border-ink font-mono"
            />
          </div>
          <div>
            <label for="form-voice" class="block text-[13px] font-mono text-steel mb-1.5">Suara Pengucapan (Speech Voice)</label>
            <select 
              id="form-voice" 
              class="w-full px-3.5 py-2.5 text-[14px] bg-tint border border-rule text-ink outline-none focus:border-ink font-mono"
            >
              <option value="ja-JP">Jepang (ja-JP)</option>
              <option value="de-DE">Jerman (de-DE)</option>
              <option value="ko-KR">Korea (ko-KR)</option>
              <option value="ar-SA">Arab (ar-SA)</option>
              <option value="zh-CN">Mandarin (zh-CN)</option>
              <option value="th-TH">Thailand (th-TH)</option>
              <option value="es-ES">Spanyol (es-ES)</option>
              <option value="fr-FR">Prancis (fr-FR)</option>
              <option value="ru-RU">Rusia (ru-RU)</option>
              <option value="en-US">Inggris (en-US)</option>
            </select>
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="form-text" class="block text-[13px] font-mono text-steel">
              Isi Karakter / Huruf * (Teks atau Baris Excel)
            </label>
            <span class="text-[12px] font-mono text-smoke">Format: <code>Romaji = Karakter</code></span>
          </div>
          <textarea 
            id="form-text" 
            rows="6" 
            required 
            placeholder="A = あ | I = い | U = う | E = え | O = お&#10;Ka = か | Ki = き | Ku = く | Ke = け | Ko = こ"
            class="w-full px-3.5 py-2.5 text-[14px] bg-tint border border-rule text-ink outline-none focus:border-ink font-mono"
          ></textarea>
        </div>

        <div class="p-4 border border-rule bg-tint/30 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <span class="font-bold text-[13px] text-ink block">Punya file Spreadsheet / Excel?</span>
            <span class="text-[12px] text-smoke">Unggah file .xlsx atau .csv untuk dikonversi otomatis menjadi tabel.</span>
          </div>
          <label class="btn btn-secondary btn-s shrink-0 cursor-pointer text-[12px]">
            📁 Pilih File Excel / CSV
            <input type="file" id="form-excel-input" accept=".xlsx, .xls, .csv" class="hidden" />
          </label>
        </div>

        <div>
          <label class="block text-[12px] font-mono text-smoke mb-1.5 uppercase tracking-wider">Pratinjau Tabel (5 Baris Pertama):</label>
          <div id="creator-preview" class="p-4 border border-rule bg-canvas overflow-x-auto min-h-[80px]">
            <span class="text-smoke italic font-mono text-[12px]">Ketik atau paste dari Excel di kotak atas untuk melihat pratinjau tabel...</span>
          </div>
        </div>

        <div class="flex items-center justify-end gap-3 pt-4 border-t border-rule">
          <button type="button" id="load-sample-btn" class="btn btn-secondary btn-s font-mono text-[12px]">
            Muat Contoh Data
          </button>
          <button type="button" id="cancel-creator-btn" class="btn btn-secondary btn-s font-mono text-[12px]">
            Batal
          </button>
          <button type="submit" class="btn btn-primary btn-s font-mono text-[12px]">
            Simpan &amp; Tampilkan Tabel
          </button>
        </div>
      </form>
    </div>
  </div>
</Base>

<!-- Load SheetJS for Excel Reading -->
<script is:inline src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<script>
  import { 
    getCurrentUser, 
    fetchUserCustomTablesFromCloud, 
    saveCustomTableToCloud, 
    deleteCustomTableFromCloud,
    fetchUserProgressFromCloud,
    saveUserProgressToCloud
  } from '../lib/supabase';

  const appEl = document.getElementById('main-app');
  if (appEl) {
    const defaultTables: any[] = JSON.parse(appEl.dataset.defaults || '[]');
    const phrasesData: Record<string, any> = JSON.parse(appEl.dataset.phrases || '{}');
    let customTables: any[] = JSON.parse(localStorage.getItem('custom_character_tables') || '[]');
    
    // User study progress (memorized chars map): { tableId: string[] }
    let userProgressMap: Record<string, string[]> = JSON.parse(localStorage.getItem('user_study_progress_map') || '{}');

    let currentTableId = defaultTables[0]?.id || '';
    let categoryFilter = 'all';
    let currentViewMode: 'table' | 'flashcard' | 'phrases' = 'table';
    let isAudioEnabled = true;
    let currentAudioRate = 1.0;
    let tableSearchQuery = '';
    let isUnaddedState = false;
    let unaddedInfo = { country: '', language: '', flag: '', voice: '' };
    let currentUser: any = null;

