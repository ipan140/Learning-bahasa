    // ========================================================
    let currentQuizAnswer = '';
    let quizQuestionDirection = 'char-to-romaji';

    function setQuizDirection(dir) {
      quizQuestionDirection = dir;
      if (dir === 'char-to-romaji') {
        btnQuizDirChar?.classList.remove('border-rule', 'bg-canvas', 'text-steel');
        btnQuizDirChar?.classList.add('border-2', 'border-cta', 'bg-cta/10', 'text-ink', 'font-bold', 'shadow-xs');
        btnQuizDirRomaji?.classList.remove('border-2', 'border-cta', 'bg-cta/10', 'font-bold', 'shadow-xs');
        btnQuizDirRomaji?.classList.add('border', 'border-rule', 'bg-canvas', 'text-steel');
      } else {
        btnQuizDirRomaji?.classList.remove('border-rule', 'bg-canvas', 'text-steel');
        btnQuizDirRomaji?.classList.add('border-2', 'border-cta', 'bg-cta/10', 'text-ink', 'font-bold', 'shadow-xs');
        btnQuizDirChar?.classList.remove('border-2', 'border-cta', 'bg-cta/10', 'font-bold', 'shadow-xs');
        btnQuizDirChar?.classList.add('border', 'border-rule', 'bg-canvas', 'text-steel');
      }
      initQuizQuestion();
    }

    btnQuizDirChar?.addEventListener('click', () => setQuizDirection('char-to-romaji'));
    btnQuizDirRomaji?.addEventListener('click', () => setQuizDirection('romaji-to-char'));

    function initQuizQuestion() {
      const cells = getCurrentTableCells();
      if (cells.length < 4) {
        if (quizQuestionChar) quizQuestionChar.textContent = '-';
        if (quizFeedback) quizFeedback.textContent = 'Minimal 4 huruf diperlukan untuk mode kuis.';
        return;
      }

      if (btnQuizNextQuestion) btnQuizNextQuestion.classList.add('hidden');
      if (quizFeedback) quizFeedback.textContent = '';

      const targetCell = cells[Math.floor(Math.random() * cells.length)];
      const isCharToRomaji = quizQuestionDirection === 'char-to-romaji';

      if (isCharToRomaji) {
        currentQuizAnswer = targetCell.romaji || targetCell.char;
        if (quizQuestionPrompt) quizQuestionPrompt.textContent = 'Bagaimana cara membaca aksara ini?';
        if (quizQuestionChar) {
          quizQuestionChar.textContent = targetCell.char;
          quizQuestionChar.className = 'text-[68px] sm:text-[76px] font-bold text-ink leading-none';
        }

        const distractors = cells
          .filter(c => (c.romaji || c.char) !== currentQuizAnswer)
          .map(c => c.romaji || c.char);
        
        const shuffledDistractors = distractors.sort(() => 0.5 - Math.random()).slice(0, 3);
        const options = [currentQuizAnswer, ...shuffledDistractors].sort(() => 0.5 - Math.random());

        if (quizOptionsGrid) {
          quizOptionsGrid.innerHTML = '';
          options.forEach(opt => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'py-3.5 px-4 border-2 border-rule bg-canvas hover:border-ink font-mono font-bold text-[16px] text-ink transition-colors shadow-sm select-none cursor-pointer';
            btn.textContent = opt;
            btn.addEventListener('click', () => handleQuizOptionClick(btn, opt, targetCell.char));
            quizOptionsGrid.appendChild(btn);
          });
        }
      } else {
        currentQuizAnswer = targetCell.char;
        if (quizQuestionPrompt) quizQuestionPrompt.textContent = 'Manakah aksara yang berbunyi demikian?';
        if (quizQuestionChar) {
          quizQuestionChar.textContent = targetCell.romaji || targetCell.char;
          quizQuestionChar.className = 'text-[44px] sm:text-[52px] font-bold text-ink leading-none font-mono';
        }

        const distractors = cells
          .filter(c => c.char !== currentQuizAnswer)
          .map(c => c.char);
        
        const shuffledDistractors = distractors.sort(() => 0.5 - Math.random()).slice(0, 3);
        const options = [currentQuizAnswer, ...shuffledDistractors].sort(() => 0.5 - Math.random());

        if (quizOptionsGrid) {
          quizOptionsGrid.innerHTML = '';
          options.forEach(opt => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'py-3.5 px-4 border-2 border-rule bg-canvas hover:border-ink font-mono font-bold text-[24px] text-ink transition-colors shadow-sm select-none cursor-pointer';
            btn.textContent = opt;
            btn.addEventListener('click', () => handleQuizOptionClick(btn, opt, targetCell.char));
            quizOptionsGrid.appendChild(btn);
          });
        }
      }
    }

    function handleQuizOptionClick(clickedBtn: HTMLButtonElement, chosen: string, char: string) {
      const allButtons = quizOptionsGrid?.querySelectorAll('button') || [];
      allButtons.forEach(b => (b.disabled = true));

      const allTables = getAllTables();
      const currentTable = allTables.find(t => t.id === currentTableId);
      speakText(char, currentTable?.voiceLang);

      if (chosen === currentQuizAnswer) {
        clickedBtn.classList.remove('border-rule', 'bg-canvas');
        clickedBtn.classList.add('border-ok', 'bg-ok/20', 'text-ok');
        if (quizFeedback) {
          quizFeedback.textContent = '✓ BENAR SEKALI!';
          quizFeedback.className = 'h-6 mt-3 text-xs font-mono font-bold text-center text-ok';
        }
        quizScore += 10;
        if (quizScoreBadge) quizScoreBadge.textContent = `Skor: ${quizScore}`;
        if (currentUser) {
          saveUserQuizScoreToCloud(currentUser.id, currentTableId, quizScore).catch(() => {});
        }
        
        if (!userProgressMap[currentTableId]) userProgressMap[currentTableId] = [];
        if (!userProgressMap[currentTableId].includes(char)) {
          userProgressMap[currentTableId].push(char);
          saveProgressMap();
          updateProgressUI();
        }
      } else {
        clickedBtn.classList.remove('border-rule', 'bg-canvas');
        clickedBtn.classList.add('border-red-500', 'bg-red-500/10', 'text-red-500');
        allButtons.forEach(b => {
          if (b.textContent === currentQuizAnswer) {
            b.classList.remove('border-rule');
            b.classList.add('border-ok', 'bg-ok/20', 'text-ok');
          }
        });
        if (quizFeedback) {
          quizFeedback.textContent = `SALAH! Jawaban yang benar adalah "${currentQuizAnswer}".`;
          quizFeedback.className = 'h-6 mt-3 text-xs font-mono font-bold text-center text-red-500';
        }
      }

      if (btnQuizNextQuestion) btnQuizNextQuestion.classList.remove('hidden');
    }

    btnQuizNextQuestion?.addEventListener('click', initQuizQuestion);

    // ========================================================
    // PHRASES VIEW & CRUD LOGIC
    // ========================================================

    function getActivePhrasesData(langId: string) {
      if (userPhrasesMap[langId]) {
        return userPhrasesMap[langId];
      }
      return phrasesData[langId] || { categories: [] };
    }

    function ensureCustomPhrases(langId: string) {
      if (!userPhrasesMap[langId]) {
        const base = phrasesData[langId] || { categories: [] };
        const allTables = getAllTables();
        const curr = allTables.find(t => t.id === langId);
        userPhrasesMap[langId] = {
          voiceLang: base.voiceLang || curr?.voiceLang || 'en-US',
          categories: JSON.parse(JSON.stringify(base.categories || []))
        };
      }
      return userPhrasesMap[langId];
    }

    async function saveUserPhrases(langId: string) {
      localStorage.setItem('user_custom_phrases_map', JSON.stringify(userPhrasesMap));
      if (!currentUser) {
        try { currentUser = await getCurrentUser(); } catch {}
      }
      if (currentUser) {
        const cats = userPhrasesMap[langId]?.categories || [];
        try {
          await saveUserPhrasesToCloud(currentUser.id, langId, cats);
        } catch (err) {
          console.warn('Gagal sinkronisasi frasa ke Supabase:', err);
        }
      }
      window.dispatchEvent(new CustomEvent('user-phrases-saved', { detail: { langId } }));
    }

    function updatePhraseEditModeUI() {
      if (btnTogglePhraseEdit) {
        if (isPhraseEditModeActive) {
          btnTogglePhraseEdit.className = 'btn btn-s font-mono bg-badge text-canvas border-badge font-bold';
        } else {
          btnTogglePhraseEdit.className = 'btn btn-secondary btn-s font-mono text-[12px]';
        }
      }
      if (phraseEditToolbar) {
        phraseEditToolbar.classList.toggle('hidden', !isPhraseEditModeActive);
      }
    }

    btnTogglePhraseEdit?.addEventListener('click', () => {
      isPhraseEditModeActive = !isPhraseEditModeActive;
      updatePhraseEditModeUI();
      renderPhrases();
      if (isPhraseEditModeActive) {
        showToast('Mode Edit Frasa Aktif: Klik tombol edit atau silang untuk mengubah frasa.');
      } else {
        showToast('Mode Edit Frasa ditutup.');
      }
    });

    btnFinishPhraseEdit?.addEventListener('click', () => {
      isPhraseEditModeActive = false;
      updatePhraseEditModeUI();
      renderPhrases();
      showToast('✓ Selesai mengedit frasa.');
    });

    btnResetPhrase?.addEventListener('click', () => {
      const allTables = getAllTables();
      const currentTable = allTables.find(t => t.id === currentTableId);
      if (confirm(`Kembalikan frasa bahasa "${currentTable?.name || 'ini'}" ke daftar bawaan awal? Semua frasa kustom bahasa ini akan di-reset.`)) {
        delete userPhrasesMap[currentTableId];
        localStorage.setItem('user_custom_phrases_map', JSON.stringify(userPhrasesMap));
        if (currentUser) {
