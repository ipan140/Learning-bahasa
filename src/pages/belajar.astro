    function parsePhraseImportText(text: string): Array<{ native: string, transliteration: string, meaning: string }> {
      const lines = text.split('\n').map(l => l.trim()).filter(Boolean);
      const items: Array<{ native: string, transliteration: string, meaning: string }> = [];

      for (const line of lines) {
        let parts: string[] = [];
        if (line.includes('=')) {
          parts = line.split('=').map(p => p.trim());
        } else if (line.includes('|')) {
          parts = line.split('|').map(p => p.trim());
        } else if (line.includes('\t')) {
          parts = line.split('\t').map(p => p.trim());
        } else if (line.includes(',')) {
          parts = line.split(',').map(p => p.trim());
        }

        if (parts.length >= 3) {
          items.push({ native: parts[0], transliteration: parts[1], meaning: parts[2] });
        } else if (parts.length === 2) {
          items.push({ native: parts[0], transliteration: '', meaning: parts[1] });
        } else if (parts.length === 1 && parts[0]) {
          items.push({ native: parts[0], transliteration: '', meaning: parts[0] });
        }
      }
      return items;
    }

    function updatePhraseImportPreview() {
      if (!phraseImportPreview || !phraseImportText) return;
      const items = parsePhraseImportText(phraseImportText.value);
      if (items.length === 0) {
        phraseImportPreview.innerHTML = 'Masukkan teks atau unggah file untuk melihat pratinjau...';
        return;
      }
      let html = `<div class="font-bold text-ink mb-1">✓ Terdeteksi ${items.length} frasa siap diimpor:</div><ul class="space-y-1 list-disc list-inside">`;
      items.slice(0, 5).forEach(it => {
        html += `<li><b class="text-ink">${it.native}</b> ${it.transliteration ? '(' + it.transliteration + ')' : ''} → <span class="italic text-steel">${it.meaning}</span></li>`;
      });
      if (items.length > 5) {
        html += `<li class="text-smoke italic">+ ${items.length - 5} frasa lainnya...</li>`;
      }
      html += '</ul>';
      phraseImportPreview.innerHTML = html;
    }

    phraseImportText?.addEventListener('input', updatePhraseImportPreview);

    if (phraseExcelInput) {
      phraseExcelInput.addEventListener('change', (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;

        showToast(`Membaca file "${file.name}"...`);
        const reader = new FileReader();
        reader.onload = (evt) => {
          try {
            const data = new Uint8Array(evt.target?.result as ArrayBuffer);
            const workbook = (window as any).XLSX.read(data, { type: 'array' });
            const sheetName = workbook.SheetNames[0];
            const worksheet = workbook.Sheets[sheetName];
            const jsonRows: any[][] = (window as any).XLSX.utils.sheet_to_json(worksheet, { header: 1 });

            const lines: string[] = [];
            for (const row of jsonRows) {
              if (!row || row.length === 0) continue;
              if (row.length >= 3) {
                lines.push(`${row[0]} = ${row[1]} = ${row[2]}`);
              } else if (row.length === 2) {
                lines.push(`${row[0]} = ${row[1]}`);
              }
            }

            if (phraseImportText) {
              phraseImportText.value = lines.join('\n');
              updatePhraseImportPreview();
              showToast(`✓ Berhasil memuat ${lines.length} baris frasa dari spreadsheet!`);
            }
          } catch {
            showToast('Gagal memproses file spreadsheet frasa.');
          }
        };
        reader.readAsArrayBuffer(file);
      });
    }

    phraseImportForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      let targetCatName = phraseImportCatSelect?.value || 'Umum';
      if (targetCatName === '__NEW__') {
        targetCatName = phraseImportCatCustom?.value.trim() || 'Kategori Baru';
      }
      saveCategoryToGlobalList(targetCatName);

      const items = parsePhraseImportText(phraseImportText?.value || '');
      if (items.length === 0) {
        showToast('Tidak ada data frasa yang valid untuk diimpor.');
        return;
      }

      const phrasesDataObj = ensureCustomPhrases(currentTableId);
      let destCat = phrasesDataObj.categories.find((c: any) => c.categoryName.toLowerCase() === targetCatName.toLowerCase());
      if (!destCat) {
        destCat = { categoryName: targetCatName, items: [] };
        phrasesDataObj.categories.push(destCat);
      }

      destCat.items.push(...items);
      saveUserPhrases(currentTableId);
      closePhraseImportModal();
      renderPhrases();
      showToast(`✓ Berhasil mengimpor ${items.length} frasa ke kategori "${targetCatName}"!`);
    });

    // ========================================================
    // FAVORITE PHRASES (BOOKMARK ⭐)
    // ========================================================
    let userFavoritePhrases = new Set<string>();
    function loadFavoritePhrases() {
      try {
        const stored = localStorage.getItem('user_favorite_phrases');
        if (stored) {
          userFavoritePhrases = new Set(JSON.parse(stored));
        }
      } catch {}
    }
    function saveFavoritePhrases() {
      try {
        localStorage.setItem('user_favorite_phrases', JSON.stringify(Array.from(userFavoritePhrases)));
      } catch {}
    }
    loadFavoritePhrases();

    function getPhraseKey(tableId: string, nativeText: string): string {
      return `${tableId}:::${nativeText.trim()}`;
    }

    function isPhraseFavorite(tableId: string, nativeText: string): boolean {
      return userFavoritePhrases.has(getPhraseKey(tableId, nativeText));
    }

    function togglePhraseFavorite(tableId: string, nativeText: string): boolean {
      const key = getPhraseKey(tableId, nativeText);
      const isFav = userFavoritePhrases.has(key);
      if (isFav) {
        userFavoritePhrases.delete(key);
      } else {
        userFavoritePhrases.add(key);
      }
      saveFavoritePhrases();
      return !isFav;
    }

    // ========================================================
    // SEQUENTIAL AUDIO WALKTHROUGH FOR PHRASES (PUTAR OTOMATIS)
    // ========================================================
    let isPlayingAllPhrases = false;
    let playAllPhrasesTimeout: any = null;
    let currentPlayPhraseCardEl: HTMLElement | null = null;

    function stopPlayAllPhrases() {
      if (!isPlayingAllPhrases && !currentPlayPhraseCardEl) return;
      isPlayingAllPhrases = false;
      if (playAllPhrasesTimeout) {
        clearTimeout(playAllPhrasesTimeout);
        playAllPhrasesTimeout = null;
      }
      if (currentPlayPhraseCardEl) {
        currentPlayPhraseCardEl.classList.remove('ring-4', 'ring-cta', 'bg-cta/20', 'scale-[1.01]', 'z-10');
        currentPlayPhraseCardEl = null;
      }
      if (btnPlayAllPhrases) {
        btnPlayAllPhrases.innerHTML = `<svg class="size-3.5 inline text-steel" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="6 3 20 12 6 21 6 3"/></svg> <span>Putar Otomatis</span>`;
        btnPlayAllPhrases.className = 'btn btn-secondary btn-s font-mono text-[12px] cursor-pointer inline-flex items-center gap-1.5';
      }
    }

    function startPlayAllPhrases() {
      const cards = phrasesContentWrapper ? phrasesContentWrapper.querySelectorAll('.phrase-card-item') : [];
      if (!cards.length) {
        showToast('Tidak ada frasa yang tampil untuk diputar.');
        return;
      }

      // Hentikan putar tabel karakter jika sedang jalan
      stopPlayAll();

      isPlayingAllPhrases = true;
      if (btnPlayAllPhrases) {
        btnPlayAllPhrases.innerHTML = `<svg class="size-3.5 inline text-canvas" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/></svg> <span>Hentikan</span>`;
        btnPlayAllPhrases.className = 'btn btn-primary btn-s font-mono text-[12px] cursor-pointer shadow-md inline-flex items-center gap-1.5';
      }

      let idx = 0;
      function playStep() {
        if (!isPlayingAllPhrases) return;
        if (idx >= cards.length) {
          stopPlayAllPhrases();
          showToast('✓ Selesai memutar seluruh frasa.');
          return;
        }

        if (currentPlayPhraseCardEl) {
          currentPlayPhraseCardEl.classList.remove('ring-4', 'ring-cta', 'bg-cta/20', 'scale-[1.01]', 'z-10');
        }

        const card = cards[idx] as HTMLElement;
        currentPlayPhraseCardEl = card;
        card.classList.add('ring-4', 'ring-cta', 'bg-cta/20', 'scale-[1.01]', 'z-10');
        card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

        const text = card.getAttribute('data-native') || '';
        const lang = card.getAttribute('data-lang') || '';
        speakText(text, lang);

        if (btnPlayAllPhrases) {
          btnPlayAllPhrases.innerHTML = `<svg class="size-3.5 inline text-canvas" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/></svg> <span>Stop (${idx + 1}/${cards.length})</span>`;
        }

        idx++;
        const charLen = text.length || 6;
        const estDuration = Math.max(1400, Math.round((charLen * 130) / currentAudioRate));
        playAllPhrasesTimeout = setTimeout(playStep, estDuration + 1100);
      }

      playStep();
    }

    btnPlayAllPhrases?.addEventListener('click', () => {
      if (isPlayingAllPhrases) stopPlayAllPhrases();
      else startPlayAllPhrases();
    });

    // ========================================================
    // RENDER PHRASES WITH SEARCH & CATEGORY FILTER
    // ========================================================
    let phraseSearchQuery = '';
    let selectedPhraseCategory = 'all';

    function renderPhraseCategoryChips(allCategories: any[]) {
      if (!phraseCategoryFilterChips) return;
      if (!allCategories || allCategories.length === 0) {
        phraseCategoryFilterChips.innerHTML = '';
        return;
      }

      let totalFavsInTable = 0;
      allCategories.forEach((cat: any) => {
        cat.items.forEach((item: any) => {
          if (isPhraseFavorite(currentTableId, item.native)) totalFavsInTable++;
        });
      });

      let chipsHtml = `
        <button type="button" data-cat="all" class="px-2.5 py-1 border transition-colors cursor-pointer ${selectedPhraseCategory === 'all' ? 'border-2 border-cta bg-cta/10 text-ink font-bold shadow-xs' : 'border-rule bg-canvas text-steel hover:text-ink'}">
          Semua
        </button>
        <button type="button" data-cat="__favorites__" class="px-2.5 py-1 border transition-colors cursor-pointer inline-flex items-center gap-1.5 whitespace-nowrap ${selectedPhraseCategory === '__favorites__' ? 'border-2 border-amber-500 bg-amber-500/15 text-ink font-bold shadow-xs' : 'border-rule bg-canvas text-steel hover:text-amber-500'}">
          <svg class="size-3.5 inline ${totalFavsInTable > 0 ? 'text-amber-500 fill-amber-400' : 'text-smoke'}" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="${totalFavsInTable > 0 ? 'currentColor' : 'none'}"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          Favorit (${totalFavsInTable})
        </button>
      `;

      allCategories.forEach((cat: any) => {
        const isActive = selectedPhraseCategory === cat.categoryName;
        chipsHtml += `
          <button type="button" data-cat="${encodeURIComponent(cat.categoryName)}" class="px-2.5 py-1 border transition-colors cursor-pointer whitespace-nowrap ${isActive ? 'border-2 border-cta bg-cta/10 text-ink font-bold shadow-xs' : 'border-rule bg-canvas text-steel hover:text-ink'}">
            ${cat.categoryName} (${cat.items.length})
          </button>
        `;
      });

      phraseCategoryFilterChips.innerHTML = chipsHtml;

      phraseCategoryFilterChips.querySelectorAll('button[data-cat]').forEach(btn => {
        btn.addEventListener('click', () => {
          const cat = btn.getAttribute('data-cat');
          selectedPhraseCategory = cat === 'all' ? 'all' : (cat === '__favorites__' ? '__favorites__' : decodeURIComponent(cat || 'all'));
          stopPlayAllPhrases();
          renderPhrases();
        });
      });
    }

    let phraseSearchDebounceTimer: any = null;
    phraseSearchInput?.addEventListener('input', (e) => {
      clearTimeout(phraseSearchDebounceTimer);
      phraseSearchDebounceTimer = setTimeout(() => {
        phraseSearchQuery = (e.target as HTMLInputElement)?.value || '';
        stopPlayAllPhrases();
        renderPhrases();
      }, 120);
    });

    function renderPhrases() {
      if (!phrasesContentWrapper) return;
      const data = getActivePhrasesData(currentTableId);
      const allTables = getAllTables();
      const currentTable = allTables.find(t => t.id === currentTableId);

      if (phrasesTitle) {
        phrasesTitle.textContent = `Frasa Penting: ${currentTable?.name || 'Bahasa'}`;
      }

      if (!data || !data.categories || data.categories.length === 0) {
        if (phraseCategoryFilterChips) phraseCategoryFilterChips.innerHTML = '';
        phrasesContentWrapper.innerHTML = `
          <div class="py-12 px-4 text-center border-2 border-dashed border-rule bg-canvas text-smoke font-mono space-y-3">
            <div class="size-12 mx-auto rounded-none bg-tint flex items-center justify-center border border-rule text-ink">
              <svg class="size-6 text-steel" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <div class="text-sm font-bold text-ink">Belum Ada Frasa untuk Bahasa "${currentTable?.name || ''}"</div>
            <p class="text-xs text-steel max-w-md mx-auto font-sans">
              Mulai koleksi frasa penting Anda sendiri sekarang. Anda bisa menambahkan satu per satu atau langsung impor dari file Excel/CSV!
            </p>
            <div class="flex items-center justify-center gap-2 pt-2">
              <button type="button" id="btn-empty-add-phrase" class="btn btn-primary btn-s font-mono text-xs cursor-pointer inline-flex items-center gap-1">
                <svg class="size-3.5 inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg> Tambah Frasa Pertama
              </button>
              <button type="button" id="btn-empty-import-phrase" class="btn btn-secondary btn-s font-mono text-xs cursor-pointer inline-flex items-center gap-1">
                <svg class="size-3.5 inline text-steel" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M8 13h2"/><path d="M14 13h2"/><path d="M8 17h2"/><path d="M14 17h2"/></svg> Impor dari Excel
              </button>
            </div>
          </div>
        `;
        document.getElementById('btn-empty-add-phrase')?.addEventListener('click', () => openPhraseModal(-1, -1));
        document.getElementById('btn-empty-import-phrase')?.addEventListener('click', openPhraseImportModal);
        return;
      }

      renderPhraseCategoryChips(data.categories);

      const searchLower = phraseSearchQuery.trim().toLowerCase();
      const filteredCategories = data.categories.map((cat: any, catIdx: number) => {
        if (selectedPhraseCategory !== 'all' && selectedPhraseCategory !== '__favorites__' && cat.categoryName !== selectedPhraseCategory) {
          return null;
        }
        const matchingItems = cat.items
          .map((item: any, itemIdx: number) => ({ ...item, originalItemIdx: itemIdx }))
          .filter((item: any) => {
            if (selectedPhraseCategory === '__favorites__' && !isPhraseFavorite(currentTableId, item.native)) {
              return false;
            }
            if (!searchLower) return true;
            return (
              (item.native && item.native.toLowerCase().includes(searchLower)) ||
              (item.transliteration && item.transliteration.toLowerCase().includes(searchLower)) ||
              (item.meaning && item.meaning.toLowerCase().includes(searchLower))
            );
          });
        if (matchingItems.length === 0) return null;
        return {
          ...cat,
          originalCatIdx: catIdx,
          items: matchingItems
        };
      }).filter(Boolean);

      if (filteredCategories.length === 0) {
        phrasesContentWrapper.innerHTML = `
          <div class="py-12 px-4 text-center border-2 border-dashed border-rule bg-canvas text-smoke font-mono space-y-2">
            <div class="size-10 mx-auto rounded-none ${selectedPhraseCategory === '__favorites__' ? 'bg-amber-500/10 border-amber-500/30 text-amber-500' : 'bg-tint border-rule text-smoke'} flex items-center justify-center border">
              ${selectedPhraseCategory === '__favorites__' ? `
                <svg class="size-5 fill-amber-400 text-amber-500" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              ` : `
                <svg class="size-5 text-steel" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
              `}
            </div>
            <div class="text-sm font-bold text-ink">${selectedPhraseCategory === '__favorites__' ? 'Belum Ada Frasa Favorit' : 'Tidak ada frasa yang cocok'}</div>
            <p class="text-xs text-steel font-sans max-w-sm mx-auto">
              ${selectedPhraseCategory === '__favorites__' ? 'Tandai frasa yang ingin Anda pelajari lebih sering dengan mengklik ikon bintang (⭐) pada kartu frasa.' : `Tidak ditemukan frasa untuk pencarian "<b>${phraseSearchQuery}</b>"${selectedPhraseCategory !== 'all' ? ` pada kategori <b>${selectedPhraseCategory}</b>` : ''}.`}
            </p>
            <button type="button" id="btn-clear-phrase-search" class="mt-2 btn btn-secondary btn-s font-mono text-xs cursor-pointer">
              ${selectedPhraseCategory === '__favorites__' ? 'Tampilkan Semua Frasa' : 'Bersihkan Filter'}
            </button>
          </div>
        `;
        document.getElementById('btn-clear-phrase-search')?.addEventListener('click', () => {
          phraseSearchQuery = '';
          selectedPhraseCategory = 'all';
          if (phraseSearchInput) phraseSearchInput.value = '';
          renderPhrases();
        });
        return;
      }

      let html = '';
      filteredCategories.forEach((cat: any) => {
        const catIdx = cat.originalCatIdx;
        html += `
          <div class="p-4 sm:p-5 border border-rule bg-canvas space-y-3 shadow-xs">
            <div class="border-b border-rule pb-2.5 flex items-center justify-between flex-wrap gap-2">
              <div class="flex items-center gap-2">
                <h3 class="text-[15px] font-bold text-ink">${cat.categoryName}</h3>
                <span class="text-[11px] font-mono text-smoke font-normal bg-tint px-2 py-0.5 border border-rule">${cat.items.length} frasa</span>
              </div>
              <div class="flex items-center gap-1.5 font-mono text-xs">
                ${isPhraseEditModeActive ? `
                  <button 
                    type="button" 
                    class="btn-cat-add px-2 py-1 border border-rule hover:border-ink hover:bg-canvas text-ink text-[11px] font-bold cursor-pointer"
                    data-cat-idx="${catIdx}"
                    data-cat-name="${cat.categoryName}"
                    title="Tambah frasa baru ke kategori ini"
                  >
                    + Tambah
                  </button>
                  <button 
                    type="button" 
                    class="btn-cat-delete px-2 py-1 border border-red-500/40 text-red-500 hover:bg-red-500 hover:text-white text-[11px] cursor-pointer"
                    data-cat-idx="${catIdx}"
                    data-cat-name="${cat.categoryName}"
                    title="Hapus seluruh kategori ini"
                  >
                    <svg class="size-3 inline mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>Hapus Kategori
                  </button>
                ` : ''}
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-1">
        `;

        cat.items.forEach((item: any, itemIdx: number) => {
          const isFav = isPhraseFavorite(currentTableId, item.native);
          html += `
            <div 
              class="phrase-card-item p-3 border border-rule bg-smoke/5 hover:border-ink hover:bg-smoke/10 cursor-pointer active:scale-[0.99] transition-all flex items-center justify-between gap-3 font-mono relative select-none ${isPhraseEditModeActive ? 'ring-1 ring-badge/40' : ''}"
              data-native="${item.native}"
              data-lang="${data.voiceLang || currentTable?.voiceLang || 'en-US'}"
              title="Klik kartu untuk mendengarkan pengucapan audio"
            >
              <div class="min-w-0 flex-1">
                <div class="text-[16px] font-bold text-ink tracking-wide truncate">${item.native}</div>
                <div class="text-[12px] text-steel font-medium mt-0.5">${item.transliteration || ''}</div>
                <div class="text-[11px] text-smoke italic font-sans mt-0.5">${item.meaning}</div>
              </div>

              <div class="flex items-center gap-1.5 shrink-0">
                <button 
                  type="button" 
                  class="btn-fav-phrase p-1.5 border border-rule hover:border-amber-400 bg-canvas text-xs cursor-pointer inline-flex items-center justify-center transition-colors ${isFav ? 'text-amber-500 border-amber-400/60 bg-amber-500/10' : 'text-smoke hover:text-amber-500'}"
                  data-native="${item.native}"
                  title="${isFav ? 'Hapus dari daftar favorit' : 'Tandai sebagai frasa favorit'}"
                >
                  <svg class="size-3.5 inline ${isFav ? 'fill-amber-400 text-amber-500' : 'text-smoke hover:text-amber-500'}" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="${isFav ? 'currentColor' : 'none'}"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                </button>
                <button 
                  type="button" 
                  class="btn-mic-phrase p-1.5 border border-rule hover:border-cta bg-canvas text-xs cursor-pointer inline-flex items-center justify-center transition-colors text-steel hover:text-cta"
                  data-native="${item.native}"
                  data-translit="${item.transliteration || ''}"
                  data-lang="${data.voiceLang || currentTable?.voiceLang || 'en-US'}"
                  title="Tes pelafalan suara Anda untuk frasa ini"
                >
                  <svg class="size-3.5 inline text-current" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
                </button>
                ${isPhraseEditModeActive ? `
                  <button 
                    type="button" 
                    class="btn-edit-phrase px-2 py-1.5 border border-rule hover:border-ink bg-canvas text-ink text-xs cursor-pointer shadow-xs inline-flex items-center justify-center"
                    data-cat="${catIdx}"
                    data-item="${item.originalItemIdx ?? itemIdx}"
                    title="Edit frasa ini"
                  >
                    <svg class="size-3.5 text-steel hover:text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                  </button>
                  <button 
                    type="button" 
                    class="btn-delete-phrase px-2 py-1.5 border border-red-500 text-red-500 hover:bg-red-500 hover:text-white text-xs cursor-pointer shadow-xs font-bold inline-flex items-center justify-center"
                    data-cat="${catIdx}"
                    data-item="${item.originalItemIdx ?? itemIdx}"
                    data-native="${item.native}"
                    title="Hapus frasa ini"
                  >
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                  </button>
                ` : ''}
                <button 
                  type="button" 
                  class="btn-speak-phrase px-2.5 py-1.5 border border-rule hover:border-ink hover:bg-canvas text-ink text-xs select-none cursor-pointer inline-flex items-center justify-center"
                  data-native="${item.native}"
                  data-lang="${data.voiceLang || currentTable?.voiceLang || 'en-US'}"
                  title="Dengarkan pengucapan audio"
                >
                  <svg class="size-3.5 text-ink inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
                </button>
              </div>
            </div>
          `;
        });

        html += `
            </div>
          </div>
        `;
      });

      phrasesContentWrapper.innerHTML = html;

      // Click card to speak audio
      phrasesContentWrapper.querySelectorAll('.phrase-card-item').forEach(card => {
        card.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          // Abaikan jika yang diklik adalah tombol edit, hapus, bintang favorit, atau mic
          if (target.closest('.btn-edit-phrase') || target.closest('.btn-delete-phrase') || target.closest('.btn-fav-phrase') || target.closest('.btn-mic-phrase')) {
            return;
          }
          const text = card.getAttribute('data-native') || '';
          const lang = card.getAttribute('data-lang') || '';
          speakText(text, lang);

          // Efek visual kartu menyala saat dibunyikan
          card.classList.add('ring-2', 'ring-cta', 'bg-cta/10');
          setTimeout(() => {
            card.classList.remove('ring-2', 'ring-cta', 'bg-cta/10');
          }, 350);
        });
      });

      // Toggle Bookmark Favorit
      phrasesContentWrapper.querySelectorAll('.btn-fav-phrase').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const native = btn.getAttribute('data-native') || '';
          const isNowFav = togglePhraseFavorite(currentTableId, native);
          showToast(isNowFav ? `⭐ Frasa "${native}" ditambahkan ke favorit!` : `Dihapus dari favorit.`);
          renderPhrases();
        });
      });

      // Uji Pelafalan Mikrofon
      phrasesContentWrapper.querySelectorAll('.btn-mic-phrase').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const native = btn.getAttribute('data-native') || '';
          const translit = btn.getAttribute('data-translit') || '';
          const lang = btn.getAttribute('data-lang') || '';
          testPhrasePronunciation(native, translit, lang, btn as HTMLElement);
        });
      });

      // Audio buttons (tetap support jika user klik langsung icon speaker)
      phrasesContentWrapper.querySelectorAll('.btn-speak-phrase').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const card = btn.closest('.phrase-card-item');
          const text = btn.getAttribute('data-native') || '';
          const lang = btn.getAttribute('data-lang') || '';
          speakText(text, lang);

          if (card) {
            card.classList.add('ring-2', 'ring-cta', 'bg-cta/10');
            setTimeout(() => {
              card.classList.remove('ring-2', 'ring-cta', 'bg-cta/10');
            }, 350);
          }
        });
      });

      // Edit Mode buttons
      if (isPhraseEditModeActive) {
        phrasesContentWrapper.querySelectorAll('.btn-edit-phrase').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const catIdx = parseInt(btn.getAttribute('data-cat') || '-1');
            const itemIdx = parseInt(btn.getAttribute('data-item') || '-1');
            openPhraseModal(catIdx, itemIdx);
          });
        });

        phrasesContentWrapper.querySelectorAll('.btn-delete-phrase').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            e.stopPropagation();
            const catIdx = parseInt(btn.getAttribute('data-cat') || '-1');
            const itemIdx = parseInt(btn.getAttribute('data-item') || '-1');
            const native = btn.getAttribute('data-native') || '';
            const ok = await showRetroConfirm({
              title: 'Hapus Frasa',
