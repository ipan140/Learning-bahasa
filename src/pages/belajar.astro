        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `p-2 sm:px-3 sm:py-2 text-[12px] sm:text-[13px] font-mono border transition-all flex items-center justify-start gap-1.5 select-none w-full min-w-0 cursor-pointer ${
