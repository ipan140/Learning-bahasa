  <!-- SINGLE CHARACTER / AKSARA EDIT MODAL       -->
  <!-- ========================================== -->
  <dialog id="char-edit-modal" class="m-auto backdrop:bg-black/60 p-0 bg-canvas text-ink border-2 border-ink w-[92vw] max-w-md shadow-2xl max-h-[90dvh] overflow-y-auto">
    <div class="p-5 sm:p-6">
      <div class="flex items-center justify-between border-b border-rule pb-3 mb-3">
        <h4 id="char-modal-title" class="text-base font-bold text-ink flex items-center gap-1.5"><Edit3 class="size-4 inline text-ink" /> Edit Karakter</h4>
        <button type="button" id="close-char-modal-btn" class="text-smoke hover:text-ink font-mono text-sm cursor-pointer p-1" aria-label="Tutup"><X class="size-4" /></button>
      </div>

      <!-- Mode Switcher Tabs (hanya tampil saat nambah huruf baru) -->
      <div id="char-modal-tabs" class="flex border-b border-rule mb-4 font-mono text-xs">
        <button type="button" id="tab-char-single" class="px-3.5 py-2 border-b-2 border-ink text-ink font-bold cursor-pointer inline-flex items-center gap-1.5">
          <Plus class="size-3.5 text-steel" /> 1 Huruf Satuan
        </button>
        <button type="button" id="tab-char-batch" class="px-3.5 py-2 border-b-2 border-transparent text-smoke hover:text-ink cursor-pointer inline-flex items-center gap-1.5">
          <FileSpreadsheet class="size-3.5 text-cta" /> Impor Banyak (Excel / Teks)
        </button>
      </div>

      <!-- TAB 1: FORM 1 HURUF SATUAN -->
      <form id="char-edit-form" class="space-y-4">
        <input type="hidden" id="char-edit-row" value="" />
        <input type="hidden" id="char-edit-col" value="" />
        <div>
          <label class="block text-xs font-mono text-steel mb-1">Aksara / Huruf Asli *</label>
          <input 
            type="text" 
            id="char-edit-char-input" 
            required
            placeholder="Misal: あ atau ب"
            class="w-full px-3 py-2 text-2xl font-bold bg-tint border border-rule text-ink outline-none focus:border-ink font-mono text-center" 
          />
        </div>
        <div>
          <label class="block text-xs font-mono text-steel mb-1">Cara Baca / Transliterasi (Romaji)</label>
          <input 
            type="text" 
            id="char-edit-romaji-input" 
            placeholder="Misal: Ka, Alif, dll."
            class="w-full px-3 py-2 text-sm bg-tint border border-rule text-ink outline-none focus:border-ink font-mono" 
          />
        </div>
        <div class="flex items-center justify-between gap-2 pt-3 border-t border-rule">
          <button type="button" id="char-edit-delete-btn" class="px-3 py-1.5 text-xs font-mono border border-rule text-red-500 hover:border-red-500 hover:bg-red-500/10 cursor-pointer inline-flex items-center gap-1">
            <Trash2 class="size-3.5 inline" /> Hapus Huruf
          </button>
          <div class="flex items-center gap-2">
            <button type="button" id="char-edit-cancel-btn" class="px-3 py-1.5 text-xs font-mono border border-rule text-smoke hover:text-ink cursor-pointer">
              Batal
            </button>
            <button type="submit" class="px-3 py-1.5 text-xs font-mono border border-ink bg-ink text-canvas font-bold cursor-pointer">
              Simpan
            </button>
          </div>
        </div>
      </form>

      <!-- TAB 2: FORM IMPOR MASSAL (EXCEL / TEXTAREA) -->
      <div id="char-batch-pane" class="hidden space-y-4">
        <!-- Unggah Excel -->
        <div class="p-3 border border-dashed border-rule bg-tint/40 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="flex items-center gap-2.5">
            <FileSpreadsheet class="size-5 text-cta shrink-0" />
            <div>
              <p class="text-xs font-bold text-ink">Unggah Spreadsheet Excel / CSV</p>
              <p class="text-[11px] text-smoke font-mono">Format kolom: Romaji / Cara Baca, Aksara</p>
            </div>
          </div>
          <label class="btn btn-secondary btn-s font-mono text-xs cursor-pointer shrink-0 inline-flex items-center gap-1.5">
            <Upload class="size-3.5" /> Pilih File
            <input type="file" id="char-batch-file-input" accept=".xlsx,.xls,.csv" class="hidden" />
          </label>
        </div>

        <!-- Tempel Teks -->
        <div>
          <div class="flex items-center justify-between mb-1">
            <label class="text-xs font-mono text-steel">Atau Tempel Baris Teks:</label>
            <span id="char-batch-count-badge" class="text-[11px] font-mono text-ok font-bold">0 huruf terdeteksi</span>
          </div>
          <textarea 
            id="char-batch-textarea" 
            rows="5" 
            placeholder="Contoh format per baris:&#10;A = あ&#10;I = い&#10;U = う&#10;E = え&#10;O = お&#10;&#10;Atau dengan pemisah pipe: Ka = か | Ki = き | Ku = く"
            class="w-full px-3 py-2 text-xs bg-tint border border-rule text-ink outline-none focus:border-ink font-mono resize-y"
          ></textarea>
        </div>

        <!-- Checkbox Anti Duplikat -->
        <div class="flex items-center gap-2 text-xs font-mono text-steel">
          <input type="checkbox" id="char-batch-dedup-check" checked class="accent-cta cursor-pointer size-4" />
          <label for="char-batch-dedup-check" class="cursor-pointer select-none">Lewati jika huruf sudah ada di tabel ini (cegah duplikat)</label>
        </div>

        <div class="flex items-center justify-between gap-2 pt-3 border-t border-rule">
          <button type="button" id="btn-char-batch-cancel" class="px-3 py-1.5 text-xs font-mono border border-rule text-smoke hover:text-ink cursor-pointer">
            Batal
          </button>
          <button type="button" id="btn-submit-char-batch" class="px-4 py-1.5 text-xs font-mono border border-ink bg-ink text-canvas font-bold cursor-pointer inline-flex items-center gap-1.5">
            <Check class="size-3.5 inline" /> Tambahkan ke Tabel Ini
          </button>
        </div>
      </div>
    </div>
  </dialog>
  <!-- ========================================== -->
  <!-- PHRASE CREATE & EDIT MODAL                 -->
  <!-- ========================================== -->
  <dialog id="phrase-modal" class="m-auto backdrop:bg-black/60 p-0 bg-canvas text-ink border-2 border-ink w-[92vw] max-w-md shadow-2xl max-h-[90dvh] overflow-y-auto">
