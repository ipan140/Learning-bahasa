    tabCharSingle?.addEventListener('click', () => switchCharModalTab('single'));
    tabCharBatch?.addEventListener('click', () => switchCharModalTab('batch'));

    function parseLinesToCharItems(text: string): { romaji: string; char: string }[] {
      const lines = text.split('\n').map(l => l.trim()).filter(Boolean);
      const items: { romaji: string; char: string }[] = [];
      for (const line of lines) {
        let parts: string[] = [];
        if (line.includes('|')) {
          parts = line.split('|').map(p => p.trim());
        } else if (line.includes('\t')) {
          parts = line.split('\t').map(p => p.trim());
        } else if (line.includes(',')) {
          parts = line.split(',').map(p => p.trim());
        } else {
          parts = [line];
        }

        for (const part of parts) {
          if (!part || part === '-' || part === 'null') continue;
          if (part.includes('=')) {
            const [romaji, ch] = part.split('=').map(s => s.trim());
            if (ch) items.push({ romaji: romaji || '', char: ch });
          } else {
            items.push({ romaji: '', char: part });
          }
        }
      }
      return items;
    }

    function updateBatchCountBadge() {
      const text = charBatchTextarea?.value || '';
      const items = parseLinesToCharItems(text);
      if (charBatchCountBadge) {
        charBatchCountBadge.textContent = `${items.length} huruf terdeteksi`;
      }
    }

    charBatchTextarea?.addEventListener('input', updateBatchCountBadge);

    // Excel / CSV file upload inside batch modal
    charBatchFileInput?.addEventListener('change', (e: any) => {
      const file = e.target?.files?.[0];
      if (!file) return;

      const fileName = file.name.toLowerCase();
      const isExcel = fileName.endsWith('.xlsx') || fileName.endsWith('.xls') || fileName.endsWith('.csv');

      if (isExcel && (window as any).XLSX) {
        showToast(`Membaca file "${file.name}"...`);
        const reader = new FileReader();
        reader.onload = (evt) => {
          try {
            const data = new Uint8Array(evt.target?.result as ArrayBuffer);
            const workbook = (window as any).XLSX.read(data, { type: 'array' });
            const sheetName = workbook.SheetNames[0];
            const worksheet = workbook.Sheets[sheetName];
            const jsonRows: any[][] = (window as any).XLSX.utils.sheet_to_json(worksheet, { header: 1 });

            const formattedLines: string[] = [];
            for (const row of jsonRows) {
              if (!row || row.length === 0) continue;
              if (row.length === 2) {
                formattedLines.push(`${row[0] ?? ''} = ${row[1] ?? ''}`);
              } else {
                const rowItems: string[] = [];
                for (let i = 0; i < row.length; i += 2) {
                  if (row[i] !== undefined && row[i+1] !== undefined) {
                    rowItems.push(`${row[i]} = ${row[i+1]}`);
                  }
                }
                if (rowItems.length > 0) formattedLines.push(rowItems.join(' | '));
              }
            }

            if (charBatchTextarea) {
              charBatchTextarea.value = formattedLines.join('\n');
              updateBatchCountBadge();
              showToast(`✓ Berhasil memuat ${formattedLines.length} baris dari "${file.name}"!`);
            }
          } catch {
            showToast('Gagal memproses file Excel.');
          }
        };
        reader.readAsArrayBuffer(file);
      } else {
        const reader = new FileReader();
        reader.onload = (evt) => {
          if (charBatchTextarea) {
            charBatchTextarea.value = evt.target?.result as string;
            updateBatchCountBadge();
            showToast(`✓ Berhasil memuat file teks!`);
          }
        };
        reader.readAsText(file);
      }
    });

    // Batch Submit Handler
    btnSubmitCharBatch?.addEventListener('click', () => {
      const text = charBatchTextarea?.value || '';
      const items = parseLinesToCharItems(text);
      if (items.length === 0) {
        showToast('Silakan tempel teks huruf atau upload file Excel terlebih dahulu.');
        return;
      }

      const table = ensureCustomTableForEditing();
      if (!table || !table.grid) return;

      const shouldDedup = charBatchDedupCheck ? charBatchDedupCheck.checked : true;
      const existingChars = new Set<string>();
      for (const row of table.grid) {
        if (!row) continue;
        for (const cell of row) {
          if (cell && cell.char) existingChars.add(cell.char.trim());
        }
      }

      let addedCount = 0;
      for (const item of items) {
        if (!item.char) continue;
        if (shouldDedup && existingChars.has(item.char.trim())) {
          continue; // Lewati jika duplikat
        }

        existingChars.add(item.char.trim());
        if (table.grid.length === 0) {
          table.grid.push([item]);
        } else {
          const lastRow = table.grid[table.grid.length - 1];
          if (lastRow.length < 5) {
            lastRow.push(item);
          } else {
            table.grid.push([item]);
          }
        }
        addedCount++;
      }

      if (addedCount === 0) {
        showToast('Semua huruf yang diimpor sudah ada di tabel ini (tidak ada huruf baru yang ditambahkan).');
        return;
      }

      saveCustomTablesToStorage();
      if (currentUser) {
        saveCustomTableToCloud(currentUser.id, table).catch(() => {});
      }

      closeCharModal();
      renderCurrentTable();
      updateProgressUI();
      showToast(`✓ Berhasil menambahkan ${addedCount} huruf baru ke tabel "${table.name}"!`);
      if (charBatchTextarea) charBatchTextarea.value = '';
    });

    btnCharBatchCancel?.addEventListener('click', closeCharModal);

    // Single Character Modal logic
    function openCharModal(row: number, col: number, char: string = '', romaji: string = '', defaultTab: 'single' | 'batch' = 'single') {
      if (!charEditModal) return;
      if (charEditRow) charEditRow.value = String(row);
      if (charEditCol) charEditCol.value = String(col);
      if (charEditCharInput) charEditCharInput.value = char;
      if (charEditRomajiInput) charEditRomajiInput.value = romaji;

      const isNew = row === -1 && col === -1;

      if (charModalTitle) {
        charModalTitle.innerHTML = isNew 
          ? '<svg class="size-4 inline mr-1.5 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg> Tambah Huruf ke Tabel' 
          : `<svg class="size-4 inline mr-1.5 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg> Edit Huruf: ${char}`;
      }
      if (charEditDeleteBtn) {
        charEditDeleteBtn.style.display = isNew ? 'none' : 'block';
      }

      if (isNew) {
        if (charModalTabs) charModalTabs.style.display = 'flex';
        switchCharModalTab(defaultTab);
      } else {
        if (charModalTabs) charModalTabs.style.display = 'none';
        switchCharModalTab('single');
      }

      charEditModal.showModal();
    }

    function closeCharModal() {
      charEditModal?.close();
    }

    closeCharModalBtn?.addEventListener('click', closeCharModal);
    charEditCancelBtn?.addEventListener('click', closeCharModal);

    charEditForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const rIdx = parseInt(charEditRow?.value || '-1');
      const cIdx = parseInt(charEditCol?.value || '-1');
      const newChar = charEditCharInput?.value.trim() || '';
      const newRomaji = charEditRomajiInput?.value.trim() || '';

      if (!newChar) return;
      const table = ensureCustomTableForEditing();
      if (!table || !table.grid) return;

      if (rIdx === -1 && cIdx === -1) {
        if (table.grid.length === 0) {
          table.grid.push([{ char: newChar, romaji: newRomaji }]);
        } else {
          const lastRow = table.grid[table.grid.length - 1];
          if (lastRow.length < 5) {
            lastRow.push({ char: newChar, romaji: newRomaji });
          } else {
            table.grid.push([{ char: newChar, romaji: newRomaji }]);
          }
        }
        showToast(`✓ Huruf "${newChar}" berhasil ditambahkan!`);
      } else {
        if (table.grid[rIdx] && table.grid[rIdx][cIdx] !== undefined) {
          table.grid[rIdx][cIdx] = { char: newChar, romaji: newRomaji };
          showToast(`✓ Karakter "${newChar}" berhasil diperbarui!`);
        }
      }

      saveCustomTablesToStorage();
      if (currentUser) {
        saveCustomTableToCloud(currentUser.id, table).catch(() => {});
      }
      closeCharModal();
      renderCurrentTable();
      updateProgressUI();
    });

    charEditDeleteBtn?.addEventListener('click', () => {
      const rIdx = parseInt(charEditRow?.value || '-1');
      const cIdx = parseInt(charEditCol?.value || '-1');
