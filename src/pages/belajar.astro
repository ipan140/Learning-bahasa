<!-- Load SheetJS for Excel Reading -->
<script is:inline src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<script>
  import { 
    getCurrentUser, 
    fetchUserCustomTablesFromCloud, 
    saveCustomTableToCloud, 
    deleteCustomTableFromCloud,
    fetchUserProgressFromCloud,
    saveUserProgressToCloud,
    fetchUserPhrasesFromCloud,
    saveUserPhrasesToCloud,
    deleteUserPhrasesFromCloud,
    fetchUserPhraseCategoriesFromCloud,
    saveUserPhraseCategoryToCloud,
    saveUserQuizScoreToCloud,
    saveUserPreferencesToCloud,
    fetchUserPreferencesFromCloud
  } from '../lib/supabase';

  const appEl = document.getElementById('main-app');
  if (appEl) {
    const defaultTables: any[] = JSON.parse(appEl.dataset.defaults || '[]');
    const phrasesData: Record<string, any> = JSON.parse(appEl.dataset.phrases || '{}');
    let customTables: any[] = JSON.parse(localStorage.getItem('custom_character_tables') || '[]');
    
    // User study progress (memorized chars map): { tableId: string[] }
    let userProgressMap: Record<string, string[]> = JSON.parse(localStorage.getItem('user_study_progress_map') || '{}');

    let currentTableId = defaultTables[0]?.id || '';
    let categoryFilter = 'all';
    let currentViewMode: 'table' | 'flashcard' | 'phrases' = 'table';
    let isAudioEnabled = true;
    let currentAudioRate = 1.0;
    let tableSearchQuery = '';
    let isUnaddedState = false;
    let unaddedInfo = { country: '', language: '', flag: '', voice: '' };
    let currentUser: any = null;

    // Edit Mode State
    let isEditModeActive = false;
    let editingTableId: string | null = null;

    // Flashcard state
    let fcIndex = 0;
    let fcIsFlipped = false;
    let fcMode: 'card' | 'quiz' = 'card';
    let quizScore = 0;

    function getAllTables() {
      return [...defaultTables, ...customTables];
    }

    // URL params
    const urlParams = new URLSearchParams(window.location.search);
    const initialLang = urlParams.get('lang');
    const initialMode = urlParams.get('mode');
    const unaddedTarget = urlParams.get('unadded');
    const createTarget = urlParams.get('create');
    const countryParam = urlParams.get('country') || unaddedTarget || createTarget;
    const languageParam = urlParams.get('language') || '';
    const flagParam = urlParams.get('flag') || '🏳️';
    const voiceTarget = urlParams.get('voice') || 'en-US';

    if (unaddedTarget || createTarget) {
      isUnaddedState = true;
      unaddedInfo = {
        country: countryParam || 'Negara',
        language: languageParam || '',
        flag: flagParam,
        voice: voiceTarget
      };
    } else if (initialLang) {
      const found = getAllTables().find(t => t.id === initialLang);
      if (found) {
        currentTableId = initialLang;
        isUnaddedState = false;
      } else {
        isUnaddedState = true;
        unaddedInfo = {
          country: countryParam || initialLang,
          language: languageParam || '',
          flag: flagParam,
          voice: voiceTarget
        };
      }
    }

    // DOM Elements
    const tabBar = document.getElementById('tab-bar');
    const categoryChips = document.querySelectorAll('#category-filter-chips button');
    
    // Mode Buttons
    const btnModeTable = document.getElementById('btn-mode-table');
    const btnModeFlashcard = document.getElementById('btn-mode-flashcard');
    const btnModePhrases = document.getElementById('btn-mode-phrases');

    // View Containers
    const viewerContainer = document.getElementById('viewer-container');
    const flashcardContainer = document.getElementById('flashcard-container');
    const phrasesContainer = document.getElementById('phrases-container');

    // Progress Elements
    const progressCountLabel = document.getElementById('progress-count-label');
    const progressPercentLabel = document.getElementById('progress-percent-label');
    const progressFillBar = document.getElementById('progress-fill-bar');
    const btnResetProgress = document.getElementById('btn-reset-progress');

    // Table elements
    const tableTitle = document.getElementById('table-title');
    const tableBadge = document.getElementById('table-badge');
    const tableDescription = document.getElementById('table-description');
    const gridWrapper = document.getElementById('table-grid-wrapper');
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const toggleAudioBtn = document.getElementById('toggle-audio-btn');
    const audioStatusLabel = document.getElementById('audio-status-label');
    const toggleSpeedBtn = document.getElementById('toggle-speed-btn');
    const speedStatusLabel = document.getElementById('speed-status-label');
    const copyAllBtn = document.getElementById('copy-all-btn');

    // Edit Mode Toolbar & Action Elements
    const toggleEditModeBtn = document.getElementById('toggle-edit-mode-btn');
    const tableEditToolbar = document.getElementById('table-edit-toolbar');
    const btnAutoDedup = document.getElementById('btn-auto-dedup');
    const btnAddCharTable = document.getElementById('btn-add-char-table');
    const btnTopAddChar = document.getElementById('btn-top-add-char');
    btnTopAddChar?.addEventListener('click', () => {
      openCharModal(-1, -1, '', '');
    });
    const btnFinishEditMode = document.getElementById('btn-finish-edit-mode');
    const duplicateTableBtn = document.getElementById('duplicate-table-btn');
    const editCustomTableBtn = document.getElementById('edit-custom-table-btn');
    const deleteTableBtn = document.getElementById('delete-table-btn');

    // Character Modal Elements
    const charEditModal = document.getElementById('char-edit-modal') as HTMLDialogElement | null;
    const charEditForm = document.getElementById('char-edit-form') as HTMLFormElement | null;
