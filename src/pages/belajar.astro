    // ========================================================
    // VOICE RECOGNITION PRONUNCIATION CHECKER (TES LAFAL MIC)
    // ========================================================
    let activeRecognition: any = null;
    let activeMicBtn: HTMLElement | null = null;

    function stopActiveMic() {
      if (activeRecognition) {
        try { activeRecognition.stop(); } catch {}
        activeRecognition = null;
      }
      if (activeMicBtn) {
        activeMicBtn.classList.remove('border-red-500', 'text-red-500', 'bg-red-500/15', 'animate-pulse');
        activeMicBtn = null;
      }
    }

    function testPhrasePronunciation(targetNative: string, targetTranslit: string, langCode: string, btnEl: HTMLElement) {
      const SpeechRecognition = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
      if (!SpeechRecognition) {
        showToast('⚠️ Fitur mic butuh browser Chrome atau Edge di desktop/Android.');
        return;
      }

      if (activeMicBtn === btnEl && activeRecognition) {
        stopActiveMic();
        showToast('Perekaman suara dihentikan.');
        return;
      }

      stopActiveMic();
      activeMicBtn = btnEl;
      btnEl.classList.add('border-red-500', 'text-red-500', 'bg-red-500/15', 'animate-pulse');

      const card = btnEl.closest('.phrase-card-item');

      try {
        const recognition = new SpeechRecognition();
        activeRecognition = recognition;
        recognition.lang = langCode || 'en-US';
        recognition.interimResults = false;
        recognition.maxAlternatives = 3;

        showToast(`🎙️ Mendengarkan... Silakan ucapkan: "${targetTranslit || targetNative}"`);

        recognition.onresult = (evt: any) => {
          stopActiveMic();
          const results = evt.results?.[0];
          if (!results || results.length === 0) {
            showToast('Suara tidak terdengar jelas. Silakan coba lagi.');
            return;
          }

          const heardWords: string[] = [];
          for (let i = 0; i < results.length; i++) {
            heardWords.push(results[i].transcript.toLowerCase().trim());
          }
          const primaryHeard = heardWords[0] || '';

          const clean = (s: string) => s.toLowerCase().replace(/[\s.,/#!$%^&*;:{}=\-_`~()?'"！？、。]/g, '');
          const cleanNative = clean(targetNative);
          const cleanTranslit = clean(targetTranslit);

          let bestMatch = 0;
          for (const heard of heardWords) {
            const cleanHeard = clean(heard);
            if (cleanHeard === cleanNative || cleanHeard === cleanTranslit) {
              bestMatch = 100;
              break;
            }
            if (cleanNative && (cleanHeard.includes(cleanNative) || cleanNative.includes(cleanHeard))) {
              bestMatch = Math.max(bestMatch, 85);
            }
            if (cleanTranslit && (cleanHeard.includes(cleanTranslit) || cleanTranslit.includes(cleanHeard))) {
              bestMatch = Math.max(bestMatch, 85);
            }
            let commonChars = 0;
            const targetRef = cleanTranslit || cleanNative;
            for (const ch of cleanHeard) {
              if (targetRef.includes(ch)) commonChars++;
            }
            const ratio = Math.round((commonChars / Math.max(targetRef.length, cleanHeard.length, 1)) * 100);
            bestMatch = Math.max(bestMatch, ratio);
          }

          if (bestMatch >= 75) {
            showToast(`🎉 Luar biasa! Pelafalan cocok (${bestMatch}%): "${primaryHeard}"`);
            if (card) {
              card.classList.add('ring-2', 'ring-ok', 'bg-ok/10');
              setTimeout(() => card.classList.remove('ring-2', 'ring-ok', 'bg-ok/10'), 1500);
            }
          } else if (bestMatch >= 40) {
            showToast(`👍 Cukup baik (${bestMatch}%). Terdengar: "${primaryHeard}". Coba ucapkan lebih jelas!`);
            if (card) {
              card.classList.add('ring-2', 'ring-amber-500', 'bg-amber-500/10');
              setTimeout(() => card.classList.remove('ring-2', 'ring-amber-500', 'bg-amber-500/10'), 1500);
            }
          } else {
            showToast(`🗣️ Terdengar: "${primaryHeard}" (${bestMatch}%). Dengarkan audio lalu ulangi ya!`);
          }
        };

        recognition.onerror = (err: any) => {
          stopActiveMic();
          if (err.error === 'not-allowed') {
            showToast('⚠️ Izin mic ditolak. Izinkan mikrofon di browser Anda.');
          } else if (err.error === 'no-speech') {
            showToast('Tidak ada suara terdeteksi. Silakan coba lagi.');
          } else {
            showToast('Gagal memproses suara. Coba lagi beberapa saat lagi.');
          }
        };

        recognition.onend = () => {
          stopActiveMic();
        };

        recognition.start();
      } catch (err) {
        stopActiveMic();
        showToast('Tidak dapat memulai mic. Pastikan perangkat memiliki mic aktif.');
      }
    }

    // ========================================================
    // PHRASE QUIZ LOGIC (KUIS TEBAK ARTI FRASA SEHARI-HARI)
    // ========================================================
    const phraseQuizModal = document.getElementById('phrase-quiz-modal') as HTMLDialogElement | null;
    const phraseQuizLangTitle = document.getElementById('phrase-quiz-lang-title');
    const phraseQuizCounter = document.getElementById('phrase-quiz-counter');
    const phraseQuizScoreBadge = document.getElementById('phrase-quiz-score-badge');
    const phraseQuizNativePrompt = document.getElementById('phrase-quiz-native-prompt');
    const phraseQuizTranslitPrompt = document.getElementById('phrase-quiz-translit-prompt');
    const phraseQuizOptionsGrid = document.getElementById('phrase-quiz-options-grid');
    const phraseQuizFeedback = document.getElementById('phrase-quiz-feedback');
    const phraseQuizBtnNext = document.getElementById('phrase-quiz-btn-next');
    const phraseQuizBtnClose = document.getElementById('phrase-quiz-btn-close');
    const btnPhraseQuizReplayAudio = document.getElementById('btn-phrase-quiz-replay-audio');

    let phraseQuizQuestions: { native: string; transliteration: string; meaning: string; voiceLang: string }[] = [];
    let phraseQuizIndex = 0;
    let phraseQuizCorrectCount = 0;
    let phraseQuizWrongCount = 0;
    let phraseQuizAnswered = false;
    let phraseQuizCurrentItem: any = null;

    function openPhraseQuiz() {
      const data = getActivePhrasesData(currentTableId);
      const allTables = getAllTables();
      const currentTable = allTables.find(t => t.id === currentTableId);

      if (!data || !data.categories || data.categories.length === 0) {
        showToast('Bahasa ini belum memiliki frasa untuk dimainkan kuis.');
        return;
      }

      const allItems: any[] = [];
      data.categories.forEach((c: any) => {
        c.items.forEach((it: any) => {
          if (it.native && it.meaning) {
            allItems.push({
              native: it.native,
              transliteration: it.transliteration || '',
              meaning: it.meaning,
              voiceLang: data.voiceLang || currentTable?.voiceLang || 'en-US'
            });
          }
        });
      });

      if (allItems.length < 2) {
        showToast('Minimal butuh 2 frasa untuk memulai kuis. Tambah frasa terlebih dahulu!');
        return;
      }

      phraseQuizQuestions = [...allItems].sort(() => Math.random() - 0.5).slice(0, 10);
      phraseQuizIndex = 0;
      phraseQuizCorrectCount = 0;
      phraseQuizWrongCount = 0;

      if (phraseQuizLangTitle) {
        phraseQuizLangTitle.textContent = `KUIS FRASA: ${currentTable?.name || 'BAHASA'}`;
      }

      phraseQuizModal?.showModal();
      renderPhraseQuizQuestion();
    }

    function renderPhraseQuizQuestion() {
      if (!phraseQuizQuestions.length || phraseQuizIndex >= phraseQuizQuestions.length) {
        renderPhraseQuizSummary();
        return;
      }

      phraseQuizAnswered = false;
      phraseQuizCurrentItem = phraseQuizQuestions[phraseQuizIndex];

      if (phraseQuizCounter) {
        phraseQuizCounter.textContent = `Soal ${phraseQuizIndex + 1} dari ${phraseQuizQuestions.length}`;
      }
      if (phraseQuizScoreBadge) {
        phraseQuizScoreBadge.textContent = `Skor: ${phraseQuizCorrectCount} Benar • ${phraseQuizWrongCount} Salah`;
      }
      if (phraseQuizNativePrompt) {
        phraseQuizNativePrompt.textContent = phraseQuizCurrentItem.native;
      }
      if (phraseQuizTranslitPrompt) {
        phraseQuizTranslitPrompt.textContent = phraseQuizCurrentItem.transliteration || '';
      }
      if (phraseQuizFeedback) {
        phraseQuizFeedback.textContent = 'Pilih arti yang tepat:';
        phraseQuizFeedback.className = 'font-bold text-[12px] text-smoke';
      }
      if (phraseQuizBtnNext) {
        phraseQuizBtnNext.textContent = 'Lewati Soal →';
      }

      speakText(phraseQuizCurrentItem.native, phraseQuizCurrentItem.voiceLang);

      const data = getActivePhrasesData(currentTableId);
      const allMeanings: string[] = [];
      data.categories.forEach((c: any) => {
        c.items.forEach((it: any) => {
          if (it.meaning && it.meaning !== phraseQuizCurrentItem.meaning && !allMeanings.includes(it.meaning)) {
            allMeanings.push(it.meaning);
          }
        });
      });

      const distractors = allMeanings.sort(() => Math.random() - 0.5).slice(0, 3);
      const options = [phraseQuizCurrentItem.meaning, ...distractors].sort(() => Math.random() - 0.5);

      if (phraseQuizOptionsGrid) {
        phraseQuizOptionsGrid.innerHTML = '';
        options.forEach(opt => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'p-3 text-left font-mono text-[13px] border border-rule bg-canvas text-ink hover:border-ink hover:bg-tint/40 transition-all cursor-pointer flex items-center justify-between gap-2 shadow-xs';
          btn.innerHTML = `<span class="truncate flex-1">${opt}</span><span class="text-smoke text-[11px] shrink-0">[Pilih]</span>`;

          btn.addEventListener('click', () => handlePhraseQuizAnswer(opt, btn));
          phraseQuizOptionsGrid.appendChild(btn);
        });
      }
    }

    function handlePhraseQuizAnswer(selectedMeaning: string, selectedBtn: HTMLElement) {
      if (phraseQuizAnswered) return;
      phraseQuizAnswered = true;

      const isCorrect = selectedMeaning === phraseQuizCurrentItem.meaning;
      const allBtns = phraseQuizOptionsGrid ? phraseQuizOptionsGrid.querySelectorAll('button') : [];

      allBtns.forEach((b: HTMLButtonElement) => {
        b.disabled = true;
        b.classList.remove('hover:border-ink', 'hover:bg-tint/40', 'cursor-pointer');
        if (b.textContent?.includes(phraseQuizCurrentItem.meaning)) {
          b.className = 'p-3 text-left font-mono text-[13px] border-2 border-ok bg-ok/15 text-ok font-bold flex items-center justify-between gap-2 shadow-xs';
          b.innerHTML = `<span class="truncate flex-1">${phraseQuizCurrentItem.meaning}</span><span class="text-ok font-bold shrink-0">✓ Benar</span>`;
        }
      });

      if (isCorrect) {
        phraseQuizCorrectCount++;
        if (phraseQuizFeedback) {
          phraseQuizFeedback.textContent = '🎉 Tepat sekali! Jawaban Anda benar!';
          phraseQuizFeedback.className = 'font-bold text-[12px] text-ok';
        }
      } else {
        phraseQuizWrongCount++;
        selectedBtn.className = 'p-3 text-left font-mono text-[13px] border-2 border-red-500 bg-red-500/15 text-red-500 font-bold flex items-center justify-between gap-2 shadow-xs';
        selectedBtn.innerHTML = `<span class="truncate flex-1">${selectedMeaning}</span><span class="text-red-500 font-bold shrink-0">✕ Salah</span>`;
        if (phraseQuizFeedback) {
          phraseQuizFeedback.textContent = `Jawaban benar: "${phraseQuizCurrentItem.meaning}"`;
          phraseQuizFeedback.className = 'font-bold text-[12px] text-red-500';
        }
      }

      if (phraseQuizScoreBadge) {
        phraseQuizScoreBadge.textContent = `Skor: ${phraseQuizCorrectCount} Benar • ${phraseQuizWrongCount} Salah`;
      }
      if (phraseQuizBtnNext) {
        phraseQuizBtnNext.textContent = 'Soal Selanjutnya →';
      }

      setTimeout(() => {
        if (phraseQuizAnswered && phraseQuizModal?.open) {
          phraseQuizIndex++;
          renderPhraseQuizQuestion();
        }
      }, 1400);
    }

    function renderPhraseQuizSummary() {
      const total = phraseQuizQuestions.length;
      const percent = total > 0 ? Math.round((phraseQuizCorrectCount / total) * 100) : 0;

      if (phraseQuizCounter) phraseQuizCounter.textContent = 'Kuis Selesai!';
      if (phraseQuizNativePrompt) phraseQuizNativePrompt.textContent = `${percent}%`;
      if (phraseQuizTranslitPrompt) phraseQuizTranslitPrompt.textContent = `${phraseQuizCorrectCount} dari ${total} soal terjawab benar`;
      if (phraseQuizFeedback) {
        phraseQuizFeedback.textContent = percent >= 80 ? '🏆 Hebat sekali! Anda sudah menguasai frasa-frasa ini!' : 'Terus berlatih untuk meningkatkan hafalan Anda!';
        phraseQuizFeedback.className = 'font-bold text-[12px] text-ink';
      }

      if (phraseQuizOptionsGrid) {
        phraseQuizOptionsGrid.innerHTML = `
          <div class="col-span-full py-4 text-center">
            <button type="button" id="btn-replay-phrase-quiz" class="btn btn-primary btn-s font-mono text-xs cursor-pointer inline-flex items-center gap-1.5 mx-auto">
              <svg class="size-3.5 inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg> Main Lagi
            </button>
          </div>
        `;
        document.getElementById('btn-replay-phrase-quiz')?.addEventListener('click', openPhraseQuiz);
      }

      if (phraseQuizBtnNext) {
        phraseQuizBtnNext.textContent = 'Tutup Kuis';
      }
    }

    phraseQuizBtnNext?.addEventListener('click', () => {
      if (phraseQuizIndex >= phraseQuizQuestions.length) {
        phraseQuizModal?.close();
      } else {
        phraseQuizIndex++;
        renderPhraseQuizQuestion();
      }
    });

    phraseQuizBtnClose?.addEventListener('click', () => phraseQuizModal?.close());
    btnPhraseQuizReplayAudio?.addEventListener('click', () => {
      if (phraseQuizCurrentItem) {
        speakText(phraseQuizCurrentItem.native, phraseQuizCurrentItem.voiceLang);
      }
    });
    document.getElementById('btn-open-phrase-quiz')?.addEventListener('click', openPhraseQuiz);

    function parseTextToGrid(text: string) {
      const lines = text.split('\n').map(l => l.trim()).filter(Boolean);
      const grid: any[] = [];
      for (const line of lines) {
        let parts: string[] = [];
        if (line.includes('|')) {
          parts = line.split('|').map(p => p.trim());
        } else if (line.includes('\t')) {
          parts = line.split('\t').map(p => p.trim());
        } else if (line.includes(',')) {
          parts = line.split(',').map(p => p.trim());
        } else {
          parts = [line];
        }

        const row: any[] = [];
        for (const part of parts) {
          if (!part || part === '-' || part === 'null') {
            row.push(null);
          } else if (part.includes('=')) {
            const [romaji, char] = part.split('=').map(s => s.trim());
            row.push({ romaji: romaji || '', char: char || '' });
          } else {
            row.push({ romaji: '', char: part });
          }
        }
        if (row.length > 0) grid.push(row);
      }
      return grid;
    }

    // Excel upload handler
    if (formExcelInput) {
      formExcelInput.addEventListener('change', (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;

        const fileName = file.name.toLowerCase();
        const isExcel = fileName.endsWith('.xlsx') || fileName.endsWith('.xls');

        if (isExcel) {
          showToast(`Membaca file Excel "${file.name}"...`);
          const reader = new FileReader();
          reader.onload = (evt) => {
            try {
              const data = new Uint8Array(evt.target?.result as ArrayBuffer);
              const workbook = (window as any).XLSX.read(data, { type: 'array' });
              const sheetName = workbook.SheetNames[0];
              const worksheet = workbook.Sheets[sheetName];
              const jsonRows: any[][] = (window as any).XLSX.utils.sheet_to_json(worksheet, { header: 1 });

              const formattedLines: string[] = [];
              for (const row of jsonRows) {
                if (!row || row.length === 0) continue;
                if (row.length === 2) {
                  formattedLines.push(`${row[0]} = ${row[1]}`);
                } else {
                  const rowItems: string[] = [];
                  for (let i = 0; i < row.length; i += 2) {
                    if (row[i] !== undefined && row[i+1] !== undefined) {
                      rowItems.push(`${row[i]} = ${row[i+1]}`);
                    }
                  }
                  if (rowItems.length > 0) formattedLines.push(rowItems.join(' | '));
                }
              }

              if (formText) {
                formText.value = formattedLines.join('\n');
                renderCreatorPreview();
                showToast(`✓ Berhasil memuat ${formattedLines.length} baris dari Excel!`);
              }
            } catch {
              showToast('Gagal memproses file Excel.');
            }
          };
          reader.readAsArrayBuffer(file);
        } else {
          const reader = new FileReader();
          reader.onload = (evt) => {
            if (formText) {
              formText.value = evt.target?.result as string;
              renderCreatorPreview();
              showToast('✓ File teks/CSV dimuat!');
            }
          };
          reader.readAsText(file);
        }
      });
    }

    function renderCreatorPreview() {
      if (!creatorPreview || !formText) return;
      const grid = parseTextToGrid(formText.value);
      if (grid.length === 0) {
        creatorPreview.innerHTML = '<span class="text-smoke italic font-mono text-[12px]">Ketik atau paste dari Excel di kotak atas untuk melihat pratinjau tabel...</span>';
        return;
      }

      let html = '<table class="w-full border-collapse border border-rule text-center text-[13px] bg-canvas font-mono"><tbody>';
      grid.slice(0, 5).forEach((row) => {
        html += '<tr>';
        row.forEach((cell: any) => {
          if (!cell) {
            html += '<td class="border border-rule p-2 bg-tint/20 text-smoke">-</td>';
          } else {
            html += `<td class="border border-rule p-2 font-bold text-ink">${cell.romaji ? cell.romaji + ' = ' : ''}${cell.char}</td>`;
          }
        });
        html += '</tr>';
      });
      html += '</tbody></table>';
      if (grid.length > 5) {
        html += `<div class="text-[11px] text-smoke mt-2 font-mono">+ ${grid.length - 5} baris lainnya akan dirender</div>`;
      }
      creatorPreview.innerHTML = html;
    }

    formText?.addEventListener('input', renderCreatorPreview);

