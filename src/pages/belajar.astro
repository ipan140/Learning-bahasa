    function getActivePhrasesData(langId: string) {
      if (userPhrasesMap[langId]) {
        return userPhrasesMap[langId];
      }
      return phrasesData[langId] || { categories: [] };
    }

    function ensureCustomPhrases(langId: string) {
      if (!userPhrasesMap[langId]) {
        const base = phrasesData[langId] || { categories: [] };
        const allTables = getAllTables();
        const curr = allTables.find(t => t.id === langId);
        userPhrasesMap[langId] = {
          voiceLang: base.voiceLang || curr?.voiceLang || 'en-US',
          categories: JSON.parse(JSON.stringify(base.categories || []))
        };
      }
      return userPhrasesMap[langId];
    }

    async function saveUserPhrases(langId: string) {
      localStorage.setItem('user_custom_phrases_map', JSON.stringify(userPhrasesMap));
      if (!currentUser) {
        try { currentUser = await getCurrentUser(); } catch {}
      }
      if (currentUser) {
        const cats = userPhrasesMap[langId]?.categories || [];
        try {
          await saveUserPhrasesToCloud(currentUser.id, langId, cats);
        } catch (err) {
          console.warn('Gagal sinkronisasi frasa ke Supabase:', err);
        }
      }
      window.dispatchEvent(new CustomEvent('user-phrases-saved', { detail: { langId } }));
    }

