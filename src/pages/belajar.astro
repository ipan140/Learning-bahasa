    // Ensure the active table is cloned to custom so edits/deletions persist
    function ensureCustomTableForEditing(): any {
      const existingCustom = customTables.find(c => c.id === currentTableId);
      if (existingCustom) return existingCustom;

      const allTables = getAllTables();
      const curr = allTables.find(t => t.id === currentTableId) || defaultTables[0];
      const newId = 'custom-' + Date.now();
      const cloned = {
        id: newId,
        name: `${curr.name} (Kustom)`,
        flag: curr.flag || '✨',
        category: 'custom',
        badge: 'Tabel Kustom',
        title: `${curr.title} (Kustom)`,
        description: curr.description || 'Tabel kustom hasil suntingan Anda.',
        voiceLang: curr.voiceLang || 'en-US',
        grid: JSON.parse(JSON.stringify(curr.grid))
      };
      customTables.push(cloned);
      saveCustomTablesToStorage();
      if (currentUser) {
        saveCustomTableToCloud(currentUser.id, cloned).catch(() => {});
      }
      currentTableId = newId;
      renderTabs();
      showToast('Tabel disalin ke Tabel Kustom agar perubahan & penghapusan tersimpan!');
      return cloned;
    }

    function updateEditModeUI() {
      if (toggleEditModeBtn) {
        if (isEditModeActive) {
