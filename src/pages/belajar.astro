    // Retro-Tech Confirm Dialog (SweetAlert replacement)
    interface RetroConfirmOptions {
      title?: string;
      message: string;
      confirmText?: string;
      cancelText?: string;
      danger?: boolean;
    }

    function showRetroConfirm(options: RetroConfirmOptions): Promise<boolean> {
      return new Promise((resolve) => {
        const dialog = document.getElementById('retro-confirm-dialog') as HTMLDialogElement | null;
        const titleEl = document.getElementById('retro-confirm-title');
        const msgEl = document.getElementById('retro-confirm-message');
        const btnOk = document.getElementById('retro-confirm-btn-ok') as HTMLButtonElement | null;
        const btnCancel = document.getElementById('retro-confirm-btn-cancel') as HTMLButtonElement | null;
        const btnClose = document.getElementById('retro-confirm-btn-close') as HTMLButtonElement | null;
        const iconBox = document.getElementById('retro-confirm-icon-box');

        if (!dialog || !btnOk || !btnCancel) {
          resolve(window.confirm(options.message));
          return;
        }

        if (titleEl) titleEl.textContent = options.title || 'Konfirmasi Tindakan';
        if (msgEl) msgEl.textContent = options.message;

        if (btnOk) {
          btnOk.textContent = options.confirmText || 'Ya, Lanjutkan';
          if (options.danger) {
            btnOk.className = 'px-5 py-2 border border-red-500 bg-red-600 text-white font-bold cursor-pointer hover:bg-red-700 font-mono text-xs shadow-xs';
          } else {
            btnOk.className = 'px-5 py-2 border border-ink bg-ink text-canvas font-bold cursor-pointer hover:opacity-90 font-mono text-xs';
          }
        }

        if (btnCancel) {
          btnCancel.textContent = options.cancelText || 'Batal';
        }

        if (iconBox) {
          if (options.danger) {
            iconBox.className = 'p-3 border border-red-500/40 bg-red-500/10 shrink-0 text-red-500';
            iconBox.innerHTML = `<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>`;
          } else {
            iconBox.className = 'p-3 border border-rule bg-tint shrink-0 text-ink';
            iconBox.innerHTML = `<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg>`;
          }
        }

        let handled = false;
        const cleanup = () => {
          if (handled) return;
          handled = true;
          btnOk.removeEventListener('click', onOk);
          btnCancel.removeEventListener('click', onCancel);
          btnClose?.removeEventListener('click', onCancel);
          dialog.removeEventListener('close', onClose);
        };

        const onOk = () => {
          cleanup();
          dialog.close();
          resolve(true);
        };

        const onCancel = () => {
          cleanup();
          dialog.close();
          resolve(false);
        };

        const onClose = () => {
          cleanup();
          resolve(false);
        };

        btnOk.addEventListener('click', onOk);
        btnCancel.addEventListener('click', onCancel);
        btnClose?.addEventListener('click', onCancel);
        dialog.addEventListener('close', onClose);

        dialog.showModal();
      });
    }

    // Phrases state: user custom phrases map
    let userPhrasesMap: Record<string, any> = JSON.parse(localStorage.getItem('user_custom_phrases_map') || '{}');
    let isPhraseEditModeActive = false;

    function showToast(msg: string) {
      if (!toast || !toastMessage) return;
      toastMessage.textContent = msg;
      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 4000);
    }
    toastClose?.addEventListener('click', () => toast?.classList.add('hidden'));

    function saveCustomTablesToStorage() {
      localStorage.setItem('custom_character_tables', JSON.stringify(customTables));
    }

    function saveProgressMap() {
      localStorage.setItem('user_study_progress_map', JSON.stringify(userProgressMap));
      if (currentUser && currentTableId) {
        const chars = userProgressMap[currentTableId] || [];
        saveUserProgressToCloud(currentUser.id, currentTableId, chars).catch(() => {});
      }
    }

    // Web Speech Synthesis
    let cachedVoices: SpeechSynthesisVoice[] = [];
    function loadVoices() {
      if ('speechSynthesis' in window) {
        cachedVoices = window.speechSynthesis.getVoices();
      }
    }
    if ('speechSynthesis' in window) {
      loadVoices();
      window.speechSynthesis.onvoiceschanged = loadVoices;
    }

    function speakText(text: string, lang?: string) {
      if (!isAudioEnabled || !text) return;
      const langCode = lang ? lang.split('-')[0].toLowerCase() : 'ja';

      if ('speechSynthesis' in window) {
        try {
          window.speechSynthesis.cancel();
          const utter = new SpeechSynthesisUtterance(text);
          if (lang) utter.lang = lang;
          utter.rate = currentAudioRate;

          const voices = cachedVoices.length ? cachedVoices : window.speechSynthesis.getVoices();
          const googleVoice = voices.find(v => 
            (v.lang.toLowerCase().startsWith(langCode) || v.lang.toLowerCase() === (lang || '').toLowerCase()) && 
            v.name.toLowerCase().includes('google')
          );
          const naturalVoice = voices.find(v => 
            (v.lang.toLowerCase().startsWith(langCode) || v.lang.toLowerCase() === (lang || '').toLowerCase()) && 
            (v.name.toLowerCase().includes('natural') || v.name.toLowerCase().includes('online'))
          );
          const matchedVoice = voices.find(v => 
            v.lang.toLowerCase().startsWith(langCode) || v.lang.toLowerCase() === (lang || '').toLowerCase()
          );

          if (googleVoice) utter.voice = googleVoice;
          else if (naturalVoice) utter.voice = naturalVoice;
          else if (matchedVoice) utter.voice = matchedVoice;

          utter.onerror = () => {
            try {
              const audioUrl = `https://translate.google.com/translate_tts?ie=UTF-8&client=tw-ob&tl=${langCode}&q=${encodeURIComponent(text)}`;
              const audio = new Audio(audioUrl);
              audio.playbackRate = currentAudioRate;
              audio.play().catch(() => {});
            } catch {}
          };

          window.speechSynthesis.speak(utter);
          return;
        } catch {}
      }

      // Fallback
      try {
        const audioUrl = `https://translate.google.com/translate_tts?ie=UTF-8&client=tw-ob&tl=${langCode}&q=${encodeURIComponent(text)}`;
        const audio = new Audio(audioUrl);
        audio.playbackRate = currentAudioRate;
        audio.play().catch(() => {});
      } catch {}
    }

    // Toggle Audio Speed: 0.5x, 0.75x, 1.0x (default), 1.25x, 1.5x, 2.0x
    const SPEED_LEVELS = [0.5, 0.75, 1.0, 1.25, 1.5, 2.0];
    toggleSpeedBtn?.addEventListener('click', () => {
      const currIdx = SPEED_LEVELS.indexOf(currentAudioRate);
      const nextIdx = (currIdx + 1) % SPEED_LEVELS.length;
      currentAudioRate = SPEED_LEVELS[nextIdx];
      if (speedStatusLabel) {
        speedStatusLabel.textContent = `${currentAudioRate}x`;
      }
      const label = currentAudioRate === 1.0 
        ? '(Normal / Default)' 
        : currentAudioRate < 1.0 
          ? '(Lambat)' 
          : '(Cepat)';
      showToast(`Kecepatan audio: ${currentAudioRate}x ${label}`);
      if (currentUser) {
        saveUserPreferencesToCloud(currentUser.id, { audioSpeed: currentAudioRate, isAudioEnabled: isAudioEnabled }).catch(() => {});
      }
    });

    // ========================================================
    // SEQUENTIAL AUDIO WALKTHROUGH (PUTAR URUT OTOMATIS)
    // ========================================================
    let isPlayingAll = false;
    let playAllTimeout: any = null;
    let currentPlayCellEl: HTMLElement | null = null;

    function stopPlayAll() {
      if (!isPlayingAll && !currentPlayCellEl) return;
      isPlayingAll = false;
      if (playAllTimeout) {
        clearTimeout(playAllTimeout);
        playAllTimeout = null;
      }
      if (currentPlayCellEl) {
        currentPlayCellEl.classList.remove('ring-4', 'ring-cta', 'bg-cta/25', 'scale-105', 'z-20');
        currentPlayCellEl = null;
      }
      if (btnPlayAll) {
        btnPlayAll.innerHTML = `<svg class="size-3.5 inline text-steel" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="6 3 20 12 6 21 6 3"/></svg> <span>Putar Urut</span>`;
        btnPlayAll.className = 'btn btn-secondary btn-s font-mono cursor-pointer inline-flex items-center gap-1.5';
      }
    }

    function startPlayAll() {
      const allCells = gridWrapper ? gridWrapper.querySelectorAll<HTMLElement>('td[data-char]') : [];
      if (!allCells.length) {
        showToast('Tabel ini tidak memiliki karakter untuk diputar.');
        return;
      }

      isPlayingAll = true;
      if (btnPlayAll) {
        btnPlayAll.innerHTML = `<svg class="size-3.5 inline text-canvas" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/></svg> <span>Hentikan</span>`;
        btnPlayAll.className = 'btn btn-primary btn-s font-mono cursor-pointer shadow-md inline-flex items-center gap-1.5';
      }

      let idx = 0;
      function playStep() {
        if (!isPlayingAll) return;
        if (idx >= allCells.length) {
          stopPlayAll();
          showToast('✓ Selesai memutar seluruh aksara.');
          return;
        }

        if (currentPlayCellEl) {
          currentPlayCellEl.classList.remove('ring-4', 'ring-cta', 'bg-cta/25', 'scale-105', 'z-20');
        }

        const cellEl = allCells[idx] as HTMLElement;
        currentPlayCellEl = cellEl;
        cellEl.classList.add('ring-4', 'ring-cta', 'bg-cta/25', 'scale-105', 'z-20');
        cellEl.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });

        const ch = cellEl.getAttribute('data-char') || '';
        const lang = cellEl.getAttribute('data-lang') || '';
        speakText(ch, lang);

        if (btnPlayAll) {
          btnPlayAll.textContent = `⏹ Stop (${idx + 1}/${allCells.length})`;
        }

        idx++;
        const interval = Math.max(900, Math.round(1500 / currentAudioRate));
        playAllTimeout = setTimeout(playStep, interval);
      }

      playStep();
    }

    btnPlayAll?.addEventListener('click', () => {
      if (isPlayingAll) stopPlayAll();
      else startPlayAll();
    });

    // Helper: get flat list of valid characters for current table
    function getCurrentTableCells(): { char: string; romaji: string }[] {
      const allTables = getAllTables();
      const currentTable = allTables.find(t => t.id === currentTableId);
      if (!currentTable) return [];
      const cells: { char: string; romaji: string }[] = [];
      currentTable.grid.forEach((row: any[]) => {
        row.forEach((cell: any) => {
          if (cell && cell.char) {
            cells.push({ char: cell.char, romaji: cell.romaji || '' });
          }
        });
      });
      return cells;
    }

    // Update Progress UI
    function updateProgressUI() {
      const cells = getCurrentTableCells();
      const total = cells.length;
      const memorized = (userProgressMap[currentTableId] || []).filter(ch => cells.some(c => c.char === ch));
      const count = memorized.length;
      const pct = total > 0 ? Math.round((count / total) * 100) : 0;

      if (progressCountLabel) progressCountLabel.textContent = `${count} / ${total} Huruf`;
      if (progressPercentLabel) progressPercentLabel.textContent = `(${pct}%)`;
      if (progressFillBar) progressFillBar.style.width = `${pct}%`;
    }

    // Reset Progress for current table
    btnResetProgress?.addEventListener('click', async () => {
      const ok = await showRetroConfirm({
        title: 'Reset Hafalan Aksara',
        message: 'Reset seluruh tanda hafalan untuk aksara bahasa ini? Seluruh progres hafalan Anda pada tabel ini akan kembali ke nol.',
        danger: true,
        confirmText: 'Reset Hafalan'
      });
      if (ok) {
        userProgressMap[currentTableId] = [];
        saveProgressMap();
        updateProgressUI();
        renderCurrentTable();
        if (currentViewMode === 'flashcard') updateFlashcardCard();
        showToast('Progres hafalan berhasil di-reset.');
      }
    });

    // Mode Switchers
    function switchViewMode(mode: 'table' | 'flashcard' | 'phrases') {
      stopPlayAll();
      if (typeof stopPlayAllPhrases === 'function') stopPlayAllPhrases();
      currentViewMode = mode;
      
      const setBtnState = (btn: HTMLElement | null, isActive: boolean) => {
        if (!btn) return;
        if (isActive) {
          btn.className = 'px-4 py-2 font-mono text-[13px] border-2 border-cta bg-cta/10 text-ink font-bold whitespace-nowrap transition-colors cursor-pointer shadow-xs';
        } else {
          btn.className = 'px-4 py-2 font-mono text-[13px] border border-rule bg-canvas text-steel hover:text-ink hover:border-ink hover:bg-tint/40 whitespace-nowrap transition-colors cursor-pointer';
        }
      };

      setBtnState(btnModeTable, mode === 'table');
      setBtnState(btnModeFlashcard, mode === 'flashcard');
      setBtnState(btnModePhrases, mode === 'phrases');

      viewerContainer?.classList.toggle('hidden', mode !== 'table');
      flashcardContainer?.classList.toggle('hidden', mode !== 'flashcard');
      phrasesContainer?.classList.toggle('hidden', mode !== 'phrases');

      if (mode === 'flashcard') {
        initFlashcard();
      } else if (mode === 'phrases') {
        renderPhrases();
      }
    }

    btnModeTable?.addEventListener('click', () => switchViewMode('table'));
    btnModeFlashcard?.addEventListener('click', () => switchViewMode('flashcard'));
    btnModePhrases?.addEventListener('click', () => switchViewMode('phrases'));

    // ========================================================
    // FLASHCARD LOGIC
    // ========================================================
    function initFlashcard() {
      const cells = getCurrentTableCells();
      if (cells.length === 0) {
        showToast('Tabel ini belum memiliki huruf untuk flashcard.');
        return;
      }
      fcIndex = 0;
      fcIsFlipped = false;
      updateFlashcardCard();
      if (fcMode === 'quiz') {
        initQuizQuestion();
      }
    }

    btnFcTypeCard?.addEventListener('click', () => {
      fcMode = 'card';
      if (btnFcTypeCard) btnFcTypeCard.className = 'px-3 py-1.5 border-2 border-cta bg-cta/10 text-ink font-bold shadow-xs cursor-pointer';
      if (btnFcTypeQuiz) btnFcTypeQuiz.className = 'px-3 py-1.5 border border-rule bg-canvas text-steel hover:text-ink hover:border-ink hover:bg-tint/40 cursor-pointer';

      fcCardSubview?.classList.remove('hidden');
      fcQuizSubview?.classList.add('hidden');
      updateFlashcardCard();
    });

    btnFcTypeQuiz?.addEventListener('click', () => {
      fcMode = 'quiz';
      if (btnFcTypeQuiz) btnFcTypeQuiz.className = 'px-3 py-1.5 border-2 border-cta bg-cta/10 text-ink font-bold shadow-xs cursor-pointer';
      if (btnFcTypeCard) btnFcTypeCard.className = 'px-3 py-1.5 border border-rule bg-canvas text-steel hover:text-ink hover:border-ink hover:bg-tint/40 cursor-pointer';

      fcQuizSubview?.classList.remove('hidden');
      fcCardSubview?.classList.add('hidden');
      quizScore = 0;
      if (quizScoreBadge) quizScoreBadge.textContent = 'Skor: 0';
      initQuizQuestion();
    });

    function updateFlashcardCard() {
      const cells = getCurrentTableCells();
      if (cells.length === 0) return;
      if (fcIndex >= cells.length) fcIndex = 0;
      const cell = cells[fcIndex];

      fcIsFlipped = false;
      fcCardFront?.classList.remove('hidden');
      fcCardBack?.classList.add('hidden');

      if (fcCharDisplay) fcCharDisplay.textContent = cell.char;
      if (fcRomajiDisplay) fcRomajiDisplay.textContent = cell.romaji || '(Tanpa Romaji)';
      if (fcCharSubdisplay) fcCharSubdisplay.textContent = cell.char;
      if (fcCardCounter) fcCardCounter.textContent = `Kartu ${fcIndex + 1} dari ${cells.length}`;

      const memorized = userProgressMap[currentTableId] || [];
      const isMem = memorized.includes(cell.char);
      if (fcCardStatus) {
        fcCardStatus.textContent = isMem ? '✓ SUDAH HAFAL' : '';
      }
    }

    fcFlashcard?.addEventListener('click', () => {
      fcIsFlipped = !fcIsFlipped;
      if (fcIsFlipped) {
        fcCardFront?.classList.add('hidden');
        fcCardBack?.classList.remove('hidden');
        const cells = getCurrentTableCells();
        const cell = cells[fcIndex];
        const allTables = getAllTables();
        const currentTable = allTables.find(t => t.id === currentTableId);
        if (cell) speakText(cell.char, currentTable?.voiceLang);
      } else {
        fcCardFront?.classList.remove('hidden');
        fcCardBack?.classList.add('hidden');
      }
    });

    btnFcSpeak?.addEventListener('click', (e) => {
      e.stopPropagation();
      const cells = getCurrentTableCells();
      const cell = cells[fcIndex];
      const allTables = getAllTables();
      const currentTable = allTables.find(t => t.id === currentTableId);
      if (cell) speakText(cell.char, currentTable?.voiceLang);
    });

    btnFcMemorized?.addEventListener('click', () => {
      const cells = getCurrentTableCells();
      const cell = cells[fcIndex];
      if (!cell) return;
      if (!userProgressMap[currentTableId]) userProgressMap[currentTableId] = [];
      if (!userProgressMap[currentTableId].includes(cell.char)) {
        userProgressMap[currentTableId].push(cell.char);
        saveProgressMap();
        updateProgressUI();
        renderCurrentTable();
        showToast(`✓ Huruf "${cell.char}" ditandai sudah hafal!`);
      }
      btnFcNext?.click();
    });

    btnFcUnmemorized?.addEventListener('click', () => {
      const cells = getCurrentTableCells();
      const cell = cells[fcIndex];
      if (!cell) return;
      if (userProgressMap[currentTableId]) {
        userProgressMap[currentTableId] = userProgressMap[currentTableId].filter(ch => ch !== cell.char);
        saveProgressMap();
        updateProgressUI();
        renderCurrentTable();
      }
      btnFcNext?.click();
    });

    btnFcNext?.addEventListener('click', () => {
      const cells = getCurrentTableCells();
      if (cells.length === 0) return;
      fcIndex = (fcIndex + 1) % cells.length;
      updateFlashcardCard();
    });

    btnFcPrev?.addEventListener('click', () => {
      const cells = getCurrentTableCells();
      if (cells.length === 0) return;
      fcIndex = (fcIndex - 1 + cells.length) % cells.length;
      updateFlashcardCard();
    });

    btnFcRandom?.addEventListener('click', () => {
      const cells = getCurrentTableCells();
      if (cells.length === 0) return;
      fcIndex = Math.floor(Math.random() * cells.length);
      updateFlashcardCard();
    });

    // Keyboard shortcuts untuk Mode Flashcard (Spasi, Panah, A, M, R)
    window.addEventListener('keydown', (e) => {
      if (currentViewMode !== 'flashcard') return;
      if (fcCardSubview?.classList.contains('hidden')) return;

      const activeTag = document.activeElement?.tagName?.toLowerCase();
      if (activeTag === 'input' || activeTag === 'textarea' || activeTag === 'select') return;
      const openDialog = document.querySelector('dialog[open]');
      if (openDialog) return;

      if (e.code === 'Space') {
        e.preventDefault();
        fcFlashcard?.click();
      } else if (e.code === 'ArrowRight') {
        e.preventDefault();
        btnFcNext?.click();
      } else if (e.code === 'ArrowLeft') {
        e.preventDefault();
        btnFcPrev?.click();
      } else if (e.code === 'KeyA') {
        e.preventDefault();
        btnFcSpeak?.click();
      } else if (e.code === 'KeyM') {
        e.preventDefault();
        btnFcMemorized?.click();
      } else if (e.code === 'KeyR') {
        e.preventDefault();
        btnFcRandom?.click();
      }
    });

    // ========================================================
    // QUIZ MODE LOGIC (AKSARA ↔ BACAAN ↔ LISTENING AUDIO)
    // ========================================================
    let currentQuizAnswer = '';
    let currentQuizTargetChar = '';
    let quizQuestionDirection = 'char-to-romaji';

    function setQuizDirection(dir: string) {
      quizQuestionDirection = dir;
      const allDirBtns = [btnQuizDirChar, btnQuizDirRomaji, btnQuizDirAudio];
      allDirBtns.forEach(b => {
        b?.classList.remove('border-2', 'border-cta', 'bg-cta/10', 'text-ink', 'font-bold', 'shadow-xs');
        b?.classList.add('border', 'border-rule', 'bg-canvas', 'text-steel');
      });

      if (dir === 'char-to-romaji') {
        btnQuizDirChar?.classList.remove('border', 'border-rule', 'bg-canvas', 'text-steel');
        btnQuizDirChar?.classList.add('border-2', 'border-cta', 'bg-cta/10', 'text-ink', 'font-bold', 'shadow-xs');
      } else if (dir === 'romaji-to-char') {
        btnQuizDirRomaji?.classList.remove('border', 'border-rule', 'bg-canvas', 'text-steel');
        btnQuizDirRomaji?.classList.add('border-2', 'border-cta', 'bg-cta/10', 'text-ink', 'font-bold', 'shadow-xs');
      } else if (dir === 'audio-to-char') {
        btnQuizDirAudio?.classList.remove('border', 'border-rule', 'bg-canvas', 'text-steel');
        btnQuizDirAudio?.classList.add('border-2', 'border-cta', 'bg-cta/10', 'text-ink', 'font-bold', 'shadow-xs');
      }

      initQuizQuestion();
    }

    btnQuizDirChar?.addEventListener('click', () => setQuizDirection('char-to-romaji'));
    btnQuizDirRomaji?.addEventListener('click', () => setQuizDirection('romaji-to-char'));
    btnQuizDirAudio?.addEventListener('click', () => setQuizDirection('audio-to-char'));

    btnQuizReplayAudio?.addEventListener('click', () => {
      const allTables = getAllTables();
      const currentTable = allTables.find(t => t.id === currentTableId);
      if (currentQuizTargetChar) {
        speakText(currentQuizTargetChar, currentTable?.voiceLang);
      }
    });

    function initQuizQuestion() {
      const cells = getCurrentTableCells();
      if (cells.length < 4) {
        if (quizQuestionChar) quizQuestionChar.textContent = '-';
        if (quizFeedback) quizFeedback.textContent = 'Minimal 4 huruf diperlukan untuk mode kuis.';
        return;
      }

      if (btnQuizNextQuestion) btnQuizNextQuestion.classList.add('hidden');
      if (quizFeedback) quizFeedback.textContent = '';

      const targetCell = cells[Math.floor(Math.random() * cells.length)];
      currentQuizTargetChar = targetCell.char;

      if (quizQuestionDirection === 'char-to-romaji') {
        btnQuizReplayAudio?.classList.add('hidden');
        btnQuizReplayAudio?.classList.remove('inline-flex');

        currentQuizAnswer = targetCell.romaji || targetCell.char;
        if (quizQuestionPrompt) quizQuestionPrompt.textContent = 'Bagaimana cara membaca aksara ini?';
        if (quizQuestionChar) {
          quizQuestionChar.textContent = targetCell.char;
          quizQuestionChar.className = 'text-[68px] sm:text-[76px] font-bold text-ink leading-none';
        }

        const distractors = cells
          .filter(c => (c.romaji || c.char) !== currentQuizAnswer)
          .map(c => c.romaji || c.char);
        
        const shuffledDistractors = distractors.sort(() => 0.5 - Math.random()).slice(0, 3);
        const options = [currentQuizAnswer, ...shuffledDistractors].sort(() => 0.5 - Math.random());

        if (quizOptionsGrid) {
          quizOptionsGrid.innerHTML = '';
          options.forEach(opt => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'py-3.5 px-4 border-2 border-rule bg-canvas hover:border-ink font-mono font-bold text-[16px] text-ink transition-colors shadow-sm select-none cursor-pointer';
            btn.textContent = opt;
            btn.addEventListener('click', () => handleQuizOptionClick(btn, opt, targetCell.char));
            quizOptionsGrid.appendChild(btn);
          });
        }
      } else if (quizQuestionDirection === 'romaji-to-char') {
        btnQuizReplayAudio?.classList.add('hidden');
        btnQuizReplayAudio?.classList.remove('inline-flex');

        currentQuizAnswer = targetCell.char;
        if (quizQuestionPrompt) quizQuestionPrompt.textContent = 'Manakah aksara yang berbunyi demikian?';
        if (quizQuestionChar) {
          quizQuestionChar.textContent = targetCell.romaji || targetCell.char;
          quizQuestionChar.className = 'text-[44px] sm:text-[52px] font-bold text-ink leading-none font-mono';
        }

        const distractors = cells
          .filter(c => c.char !== currentQuizAnswer)
          .map(c => c.char);
        
        const shuffledDistractors = distractors.sort(() => 0.5 - Math.random()).slice(0, 3);
        const options = [currentQuizAnswer, ...shuffledDistractors].sort(() => 0.5 - Math.random());

        if (quizOptionsGrid) {
          quizOptionsGrid.innerHTML = '';
          options.forEach(opt => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'py-3.5 px-4 border-2 border-rule bg-canvas hover:border-ink font-mono font-bold text-[24px] text-ink transition-colors shadow-sm select-none cursor-pointer';
            btn.textContent = opt;
            btn.addEventListener('click', () => handleQuizOptionClick(btn, opt, targetCell.char));
            quizOptionsGrid.appendChild(btn);
          });
        }
      } else if (quizQuestionDirection === 'audio-to-char') {
        currentQuizAnswer = targetCell.char;
        if (quizQuestionPrompt) quizQuestionPrompt.textContent = '🎧 Dengarkan audio dan tebak aksara yang tepat:';
        if (quizQuestionChar) {
          quizQuestionChar.textContent = '🎧';
          quizQuestionChar.className = 'text-[54px] sm:text-[64px] font-bold text-cta leading-none select-none';
        }
        if (btnQuizReplayAudio) {
          btnQuizReplayAudio.classList.remove('hidden');
          btnQuizReplayAudio.classList.add('inline-flex');
        }

        // Otomatis putar audio pengucapan aksara
        setTimeout(() => {
          const allTables = getAllTables();
          const currentTable = allTables.find(t => t.id === currentTableId);
          speakText(targetCell.char, currentTable?.voiceLang);
        }, 180);

        const distractors = cells
          .filter(c => c.char !== currentQuizAnswer)
          .map(c => c.char);
        
        const shuffledDistractors = distractors.sort(() => 0.5 - Math.random()).slice(0, 3);
        const options = [currentQuizAnswer, ...shuffledDistractors].sort(() => 0.5 - Math.random());

        if (quizOptionsGrid) {
          quizOptionsGrid.innerHTML = '';
          options.forEach(opt => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'py-3.5 px-4 border-2 border-rule bg-canvas hover:border-ink font-mono font-bold text-[24px] text-ink transition-colors shadow-sm select-none cursor-pointer';
            btn.textContent = opt;
            btn.addEventListener('click', () => handleQuizOptionClick(btn, opt, targetCell.char));
            quizOptionsGrid.appendChild(btn);
          });
        }
      }
    }

    function handleQuizOptionClick(clickedBtn: HTMLButtonElement, chosen: string, char: string) {
      const allButtons = quizOptionsGrid?.querySelectorAll('button') || [];
      allButtons.forEach(b => (b.disabled = true));

      const allTables = getAllTables();
      const currentTable = allTables.find(t => t.id === currentTableId);
      speakText(char, currentTable?.voiceLang);

      if (chosen === currentQuizAnswer) {
        clickedBtn.classList.remove('border-rule', 'bg-canvas');
        clickedBtn.classList.add('border-ok', 'bg-ok/20', 'text-ok');
        if (quizFeedback) {
          quizFeedback.textContent = '✓ BENAR SEKALI!';
          quizFeedback.className = 'h-6 mt-3 text-xs font-mono font-bold text-center text-ok';
        }
        quizScore += 10;
        if (quizScoreBadge) quizScoreBadge.textContent = `Skor: ${quizScore}`;
        if (currentUser) {
          saveUserQuizScoreToCloud(currentUser.id, currentTableId, quizScore).catch(() => {});
        }
        
        if (!userProgressMap[currentTableId]) userProgressMap[currentTableId] = [];
        if (!userProgressMap[currentTableId].includes(char)) {
          userProgressMap[currentTableId].push(char);
          saveProgressMap();
          updateProgressUI();
        }
      } else {
        clickedBtn.classList.remove('border-rule', 'bg-canvas');
        clickedBtn.classList.add('border-red-500', 'bg-red-500/10', 'text-red-500');
        allButtons.forEach(b => {
          if (b.textContent === currentQuizAnswer) {
            b.classList.remove('border-rule');
            b.classList.add('border-ok', 'bg-ok/20', 'text-ok');
          }
        });
        if (quizFeedback) {
          quizFeedback.textContent = `SALAH! Jawaban yang benar adalah "${currentQuizAnswer}".`;
          quizFeedback.className = 'h-6 mt-3 text-xs font-mono font-bold text-center text-red-500';
        }
      }

      if (btnQuizNextQuestion) btnQuizNextQuestion.classList.remove('hidden');
    }

