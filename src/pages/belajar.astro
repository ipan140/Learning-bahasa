    const DEFAULT_PHRASE_CATEGORIES = [
      'Salam & Ungkapan Populer',
      'Angka & Berhitung',
      'Restoran & Kuliner',
      'Arah & Transportasi',
      'Belanja & Transaksi',
      'Darurat & Kesehatan',
      'Percakapan Santai',
      'Waktu & Hari'
    ];

    let userCustomCategories: string[] = JSON.parse(localStorage.getItem('user_phrase_categories') || '[]');

    function populateCategorySelect(selectEl: HTMLSelectElement | null, customInputEl: HTMLInputElement | null, selectedCatName: string = '') {
      if (!selectEl) return;
      const data = getActivePhrasesData(currentTableId);
      const currentCats: string[] = (data.categories || []).map((c: any) => c.categoryName);

      // Merge current language categories, default master categories, and user custom categories
      const allCatNames: string[] = [];
      const seen = new Set<string>();

      [...currentCats, ...DEFAULT_PHRASE_CATEGORIES, ...userCustomCategories].forEach(name => {
        const trimmed = (name || '').trim();
        if (trimmed && !seen.has(trimmed.toLowerCase())) {
          seen.add(trimmed.toLowerCase());
          allCatNames.push(trimmed);
        }
      });

      selectEl.innerHTML = '';
      allCatNames.forEach(catName => {
        const opt = document.createElement('option');
        opt.value = catName;
        opt.textContent = catName;
        if (catName.toLowerCase() === (selectedCatName || '').toLowerCase()) {
          opt.selected = true;
        }
        selectEl.appendChild(opt);
      });

      const newOpt = document.createElement('option');
      newOpt.value = '__NEW__';
      newOpt.textContent = '+ Buat Kategori Baru...';
      selectEl.appendChild(newOpt);

      if (customInputEl) {
        customInputEl.classList.toggle('hidden', selectEl.value !== '__NEW__');
        if (selectEl.value === '__NEW__') customInputEl.focus();
        selectEl.onchange = () => {
          customInputEl.classList.toggle('hidden', selectEl.value !== '__NEW__');
          if (selectEl.value === '__NEW__') customInputEl.focus();
        };
      }
    }

    function saveCategoryToGlobalList(catName: string) {
      if (!catName || !catName.trim()) return;
      const trimmed = catName.trim();
      const isDefault = DEFAULT_PHRASE_CATEGORIES.some(c => c.toLowerCase() === trimmed.toLowerCase());
      const isExisting = userCustomCategories.some(c => c.toLowerCase() === trimmed.toLowerCase());
      if (!isDefault && !isExisting) {
        userCustomCategories.push(trimmed);
        localStorage.setItem('user_phrase_categories', JSON.stringify(userCustomCategories));
        if (currentUser) {
          saveUserPhraseCategoryToCloud(currentUser.id, trimmed).catch(() => {});
        }
      }
    }

    function openPhraseModal(catIdx: number = -1, itemIdx: number = -1, defaultCatName: string = '') {
      if (!phraseModal) return;
      if (phraseEditCatIdx) phraseEditCatIdx.value = String(catIdx);
      if (phraseEditItemIdx) phraseEditItemIdx.value = String(itemIdx);

      const isEdit = catIdx >= 0 && itemIdx >= 0;
      if (phraseModalTitle) {
        phraseModalTitle.innerHTML = isEdit 
          ? '<svg class="size-4 inline mr-1.5 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg> Edit Frasa'
          : '<svg class="size-4 inline mr-1.5 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg> Tambah Frasa Baru';
      }
      if (phraseDeleteBtn) {
        phraseDeleteBtn.classList.toggle('hidden', !isEdit);
      }

      const data = getActivePhrasesData(currentTableId);
      let catName = defaultCatName;
      if (isEdit && data.categories[catIdx]) {
        catName = data.categories[catIdx].categoryName;
        const item = data.categories[catIdx].items[itemIdx];
        if (phraseNativeInput) phraseNativeInput.value = item?.native || '';
        if (phraseTranslitInput) phraseTranslitInput.value = item?.transliteration || '';
        if (phraseMeaningInput) phraseMeaningInput.value = item?.meaning || '';
      } else {
        if (phraseNativeInput) phraseNativeInput.value = '';
        if (phraseTranslitInput) phraseTranslitInput.value = '';
        if (phraseMeaningInput) phraseMeaningInput.value = '';
      }

      populateCategorySelect(phraseCatSelect, phraseCatCustomInput, catName);
      if (phraseCatCustomInput) phraseCatCustomInput.value = '';

      phraseModal.showModal();
    }

    function closePhraseModal() {
      phraseModal?.close();
    }

    btnOpenPhraseModal?.addEventListener('click', () => openPhraseModal(-1, -1));
    closePhraseModalBtn?.addEventListener('click', closePhraseModal);
    phraseCancelBtn?.addEventListener('click', closePhraseModal);

    phraseForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const catIdx = parseInt(phraseEditCatIdx?.value || '-1');
      const itemIdx = parseInt(phraseEditItemIdx?.value || '-1');
      
      let targetCatName = phraseCatSelect?.value || 'Umum';
      if (targetCatName === '__NEW__') {
        targetCatName = phraseCatCustomInput?.value.trim() || 'Kategori Baru';
      }
      saveCategoryToGlobalList(targetCatName);

      const native = phraseNativeInput?.value.trim() || '';
      const transliteration = phraseTranslitInput?.value.trim() || '';
      const meaning = phraseMeaningInput?.value.trim() || '';

      if (!native || !meaning) return;

      const phrasesDataObj = ensureCustomPhrases(currentTableId);
      const isEdit = catIdx >= 0 && itemIdx >= 0;

      if (isEdit) {
        const oldCat = phrasesDataObj.categories[catIdx];
        if (oldCat && oldCat.categoryName === targetCatName) {
          oldCat.items[itemIdx] = { native, transliteration, meaning };
        } else {
          // Moved category or changed category
          if (oldCat) {
            oldCat.items.splice(itemIdx, 1);
            if (oldCat.items.length === 0) {
              phrasesDataObj.categories.splice(catIdx, 1);
            }
          }
          let destCat = phrasesDataObj.categories.find((c: any) => c.categoryName.toLowerCase() === targetCatName.toLowerCase());
          if (!destCat) {
            destCat = { categoryName: targetCatName, items: [] };
            phrasesDataObj.categories.push(destCat);
          }
          destCat.items.push({ native, transliteration, meaning });
        }
        showToast(`✓ Frasa "${native}" berhasil diperbarui!`);
      } else {
        // New item
        let destCat = phrasesDataObj.categories.find((c: any) => c.categoryName.toLowerCase() === targetCatName.toLowerCase());
        if (!destCat) {
          destCat = { categoryName: targetCatName, items: [] };
          phrasesDataObj.categories.push(destCat);
        }
        destCat.items.push({ native, transliteration, meaning });
        showToast(`✓ Frasa "${native}" berhasil ditambahkan!`);
      }

      saveUserPhrases(currentTableId);
      closePhraseModal();
      renderPhrases();
    });

    phraseDeleteBtn?.addEventListener('click', () => {
      const catIdx = parseInt(phraseEditCatIdx?.value || '-1');
      const itemIdx = parseInt(phraseEditItemIdx?.value || '-1');
      if (catIdx >= 0 && itemIdx >= 0) {
        const phrasesDataObj = ensureCustomPhrases(currentTableId);
        const cat = phrasesDataObj.categories[catIdx];
        if (cat) {
          const removed = cat.items.splice(itemIdx, 1)[0];
          if (cat.items.length === 0) {
            phrasesDataObj.categories.splice(catIdx, 1);
          }
          saveUserPhrases(currentTableId);
          closePhraseModal();
          renderPhrases();
          showToast(`✓ Frasa "${removed?.native || ''}" berhasil dihapus!`);
        }
      }
    });

    // ========================================================
    // PHRASE IMPORT MODAL (EXCEL / CSV / TEXT)
    // ========================================================
    function openPhraseImportModal() {
      if (!phraseImportModal) return;
      populateCategorySelect(phraseImportCatSelect, phraseImportCatCustom);
      if (phraseImportCatCustom) phraseImportCatCustom.value = '';
      if (phraseImportText) phraseImportText.value = '';
      if (phraseImportPreview) phraseImportPreview.innerHTML = 'Masukkan teks atau unggah file untuk melihat pratinjau...';
      phraseImportModal.showModal();
    }

    function closePhraseImportModal() {
      phraseImportModal?.close();
    }

    btnOpenPhraseImport?.addEventListener('click', openPhraseImportModal);
    closePhraseImportBtn?.addEventListener('click', closePhraseImportModal);
    phraseImportCancelBtn?.addEventListener('click', closePhraseImportModal);

    function parsePhraseImportText(text: string): Array<{ native: string, transliteration: string, meaning: string }> {
      const lines = text.split('\n').map(l => l.trim()).filter(Boolean);
      const items: Array<{ native: string, transliteration: string, meaning: string }> = [];

      for (const line of lines) {
        let parts: string[] = [];
        if (line.includes('=')) {
          parts = line.split('=').map(p => p.trim());
        } else if (line.includes('|')) {
          parts = line.split('|').map(p => p.trim());
        } else if (line.includes('\t')) {
          parts = line.split('\t').map(p => p.trim());
        } else if (line.includes(',')) {
          parts = line.split(',').map(p => p.trim());
        }

        if (parts.length >= 3) {
          items.push({ native: parts[0], transliteration: parts[1], meaning: parts[2] });
        } else if (parts.length === 2) {
          items.push({ native: parts[0], transliteration: '', meaning: parts[1] });
        } else if (parts.length === 1 && parts[0]) {
          items.push({ native: parts[0], transliteration: '', meaning: parts[0] });
        }
      }
      return items;
    }

    function updatePhraseImportPreview() {
      if (!phraseImportPreview || !phraseImportText) return;
      const items = parsePhraseImportText(phraseImportText.value);
      if (items.length === 0) {
        phraseImportPreview.innerHTML = 'Masukkan teks atau unggah file untuk melihat pratinjau...';
        return;
      }
      let html = `<div class="font-bold text-ink mb-1">✓ Terdeteksi ${items.length} frasa siap diimpor:</div><ul class="space-y-1 list-disc list-inside">`;
      items.slice(0, 5).forEach(it => {
        html += `<li><b class="text-ink">${it.native}</b> ${it.transliteration ? '(' + it.transliteration + ')' : ''} → <span class="italic text-steel">${it.meaning}</span></li>`;
      });
      if (items.length > 5) {
        html += `<li class="text-smoke italic">+ ${items.length - 5} frasa lainnya...</li>`;
      }
      html += '</ul>';
      phraseImportPreview.innerHTML = html;
    }

    phraseImportText?.addEventListener('input', updatePhraseImportPreview);

    if (phraseExcelInput) {
      phraseExcelInput.addEventListener('change', (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;

        showToast(`Membaca file "${file.name}"...`);
        const reader = new FileReader();
        reader.onload = (evt) => {
          try {
            const data = new Uint8Array(evt.target?.result as ArrayBuffer);
            const workbook = (window as any).XLSX.read(data, { type: 'array' });
            const sheetName = workbook.SheetNames[0];
            const worksheet = workbook.Sheets[sheetName];
            const jsonRows: any[][] = (window as any).XLSX.utils.sheet_to_json(worksheet, { header: 1 });

            const lines: string[] = [];
            for (const row of jsonRows) {
              if (!row || row.length === 0) continue;
              if (row.length >= 3) {
                lines.push(`${row[0]} = ${row[1]} = ${row[2]}`);
              } else if (row.length === 2) {
                lines.push(`${row[0]} = ${row[1]}`);
              }
            }

            if (phraseImportText) {
              phraseImportText.value = lines.join('\n');
              updatePhraseImportPreview();
              showToast(`✓ Berhasil memuat ${lines.length} baris frasa dari spreadsheet!`);
            }
          } catch {
            showToast('Gagal memproses file spreadsheet frasa.');
          }
        };
        reader.readAsArrayBuffer(file);
      });
    }

    phraseImportForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      let targetCatName = phraseImportCatSelect?.value || 'Umum';
      if (targetCatName === '__NEW__') {
        targetCatName = phraseImportCatCustom?.value.trim() || 'Kategori Baru';
      }
      saveCategoryToGlobalList(targetCatName);

      const items = parsePhraseImportText(phraseImportText?.value || '');
      if (items.length === 0) {
        showToast('Tidak ada data frasa yang valid untuk diimpor.');
        return;
      }

      const phrasesDataObj = ensureCustomPhrases(currentTableId);
      let destCat = phrasesDataObj.categories.find((c: any) => c.categoryName.toLowerCase() === targetCatName.toLowerCase());
      if (!destCat) {
        destCat = { categoryName: targetCatName, items: [] };
        phrasesDataObj.categories.push(destCat);
      }

      destCat.items.push(...items);
      saveUserPhrases(currentTableId);
      closePhraseImportModal();
      renderPhrases();
      showToast(`✓ Berhasil mengimpor ${items.length} frasa ke kategori "${targetCatName}"!`);
    });

    // ========================================================
    // RENDER PHRASES WITH SEARCH & CATEGORY FILTER
    // ========================================================
    let phraseSearchQuery = '';
    let selectedPhraseCategory = 'all';

    function renderPhraseCategoryChips(allCategories) {
      if (!phraseCategoryFilterChips) return;
      if (!allCategories || allCategories.length <= 1) {
        phraseCategoryFilterChips.innerHTML = '';
        return;
      }

      let chipsHtml = `
        <button type="button" data-cat="all" class="px-2.5 py-1 border transition-colors cursor-pointer ${selectedPhraseCategory === 'all' ? 'border-2 border-cta bg-cta/10 text-ink font-bold shadow-xs' : 'border-rule bg-canvas text-steel hover:text-ink'}">
          Semua
        </button>
      `;

      allCategories.forEach((cat) => {
        const isActive = selectedPhraseCategory === cat.categoryName;
        chipsHtml += `
          <button type="button" data-cat="${encodeURIComponent(cat.categoryName)}" class="px-2.5 py-1 border transition-colors cursor-pointer whitespace-nowrap ${isActive ? 'border-2 border-cta bg-cta/10 text-ink font-bold shadow-xs' : 'border-rule bg-canvas text-steel hover:text-ink'}">
            ${cat.categoryName}
          </button>
        `;
      });

      phraseCategoryFilterChips.innerHTML = chipsHtml;

      phraseCategoryFilterChips.querySelectorAll('button').forEach(btn => {
        btn.addEventListener('click', () => {
          const cat = btn.getAttribute('data-cat');
          selectedPhraseCategory = cat === 'all' ? 'all' : decodeURIComponent(cat || 'all');
          renderPhrases();
        });
      });
    }

    let phraseSearchDebounceTimer = null;
    phraseSearchInput?.addEventListener('input', (e) => {
      clearTimeout(phraseSearchDebounceTimer);
      phraseSearchDebounceTimer = setTimeout(() => {
        phraseSearchQuery = e.target.value;
        renderPhrases();
      }, 120);
    });

    function renderPhrases() {
      if (!phrasesContentWrapper) return;
      const data = getActivePhrasesData(currentTableId);
      const allTables = getAllTables();
      const currentTable = allTables.find(t => t.id === currentTableId);

      if (phrasesTitle) {
        phrasesTitle.textContent = `Frasa Penting: ${currentTable?.name || 'Bahasa'}`;
      }

      if (!data || !data.categories || data.categories.length === 0) {
        if (phraseCategoryFilterChips) phraseCategoryFilterChips.innerHTML = '';
        phrasesContentWrapper.innerHTML = `
          <div class="py-12 px-4 text-center border-2 border-dashed border-rule bg-canvas text-smoke font-mono space-y-3">
            <div class="size-12 mx-auto rounded-none bg-tint flex items-center justify-center border border-rule text-ink">
              <svg class="size-6 text-steel" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <div class="text-sm font-bold text-ink">Belum Ada Frasa untuk Bahasa "${currentTable?.name || ''}"</div>
            <p class="text-xs text-steel max-w-md mx-auto font-sans">
              Mulai koleksi frasa penting Anda sendiri sekarang. Anda bisa menambahkan satu per satu atau langsung impor dari file Excel/CSV!
            </p>
            <div class="flex items-center justify-center gap-2 pt-2">
              <button type="button" id="btn-empty-add-phrase" class="btn btn-primary btn-s font-mono text-xs cursor-pointer inline-flex items-center gap-1">
                <svg class="size-3.5 inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg> Tambah Frasa Pertama
              </button>
              <button type="button" id="btn-empty-import-phrase" class="btn btn-secondary btn-s font-mono text-xs cursor-pointer inline-flex items-center gap-1">
                <svg class="size-3.5 inline text-steel" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M8 13h2"/><path d="M14 13h2"/><path d="M8 17h2"/><path d="M14 17h2"/></svg> Impor dari Excel
              </button>
            </div>
          </div>
        `;
        document.getElementById('btn-empty-add-phrase')?.addEventListener('click', () => openPhraseModal(-1, -1));
        document.getElementById('btn-empty-import-phrase')?.addEventListener('click', openPhraseImportModal);
        return;
      }

      renderPhraseCategoryChips(data.categories);

      const searchLower = phraseSearchQuery.trim().toLowerCase();
      const filteredCategories = data.categories.map((cat, catIdx) => {
        if (selectedPhraseCategory !== 'all' && cat.categoryName !== selectedPhraseCategory) {
          return null;
        }
        const matchingItems = cat.items
          .map((item, itemIdx) => ({ ...item, originalItemIdx: itemIdx }))
          .filter((item) => {
            if (!searchLower) return true;
            return (
              (item.native && item.native.toLowerCase().includes(searchLower)) ||
              (item.transliteration && item.transliteration.toLowerCase().includes(searchLower)) ||
              (item.meaning && item.meaning.toLowerCase().includes(searchLower))
            );
          });
        if (matchingItems.length === 0) return null;
        return {
          ...cat,
          originalCatIdx: catIdx,
          items: matchingItems
        };
      }).filter(Boolean);

      if (filteredCategories.length === 0) {
        phrasesContentWrapper.innerHTML = `
          <div class="py-12 px-4 text-center border-2 border-dashed border-rule bg-canvas text-smoke font-mono space-y-2">
            <div class="size-10 mx-auto rounded-none bg-tint flex items-center justify-center border border-rule text-smoke">
              <svg class="size-5 text-steel" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </div>
