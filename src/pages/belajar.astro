    .btn-mic-phrase,
    .btn-speak-phrase,
    .btn-edit-phrase,
    .btn-delete-phrase,
    .btn-cat-add,
    .btn-cat-delete,
    #phrase-category-filter-chips,
    #phrase-quiz-modal,
    #phrase-search-input {
      display: none !important;
