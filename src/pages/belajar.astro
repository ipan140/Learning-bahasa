      const count = memorized.length;
      const pct = total > 0 ? Math.round((count / total) * 100) : 0;

      if (progressCountLabel) progressCountLabel.textContent = `${count} / ${total} Huruf`;
      if (progressPercentLabel) progressPercentLabel.textContent = `(${pct}%)`;
      if (progressFillBar) progressFillBar.style.width = `${pct}%`;
    }

