            </div>

            <button type="button" id="btn-quiz-next-question" class="w-full mt-4 btn btn-primary py-2.5 font-mono text-xs justify-center hidden">
              Soal Berikutnya →
            </button>
          </div>
        </div>

        <!-- ============================================== -->
        <!-- VIEW 3: FRASA DASAR SEHARI-HARI                -->
        <!-- ============================================== -->
        <div id="phrases-container" class="hidden border border-rule bg-canvas p-5 sm:p-6 shadow-sm space-y-5">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-rule pb-4">
            <div>
              <span class="px-2.5 py-1 text-[11px] font-mono border border-rule text-smoke uppercase tracking-wider bg-tint">Survival Phrases</span>
              <h2 id="phrases-title" class="text-[22px] sm:text-[24px] font-bold text-ink tracking-tight mt-1">
                Frasa Penting Sehari-hari
              </h2>
              <p class="text-[13px] text-steel mt-0.5">
                Kosakata &amp; percakapan dasar: salam, angka, belanja, dan frasa darurat dengan tombol audio asli.
              </p>
            </div>

            <!-- Phrases Action Buttons -->
            <div class="flex items-center gap-2 flex-wrap shrink-0">
              <button 
                type="button" 
                id="btn-play-all-phrases" 
                class="btn btn-secondary btn-s font-mono text-[12px] inline-flex items-center gap-1.5"
                title="Dengarkan seluruh frasa yang tampil secara otomatis satu per satu"
              >
                <Play class="size-3.5 inline text-steel" /> <span>Putar Otomatis</span>
              </button>
              <button 
                type="button" 
                id="btn-open-phrase-quiz" 
                class="btn btn-secondary btn-s font-mono text-[12px] inline-flex items-center gap-1.5"
                title="Mulai Kuis Tebak Arti Frasa Sehari-hari"
              >
                <Trophy class="size-3.5 inline text-amber-500" /> <span>Kuis Frasa</span>
              </button>
              <button 
                type="button" 
                id="btn-open-phrase-modal" 
                class="btn btn-primary btn-s font-mono text-[12px] inline-flex items-center gap-1.5"
                title="Tambah frasa baru ke koleksi bahasa ini"
              >
                <Plus class="size-3.5 inline" /> Tambah Frasa
              </button>
              <button 
                type="button" 
                id="btn-open-phrase-import" 
                class="btn btn-secondary btn-s font-mono text-[12px] inline-flex items-center gap-1.5"
                title="Impor kumpulan frasa dari file Excel atau teks"
              >
                <FileSpreadsheet class="size-3.5 inline text-steel" /> Impor Excel
              </button>
              <button 
                type="button" 
                id="btn-export-phrases-excel" 
                class="btn btn-secondary btn-s font-mono text-[12px] inline-flex items-center gap-1.5"
                title="Unduh seluruh frasa ke file Excel (.xlsx)"
              >
                <FileSpreadsheet class="size-3.5 inline text-steel" /> Ekspor Excel
              </button>
              <button 
                type="button" 
                id="btn-print-phrases" 
                class="btn btn-secondary btn-s font-mono text-[12px] inline-flex items-center gap-1.5"
                title="Cetak kumpulan frasa ini ke kertas atau simpan sebagai dokumen PDF"
              >
                <Printer class="size-3.5 inline text-steel" /> Cetak / PDF
              </button>
              <button 
                type="button" 
                id="btn-toggle-phrase-edit" 
                class="btn btn-secondary btn-s font-mono text-[12px] inline-flex items-center gap-1.5"
                title="Aktifkan mode edit/hapus untuk frasa"
              >
                <Edit3 class="size-3.5 inline text-steel" /> Mode Edit Frasa
              </button>
              <button 
                type="button" 
                id="btn-reset-phrase" 
                class="px-2.5 py-1.5 text-[11px] font-mono border border-rule text-smoke hover:text-ink hover:border-ink transition-colors inline-flex items-center gap-1"
                title="Kembalikan frasa ke bawaan awal"
              >
                <RotateCcw class="size-3 inline text-smoke" /> Reset
              </button>
            </div>
          </div>

          <!-- Edit Mode Notice Banner -->
          <div id="phrase-edit-toolbar" class="hidden p-3 border-2 border-badge bg-badge/10 font-mono text-xs text-ink flex flex-col sm:flex-row sm:items-center justify-between gap-2 shadow-sm">
            <div class="flex items-center gap-2">
              <span class="text-badge font-bold flex items-center gap-1"><Edit3 class="size-3.5 inline text-badge" /> MODE EDIT FRASA:</span>
              <span>Klik icon pensil pada kartu frasa untuk mengedit, atau tombol silang merah <span class="text-red-500 font-bold">[✕]</span> untuk menghapus frasa.</span>
            </div>
            <button type="button" id="btn-finish-phrase-edit" class="px-3 py-1 text-xs border border-ink bg-ink text-canvas font-bold cursor-pointer shrink-0 inline-flex items-center gap-1">
              <Check class="size-3.5 inline" /> Selesai Edit
            </button>
          </div>

          <!-- Phrase Search & Category Filter Toolbar -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 p-3 border border-rule bg-smoke/5">
            <div class="flex items-center gap-2 flex-1 min-w-0">
              <span class="text-steel text-xs font-mono select-none">CARI:</span>
              <input 
                type="text" 
                id="phrase-search-input" 
                placeholder="Cari kata, cara baca, atau arti frasa..." 
                class="w-full px-3 py-1.5 text-xs bg-canvas border border-rule text-ink outline-none focus:border-ink font-mono"
              />
            </div>
            <div class="flex items-center gap-1.5 overflow-x-auto scrollbar-none pb-0.5 text-xs font-mono shrink-0" id="phrase-category-filter-chips">
              <!-- Dynamically populated category chips -->
            </div>
          </div>

          <div id="phrases-content-wrapper" class="space-y-6">
            <!-- Rendered by client script -->
          </div>
        </div>

      </div>
    </div>
  </Section>

  <!-- ========================================== -->
  <!-- CUSTOM TABLE CREATOR MODAL                 -->
  <!-- ========================================== -->
  <div id="buat-tabel" class="frame px-4 sm:px-6">
    <div id="creator-modal" class="hidden my-4 sm:my-8 p-4 sm:p-8 border-2 border-ink bg-canvas shadow-2xl">
      <div class="flex items-start justify-between gap-3 border-b border-rule pb-4 mb-6">
        <div>
          <h3 id="creator-modal-title" class="text-[22px] font-bold text-ink">Buat Tabel / Materi Bahasa Baru</h3>
          <p class="text-[13px] text-steel mt-1">
            Tambahkan materi atau bahasa apa saja dengan format teks bebas, atau <strong>impor langsung dari file Excel/Spreadsheet</strong> Anda.
          </p>
        </div>
        <button type="button" id="close-creator-btn" class="btn btn-secondary btn-s shrink-0 inline-flex items-center gap-1"><X class="size-3.5 inline" /> Tutup</button>
      </div>

      <form id="creator-form" class="space-y-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="form-name" class="block text-[13px] font-mono text-steel mb-1.5">Nama Bahasa / Kategori *</label>
            <input 
              type="text" 
              id="form-name" 
              required 
              placeholder="Misal: Mandarin (Hanzi), Jerman, dll." 
              class="w-full px-3.5 py-2.5 text-[14px] bg-tint border border-rule text-ink outline-none focus:border-ink font-mono"
            />
          </div>
          <div>
            <label for="form-title" class="block text-[13px] font-mono text-steel mb-1.5">Judul Tabel *</label>
            <input 
              type="text" 
              id="form-title" 
              required 
              placeholder="Misal: Tabel Angka 1-10, Tabel Aksara Khusus" 
              class="w-full px-3.5 py-2.5 text-[14px] bg-tint border border-rule text-ink outline-none focus:border-ink font-mono"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="form-desc" class="block text-[13px] font-mono text-steel mb-1.5">Keterangan Singkat</label>
            <input 
              type="text" 
              id="form-desc" 
              placeholder="Keterangan singkat materi belajar ini..." 
              class="w-full px-3.5 py-2.5 text-[14px] bg-tint border border-rule text-ink outline-none focus:border-ink font-mono"
            />
          </div>
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="form-voice" class="block text-[13px] font-mono text-steel">Suara Pengucapan (Speech Voice)</label>
              <button 
                type="button" 
                id="btn-test-creator-voice" 
                class="text-[11px] font-mono text-smoke hover:text-ink cursor-pointer inline-flex items-center gap-1 hover:underline" 
                title="Dengarkan sampel suara pengucapan bahasa yang dipilih"
              >
                <Volume2 class="size-3 inline text-ink" /> Coba Dengar
              </button>
            </div>
            <select 
              id="form-voice" 
              class="w-full px-3 py-2 text-[13px] bg-tint border border-rule text-ink outline-none focus:border-ink font-mono"
            >
              <optgroup label="── Bahasa Populer & Indonesia ──">
                <option value="id-ID">Indonesia (id-ID)</option>
                <option value="ja-JP">Jepang (ja-JP)</option>
                <option value="ko-KR">Korea (ko-KR)</option>
                <option value="ar-SA">Arab Saudi (ar-SA)</option>
                <option value="zh-CN">Mandarin China (zh-CN)</option>
                <option value="en-US">Inggris US (en-US)</option>
                <option value="de-DE">Jerman (de-DE)</option>
                <option value="fr-FR">Prancis (fr-FR)</option>
                <option value="es-ES">Spanyol (es-ES)</option>
                <option value="ru-RU">Rusia (ru-RU)</option>
              </optgroup>
              <optgroup label="── Asia & Pasifik ──">
                <option value="ms-MY">Melayu (ms-MY)</option>
                <option value="th-TH">Thailand (th-TH)</option>
                <option value="vi-VN">Vietnam (vi-VN)</option>
                <option value="zh-TW">Mandarin Taiwan (zh-TW)</option>
                <option value="zh-HK">Kanton Hong Kong (zh-HK)</option>
                <option value="fil-PH">Filipina / Tagalog (fil-PH)</option>
                <option value="hi-IN">Hindi India (hi-IN)</option>
                <option value="ta-IN">Tamil (ta-IN)</option>
                <option value="bn-IN">Bengali (bn-IN)</option>
              </optgroup>
              <optgroup label="── Timur Tengah & Afrika ──">
                <option value="ar-EG">Arab Mesir (ar-EG)</option>
                <option value="tr-TR">Turki (tr-TR)</option>
                <option value="fa-IR">Persia / Farsi (fa-IR)</option>
                <option value="he-IL">Ibrani / Hebrew (he-IL)</option>
                <option value="sw-KE">Swahili (sw-KE)</option>
              </optgroup>
              <optgroup label="── Eropa Barat, Utara & Selatan ──">
                <option value="en-GB">Inggris UK (en-GB)</option>
                <option value="it-IT">Italia (it-IT)</option>
                <option value="nl-NL">Belanda (nl-NL)</option>
                <option value="pt-PT">Portugis Eropa (pt-PT)</option>
                <option value="pt-BR">Portugis Brasil (pt-BR)</option>
                <option value="sv-SE">Swedia (sv-SE)</option>
                <option value="da-DK">Denmark (da-DK)</option>
                <option value="fi-FI">Finlandia (fi-FI)</option>
                <option value="no-NO">Norwegia (no-NO)</option>
                <option value="el-GR">Yunani / Greek (el-GR)</option>
                <option value="pl-PL">Polandia (pl-PL)</option>
                <option value="uk-UA">Ukraina (uk-UA)</option>
                <option value="cs-CZ">Ceko (cs-CZ)</option>
                <option value="hu-HU">Hungaria (hu-HU)</option>
                <option value="ro-RO">Rumania (ro-RO)</option>
              </optgroup>
              <optgroup label="── Suara Sistem di Perangkat Anda ──" id="form-voice-system-optgroup">
                <!-- Dynamically populated from window.speechSynthesis.getVoices() -->
              </optgroup>
              <optgroup label="── Preset Kustom Tersimpan ──" id="form-voice-custom-optgroup">
                <!-- Dynamically populated from user's custom presets -->
              </optgroup>
              <option value="__custom__">+ Ketik &amp; Simpan Bahasa Kustom Baru...</option>
            </select>

            <!-- Custom Voice Code Input Panel -->
            <div id="form-voice-custom-panel" class="hidden mt-2 p-2.5 border border-rule bg-tint/40 space-y-2">
              <div class="text-[11px] font-mono text-smoke">Ketik kode standar bahasa (BCP-47) &amp; nama tampilan:</div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                <input 
                  type="text" 
                  id="input-custom-voice-code" 
                  placeholder="Kode: misal jv-ID, su-ID, es-MX" 
                  class="px-2.5 py-1.5 text-xs bg-canvas border border-rule text-ink outline-none focus:border-ink font-mono" 
                />
                <input 
                  type="text" 
                  id="input-custom-voice-label" 
                  placeholder="Label: misal Jawa (jv-ID)" 
                  class="px-2.5 py-1.5 text-xs bg-canvas border border-rule text-ink outline-none focus:border-ink font-mono" 
                />
              </div>
              <div class="flex items-center justify-between gap-2 pt-1 text-xs font-mono">
                <span class="text-[10px] text-smoke">Preset kustom akan tersimpan otomatis.</span>
                <button 
                  type="button" 
                  id="btn-save-custom-voice-preset" 
                  class="btn btn-secondary btn-s text-[11px] py-1 px-2.5 cursor-pointer font-mono"
                >
                  + Simpan Preset
                </button>
              </div>
            </div>
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="form-text" class="block text-[13px] font-mono text-steel">
              Isi Karakter / Huruf * (Teks atau Baris Excel)
            </label>
            <span class="text-[12px] font-mono text-smoke">Format: <code>Romaji = Karakter</code></span>
          </div>
          <textarea 
            id="form-text" 
            rows="6" 
            required 
            placeholder="A = あ | I = い | U = う | E = え | O = お&#10;Ka = か | Ki = き | Ku = く | Ke = け | Ko = こ"
            class="w-full px-3.5 py-2.5 text-[14px] bg-tint border border-rule text-ink outline-none focus:border-ink font-mono"
          ></textarea>
        </div>

        <div class="p-4 border border-rule bg-tint/30 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <span class="font-bold text-[13px] text-ink block">Punya file Spreadsheet / Excel?</span>
            <span class="text-[12px] text-smoke">Unggah file .xlsx atau .csv untuk dikonversi otomatis menjadi tabel.</span>
          </div>
          <label class="btn btn-secondary btn-s shrink-0 cursor-pointer text-[12px] inline-flex items-center gap-1.5">
            <FileSpreadsheet class="size-3.5 inline text-steel" />
            Pilih File Excel / CSV
            <input type="file" id="form-excel-input" accept=".xlsx, .xls, .csv" class="hidden" />
          </label>
        </div>

        <div>
          <label class="block text-[12px] font-mono text-smoke mb-1.5 uppercase tracking-wider">Pratinjau Tabel (5 Baris Pertama):</label>
          <div id="creator-preview" class="p-4 border border-rule bg-canvas overflow-x-auto min-h-[80px]">
            <span class="text-smoke italic font-mono text-[12px]">Ketik atau paste dari Excel di kotak atas untuk melihat pratinjau tabel...</span>
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-end gap-2 sm:gap-3 pt-4 border-t border-rule">
          <button type="button" id="load-sample-btn" class="btn btn-secondary btn-s font-mono text-[11px] sm:text-[12px]">
            Muat Contoh Data
          </button>
          <button type="button" id="cancel-creator-btn" class="btn btn-secondary btn-s font-mono text-[11px] sm:text-[12px]">
            Batal
          </button>
          <button type="submit" id="creator-submit-btn" class="btn btn-primary btn-s font-mono text-[11px] sm:text-[12px]">
            Simpan &amp; Tampilkan Tabel
          </button>
        </div>
      </form>
    </div>
  </div>
