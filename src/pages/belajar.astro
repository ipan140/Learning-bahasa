---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import { defaultLanguageTables } from '../data/languages';
import { languagePhrasesData } from '../data/phrases';
import { 
  Globe, 
  Plus, 
  Layers, 
  RotateCcw, 
  MessageSquare, 
  Volume2, 
  VolumeX, 
  Gauge, 
  Play, 
  Square, 
  Copy, 
  Printer, 
  Edit3, 
  Trash2, 
  Sparkles, 
  Check, 
  Shuffle, 
  HelpCircle, 
  FileSpreadsheet, 
  FileText,
  Search,
  X,
  Lightbulb,
  AlertCircle
} from 'lucide-astro';
---

<Base 
  title="Studio Belajar Aksara & Huruf Bahasa - Belajar Bahasa" 
  description="Tabel interaktif aksara bahasa: Jepang (Hiragana & Katakana), Jerman, Korea (Hangul), Arab (Hijaiyah), Mandarin, Thai, dan lainnya dengan audio lafal asli, flashcard latihan, dan sinkronisasi cloud."
>
  
  <!-- [01] MAIN APP: Area Belajar Aksara -->
  <Section id="area-belajar" top={false} inner="px-6 pt-12 pb-18 lg:pt-16 lg:pb-22 max-md:px-5">
    <div class="w-full">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-rule">
        <div>
          <p class="label"><b>[01]</b> studio belajar interaktif</p>
          <h1 class="mt-3 text-[clamp(28px,3.8vw,46px)] leading-[1.08] font-bold tracking-[-0.035em] text-ink">
            Tabel Huruf &amp; Aksara Bahasa
          </h1>
          <p class="mt-3 max-w-[65ch] text-[15px] leading-[1.6] text-steel">
            Pilih aksara bahasa di bawah ini. Anda dapat belajar menggunakan tabel interaktif, berlatih dengan kartu flashcard &amp; kuis, atau mempelajari frasa percakapan penting sehari-hari.
          </p>
        </div>
        <div class="flex items-center gap-2.5 shrink-0 flex-wrap">
          <a href="/katalog" class="btn btn-secondary btn-s font-mono text-[13px] inline-flex items-center gap-1.5">
            <Globe class="size-3.5 inline text-steel" /> Katalog 250 Negara →
          </a>
          <button type="button" id="open-creator-top-btn" class="btn btn-primary btn-s font-mono text-[13px] inline-flex items-center gap-1.5">
            <Plus class="size-3.5 inline" /> Buat Tabel
          </button>
        </div>
      </div>
    </div>

    <!-- App Data Container -->
    <div 
      id="main-app" 
      class="mt-8"
      data-defaults={JSON.stringify(defaultLanguageTables)}
      data-phrases={JSON.stringify(languagePhrasesData)}
    >

      <!-- Notification Toast -->
      <div id="toast" class="hidden mb-6 px-4 py-2.5 text-[13px] border border-ok text-ok bg-canvas flex items-center justify-between font-mono">
        <span id="toast-message">Berhasil disimpan!</span>
        <button type="button" id="toast-close" class="text-smoke hover:text-ink font-bold ml-4 cursor-pointer p-0.5" aria-label="Tutup"><X class="size-3.5" /></button>
      </div>

      <!-- ========================================== -->
      <!-- SECTION TABEL AKSARA & HURUF               -->
      <!-- ========================================== -->
      <div id="section-tables" class="space-y-6">
        
        <!-- Language Switcher Bar -->
        <div class="p-4 sm:p-5 border border-rule bg-canvas shadow-sm space-y-3.5">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <span class="label font-bold text-ink">PILIH AKSARA BAHASA:</span>
            <!-- Category Chips Filter -->
            <div class="flex items-center gap-1.5 text-[12px] font-mono overflow-x-auto pb-1 scrollbar-none" id="category-filter-chips">
              <button type="button" data-cat="all" class="px-3 py-1 border-2 border-cta bg-cta/10 text-ink font-bold whitespace-nowrap shadow-xs cursor-pointer">Semua</button>
              <button type="button" data-cat="Asia" class="px-3 py-1 border border-rule bg-canvas text-steel hover:text-ink hover:border-ink hover:bg-tint/40 whitespace-nowrap cursor-pointer">Asia</button>
              <button type="button" data-cat="Eropa" class="px-3 py-1 border border-rule bg-canvas text-steel hover:text-ink hover:border-ink hover:bg-tint/40 whitespace-nowrap cursor-pointer">Eropa</button>
              <button type="button" data-cat="Timur Tengah" class="px-3 py-1 border border-rule bg-canvas text-steel hover:text-ink hover:border-ink hover:bg-tint/40 whitespace-nowrap cursor-pointer">Timur Tengah</button>
              <button type="button" data-cat="custom" class="px-3 py-1 border border-rule bg-canvas text-steel hover:text-ink hover:border-ink hover:bg-tint/40 whitespace-nowrap cursor-pointer">Kustom</button>
            </div>
          </div>

          <!-- Buttons Container (Responsive grid) -->
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2 pt-1" id="tab-bar">
            <!-- Rendered by client script -->
          </div>
        </div>

        <!-- Mode Switcher Tabs (Tabel, Flashcard, Frasa Penting) -->
        <div class="flex items-center gap-2 border-b border-rule pb-2 overflow-x-auto scrollbar-none">
          <button 
            type="button" 
            id="btn-mode-table" 
            class="px-4 py-2 font-mono text-[13px] border-2 border-cta bg-cta/10 text-ink font-bold whitespace-nowrap transition-colors cursor-pointer shadow-xs inline-flex items-center gap-1.5"
          >
            <Layers class="size-3.5 inline" /> Mode Tabel Aksara
          </button>
          <button 
            type="button" 
            id="btn-mode-flashcard" 
            class="px-4 py-2 font-mono text-[13px] border border-rule bg-canvas text-steel hover:text-ink hover:border-ink hover:bg-tint/40 whitespace-nowrap transition-colors cursor-pointer inline-flex items-center gap-1.5"
          >
            <RotateCcw class="size-3.5 inline" /> Mode Flashcard &amp; Latihan
          </button>
          <button 
            type="button" 
            id="btn-mode-phrases" 
            class="px-4 py-2 font-mono text-[13px] border border-rule bg-canvas text-steel hover:text-ink hover:border-ink hover:bg-tint/40 whitespace-nowrap transition-colors cursor-pointer inline-flex items-center gap-1.5"
          >
            <MessageSquare class="size-3.5 inline" /> Frasa Dasar Sehari-hari
          </button>
        </div>

        <!-- Progress Tracker Banner -->
        <div id="study-progress-box" class="p-4 border border-rule bg-smoke/5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs font-mono">
          <div class="flex items-center gap-2.5 flex-wrap">
            <span class="font-bold text-ink uppercase tracking-wider">Progres Hafalan:</span>
            <span id="progress-count-label" class="text-ok font-bold">0 / 0 Huruf</span>
            <span id="progress-percent-label" class="text-smoke">(0%)</span>
          </div>
          <div class="flex items-center gap-3 w-full sm:w-auto">
            <div class="flex-1 sm:w-48 h-2.5 bg-rule overflow-hidden">
              <div id="progress-fill-bar" class="h-full bg-ok transition-all duration-300" style="width: 0%"></div>
            </div>
            <button 
              type="button" 
              id="btn-reset-progress" 
              class="text-smoke hover:text-red-500 text-[11px] underline shrink-0 transition-colors"
              title="Reset tanda hafalan pada bahasa ini"
            >
              Reset
            </button>
          </div>
        </div>

        <!-- Action & Search Toolbar -->
        <div class="flex flex-wrap items-center justify-between gap-4 p-4 border border-rule bg-canvas">
          <div class="flex items-center gap-3 flex-1 min-w-0 w-full sm:w-auto sm:min-w-[240px]">
            <span class="text-smoke text-[13px] font-mono select-none">CARI:</span>
            <input 
              type="text" 
              id="search-input" 
              placeholder="Cari huruf atau romaji (misal: Ka, あ, Ä, ㄱ)..." 
              class="w-full max-w-sm px-3.5 py-2 text-[14px] bg-tint border border-rule text-ink outline-none focus:border-ink font-mono"
            />
          </div>
          <div class="flex items-center gap-2 flex-wrap text-[13px]">
            <button 
              type="button" 
              id="toggle-audio-btn" 
              class="btn btn-secondary btn-s inline-flex items-center gap-1.5"
              title="Aktifkan/Nonaktifkan Suara Pengucapan"
            >
              <Volume2 class="size-3.5 inline" id="icon-audio-toggle" />
              <span>Suara: <span id="audio-status-label" class="text-ok font-bold">AKTIF</span></span>
            </button>
            <button 
              type="button" 
              id="toggle-speed-btn" 
              class="btn btn-secondary btn-s font-mono inline-flex items-center gap-1.5"
              title="Atur Kecepatan Suara: 0.5x, 0.75x, 1x (default), 1.25x, 1.5x, 2x"
            >
              <Gauge class="size-3.5 inline text-steel" />
              <span>Speed: <span id="speed-status-label" class="text-ink font-bold">1.0x</span></span>
            </button>
            <button 
              type="button" 
              id="btn-play-all" 
              class="btn btn-secondary btn-s font-mono cursor-pointer inline-flex items-center gap-1.5"
              title="Dengarkan seluruh aksara dalam tabel ini secara berurutan otomatis"
            >
              <Play class="size-3.5 inline text-steel" id="icon-play-all" />
              <span id="label-play-all">Putar Urut</span>
            </button>
            <button 
              type="button" 
              id="copy-all-btn" 
              class="btn btn-secondary btn-s inline-flex items-center gap-1.5"
              title="Salin seluruh isi tabel ke clipboard"
            >
              <Copy class="size-3.5 inline text-steel" /> Salin Teks
            </button>
            <button 
              type="button" 
              id="print-table-btn" 
              class="btn btn-secondary btn-s font-mono cursor-pointer inline-flex items-center gap-1.5"
              title="Cetak tabel aksara ini ke kertas atau simpan sebagai dokumen PDF"
            >
              <Printer class="size-3.5 inline text-steel" /> Cetak / PDF
            </button>
            <button 
              type="button" 
              id="open-creator-btn" 
              class="btn btn-primary btn-s inline-flex items-center gap-1.5"
            >
              <Plus class="size-3.5 inline" /> Buat Tabel Sendiri
            </button>
          </div>
        </div>

        <!-- ============================================== -->
        <!-- VIEW 1: TABEL LENGKAP                          -->
        <!-- ============================================== -->
        <div id="viewer-container" class="border border-rule bg-canvas p-5 sm:p-6 shadow-sm">
          <!-- Table Title & Description -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-rule pb-4 mb-6">
            <div>
              <div class="flex items-center gap-3 flex-wrap">
                <span id="table-badge" class="px-2.5 py-1 text-[11px] font-mono border border-rule text-smoke uppercase tracking-wider bg-tint">Hiragana Dasar</span>
                <h2 id="table-title" class="text-[22px] sm:text-[26px] font-bold text-ink tracking-tight">
                  A. Tabel Huruf Hiragana Dasar
                </h2>
              </div>
              <p id="table-description" class="mt-1.5 text-[14px] text-steel">
                Aksara fonetik utama dalam bahasa Jepang.
              </p>
            </div>
            <div id="table-toolbar-actions" class="flex items-center gap-2 flex-wrap shrink-0">
              <button type="button" id="btn-top-add-char" class="btn btn-primary btn-s font-mono text-[12px] inline-flex items-center gap-1.5" title="Tambah aksara baru ke tabel ini">
                <Plus class="size-3.5 inline" /> Tambah Aksara
              </button>
              <button type="button" id="duplicate-table-btn" class="btn btn-secondary btn-s font-mono text-[12px] inline-flex items-center gap-1.5" title="Duplikat tabel ini ke tabel kustom agar dapat diedit bebas">
                <Copy class="size-3.5 inline text-steel" /> Duplikat &amp; Edit
              </button>
              <button type="button" id="toggle-edit-mode-btn" class="btn btn-secondary btn-s font-mono text-[12px] inline-flex items-center gap-1.5" title="Aktifkan mode edit untuk mengubah atau menghapus huruf dobel">
                <Edit3 class="size-3.5 inline text-steel" /> Mode Edit Aksara
              </button>
              <button type="button" id="edit-custom-table-btn" class="hidden btn btn-secondary btn-s font-mono text-[12px] inline-flex items-center gap-1.5" title="Edit seluruh isi tabel (teks/spreadsheet)">
                <FileText class="size-3.5 inline text-steel" /> Edit Teks
              </button>
              <button type="button" id="delete-table-btn" class="hidden px-3 py-1.5 text-[12px] font-mono border border-rule text-smoke hover:text-red-500 hover:border-red-500 transition-colors inline-flex items-center gap-1.5">
                <Trash2 class="size-3.5 inline" /> Hapus Tabel
              </button>
            </div>
          </div>

          <!-- The Text Grid / Table -->
          <!-- Edit Mode Toolbar (muncul saat Mode Edit aktif) -->
          <div id="table-edit-toolbar" class="hidden mb-4 p-3.5 border-2 border-badge bg-badge/10 font-mono text-[13px] flex flex-col md:flex-row md:items-center justify-between gap-3 shadow-sm">
            <div class="flex items-center gap-2">
              <span class="text-badge font-bold flex items-center gap-1.5"><Edit3 class="size-3.5 inline text-badge" /> MODE EDIT AKTIF:</span>
              <span class="text-ink text-xs sm:text-sm">Klik icon silang <span class="text-red-500 font-bold">[✕]</span> pada kotak untuk menghapus huruf, atau icon pensil untuk mengedit.</span>
            </div>
            <div class="flex items-center gap-2 flex-wrap shrink-0">
              <button type="button" id="btn-auto-dedup" class="px-2.5 py-1 text-xs border border-rule bg-canvas hover:border-ink font-bold text-ink cursor-pointer inline-flex items-center gap-1" title="Cari huruf yang kembar/dobel di tabel ini dan hapus otomatis">
                <Sparkles class="size-3.5 inline text-steel" /> Hapus Huruf Dobel Otomatis
              </button>
              <button type="button" id="btn-add-char-table" class="px-2.5 py-1 text-xs border border-rule bg-canvas hover:border-ink font-bold text-ink cursor-pointer inline-flex items-center gap-1">
                <Plus class="size-3.5 inline text-steel" /> Tambah Huruf
              </button>
              <button type="button" id="btn-finish-edit-mode" class="px-3 py-1 text-xs border border-ink bg-ink text-canvas font-bold cursor-pointer inline-flex items-center gap-1">
                <Check class="size-3.5 inline" /> Selesai Edit
              </button>
            </div>
          </div>

          <div class="w-full overflow-x-auto pb-4">
            <div id="table-grid-wrapper" class="inline-block min-w-full align-middle">
              <!-- Table will be rendered here -->
            </div>
          </div>

          <!-- Instructions footer -->
          <div class="mt-6 p-4 border border-dashed border-rule text-[13px] text-smoke flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-tint/30">
            <span class="inline-flex items-center gap-1.5"><Lightbulb class="size-4 inline text-badge shrink-0" /> <strong>Tips:</strong> Klik kotak huruf untuk mendengar audio asli &amp; salin karakter. Huruf bergaris hijau menandakan sudah Anda tandai hafal.</span>
            <span class="font-mono text-[12px]">Format: [Romaji/Cara Baca] = [Aksara]</span>
          </div>
        </div>

        <!-- ============================================== -->
        <!-- VIEW 2: FLASHCARD & LATIHAN HAFALAN            -->
        <!-- ============================================== -->
        <div id="flashcard-container" class="hidden border border-rule bg-canvas p-6 sm:p-8 shadow-sm">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-rule pb-4 mb-6">
            <div>
              <span class="px-2.5 py-1 text-[11px] font-mono border border-rule text-smoke uppercase tracking-wider bg-tint">Mode Latihan</span>
              <h2 class="text-[22px] sm:text-[24px] font-bold text-ink tracking-tight mt-1">
                Latihan Hafalan Huruf &amp; Aksara
              </h2>
              <p class="text-[13px] text-steel mt-0.5">
                Uji ingatan Anda. Balik kartu untuk memeriksa bacaan atau uji dengan kuis pilihan ganda.
              </p>
            </div>

            <!-- Toggle Flashcard vs Kuis -->
            <div class="flex items-center gap-1.5 text-[12px] font-mono shrink-0">
              <button type="button" id="btn-fc-type-card" class="px-3 py-1.5 border-2 border-cta bg-cta/10 text-ink font-bold shadow-xs cursor-pointer inline-flex items-center gap-1.5">
                <Layers class="size-3.5 inline" /> Flashcard
              </button>
              <button type="button" id="btn-fc-type-quiz" class="px-3 py-1.5 border border-rule bg-canvas text-steel hover:text-ink hover:border-ink hover:bg-tint/40 cursor-pointer inline-flex items-center gap-1.5">
                <HelpCircle class="size-3.5 inline text-steel" /> Kuis Pilihan Ganda
              </button>
            </div>
          </div>

          <!-- 2A. Kartu Flashcard -->
          <div id="fc-card-subview" class="max-w-md mx-auto flex flex-col items-center">
            <div class="w-full flex items-center justify-between text-xs font-mono text-smoke mb-3">
              <span id="fc-card-counter">Kartu 1 dari 46</span>
              <span id="fc-card-status" class="text-ok font-bold"></span>
            </div>

            <!-- Big Flip Card -->
            <div 
              id="fc-flashcard" 
              class="w-full min-h-[260px] p-8 border-2 border-ink bg-canvas hover:bg-smoke/5 cursor-pointer flex flex-col items-center justify-center text-center transition-all select-none shadow-md relative"
              title="Klik untuk membalik kartu"
            >
              <span class="absolute top-3 right-3 text-[11px] font-mono text-smoke inline-flex items-center gap-1">
                <RotateCcw class="size-3 inline text-smoke" /> Klik untuk balik
              </span>
              
              <!-- Front Side (Karakter Besar) -->
              <div id="fc-card-front" class="flex flex-col items-center justify-center">
                <span id="fc-char-display" class="text-[68px] sm:text-[80px] font-bold text-ink leading-none">あ</span>
                <span class="text-xs text-smoke font-mono mt-4">Tebak cara baca aksara ini...</span>
              </div>

              <!-- Back Side (Romaji & Audio) -->
              <div id="fc-card-back" class="hidden flex flex-col items-center justify-center">
                <span id="fc-romaji-display" class="text-[32px] sm:text-[40px] font-bold text-ink leading-tight">A</span>
                <span id="fc-char-subdisplay" class="text-[20px] text-steel font-mono mt-1">あ</span>
                <button type="button" id="btn-fc-speak" class="mt-4 btn btn-secondary btn-s font-mono text-xs inline-flex items-center gap-1.5">
                  <Volume2 class="size-3.5 inline text-steel" /> Dengarkan Lafal
                </button>
              </div>
            </div>

            <!-- Action Buttons: Belum vs Sudah Hafal -->
            <div class="w-full grid grid-cols-2 gap-3 mt-5">
              <button 
                type="button" 
                id="btn-fc-unmemorized" 
                class="py-3 px-4 border border-rule bg-canvas hover:border-red-500 hover:text-red-500 text-steel font-mono text-[13px] font-bold text-center transition-colors inline-flex items-center justify-center gap-1.5"
              >
                <RotateCcw class="size-3.5 inline" /> Belum Hafal
              </button>
              <button 
                type="button" 
                id="btn-fc-memorized" 
                class="py-3 px-4 border border-ok bg-ok/10 hover:bg-ok text-ok hover:text-canvas font-mono text-[13px] font-bold text-center transition-colors shadow-sm inline-flex items-center justify-center gap-1.5"
              >
                <Check class="size-3.5 inline" /> Sudah Hafal!
              </button>
            </div>

            <!-- Navigation Controls -->
            <div class="w-full flex items-center justify-between gap-2 mt-5 pt-4 border-t border-rule text-xs font-mono">
              <button type="button" id="btn-fc-prev" class="px-3 py-1.5 border border-rule hover:border-ink text-steel hover:text-ink">
                ← Sebelumnya
              </button>
              <button type="button" id="btn-fc-random" class="px-3 py-1.5 border border-rule hover:border-ink text-steel hover:text-ink inline-flex items-center gap-1">
                <Shuffle class="size-3 inline text-steel" /> Acak Huruf
              </button>
              <button type="button" id="btn-fc-next" class="px-3 py-1.5 border border-rule hover:border-ink text-steel hover:text-ink">
                Selanjutnya →
              </button>
            </div>
          </div>

          <!-- 2B. Kuis Pilihan Ganda -->
          <div id="fc-quiz-subview" class="hidden max-w-md mx-auto flex flex-col items-center">
            <!-- Mode Arah Kuis & Skor -->
            <div class="w-full flex items-center justify-between gap-2 text-xs font-mono mb-3 flex-wrap">
              <div class="flex items-center gap-1">
                <button type="button" id="btn-quiz-dir-char" class="px-2.5 py-1 text-[11px] border-2 border-cta bg-cta/10 text-ink font-bold shadow-xs cursor-pointer">
                  Aksara → Bacaan
                </button>
                <button type="button" id="btn-quiz-dir-romaji" class="px-2.5 py-1 text-[11px] border border-rule bg-canvas text-steel hover:text-ink cursor-pointer">
                  Bacaan → Aksara
                </button>
              </div>
              <span id="quiz-score-badge" class="text-ink font-bold shrink-0">Skor: 0</span>
            </div>

            <div class="w-full p-8 border-2 border-ink bg-canvas flex flex-col items-center justify-center text-center shadow-md">
              <span id="quiz-question-prompt" class="text-xs text-smoke font-mono mb-2 uppercase tracking-wider">Bagaimana cara membaca aksara ini?</span>
              <span id="quiz-question-char" class="text-[72px] font-bold text-ink leading-none">あ</span>
            </div>

            <div id="quiz-feedback" class="h-6 mt-3 text-xs font-mono font-bold text-center"></div>

            <!-- 4 Multiple Choice Options -->
            <div id="quiz-options-grid" class="w-full grid grid-cols-2 gap-3 mt-3">
              <!-- Rendered by JS -->
            </div>

            <button type="button" id="btn-quiz-next-question" class="w-full mt-4 btn btn-primary py-2.5 font-mono text-xs justify-center hidden">
              Soal Berikutnya →
            </button>
          </div>
        </div>

        <!-- ============================================== -->
        <!-- VIEW 3: FRASA DASAR SEHARI-HARI                -->
        <!-- ============================================== -->
        <div id="phrases-container" class="hidden border border-rule bg-canvas p-5 sm:p-6 shadow-sm space-y-5">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-rule pb-4">
            <div>
              <span class="px-2.5 py-1 text-[11px] font-mono border border-rule text-smoke uppercase tracking-wider bg-tint">Survival Phrases</span>
              <h2 id="phrases-title" class="text-[22px] sm:text-[24px] font-bold text-ink tracking-tight mt-1">
                Frasa Penting Sehari-hari
              </h2>
              <p class="text-[13px] text-steel mt-0.5">
                Kosakata &amp; percakapan dasar: salam, angka, belanja, dan frasa darurat dengan tombol audio asli.
              </p>
            </div>

            <!-- Phrases Action Buttons -->
            <div class="flex items-center gap-2 flex-wrap shrink-0">
              <button 
                type="button" 
                id="btn-open-phrase-modal" 
                class="btn btn-primary btn-s font-mono text-[12px] inline-flex items-center gap-1.5"
                title="Tambah frasa baru ke koleksi bahasa ini"
              >
                <Plus class="size-3.5 inline" /> Tambah Frasa
              </button>
              <button 
                type="button" 
                id="btn-open-phrase-import" 
                class="btn btn-secondary btn-s font-mono text-[12px] inline-flex items-center gap-1.5"
                title="Impor kumpulan frasa dari file Excel atau teks"
              >
                <FileSpreadsheet class="size-3.5 inline text-steel" /> Impor Excel / CSV
              </button>
              <button 
                type="button" 
                id="btn-toggle-phrase-edit" 
