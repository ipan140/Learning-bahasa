    // Character Modal Tabs & Batch Import Logic
    function switchCharModalTab(tab: 'single' | 'batch') {
      if (tab === 'single') {
        charEditForm?.classList.remove('hidden');
        charBatchPane?.classList.add('hidden');
        tabCharSingle?.classList.add('border-b-2', 'border-ink', 'text-ink', 'font-bold');
        tabCharSingle?.classList.remove('border-transparent', 'text-smoke');
        tabCharBatch?.classList.remove('border-b-2', 'border-ink', 'text-ink', 'font-bold');
