    // Single Character Modal logic
    function openCharModal(row: number, col: number, char: string = '', romaji: string = '') {
      if (!charEditModal) return;
      if (charEditRow) charEditRow.value = String(row);
      if (charEditCol) charEditCol.value = String(col);
      if (charEditCharInput) charEditCharInput.value = char;
      if (charEditRomajiInput) charEditRomajiInput.value = romaji;
      if (charModalTitle) {
        charModalTitle.innerHTML = row === -1 
          ? '<svg class="size-4 inline mr-1.5 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg> Tambah Huruf Baru' 
          : `<svg class="size-4 inline mr-1.5 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg> Edit Huruf: ${char}`;
      }
      if (charEditDeleteBtn) {
        charEditDeleteBtn.style.display = row === -1 ? 'none' : 'block';
      }
      charEditModal.showModal();
    }

    function closeCharModal() {
      charEditModal?.close();
    }

    closeCharModalBtn?.addEventListener('click', closeCharModal);
    charEditCancelBtn?.addEventListener('click', closeCharModal);

    charEditForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const rIdx = parseInt(charEditRow?.value || '-1');
      const cIdx = parseInt(charEditCol?.value || '-1');
      const newChar = charEditCharInput?.value.trim() || '';
      const newRomaji = charEditRomajiInput?.value.trim() || '';

      if (!newChar) return;
      const table = ensureCustomTableForEditing();
      if (!table || !table.grid) return;

      if (rIdx === -1 && cIdx === -1) {
        if (table.grid.length === 0) {
          table.grid.push([{ char: newChar, romaji: newRomaji }]);
        } else {
          const lastRow = table.grid[table.grid.length - 1];
          if (lastRow.length < 5) {
            lastRow.push({ char: newChar, romaji: newRomaji });
          } else {
            table.grid.push([{ char: newChar, romaji: newRomaji }]);
          }
        }
        showToast(`✓ Huruf "${newChar}" berhasil ditambahkan!`);
      } else {
        if (table.grid[rIdx] && table.grid[rIdx][cIdx] !== undefined) {
          table.grid[rIdx][cIdx] = { char: newChar, romaji: newRomaji };
          showToast(`✓ Karakter "${newChar}" berhasil diperbarui!`);
        }
      }

      saveCustomTablesToStorage();
      if (currentUser) {
        saveCustomTableToCloud(currentUser.id, table).catch(() => {});
      }
      closeCharModal();
      renderCurrentTable();
      updateProgressUI();
    });

    charEditDeleteBtn?.addEventListener('click', () => {
      const rIdx = parseInt(charEditRow?.value || '-1');
      const cIdx = parseInt(charEditCol?.value || '-1');
