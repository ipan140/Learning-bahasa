    phraseQuickExcelInput?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;

      showToast(`Membaca file "${file.name}"...`);
      const reader = new FileReader();
      reader.onload = (evt) => {
        try {
          const data = new Uint8Array(evt.target?.result as ArrayBuffer);
          const workbook = (window as any).XLSX.read(data, { type: 'array' });
          const sheetName = workbook.SheetNames[0];
          const worksheet = workbook.Sheets[sheetName];
          const jsonRows: any[][] = (window as any).XLSX.utils.sheet_to_json(worksheet, { header: 1 });
          const validRows = jsonRows.filter(r => r && r.length > 0 && String(r[0] || '').trim().length > 0);

          if (validRows.length === 0) {
            showToast('File spreadsheet kosong atau format tidak sesuai.');
            return;
          }

          const firstStr = String(validRows[0][0] || '').toLowerCase();
          const isHeader = ['aksara', 'native', 'frasa', 'teks', 'karakter', 'kata'].some(h => firstStr.includes(h));
          const dataRows = isHeader ? validRows.slice(1) : validRows;

          if (dataRows.length <= 1) {
            const row = dataRows[0] || validRows[0];
            if (phraseNativeInput) phraseNativeInput.value = String(row[0] || '').trim();
            if (phraseTranslitInput) phraseTranslitInput.value = String(row[1] || '').trim();
            if (phraseMeaningInput) phraseMeaningInput.value = String(row[2] || row[1] || '').trim();
            showToast(`✓ Formulir berhasil diisi dari Excel: "${row[0]}"`);
          } else {
            closePhraseModal();
            openPhraseImportModal();
            const lines: string[] = [];
            for (const r of dataRows) {
              if (r.length >= 3) {
                lines.push(`${r[0]} = ${r[1]} = ${r[2]}`);
              } else if (r.length === 2) {
                lines.push(`${r[0]} = ${r[1]}`);
              }
            }
            if (phraseImportText) {
              phraseImportText.value = lines.join('\n');
              updatePhraseImportPreview();
            }
            showToast(`✓ Terdeteksi ${lines.length} baris frasa! Siap diimpor massal.`);
          }
        } catch {
          showToast('Gagal memproses file spreadsheet frasa.');
        }
      };
      reader.readAsArrayBuffer(file);
      (e.target as HTMLInputElement).value = '';
    });

