                >
                  <svg class="size-4 ${isTargeted ? 'fill-badge text-badge' : 'text-smoke'}" viewBox="0 0 24 24" fill="${isTargeted ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
