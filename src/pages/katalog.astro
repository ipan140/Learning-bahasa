                <div class="flex items-baseline justify-between gap-2">
                  <span class="text-smoke">Kawasan:</span>
                  <span class="text-steel text-right truncate">${c.region} ${c.subregion ? '(' + c.subregion + ')' : ''}</span>
                </div>
                <div class="flex items-baseline justify-between gap-2">
                  <span class="text-smoke">Ibukota:</span>
                  <span class="text-steel text-right truncate">${c.capital || '-'}</span>
                </div>
                <div class="flex items-baseline justify-between gap-2">
                  <span class="text-smoke">Bahasa:</span>
                  <span class="text-ink font-semibold text-right truncate">${c.language}</span>
                </div>
              </div>

              ${isTargeted ? `
                <div class="mt-3 pt-2.5 border-t border-dashed border-rule">
                  <div class="flex items-center justify-between text-[11px] font-mono">
                    <span class="text-smoke">Catatan:</span>
                    <button 
                      type="button" 
                      data-edit-note="${c.id}" 
                      class="text-cta hover:underline font-bold cursor-pointer inline-flex items-center"
                    >
                      ${userNotesMap[c.id] 
                        ? '<svg class="size-3 inline mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>Edit Catatan' 
                        : '<svg class="size-3 inline mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>Tambah Catatan'}
                    </button>
                  </div>
                  ${userNotesMap[c.id] ? `
                    <div class="mt-1.5 p-2 bg-smoke/5 border-l-2 border-cta text-[11px] text-steel font-mono italic">
                      "${userNotesMap[c.id]}"
                    </div>
                  ` : ''}
                </div>
              ` : ''}
            </div>

            <div class="mt-4 pt-3 border-t border-rule">
              ${hasTable ? `
                <div class="grid grid-cols-2 gap-2">
                  <a 
                    href="/belajar?lang=${c.tableId}"
                    class="btn btn-primary btn-s text-[11px] justify-center text-center font-mono truncate inline-flex items-center"
                    title="Buka tabel aksara"
                  >
                    <svg class="size-3 inline mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 2v20"/></svg> Tabel
                  </a>
                  <a 
                    href="/belajar?lang=${c.tableId}&mode=phrases"
                    class="btn btn-secondary btn-s text-[11px] justify-center text-center font-mono truncate inline-flex items-center"
                    title="Pelajari frasa percakapan penting sehari-hari"
                  >
                    <svg class="size-3 inline mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg> Frasa
                  </a>
                </div>
              ` : `
                <a 
                  href="/belajar?unadded=${encodeURIComponent(c.name)}&country=${encodeURIComponent(c.name)}&language=${encodeURIComponent(c.language)}&flag=${encodeURIComponent(c.flag || '')}&voice=${encodeURIComponent(c.voiceLang || 'en-US')}"
                  class="btn btn-secondary btn-s text-[12px] w-full justify-center text-center font-mono text-smoke hover:text-ink inline-flex items-center gap-1.5"
                >
                  <svg class="size-3.5 inline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg> Belum Ditambahkan (+ Buat)
                </a>
              `}
            </div>
          </div>
        `;
      }).join('');

      // Attach Star Target toggle listeners
      countriesGrid.querySelectorAll('[data-toggle-target]').forEach(btn => {
        btn.addEventListener('click', async () => {
          const cid = btn.getAttribute('data-toggle-target');
          if (!cid) return;
          const country = allCountries.find(c => c.id === cid || c.code.toLowerCase() === cid.toLowerCase());
          const targetId = country ? country.id : cid;
          const isAdded = !isCountryTargeted(country || { id: targetId });

          if (isAdded) {
            targetCountryIds.push(targetId);
            targetCountryIds = Array.from(new Set(targetCountryIds));
            showToast(`⭐ ${country ? country.name : 'Negara'} ditambahkan ke target belajar Anda!`);
          } else {
            targetCountryIds = targetCountryIds.filter(id => {
              const val = String(id).trim().toLowerCase();
              return val !== targetId.toLowerCase() && (country ? val !== country.code.toLowerCase() : true);
            });
            showToast('Negara dihapus dari target.');
          }

          saveTargetsToStorage();
          renderCountries();

          // Cloud sync jika user login
          if (currentUser) {
            try {
              if (isAdded) {
                await addTargetToCloud(currentUser.id, targetId);
              } else {
                await removeTargetFromCloud(currentUser.id, targetId);
              }
            } catch (err) {
              console.warn('Gagal sinkron target ke Supabase:', err);
            }
          }
        });
      });

      // Attach Note edit listeners
      countriesGrid.querySelectorAll('[data-edit-note]').forEach(btn => {
        btn.addEventListener('click', () => {
          const cid = btn.getAttribute('data-edit-note');
          if (!cid) return;
          const country = allCountries.find(c => c.id === cid);
          activeEditingCountryId = cid;
          if (noteModalTitle) noteModalTitle.innerHTML = `<svg class="size-4 inline mr-1.5 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg> Catatan: ${country ? country.flag + ' ' + country.name : 'Target Belajar'}`;
          if (inputTargetNote) inputTargetNote.value = userNotesMap[cid] || '';
          noteModal?.showModal();
        });
      });
    }

    // Modal Note Handlers
    closeNoteModalBtn?.addEventListener('click', () => noteModal?.close());
    btnCancelNote?.addEventListener('click', () => noteModal?.close());

    btnSaveNote?.addEventListener('click', async () => {
      if (!activeEditingCountryId) return;
      const noteText = inputTargetNote?.value.trim() || '';
      
      if (noteText) {
        userNotesMap[activeEditingCountryId] = noteText;
        showToast('✓ Catatan target berhasil disimpan!');
      } else {
        delete userNotesMap[activeEditingCountryId];
        showToast('Catatan dihapus.');
      }

      localStorage.setItem('user_target_notes', JSON.stringify(userNotesMap));
      noteModal?.close();
      renderCountries();

      // Cloud sync jika user login
      if (currentUser) {
        try {
          await saveTargetNoteToCloud(currentUser.id, activeEditingCountryId, noteText);
        } catch (err) {
          console.warn('Gagal simpan catatan ke cloud:', err);
        }
      }
    });

    // Filter Buttons Handlers
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        if (!filter) return;
        countryFilter = filter;
        countryDisplayLimit = 36;

        filterButtons.forEach(b => {
          b.className = 'px-3.5 py-1.5 font-mono border border-rule bg-canvas text-steel hover:text-ink hover:border-ink hover:bg-tint/40 cursor-pointer';
        });
        btn.className = 'px-3.5 py-1.5 font-mono border-2 border-cta bg-cta/10 text-ink font-bold shadow-xs cursor-pointer';

        renderCountries();
      });
    });

    // Search Handler (debounced for smooth 250-country filtering)
    let countrySearchDebounceTimer: any = null;
    searchInput?.addEventListener('input', (e) => {
      clearTimeout(countrySearchDebounceTimer);
      countrySearchDebounceTimer = setTimeout(() => {
        countrySearchQuery = (e.target as HTMLInputElement).value;
        countryDisplayLimit = 36;
        renderCountries();
      }, 120);
    });

    // Clear Search Button
    btnClearSearch?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      countrySearchQuery = '';
      countryDisplayLimit = 36;
      renderCountries();
      searchInput?.focus();
    });

    // Quick Search Tags
    quickTags.forEach(btn => {
      btn.addEventListener('click', () => {
        const tag = btn.getAttribute('data-tag') || '';
        if (searchInput) searchInput.value = tag;
        countrySearchQuery = tag;
        countryDisplayLimit = 36;
        renderCountries();
      });
    });

    // Alphabet A-Z Bar Handler
    letterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const letter = btn.getAttribute('data-letter') || 'all';
        selectedLetter = letter;
        countryDisplayLimit = 36;

        letterButtons.forEach(b => {
          b.className = 'letter-btn px-1.5 py-0.5 border border-rule bg-canvas text-steel hover:text-ink hover:border-ink cursor-pointer text-[11px]';
        });
        btn.className = 'letter-btn active px-2 py-0.5 border border-ink bg-ink text-canvas font-bold cursor-pointer text-[11px]';

        renderCountries();
      });
    });

    // Sort Handler
    sortSelect?.addEventListener('change', (e) => {
      countrySortMode = (e.target as HTMLSelectElement).value;
      renderCountries();
    });

    // Load More Handler
    loadMoreBtn?.addEventListener('click', () => {
      countryDisplayLimit += 36;
      renderCountries();
    });

    // Load All Handler
    btnLoadAll?.addEventListener('click', () => {
      countryDisplayLimit = allCountries.length + 50;
      renderCountries();
    });

    // Export Excel
    document.getElementById('btn-export-excel')?.addEventListener('click', () => {
      const XLSX = (window as any).XLSX;
      if (!XLSX) {
        showToast('Library spreadsheet sedang dimuat...');
        return;
      }

      showToast('Membuat file Excel...');
      const wb = XLSX.utils.book_new();

      // Sheet 1: Target Belajar Saya
      const targetCountriesList = allCountries.filter(c => isCountryTargeted(c));
      const targetRows = targetCountriesList.map((c, idx) => ({
        'No': idx + 1,
        'Kode': c.code,
        'Nama Negara': c.name,
        'Nama Asli': c.nativeName || c.name,
        'Bendera': c.flag || '',
        'Kawasan': c.region,
        'Subwilayah': c.subregion || '',
        'Bahasa Resmi': c.language,
        'Ibukota': c.capital || '-',
        'Catatan Target': userNotesMap[c.id] || '',
        'Tabel Aksara': c.tableId ? 'Tersedia' : 'Belum Ditambahkan'
      }));

      const wsTargets = XLSX.utils.json_to_sheet(targetRows.length > 0 ? targetRows : [
        { 'Info': 'Belum ada negara yang ditandai sebagai target belajar. Klik bintang pada kartu negara.' }
      ]);
      XLSX.utils.book_append_sheet(wb, wsTargets, 'Target Belajar Saya');

      // Sheet 2: Seluruh 250 Negara
      const allRows = allCountries.map((c, idx) => ({
        'No': idx + 1,
        'Kode': c.code,
        'Nama Negara': c.name,
        'Nama Asli': c.nativeName || c.name,
        'Bendera': c.flag || '',
        'Kawasan': c.region,
        'Subwilayah': c.subregion || '',
        'Bahasa Resmi': c.language,
        'Ibukota': c.capital || '-',
        'Target Belajar': isCountryTargeted(c) ? 'YA' : 'TIDAK',
        'Catatan': userNotesMap[c.id] || ''
      }));
      const wsAll = XLSX.utils.json_to_sheet(allRows);
      XLSX.utils.book_append_sheet(wb, wsAll, '250 Negara di Dunia');

      const dateStr = new Date().toISOString().split('T')[0];
      XLSX.writeFile(wb, `target-belajar-bahasa-${dateStr}.xlsx`);
      showToast('✓ File Excel target belajar berhasil diunduh!');
    });

    // Import Excel
    const inputImportExcel = document.getElementById('input-import-excel') as HTMLInputElement | null;
    inputImportExcel?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;

      const XLSX = (window as any).XLSX;
      if (!XLSX) {
        showToast('Library spreadsheet sedang dimuat...');
        return;
      }

      showToast(`Membaca file "${file.name}"...`);
      const reader = new FileReader();

      reader.onload = async (evt) => {
        try {
          const data = new Uint8Array(evt.target?.result as ArrayBuffer);
          const workbook = XLSX.read(data, { type: 'array' });
          const firstSheetName = workbook.SheetNames[0];
          const worksheet = workbook.Sheets[firstSheetName];
          const jsonRows: any[][] = XLSX.utils.sheet_to_json(worksheet, { header: 1 });

          if (!jsonRows || jsonRows.length === 0) {
            showToast('File spreadsheet kosong.');
            return;
          }

          let importedCount = 0;
          const newTargetSet = new Set<string>(targetCountryIds);

          const header = jsonRows[0].map((h: any) => String(h || '').trim().toLowerCase());
          const codeIdx = header.findIndex((h: string) => h.includes('kode') || h === 'code' || h === 'id' || h === 'iso');
          const nameIdx = header.findIndex((h: string) => h.includes('negara') || h.includes('country') || h === 'name');
          const noteIdx = header.findIndex((h: string) => h.includes('catatan') || h.includes('note') || h.includes('target'));

          const startRow = (codeIdx >= 0 || nameIdx >= 0) ? 1 : 0;

          for (let i = startRow; i < jsonRows.length; i++) {
            const row = jsonRows[i];
            if (!row || row.length === 0) continue;

            let resolvedCid: string | null = null;
            if (codeIdx >= 0 && row[codeIdx]) {
              resolvedCid = resolveCanonicalCountryId(row[codeIdx]);
            }
            if (!resolvedCid && nameIdx >= 0 && row[nameIdx]) {
              resolvedCid = resolveCanonicalCountryId(row[nameIdx]);
            }
            if (!resolvedCid) {
              for (const cell of row) {
                if (cell && typeof cell === 'string') {
                  const testCid = resolveCanonicalCountryId(cell);
                  if (testCid) {
                    resolvedCid = testCid;
                    break;
                  }
                }
              }
            }

            if (resolvedCid) {
              if (!newTargetSet.has(resolvedCid)) {
                newTargetSet.add(resolvedCid);
                importedCount++;
              }
              if (noteIdx >= 0 && row[noteIdx]) {
                const noteVal = String(row[noteIdx]).trim();
                if (noteVal && noteVal.toUpperCase() !== 'YA' && noteVal.toUpperCase() !== 'TIDAK') {
                  userNotesMap[resolvedCid] = noteVal;
                }
              }
            }
          }

          targetCountryIds = Array.from(newTargetSet);
          saveTargetsToStorage();
          localStorage.setItem('user_target_notes', JSON.stringify(userNotesMap));
          renderCountries();

          if (currentUser) {
            try {
              await batchSyncTargetsToCloud(currentUser.id, targetCountryIds);
            } catch (err) {
              console.warn('Sync imported targets error:', err);
            }
          }

          showToast(`✓ Berhasil mengimpor ${importedCount} negara target dari Excel!`);
        } catch (err) {
          console.error(err);
          showToast('Gagal memproses file Excel.');
        }
      };

      reader.readAsArrayBuffer(file);
      (e.target as HTMLInputElement).value = '';
    });

    // Backup JSON
    document.getElementById('btn-export-backup')?.addEventListener('click', () => {
      const backupData = {
        app: 'belajar-bahasa',
        exportedAt: new Date().toISOString(),
        targetCountries: targetCountryIds,
        notes: userNotesMap,
        customTables: JSON.parse(localStorage.getItem('custom_character_tables') || '[]')
      };
      const blob = new Blob([JSON.stringify(backupData, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `belajar-bahasa-backup-${new Date().toISOString().split('T')[0]}.json`;
      a.click();
      URL.revokeObjectURL(url);
      showToast('Cadangan data berhasil diunduh!');
    });

    // Import JSON
    document.getElementById('input-import-file')?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (evt) => {
        try {
          const parsed = JSON.parse(evt.target?.result as string);
          if (Array.isArray(parsed.targetCountries)) {
            targetCountryIds = Array.from(new Set([...targetCountryIds, ...parsed.targetCountries]));
            saveTargetsToStorage();
          }
          if (parsed.notes && typeof parsed.notes === 'object') {
            Object.assign(userNotesMap, parsed.notes);
            localStorage.setItem('user_target_notes', JSON.stringify(userNotesMap));
          }
          if (Array.isArray(parsed.customTables)) {
            const existing = JSON.parse(localStorage.getItem('custom_character_tables') || '[]');
            const existingIds = new Set(existing.map((t: any) => t.id));
            parsed.customTables.forEach((t: any) => {
              if (!existingIds.has(t.id)) existing.push(t);
            });
            localStorage.setItem('custom_character_tables', JSON.stringify(existing));
          }
          renderCountries();
          showToast('✓ Data cadangan berhasil dipulihkan!');
        } catch {
          showToast('File JSON tidak valid.');
        }
      };
      reader.readAsText(file);
    });

    // Trigger Auth Modal
    document.getElementById('btn-cloud-sync-trigger')?.addEventListener('click', () => {
      const authModal = document.getElementById('auth-modal') as HTMLDialogElement | null;
      authModal?.showModal();
    });

    // TRIVIA QUIZ LOGIC
    const triviaModal = document.getElementById('trivia-modal') as HTMLDialogElement | null;
    const btnOpenTrivia = document.getElementById('btn-open-trivia');
    const closeTriviaBtn = document.getElementById('close-trivia-btn');
    const triviaStreakLabel = document.getElementById('trivia-streak-label');
    const triviaScoreLabel = document.getElementById('trivia-score-label');
    const triviaFlagDisplay = document.getElementById('trivia-flag-display');
    const triviaCountryName = document.getElementById('trivia-country-name');
    const triviaQuestionText = document.getElementById('trivia-question-text');
    const triviaFeedback = document.getElementById('trivia-feedback');
    const triviaOptionsGrid = document.getElementById('trivia-options-grid');
    const btnNextTrivia = document.getElementById('btn-next-trivia');

    let triviaScore = 0;
    let triviaStreak = 0;
    let triviaHighScore = parseInt(localStorage.getItem('trivia_countries_high_score') || '0', 10);
    let triviaCorrectAnswer = '';

    function updateTriviaScoreDisplay() {
      if (triviaScoreLabel) {
        triviaScoreLabel.textContent = triviaHighScore > 0 
          ? `Skor: ${triviaScore} (Rekor: ${triviaHighScore})`
          : `Skor: ${triviaScore}`;
      }
    }

    btnOpenTrivia?.addEventListener('click', () => {
      triviaModal?.showModal();
      updateTriviaScoreDisplay();
      nextTriviaQuestion();
    });

    closeTriviaBtn?.addEventListener('click', () => {
      triviaModal?.close();
    });

    function nextTriviaQuestion() {
      if (allCountries.length < 4) return;
      if (btnNextTrivia) btnNextTrivia.classList.add('hidden');
      if (triviaFeedback) triviaFeedback.textContent = '';

      const questionType = Math.random() > 0.5 ? 0 : 1;
      const targetCountry = allCountries[Math.floor(Math.random() * allCountries.length)];

      if (triviaFlagDisplay) triviaFlagDisplay.textContent = targetCountry.flag;
      if (triviaCountryName) triviaCountryName.textContent = targetCountry.name;

      if (questionType === 0) {
        if (triviaQuestionText) triviaQuestionText.textContent = 'Apa bahasa resmi dari negara ini?';
        triviaCorrectAnswer = targetCountry.officialLanguage || targetCountry.language;
        
        const otherLangs = Array.from(new Set(allCountries.map(c => c.officialLanguage || c.language)))
          .filter(l => l && l !== triviaCorrectAnswer);
        const shuffledDistractors = otherLangs.sort(() => 0.5 - Math.random()).slice(0, 3);
        const options = [triviaCorrectAnswer, ...shuffledDistractors].sort(() => 0.5 - Math.random());
        renderTriviaOptions(options);
      } else {
        if (triviaQuestionText) triviaQuestionText.textContent = 'Apa ibukota dari negara ini?';
        triviaCorrectAnswer = targetCountry.capital;
        
        const otherCapitals = Array.from(new Set(allCountries.map(c => c.capital)))
          .filter(cap => cap && cap !== triviaCorrectAnswer);
        const shuffledDistractors = otherCapitals.sort(() => 0.5 - Math.random()).slice(0, 3);
        const options = [triviaCorrectAnswer, ...shuffledDistractors].sort(() => 0.5 - Math.random());
        renderTriviaOptions(options);
      }
    }

    function renderTriviaOptions(options: string[]) {
      if (!triviaOptionsGrid) return;
      triviaOptionsGrid.innerHTML = '';

      options.forEach(opt => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'py-3 px-3 border border-rule bg-canvas hover:border-ink font-mono font-medium text-[13px] text-ink transition-colors shadow-sm text-left truncate';
        btn.textContent = opt;
        btn.title = opt;

        btn.addEventListener('click', () => {
          const allBtns = triviaOptionsGrid.querySelectorAll('button');
          allBtns.forEach(b => (b.disabled = true));

          if (opt === triviaCorrectAnswer) {
            btn.classList.remove('border-rule', 'bg-canvas');
            btn.classList.add('border-ok', 'bg-ok/20', 'text-ok', 'font-bold');
            if (triviaFeedback) {
              triviaFeedback.textContent = '✓ BENAR!';
              triviaFeedback.className = 'h-6 text-xs font-mono font-bold text-center text-ok';
            }
            triviaScore += 10;
            triviaStreak += 1;
            if (triviaScore > triviaHighScore) {
              triviaHighScore = triviaScore;
              localStorage.setItem('trivia_countries_high_score', String(triviaHighScore));
              if (currentUser) {
                saveUserQuizScoreToCloud(currentUser.id, 'trivia-countries', triviaHighScore).catch(() => {});
              }
            }
          } else {
            btn.classList.remove('border-rule', 'bg-canvas');
            btn.classList.add('border-red-500', 'bg-red-500/10', 'text-red-500');
            allBtns.forEach(b => {
              if (b.textContent === triviaCorrectAnswer) {
                b.classList.remove('border-rule');
                b.classList.add('border-ok', 'bg-ok/20', 'text-ok', 'font-bold');
              }
            });
            if (triviaFeedback) {
              triviaFeedback.textContent = `SALAH! Jawaban: "${triviaCorrectAnswer}".`;
              triviaFeedback.className = 'h-6 text-xs font-mono font-bold text-center text-red-500';
            }
            triviaStreak = 0;
          }

          updateTriviaScoreDisplay();
          if (triviaStreakLabel) triviaStreakLabel.innerHTML = `<svg class="size-3.5 inline text-badge" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg> Streak: ${triviaStreak}`;
          if (btnNextTrivia) btnNextTrivia.classList.remove('hidden');
        });

        triviaOptionsGrid.appendChild(btn);
      });
    }

    btnNextTrivia?.addEventListener('click', nextTriviaQuestion);

    // Check auth on load to fetch Supabase targets & notes
    async function initUserTargets() {
      try {
        currentUser = await getCurrentUser();
        if (currentUser) {
          const cloudTargets = await fetchUserTargetsFromCloud(currentUser.id);
          const localTargets: any[] = JSON.parse(localStorage.getItem('target_countries') || '[]');

          const unifiedSet = new Set<string>();
          [...cloudTargets, ...localTargets, ...targetCountryIds].forEach(raw => {
            const cid = resolveCanonicalCountryId(raw);
            if (cid) unifiedSet.add(cid);
          });

          targetCountryIds = Array.from(unifiedSet);
          saveTargetsToStorage();

          const cloudNotes = await fetchUserTargetsWithNotesFromCloud(currentUser.id);
          if (cloudNotes && Object.keys(cloudNotes).length > 0) {
            Object.assign(userNotesMap, cloudNotes);
            localStorage.setItem('user_target_notes', JSON.stringify(userNotesMap));
          }

          renderCountries();
        }
      } catch (err) {
        console.warn('Init user targets error:', err);
      }
    }

    // Listener sync otomatis dari AuthModal
    window.addEventListener('supabase-data-loaded', (e: any) => {
      const incomingTargets = e.detail?.targets;
      if (Array.isArray(incomingTargets)) {
        const unifiedSet = new Set<string>();
        incomingTargets.forEach(raw => {
          const cid = resolveCanonicalCountryId(raw);
          if (cid) unifiedSet.add(cid);
        });
        targetCountryIds = Array.from(unifiedSet);
        saveTargetsToStorage();
        renderCountries();
      }
    });

    window.addEventListener('target-countries-updated', (e: any) => {
      const incomingTargets = e.detail?.targets;
      if (Array.isArray(incomingTargets)) {
        targetCountryIds = Array.from(new Set(incomingTargets.map(raw => resolveCanonicalCountryId(raw)).filter(Boolean) as string[]));
        renderCountries();
      }
    });

    // Sync button highlight with initial URL filter
    if (countryFilter !== 'all') {
      filterButtons.forEach(b => {
        const f = b.getAttribute('data-filter');
        if (f === countryFilter) {
          b.className = 'px-3.5 py-1.5 font-mono border border-ink bg-ink text-canvas font-bold';
        } else {
          b.className = 'px-3.5 py-1.5 font-mono border border-rule bg-canvas text-steel hover:text-ink hover:border-ink';
        }
      });
    }

    // Initial render
    renderCountries();
    initUserTargets();
  }
</script>
