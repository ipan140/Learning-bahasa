---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import { worldCountries } from '../data/countries';
import { Gamepad2, Cloud, Download, Upload, Star, Edit3, Flame, X, Search, BookOpen, FileSpreadsheet } from 'lucide-astro';
---

<Base 
  title="Katalog 250 Negara di Dunia - Belajar Bahasa" 
  description="Katalog lengkap 250 negara di dunia dengan informasi bahasa, aksara, ibukota, dan fitur target belajar mandiri yang tersinkron ke cloud."
>
  <Section top={false} inner="px-6 pt-12 pb-18 lg:pt-16 lg:pb-24 max-md:px-5">
    
    <!-- Header Section -->
    <div class="w-full">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-rule">
        <div>
          <p class="label"><b>[02]</b> katalog 250 negara &amp; target belajar</p>
          <h1 class="mt-3 text-[clamp(28px,3.8vw,46px)] leading-[1.08] font-bold tracking-[-0.035em] text-ink">
            Katalog 250 Negara di Dunia
          </h1>
          <p class="mt-3 max-w-[65ch] text-[15px] leading-[1.6] text-steel">
            Tandai target pada negara yang ingin Anda pelajari atau klik "Buka Tabel Aksara" untuk belajar langsung di ruang belajar. Seluruh target Anda tersimpan aman dan dapat disinkronkan ke cloud.
          </p>
        </div>

        <div class="flex items-center gap-2 flex-wrap shrink-0">
          <button type="button" id="btn-open-trivia" class="btn btn-primary btn-s text-[12px] font-mono flex items-center gap-1.5">
            <Gamepad2 class="size-3.5 inline" /> Kuis 250 Negara
          </button>
          <button type="button" id="btn-cloud-sync-trigger" class="btn btn-secondary btn-s text-[12px] flex items-center gap-1.5" title="Masuk untuk sinkronisasi materi ke smartphone & laptop lain">
            <Cloud class="size-3.5 inline" /> Sinkron Akun
          </button>
          <button type="button" id="btn-export-excel" class="btn btn-secondary btn-s text-[12px] flex items-center gap-1.5" title="Ekspor daftar target dan data negara ke spreadsheet Excel (.xlsx)">
            <FileSpreadsheet class="size-3.5 inline text-ok" /> Export Excel
          </button>
          <label class="btn btn-secondary btn-s text-[12px] cursor-pointer inline-flex items-center gap-1.5" title="Impor daftar target belajar dari file Excel (.xlsx / .csv)">
            <Upload class="size-3.5 inline text-ok" /> Import Excel
            <input type="file" id="input-import-excel" accept=".xlsx, .xls, .csv" class="hidden" />
          </label>
          <button type="button" id="btn-export-backup" class="btn btn-secondary btn-s text-[12px] flex items-center gap-1.5" title="Simpan file cadangan target belajar JSON">
            <Download class="size-3.5 inline" /> Backup JSON
          </button>
          <label class="btn btn-secondary btn-s text-[12px] cursor-pointer inline-flex items-center gap-1.5" title="Pulihkan cadangan dari file JSON">
            <Upload class="size-3.5 inline" /> Import JSON
            <input type="file" id="input-import-file" accept=".json" class="hidden" />
          </label>
        </div>
      </div>
    </div>

    <!-- Country Catalog App Container -->
    <div 
      id="countries-app" 
      class="mt-8 space-y-6"
      data-countries={JSON.stringify(worldCountries)}
    >
      
      <!-- Notification Toast -->
      <div id="toast" class="hidden mb-6 px-4 py-2.5 text-[13px] border border-ok text-ok bg-canvas flex items-center justify-between font-mono">
        <span id="toast-message">Berhasil disimpan!</span>
        <button type="button" id="toast-close" class="text-smoke hover:text-ink font-bold ml-4 cursor-pointer p-0.5" aria-label="Tutup"><X class="size-3.5" /></button>
      </div>

      <!-- Filter Pills & Search -->
      <div class="p-5 border border-rule bg-canvas space-y-4 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-4">
          
          <!-- Region Filter Pills -->
          <div class="flex flex-wrap items-center gap-1.5 text-[13px]" id="country-region-filters">
            <button type="button" data-filter="all" class="px-3.5 py-1.5 font-mono border-2 border-cta bg-cta/10 text-ink font-bold shadow-xs cursor-pointer">
              Semua (<span id="total-country-count">250</span>)
            </button>
            <button type="button" data-filter="targets" class="px-3.5 py-1.5 font-mono border border-rule bg-canvas text-steel hover:text-ink hover:border-ink hover:bg-tint/40 cursor-pointer inline-flex items-center gap-1.5">
              <Star class="size-3.5 fill-badge text-badge inline" /> Target Saya (<span id="filter-target-count">0</span>)
            </button>
            <button type="button" data-filter="Asia" class="px-3 py-1.5 font-mono border border-rule bg-canvas text-steel hover:text-ink hover:border-ink">Asia</button>
            <button type="button" data-filter="Eropa" class="px-3 py-1.5 font-mono border border-rule bg-canvas text-steel hover:text-ink hover:border-ink">Eropa</button>
            <button type="button" data-filter="Timur Tengah" class="px-3 py-1.5 font-mono border border-rule bg-canvas text-steel hover:text-ink hover:border-ink">Timur Tengah</button>
            <button type="button" data-filter="Amerika" class="px-3 py-1.5 font-mono border border-rule bg-canvas text-steel hover:text-ink hover:border-ink">Amerika</button>
            <button type="button" data-filter="Afrika" class="px-3 py-1.5 font-mono border border-rule bg-canvas text-steel hover:text-ink hover:border-ink">Afrika</button>
            <button type="button" data-filter="Oseania" class="px-3 py-1.5 font-mono border border-rule bg-canvas text-steel hover:text-ink hover:border-ink">Oseania</button>
          </div>

          <!-- Search & Sort Controls -->
          <div class="w-full sm:w-auto flex items-center gap-2 flex-wrap">
            <div class="relative w-full sm:w-72">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-steel pointer-events-none">
                <Search class="size-3.5 inline" />
              </span>
              <input 
                type="text" 
                id="country-search-input" 
                placeholder="Cari negara / bahasa / ibukota..." 
                class="w-full pl-8 pr-8 py-2 text-[13px] bg-tint border border-rule text-ink outline-none focus:border-ink font-mono"
              />
              <button 
                type="button" 
                id="btn-clear-country-search" 
                class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-smoke hover:text-ink cursor-pointer p-0.5" 
                title="Hapus pencarian"
              >
                <X class="size-3.5" />
              </button>
            </div>
            <select 
              id="country-sort-select" 
              class="px-2.5 py-2 text-[12px] bg-tint border border-rule text-ink outline-none focus:border-ink font-mono cursor-pointer"
              title="Urutkan daftar negara"
            >
              <option value="name-asc">Urut: Nama (A-Z)</option>
              <option value="name-desc">Urut: Nama (Z-A)</option>
              <option value="region">Urut: Kawasan Benua</option>
            </select>
          </div>
        </div>

        <!-- Quick Tags & Alphabet Jump Bar -->
        <div class="pt-3 border-t border-rule space-y-2.5">
          <!-- Popular Quick Search Tags -->
          <div class="flex items-center gap-1.5 flex-wrap text-xs font-mono">
            <span class="text-[11px] text-smoke uppercase tracking-wider shrink-0 mr-1">Cepat:</span>
            {['Indonesia', 'Jepang', 'Korea', 'Arab', 'Jerman', 'Rusia', 'Prancis', 'Spanyol', 'Inggris', 'China', 'Thailand'].map((tag) => (
              <button 
                type="button" 
                class="btn-quick-tag px-2.5 py-1 border border-rule bg-canvas text-steel hover:text-ink hover:border-ink hover:bg-tint text-[11px] cursor-pointer" 
                data-tag={tag}
              >
                {tag}
              </button>
            ))}
          </div>

          <!-- Alphabet A-Z bar -->
          <div class="flex items-center gap-1 flex-wrap text-xs font-mono" id="alphabet-filter-bar">
            <span class="text-[11px] text-smoke uppercase tracking-wider shrink-0 mr-1">Abjad:</span>
            <button 
              type="button" 
              data-letter="all" 
              class="letter-btn active px-2 py-0.5 border border-ink bg-ink text-canvas font-bold cursor-pointer text-[11px]"
            >
              Semua
            </button>
            {Array.from('ABCDEFGHIJKLMNOPQRSTUVWXYZ').map((letter) => (
              <button 
                type="button" 
                data-letter={letter} 
                class="letter-btn px-1.5 py-0.5 border border-rule bg-canvas text-steel hover:text-ink hover:border-ink cursor-pointer text-[11px]"
              >
                {letter}
              </button>
            ))}
          </div>
        </div>

        <!-- Count Status -->
        <div class="flex items-center justify-between text-[12px] text-smoke pt-2 border-t border-rule font-mono">
          <span id="country-results-info">Memuat data negara...</span>
          <span class="text-steel hidden sm:inline flex items-center gap-1">Klik icon bintang untuk menyimpan target belajar Anda</span>
        </div>
      </div>

      <!-- Countries Grid -->
      <div id="countries-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- Rendered dynamically by client script -->
      </div>

      <!-- Load More & Load All Buttons -->
      <div id="load-more-wrapper" class="hidden text-center pt-4 flex flex-wrap items-center justify-center gap-3">
        <button type="button" id="btn-load-more" class="btn btn-secondary px-6 py-2.5 text-[13px] font-mono">
          Tampilkan Lebih Banyak (+36) ↓
        </button>
        <button type="button" id="btn-load-all" class="btn btn-secondary px-5 py-2.5 text-[13px] font-mono text-steel hover:text-ink">
          Tampilkan Semua Sekaligus
        </button>
      </div>

    </div>
  </Section>

  <!-- ============================================== -->
  <!-- MODAL KUIS TRIVIA 250 NEGARA                   -->
  <!-- ============================================== -->
  <dialog id="trivia-modal" class="m-auto backdrop:bg-black/60 p-0 bg-canvas text-ink border border-rule w-[92vw] max-w-[480px] shadow-2xl">
    <div class="p-6 max-sm:p-5 flex flex-col gap-4">
      <div class="flex items-start justify-between pb-3 border-b border-rule">
        <div>
          <h2 class="text-[18px] font-bold tracking-tight text-ink flex items-center gap-2"><Gamepad2 class="size-4.5 inline text-ink" /> Kuis Trivia 250 Negara</h2>
          <p class="text-[12px] text-steel mt-0.5">Uji pengetahuan Anda tentang bahasa resmi &amp; ibukota negara di dunia.</p>
        </div>
        <button type="button" id="close-trivia-btn" class="text-xs font-mono p-1 border border-rule hover:bg-smoke/10 text-smoke hover:text-ink shrink-0 ml-3 cursor-pointer" aria-label="Tutup">
          <X class="size-3.5" />
        </button>
      </div>

      <div class="flex items-center justify-between text-xs font-mono text-smoke">
        <span id="trivia-streak-label" class="flex items-center gap-1 text-badge font-bold"><Flame class="size-3.5 inline text-badge" /> Streak: 0</span>
        <span id="trivia-score-label" class="font-bold text-ink">Skor: 0</span>
      </div>

      <div class="p-6 border-2 border-ink bg-canvas flex flex-col items-center justify-center text-center shadow-sm">
        <div id="trivia-flag-display" class="text-[54px] leading-none mb-2">🇯🇵</div>
        <div id="trivia-country-name" class="text-[20px] font-bold text-ink mb-1">Jepang</div>
        <p id="trivia-question-text" class="text-xs text-steel font-mono">Apa bahasa resmi dari negara ini?</p>
      </div>

      <div id="trivia-feedback" class="h-6 text-xs font-mono font-bold text-center"></div>

      <div id="trivia-options-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        <!-- Rendered by client script -->
      </div>

      <div class="pt-3 border-t border-rule flex justify-end">
        <button type="button" id="btn-next-trivia" class="btn btn-primary btn-s w-full justify-center hidden font-mono text-xs">
          Soal Selanjutnya →
        </button>
      </div>
    </div>
  </dialog>


  <!-- ============================================== -->
  <!-- MODAL CATATAN TARGET PRIBADI                   -->
  <!-- ============================================== -->
  <dialog id="target-note-modal" class="m-auto backdrop:bg-black/60 p-0 bg-canvas text-ink border border-rule w-[92vw] max-w-[440px] shadow-2xl">
    <div class="p-6 max-sm:p-5 flex flex-col gap-4">
      <div class="flex items-start justify-between pb-3 border-b border-rule">
        <div>
          <h2 class="text-[17px] font-bold tracking-tight text-ink flex items-center gap-1.5" id="note-modal-title"><Edit3 class="size-4 inline text-ink" /> Catatan Target Belajar</h2>
          <p class="text-[12px] text-steel mt-0.5" id="note-modal-subtitle">Tulis target, rencana, atau motivasi belajar Anda.</p>
        </div>
        <button type="button" id="close-note-modal-btn" class="text-xs font-mono p-1 border border-rule hover:bg-smoke/10 text-smoke hover:text-ink shrink-0 ml-3 cursor-pointer" aria-label="Tutup">
          <X class="size-3.5" />
        </button>
      </div>

      <div>
        <label for="input-target-note" class="block text-[11px] font-mono text-smoke uppercase tracking-wider mb-1.5">
          Catatan Pribadi (Tersinkron ke Cloud)
        </label>
        <textarea 
          id="input-target-note" 
          rows="4" 
          placeholder="Misal: Target hafalan 50 kosakata sebelum akhir tahun, persiapan liburan, dll..." 
          class="w-full px-3.5 py-2.5 text-[13px] bg-canvas border border-rule focus:border-ink focus:outline-none text-ink font-mono"
        ></textarea>
      </div>

      <div class="flex items-center justify-end gap-2.5 pt-3 border-t border-rule">
        <button type="button" id="btn-cancel-note" class="btn btn-secondary btn-s font-mono text-xs">
          Batal
        </button>
        <button type="button" id="btn-save-note" class="btn btn-primary btn-s font-mono text-xs">
          Simpan Catatan
        </button>
      </div>
    </div>
  </dialog>

</Base>

<!-- Load SheetJS for Excel Reading & Writing -->
<script is:inline src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<script>
  import {
    getCurrentUser,
    fetchUserTargetsFromCloud,
    addTargetToCloud,
    removeTargetFromCloud,
    saveTargetNoteToCloud,
    fetchUserTargetsWithNotesFromCloud,
    saveUserQuizScoreToCloud,
    batchSyncTargetsToCloud
  } from '../lib/supabase';

  const container = document.getElementById('countries-app');
  if (container) {
    const rawCountries = container.getAttribute('data-countries');
    const allCountries: any[] = rawCountries ? JSON.parse(rawCountries) : [];

    function resolveCanonicalCountryId(raw: any): string | null {
      if (!raw) return null;
      const str = String(raw).trim().toLowerCase();
      const found = allCountries.find(c => 
        c.id.toLowerCase() === str || 
        c.code.toLowerCase() === str || 
        c.name.toLowerCase() === str || 
        (c.nativeName && c.nativeName.toLowerCase() === str)
      );
      if (found) return found.id;

      const aliases: Record<string, string> = {
        'jerman': 'de',
        'jepang': 'jp',
        'korea': 'kr',
        'korea selatan': 'kr',
        'south korea': 'kr',
        'arab': 'sa',
        'arab saudi': 'sa',
        'saudi arabia': 'sa',
        'rusia': 'ru',
        'russia': 'ru',
        'prancis': 'fr',
        'france': 'fr',
        'spanyol': 'es',
        'spain': 'es',
        'inggris': 'gb',
        'united kingdom': 'gb',
        'china': 'cn',
        'tiongkok': 'cn',
        'belanda': 'nl',
        'netherlands': 'nl',
        'italia': 'it',
        'italy': 'it',
        'turki': 'tr',
        'turkey': 'tr',
        'mesir': 'eg',
        'egypt': 'eg',
        'yunani': 'gr',
        'greece': 'gr'
      };
      return aliases[str] || null;
    }

    // Local Storage target countries (Default kosong [], dinamis)
    let rawTargetIds: any[] = JSON.parse(localStorage.getItem('target_countries') || '[]');
    let targetCountryIds: string[] = Array.from(new Set(
      rawTargetIds.map(id => resolveCanonicalCountryId(id)).filter(Boolean) as string[]
    ));

    let userNotesMap: Record<string, string> = JSON.parse(localStorage.getItem('user_target_notes') || '{}');
    let activeEditingCountryId = '';

    const noteModal = document.getElementById('target-note-modal') as HTMLDialogElement | null;
    const noteModalTitle = document.getElementById('note-modal-title');
    const inputTargetNote = document.getElementById('input-target-note') as HTMLTextAreaElement | null;
    const btnSaveNote = document.getElementById('btn-save-note');
    const btnCancelNote = document.getElementById('btn-cancel-note');
    const closeNoteModalBtn = document.getElementById('close-note-modal-btn');

    // Baca parameter URL
    const urlParams = new URLSearchParams(window.location.search);
    const initialRegion = urlParams.get('region');
    const initialFilter = urlParams.get('filter');

    let countryFilter = 'all';
    if (initialFilter === 'targets') {
      countryFilter = 'targets';
    } else if (initialRegion) {
      countryFilter = initialRegion;
    }

    let countrySearchQuery = '';
    let countryDisplayLimit = 36;
    let countrySortMode = 'name-asc';
    let selectedLetter = 'all';
    let currentUser: any = null;

    const countriesGrid = document.getElementById('countries-grid');
    const searchInput = document.getElementById('country-search-input') as HTMLInputElement | null;
    const btnClearSearch = document.getElementById('btn-clear-country-search');
    const sortSelect = document.getElementById('country-sort-select') as HTMLSelectElement | null;
    const filterButtons = document.querySelectorAll('#country-region-filters button');
    const letterButtons = document.querySelectorAll('#alphabet-filter-bar button');
    const quickTags = document.querySelectorAll('.btn-quick-tag');
    const resultsInfo = document.getElementById('country-results-info');
    const loadMoreWrapper = document.getElementById('load-more-wrapper');
    const loadMoreBtn = document.getElementById('btn-load-more');
    const btnLoadAll = document.getElementById('btn-load-all');
    const targetCountSpan = document.getElementById('filter-target-count');
    const totalCountSpan = document.getElementById('total-country-count');
    const hasTableCountSpan = document.getElementById('has-table-count');
    const toast = document.getElementById('toast');
    const toastMessage = document.getElementById('toast-message');
    const toastClose = document.getElementById('toast-close');

    function showToast(msg: string) {
      if (!toast || !toastMessage) return;
      toastMessage.textContent = msg;
      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 4000);
    }
    toastClose?.addEventListener('click', () => toast?.classList.add('hidden'));

    function isCountryTargeted(c: any): boolean {
      if (!c) return false;
      const cid = (c.id || '').toLowerCase();
      return targetCountryIds.some(t => {
        const val = resolveCanonicalCountryId(t);
        return val === cid;
      });
    }

    function saveTargetsToStorage() {
      localStorage.setItem('target_countries', JSON.stringify(targetCountryIds));
      updateBadges();
      window.dispatchEvent(new CustomEvent('target-countries-updated', { detail: { targets: targetCountryIds } }));
    }

    function updateBadges() {
      const count = allCountries.filter(c => isCountryTargeted(c)).length;
      if (targetCountSpan) targetCountSpan.textContent = String(count);
      if (totalCountSpan) totalCountSpan.textContent = String(allCountries.length);
      const hasTableCount = allCountries.filter(c => Boolean(c.tableId)).length;
      if (hasTableCountSpan) hasTableCountSpan.textContent = String(hasTableCount);
    }

    function renderCountries() {
      if (!countriesGrid) return;
      updateBadges();

      if (btnClearSearch) {
        btnClearSearch.classList.toggle('hidden', !countrySearchQuery);
      }

      const query = countrySearchQuery.trim().toLowerCase();

      const filtered = allCountries.filter(c => {
        let matchesFilter = true;
        if (countryFilter === 'targets') {
          matchesFilter = isCountryTargeted(c);
        } else if (countryFilter === 'has-table') {
          matchesFilter = Boolean(c.tableId);
        } else if (countryFilter !== 'all') {
          matchesFilter = c.region === countryFilter || (c.subregion && c.subregion.includes(countryFilter));
        }

        let matchesLetter = true;
        if (selectedLetter !== 'all') {
          matchesLetter = (c.name || '').toUpperCase().startsWith(selectedLetter);
        }

        const matchesQuery = !query || 
          c.name.toLowerCase().includes(query) ||
          c.nativeName.toLowerCase().includes(query) ||
          c.language.toLowerCase().includes(query) ||
          (c.capital && c.capital.toLowerCase().includes(query)) ||
          c.code.toLowerCase().includes(query);

        return matchesFilter && matchesLetter && matchesQuery;
      });

      filtered.sort((a, b) => {
        if (countrySortMode === 'name-desc') {
          return b.name.localeCompare(a.name);
        } else if (countrySortMode === 'region') {
          return a.region.localeCompare(b.region) || a.name.localeCompare(b.name);
        }
        return a.name.localeCompare(b.name);
      });

      if (resultsInfo) {
        const filterLabel = countryFilter === 'all' ? 'semua wilayah' : countryFilter === 'targets' ? 'target saya' : countryFilter;
        resultsInfo.textContent = `Menampilkan ${Math.min(filtered.length, countryDisplayLimit)} dari ${filtered.length} negara (${filterLabel})`;
      }

      const visible = filtered.slice(0, countryDisplayLimit);

      if (loadMoreWrapper) {
        if (filtered.length > countryDisplayLimit) {
          loadMoreWrapper.classList.remove('hidden');
        } else {
          loadMoreWrapper.classList.add('hidden');
        }
      }

      if (visible.length === 0) {
        if (countryFilter === 'targets') {
          countriesGrid.innerHTML = `
            <div class="col-span-full p-10 border border-dashed border-rule text-center bg-tint text-steel select-none font-mono">
              <div class="mb-2 leading-none flex items-center justify-center">
                <svg class="size-10 text-badge fill-badge" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </div>
              <p class="font-bold text-[18px] text-ink">Belum Ada Target Belajar</p>
              <p class="text-[13px] mt-2 text-smoke max-w-[48ch] mx-auto font-sans leading-relaxed">
                Anda belum menandai negara target belajar. Klik icon bintang pada kartu negara mana saja untuk menjadikannya target belajar Anda!
              </p>
              <button type="button" id="btn-empty-see-all" class="mt-5 btn btn-primary btn-s font-mono text-xs">
                ← Jelajahi Semua 250 Negara
              </button>
            </div>
          `;
          document.getElementById('btn-empty-see-all')?.addEventListener('click', () => {
            const allBtn = document.querySelector<HTMLButtonElement>('#country-region-filters button[data-filter="all"]');
            allBtn?.click();
          });
          return;
        }

        countriesGrid.innerHTML = `
          <div class="col-span-full p-8 border border-dashed border-rule text-center bg-tint text-steel font-mono">
            <p class="font-bold text-[16px] text-ink">Tidak ada negara yang sesuai pencarian / filter.</p>
            <p class="text-[13px] mt-1 text-smoke">Coba kata kunci lain atau pilih tab "Semua (${allCountries.length})".</p>
          </div>
        `;
        return;
      }

      countriesGrid.innerHTML = visible.map(c => {
        const isTargeted = isCountryTargeted(c);
        const hasTable = Boolean(c.tableId);

        return `
          <div class="border border-rule bg-canvas p-4 sm:p-5 flex flex-col justify-between hover:border-ink transition-colors group">
            <div>
              <div class="flex items-start justify-between gap-2 border-b border-rule pb-3">
                <div class="flex items-center gap-2.5 min-w-0">
                  <span class="text-[22px] leading-none shrink-0" aria-hidden="true">${c.flag || '🏳️'}</span>
                  <div class="min-w-0">
