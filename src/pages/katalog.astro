---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import { worldCountries } from '../data/countries';
---

<Base 
  title="Katalog 250 Negara di Dunia - Belajar Bahasa" 
  description="Katalog lengkap 250 negara di dunia dengan informasi bahasa, aksara, ibukota, dan fitur target belajar mandiri yang tersinkron ke cloud."
>
  <Section top={false} inner="px-6 pt-12 pb-18 lg:pt-16 lg:pb-24 max-md:px-5">
    
    <!-- Header Section -->
    <div class="w-full">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-rule">
        <div>
          <p class="label"><b>[02]</b> katalog 250 negara &amp; target belajar</p>
          <h1 class="mt-3 text-[clamp(28px,3.8vw,46px)] leading-[1.08] font-bold tracking-[-0.035em] text-ink">
            Katalog 250 Negara di Dunia
          </h1>
          <p class="mt-3 max-w-[65ch] text-[15px] leading-[1.6] text-steel">
            Tandai bintang ⭐ pada negara yang ingin Anda pelajari atau klik "Buka Tabel Aksara" untuk belajar langsung di ruang belajar. Seluruh target Anda tersimpan aman dan dapat disinkronkan ke cloud.
          </p>
        </div>

        <div class="flex items-center gap-2 flex-wrap shrink-0">
          <button type="button" id="btn-open-trivia" class="btn btn-primary btn-s text-[12px] font-mono">
            🎮 Kuis 250 Negara
          </button>
          <button type="button" id="btn-cloud-sync-trigger" class="btn btn-secondary btn-s text-[12px]" title="Masuk untuk sinkronisasi materi ke smartphone & laptop lain">
            ☁️ Sinkron Akun
          </button>
          <button type="button" id="btn-export-backup" class="btn btn-secondary btn-s text-[12px]" title="Simpan file cadangan target belajar">
            📥 Backup JSON
          </button>
          <label class="btn btn-secondary btn-s text-[12px] cursor-pointer" title="Pulihkan cadangan dari file JSON">
            📤 Import JSON
            <input type="file" id="input-import-file" accept=".json" class="hidden" />
          </label>
        </div>
      </div>
    </div>

    <!-- Country Catalog App Container -->
    <div 
      id="countries-app" 
      class="mt-8 space-y-6"
      data-countries={JSON.stringify(worldCountries)}
    >
      
      <!-- Notification Toast -->
      <div id="toast" class="hidden mb-6 px-4 py-2.5 text-[13px] border border-ok text-ok bg-canvas flex items-center justify-between font-mono">
        <span id="toast-message">Berhasil disimpan!</span>
        <button type="button" id="toast-close" class="text-smoke hover:text-ink font-bold ml-4">✕</button>
      </div>

      <!-- Filter Pills & Search -->
      <div class="p-5 border border-rule bg-canvas space-y-4 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-4">
          
          <!-- Region Filter Pills -->
          <div class="flex flex-wrap items-center gap-1.5 text-[13px]" id="country-region-filters">
            <button type="button" data-filter="all" class="px-3.5 py-1.5 font-mono border-2 border-cta bg-cta/10 text-ink font-bold shadow-xs cursor-pointer">
              Semua (<span id="total-country-count">250</span>)
            </button>
            <button type="button" data-filter="targets" class="px-3.5 py-1.5 font-mono border border-rule bg-canvas text-steel hover:text-ink hover:border-ink hover:bg-tint/40 cursor-pointer">
              ⭐ Target Saya (<span id="filter-target-count">0</span>)
            </button>
            <button type="button" data-filter="Asia" class="px-3 py-1.5 font-mono border border-rule bg-canvas text-steel hover:text-ink hover:border-ink">Asia</button>
            <button type="button" data-filter="Eropa" class="px-3 py-1.5 font-mono border border-rule bg-canvas text-steel hover:text-ink hover:border-ink">Eropa</button>
            <button type="button" data-filter="Timur Tengah" class="px-3 py-1.5 font-mono border border-rule bg-canvas text-steel hover:text-ink hover:border-ink">Timur Tengah</button>
            <button type="button" data-filter="Amerika" class="px-3 py-1.5 font-mono border border-rule bg-canvas text-steel hover:text-ink hover:border-ink">Amerika</button>
            <button type="button" data-filter="Afrika" class="px-3 py-1.5 font-mono border border-rule bg-canvas text-steel hover:text-ink hover:border-ink">Afrika</button>
            <button type="button" data-filter="Oseania" class="px-3 py-1.5 font-mono border border-rule bg-canvas text-steel hover:text-ink hover:border-ink">Oseania</button>
          </div>

          <!-- Search Input -->
          <div class="w-full sm:w-80">
            <input 
              type="text" 
              id="country-search-input" 
              placeholder="Cari negara / bahasa / ibukota..." 
              class="w-full px-3.5 py-2 text-[13px] bg-tint border border-rule text-ink outline-none focus:border-ink font-mono"
            />
          </div>
        </div>

        <!-- Count Status -->
        <div class="flex items-center justify-between text-[12px] text-smoke pt-2 border-t border-rule font-mono">
          <span id="country-results-info">Memuat data negara...</span>
          <span class="text-steel hidden sm:inline">Klik bintang ⭐ untuk menyimpan target belajar Anda</span>
        </div>
      </div>

      <!-- Countries Grid -->
      <div id="countries-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- Rendered dynamically by client script -->
      </div>

      <!-- Load More Button -->
      <div id="load-more-wrapper" class="hidden text-center pt-4">
        <button type="button" id="btn-load-more" class="btn btn-secondary px-8 py-2.5 text-[13px] font-mono">
          Tampilkan Lebih Banyak Negara (+36) ↓
        </button>
      </div>

    </div>
  </Section>

  <!-- ============================================== -->
  <!-- MODAL KUIS TRIVIA 250 NEGARA                   -->
  <!-- ============================================== -->
  <dialog id="trivia-modal" class="m-auto backdrop:bg-black/60 p-0 bg-canvas text-ink border border-rule w-[92vw] max-w-[480px] shadow-2xl">
    <div class="p-6 max-sm:p-5 flex flex-col gap-4">
      <div class="flex items-start justify-between pb-3 border-b border-rule">
        <div>
          <h2 class="text-[18px] font-bold tracking-tight text-ink">🎮 Kuis Trivia 250 Negara</h2>
          <p class="text-[12px] text-steel mt-0.5">Uji pengetahuan Anda tentang bahasa resmi &amp; ibukota negara di dunia.</p>
        </div>
        <button type="button" id="close-trivia-btn" class="text-xs font-mono px-2 py-1 border border-rule hover:bg-smoke/10 text-smoke hover:text-ink shrink-0 ml-3">
          [x]
        </button>
      </div>

      <div class="flex items-center justify-between text-xs font-mono text-smoke">
        <span id="trivia-streak-label">🔥 Streak: 0</span>
        <span id="trivia-score-label" class="font-bold text-ink">Skor: 0</span>
      </div>

      <div class="p-6 border-2 border-ink bg-canvas flex flex-col items-center justify-center text-center shadow-sm">
        <div id="trivia-flag-display" class="text-[54px] leading-none mb-2">🇯🇵</div>
        <div id="trivia-country-name" class="text-[20px] font-bold text-ink mb-1">Jepang</div>
        <p id="trivia-question-text" class="text-xs text-steel font-mono">Apa bahasa resmi dari negara ini?</p>
      </div>

      <div id="trivia-feedback" class="h-6 text-xs font-mono font-bold text-center"></div>

      <div id="trivia-options-grid" class="grid grid-cols-2 gap-2.5">
        <!-- Rendered by client script -->
      </div>

      <div class="pt-3 border-t border-rule flex justify-end">
        <button type="button" id="btn-next-trivia" class="btn btn-primary btn-s w-full justify-center hidden font-mono text-xs">
          Soal Selanjutnya →
        </button>
      </div>
    </div>
  </dialog>


  <!-- ============================================== -->
  <!-- MODAL CATATAN TARGET PRIBADI                   -->
  <!-- ============================================== -->
  <dialog id="target-note-modal" class="m-auto backdrop:bg-black/60 p-0 bg-canvas text-ink border border-rule w-[92vw] max-w-[440px] shadow-2xl">
    <div class="p-6 max-sm:p-5 flex flex-col gap-4">
      <div class="flex items-start justify-between pb-3 border-b border-rule">
        <div>
          <h2 class="text-[17px] font-bold tracking-tight text-ink" id="note-modal-title">✏️ Catatan Target Belajar</h2>
          <p class="text-[12px] text-steel mt-0.5" id="note-modal-subtitle">Tulis target, rencana, atau motivasi belajar Anda.</p>
        </div>
        <button type="button" id="close-note-modal-btn" class="text-xs font-mono px-2 py-1 border border-rule hover:bg-smoke/10 text-smoke hover:text-ink shrink-0 ml-3">
          [x]
        </button>
      </div>

      <div>
        <label for="input-target-note" class="block text-[11px] font-mono text-smoke uppercase tracking-wider mb-1.5">
          Catatan Pribadi (Tersinkron ke Cloud)
        </label>
        <textarea 
          id="input-target-note" 
          rows="4" 
          placeholder="Misal: Target hafalan 50 kosakata sebelum akhir tahun, persiapan liburan, dll..." 
          class="w-full px-3.5 py-2.5 text-[13px] bg-canvas border border-rule focus:border-ink focus:outline-none text-ink font-mono"
        ></textarea>
      </div>

      <div class="flex items-center justify-end gap-2.5 pt-3 border-t border-rule">
        <button type="button" id="btn-cancel-note" class="btn btn-secondary btn-s font-mono text-xs">
          Batal
        </button>
        <button type="button" id="btn-save-note" class="btn btn-primary btn-s font-mono text-xs">
          Simpan Catatan
        </button>
      </div>
    </div>
  </dialog>

</Base>

<script>
  import {
    getCurrentUser,
    fetchUserTargetsFromCloud,
    addTargetToCloud,
    removeTargetFromCloud,
    saveTargetNoteToCloud,
    fetchUserTargetsWithNotesFromCloud
  } from '../lib/supabase';

  const container = document.getElementById('countries-app');
  if (container) {
    const rawCountries = container.getAttribute('data-countries');
    const allCountries: any[] = rawCountries ? JSON.parse(rawCountries) : [];

    // Local Storage target countries (Default kosong [], dinamis)
    let rawTargetIds: any[] = JSON.parse(localStorage.getItem('target_countries') || '[]');
    let targetCountryIds: string[] = rawTargetIds
      .map(id => {
        const found = allCountries.find(c => c.id.toLowerCase() === String(id).toLowerCase() || c.code.toUpperCase() === String(id).toUpperCase());
        return found ? found.id : null;
      })
      .filter(Boolean) as string[];
    targetCountryIds = Array.from(new Set(targetCountryIds));

    let userNotesMap: Record<string, string> = JSON.parse(localStorage.getItem('user_target_notes') || '{}');
    let activeEditingCountryId = '';

    const noteModal = document.getElementById('target-note-modal') as HTMLDialogElement | null;
    const noteModalTitle = document.getElementById('note-modal-title');
    const inputTargetNote = document.getElementById('input-target-note') as HTMLTextAreaElement | null;
    const btnSaveNote = document.getElementById('btn-save-note');
    const btnCancelNote = document.getElementById('btn-cancel-note');
    const closeNoteModalBtn = document.getElementById('close-note-modal-btn');

    // Baca parameter URL
    const urlParams = new URLSearchParams(window.location.search);
    const initialRegion = urlParams.get('region');
    const initialFilter = urlParams.get('filter');

    let countryFilter = 'all';
    if (initialFilter === 'targets') {
      countryFilter = 'targets';
    } else if (initialRegion) {
      countryFilter = initialRegion;
    }

    let countrySearchQuery = '';
    let countryDisplayLimit = 36;
    let currentUser: any = null;

    const countriesGrid = document.getElementById('countries-grid');
    const searchInput = document.getElementById('country-search-input') as HTMLInputElement | null;
    const filterButtons = document.querySelectorAll('#country-region-filters button');
    const resultsInfo = document.getElementById('country-results-info');
    const loadMoreWrapper = document.getElementById('load-more-wrapper');
    const loadMoreBtn = document.getElementById('btn-load-more');
    const targetCountSpan = document.getElementById('filter-target-count');
    const totalCountSpan = document.getElementById('total-country-count');
    const toast = document.getElementById('toast');
    const toastMessage = document.getElementById('toast-message');
    const toastClose = document.getElementById('toast-close');

    function showToast(msg: string) {
      if (!toast || !toastMessage) return;
      toastMessage.textContent = msg;
      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 4000);
    }
    toastClose?.addEventListener('click', () => toast?.classList.add('hidden'));

    function isCountryTargeted(c: any): boolean {
      if (!c) return false;
      const cid = (c.id || '').toLowerCase();
      const ccode = (c.code || '').toUpperCase();
      return targetCountryIds.some(t => {
        const val = String(t).trim();
        return val.toLowerCase() === cid || val.toUpperCase() === ccode;
      });
    }

    function saveTargetsToStorage() {
      localStorage.setItem('target_countries', JSON.stringify(targetCountryIds));
      updateBadges();
    }

    function updateBadges() {
      const count = allCountries.filter(c => isCountryTargeted(c)).length;
      if (targetCountSpan) targetCountSpan.textContent = String(count);
      if (totalCountSpan) totalCountSpan.textContent = String(allCountries.length);
    }

    function renderCountries() {
      if (!countriesGrid) return;
      updateBadges();

      const query = countrySearchQuery.trim().toLowerCase();

      const filtered = allCountries.filter(c => {
        let matchesFilter = true;
        if (countryFilter === 'targets') {
          matchesFilter = isCountryTargeted(c);
        } else if (countryFilter !== 'all') {
          matchesFilter = c.region === countryFilter || (c.subregion && c.subregion.includes(countryFilter));
        }

        const matchesQuery = !query || 
          c.name.toLowerCase().includes(query) ||
          c.nativeName.toLowerCase().includes(query) ||
          c.language.toLowerCase().includes(query) ||
          (c.capital && c.capital.toLowerCase().includes(query)) ||
          c.code.toLowerCase().includes(query);

        return matchesFilter && matchesQuery;
      });

      if (resultsInfo) {
        const filterLabel = countryFilter === 'all' ? 'semua wilayah' : countryFilter === 'targets' ? 'target saya' : countryFilter;
        resultsInfo.textContent = `Menampilkan ${Math.min(filtered.length, countryDisplayLimit)} dari ${filtered.length} negara (${filterLabel})`;
      }

      const visible = filtered.slice(0, countryDisplayLimit);

      if (loadMoreWrapper) {
        if (filtered.length > countryDisplayLimit) {
          loadMoreWrapper.classList.remove('hidden');
        } else {
          loadMoreWrapper.classList.add('hidden');
        }
      }

      if (visible.length === 0) {
        if (countryFilter === 'targets') {
          countriesGrid.innerHTML = `
            <div class="col-span-full p-10 border border-dashed border-rule text-center bg-tint text-steel select-none font-mono">
              <div class="text-[40px] mb-2 leading-none">⭐</div>
              <p class="font-bold text-[18px] text-ink">Belum Ada Target Belajar</p>
              <p class="text-[13px] mt-2 text-smoke max-w-[48ch] mx-auto font-sans leading-relaxed">
                Anda belum menandai negara target belajar. Klik tombol bintang (☆) pada kartu negara mana saja untuk menjadikannya target belajar Anda!
              </p>
              <button type="button" id="btn-empty-see-all" class="mt-5 btn btn-primary btn-s font-mono text-xs">
                ← Jelajahi Semua 250 Negara
              </button>
            </div>
          `;
          document.getElementById('btn-empty-see-all')?.addEventListener('click', () => {
            const allBtn = document.querySelector<HTMLButtonElement>('#country-region-filters button[data-filter="all"]');
            allBtn?.click();
          });
          return;
        }

        countriesGrid.innerHTML = `
          <div class="col-span-full p-8 border border-dashed border-rule text-center bg-tint text-steel font-mono">
            <p class="font-bold text-[16px] text-ink">Tidak ada negara yang sesuai pencarian / filter.</p>
            <p class="text-[13px] mt-1 text-smoke">Coba kata kunci lain atau pilih tab "Semua (${allCountries.length})".</p>
          </div>
        `;
        return;
      }

      countriesGrid.innerHTML = visible.map(c => {
        const isTargeted = isCountryTargeted(c);
        const hasTable = Boolean(c.tableId);

        return `
          <div class="border border-rule bg-canvas p-4 sm:p-5 flex flex-col justify-between hover:border-ink transition-colors group">
            <div>
              <div class="flex items-start justify-between gap-2 border-b border-rule pb-3">
                <div class="flex items-center gap-2.5 min-w-0">
                  <span class="text-[22px] leading-none shrink-0" aria-hidden="true">${c.flag || '🏳️'}</span>
                  <div class="min-w-0">
                    <div class="flex items-center gap-1.5">
                      <span class="font-bold text-[15px] text-ink truncate">${c.name}</span>
                      <span class="text-[10px] font-mono text-smoke uppercase">(${c.code})</span>
                    </div>
                    <div class="text-[12px] text-smoke truncate">${c.nativeName || c.name}</div>
                  </div>
                </div>
                <button 
                  type="button" 
                  data-toggle-target="${c.id}"
                  class="size-8 flex items-center justify-center border border-rule hover:border-ink transition-colors shrink-0 ${isTargeted ? 'text-badge bg-badge/10 font-bold border-badge' : 'text-smoke hover:text-ink'}"
                  title="${isTargeted ? 'Hapus dari target belajar' : 'Tandai sebagai target belajar'}"
                  aria-label="Target ${c.name}"
                >
                  ${isTargeted ? '★' : '☆'}
                </button>
              </div>

              <div class="mt-3.5 space-y-1.5 text-[12px] font-mono">
                <div class="flex items-baseline justify-between gap-2">
                  <span class="text-smoke">Kawasan:</span>
                  <span class="text-steel text-right truncate">${c.region} ${c.subregion ? '(' + c.subregion + ')' : ''}</span>
                </div>
                <div class="flex items-baseline justify-between gap-2">
                  <span class="text-smoke">Ibukota:</span>
                  <span class="text-steel text-right truncate">${c.capital || '-'}</span>
                </div>
                <div class="flex items-baseline justify-between gap-2">
                  <span class="text-smoke">Bahasa:</span>
                  <span class="text-ink font-semibold text-right truncate">${c.language}</span>
                </div>
              </div>

              ${isTargeted ? `
                <div class="mt-3 pt-2.5 border-t border-dashed border-rule">
                  <div class="flex items-center justify-between text-[11px] font-mono">
                    <span class="text-smoke">Catatan:</span>
                    <button 
                      type="button" 
                      data-edit-note="${c.id}" 
                      class="text-cta hover:underline font-bold cursor-pointer"
                    >
                      ${userNotesMap[c.id] ? '✏️ Edit Catatan' : '+ Tambah Catatan'}
                    </button>
                  </div>
                  ${userNotesMap[c.id] ? `
                    <div class="mt-1.5 p-2 bg-smoke/5 border-l-2 border-cta text-[11px] text-steel font-mono italic">
                      "${userNotesMap[c.id]}"
                    </div>
                  ` : ''}
                </div>
              ` : ''}
            </div>

            <div class="mt-4 pt-3 border-t border-rule">
              ${hasTable ? `
                <div class="grid grid-cols-2 gap-2">
                  <a 
                    href="/belajar?lang=${c.tableId}"
                    class="btn btn-primary btn-s text-[11px] justify-center text-center font-mono truncate"
                    title="Buka tabel aksara"
                  >
                    📖 Tabel
                  </a>
                  <a 
                    href="/belajar?lang=${c.tableId}&mode=phrases"
                    class="btn btn-secondary btn-s text-[11px] justify-center text-center font-mono truncate"
                    title="Pelajari frasa percakapan penting sehari-hari"
                  >
                    💬 Frasa
                  </a>
                </div>
              ` : `
                <a 
                  href="/belajar?unadded=${encodeURIComponent(c.name)}&country=${encodeURIComponent(c.name)}&language=${encodeURIComponent(c.language)}&flag=${encodeURIComponent(c.flag || '')}&voice=${encodeURIComponent(c.voiceLang || 'en-US')}"
                  class="btn btn-secondary btn-s text-[12px] w-full justify-center text-center font-mono text-smoke hover:text-ink"
                >
                  ⚠️ Belum Ditambahkan (+ Buat)
                </a>
              `}
            </div>
          </div>
        `;
      }).join('');

      // Attach Star Target toggle listeners
      countriesGrid.querySelectorAll('[data-toggle-target]').forEach(btn => {
        btn.addEventListener('click', async () => {
          const cid = btn.getAttribute('data-toggle-target');
          if (!cid) return;
          const country = allCountries.find(c => c.id === cid || c.code.toLowerCase() === cid.toLowerCase());
          const targetId = country ? country.id : cid;
          const isAdded = !isCountryTargeted(country || { id: targetId });

          if (isAdded) {
            targetCountryIds.push(targetId);
            targetCountryIds = Array.from(new Set(targetCountryIds));
            showToast(`⭐ ${country ? country.name : 'Negara'} ditambahkan ke target belajar Anda!`);
          } else {
            targetCountryIds = targetCountryIds.filter(id => {
              const val = String(id).trim().toLowerCase();
              return val !== targetId.toLowerCase() && (country ? val !== country.code.toLowerCase() : true);
            });
            showToast('Negara dihapus dari target.');
          }

          saveTargetsToStorage();
          renderCountries();

          // Cloud sync jika user login
          if (currentUser) {
            try {
              if (isAdded) {
                await addTargetToCloud(currentUser.id, targetId);
              } else {
                await removeTargetFromCloud(currentUser.id, targetId);
              }
            } catch (err) {
              console.warn('Gagal sinkron target ke Supabase:', err);
            }
          }
        });
      });

      // Attach Note edit listeners
      countriesGrid.querySelectorAll('[data-edit-note]').forEach(btn => {
        btn.addEventListener('click', () => {
          const cid = btn.getAttribute('data-edit-note');
          if (!cid) return;
          const country = allCountries.find(c => c.id === cid);
          activeEditingCountryId = cid;
          if (noteModalTitle) noteModalTitle.textContent = `✏️ Catatan: ${country ? country.flag + ' ' + country.name : 'Target Belajar'}`;
          if (inputTargetNote) inputTargetNote.value = userNotesMap[cid] || '';
          noteModal?.showModal();
        });
      });
    }

    // Modal Note Handlers
    closeNoteModalBtn?.addEventListener('click', () => noteModal?.close());
    btnCancelNote?.addEventListener('click', () => noteModal?.close());

    btnSaveNote?.addEventListener('click', async () => {
      if (!activeEditingCountryId) return;
      const noteText = inputTargetNote?.value.trim() || '';
      
      if (noteText) {
        userNotesMap[activeEditingCountryId] = noteText;
        showToast('✓ Catatan target berhasil disimpan!');
      } else {
        delete userNotesMap[activeEditingCountryId];
        showToast('Catatan dihapus.');
      }

      localStorage.setItem('user_target_notes', JSON.stringify(userNotesMap));
      noteModal?.close();
      renderCountries();

      // Cloud sync jika user login
      if (currentUser) {
        try {
          await saveTargetNoteToCloud(currentUser.id, activeEditingCountryId, noteText);
        } catch (err) {
          console.warn('Gagal simpan catatan ke cloud:', err);
        }
      }
    });

    // Filter Buttons Handlers
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        if (!filter) return;
        countryFilter = filter;
        countryDisplayLimit = 36;

        filterButtons.forEach(b => {
          b.className = 'px-3.5 py-1.5 font-mono border border-rule bg-canvas text-steel hover:text-ink hover:border-ink hover:bg-tint/40 cursor-pointer';
        });
        btn.className = 'px-3.5 py-1.5 font-mono border-2 border-cta bg-cta/10 text-ink font-bold shadow-xs cursor-pointer';

        renderCountries();
      });
    });

    // Search Handler
    searchInput?.addEventListener('input', (e) => {
      countrySearchQuery = (e.target as HTMLInputElement).value;
      countryDisplayLimit = 36;
      renderCountries();
    });

    // Load More Handler
    loadMoreBtn?.addEventListener('click', () => {
      countryDisplayLimit += 36;
      renderCountries();
    });

    // Backup JSON
    document.getElementById('btn-export-backup')?.addEventListener('click', () => {
      const backupData = {
        app: 'belajar-bahasa',
        exportedAt: new Date().toISOString(),
        targetCountries: targetCountryIds,
        notes: userNotesMap,
        customTables: JSON.parse(localStorage.getItem('custom_character_tables') || '[]')
      };
      const blob = new Blob([JSON.stringify(backupData, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `belajar-bahasa-backup-${new Date().toISOString().split('T')[0]}.json`;
      a.click();
      URL.revokeObjectURL(url);
      showToast('Cadangan data berhasil diunduh!');
    });

    // Import JSON
    document.getElementById('input-import-file')?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (evt) => {
        try {
          const parsed = JSON.parse(evt.target?.result as string);
          if (Array.isArray(parsed.targetCountries)) {
            targetCountryIds = Array.from(new Set([...targetCountryIds, ...parsed.targetCountries]));
            saveTargetsToStorage();
          }
          if (parsed.notes && typeof parsed.notes === 'object') {
            Object.assign(userNotesMap, parsed.notes);
            localStorage.setItem('user_target_notes', JSON.stringify(userNotesMap));
          }
          if (Array.isArray(parsed.customTables)) {
            const existing = JSON.parse(localStorage.getItem('custom_character_tables') || '[]');
            const existingIds = new Set(existing.map((t: any) => t.id));
            parsed.customTables.forEach((t: any) => {
              if (!existingIds.has(t.id)) existing.push(t);
            });
            localStorage.setItem('custom_character_tables', JSON.stringify(existing));
          }
          renderCountries();
          showToast('✓ Data cadangan berhasil dipulihkan!');
        } catch {
          showToast('File JSON tidak valid.');
        }
      };
      reader.readAsText(file);
    });

    // Trigger Auth Modal
    document.getElementById('btn-cloud-sync-trigger')?.addEventListener('click', () => {
      const authModal = document.getElementById('auth-modal') as HTMLDialogElement | null;
      authModal?.showModal();
    });

    // TRIVIA QUIZ LOGIC
    const triviaModal = document.getElementById('trivia-modal') as HTMLDialogElement | null;
    const btnOpenTrivia = document.getElementById('btn-open-trivia');
    const closeTriviaBtn = document.getElementById('close-trivia-btn');
    const triviaStreakLabel = document.getElementById('trivia-streak-label');
    const triviaScoreLabel = document.getElementById('trivia-score-label');
    const triviaFlagDisplay = document.getElementById('trivia-flag-display');
    const triviaCountryName = document.getElementById('trivia-country-name');
    const triviaQuestionText = document.getElementById('trivia-question-text');
    const triviaFeedback = document.getElementById('trivia-feedback');
    const triviaOptionsGrid = document.getElementById('trivia-options-grid');
    const btnNextTrivia = document.getElementById('btn-next-trivia');

    let triviaScore = 0;
    let triviaStreak = 0;
    let triviaCorrectAnswer = '';

    btnOpenTrivia?.addEventListener('click', () => {
      triviaModal?.showModal();
      nextTriviaQuestion();
    });

    closeTriviaBtn?.addEventListener('click', () => {
      triviaModal?.close();
    });

    function nextTriviaQuestion() {
      if (allCountries.length < 4) return;
      if (btnNextTrivia) btnNextTrivia.classList.add('hidden');
      if (triviaFeedback) triviaFeedback.textContent = '';

      const questionType = Math.random() > 0.5 ? 0 : 1;
      const targetCountry = allCountries[Math.floor(Math.random() * allCountries.length)];

      if (triviaFlagDisplay) triviaFlagDisplay.textContent = targetCountry.flag;
      if (triviaCountryName) triviaCountryName.textContent = targetCountry.name;

      if (questionType === 0) {
        if (triviaQuestionText) triviaQuestionText.textContent = 'Apa bahasa resmi dari negara ini?';
        triviaCorrectAnswer = targetCountry.officialLanguage || targetCountry.language;
        
        const otherLangs = Array.from(new Set(allCountries.map(c => c.officialLanguage || c.language)))
          .filter(l => l && l !== triviaCorrectAnswer);
        const shuffledDistractors = otherLangs.sort(() => 0.5 - Math.random()).slice(0, 3);
        const options = [triviaCorrectAnswer, ...shuffledDistractors].sort(() => 0.5 - Math.random());
        renderTriviaOptions(options);
      } else {
        if (triviaQuestionText) triviaQuestionText.textContent = 'Apa ibukota dari negara ini?';
        triviaCorrectAnswer = targetCountry.capital;
        
        const otherCapitals = Array.from(new Set(allCountries.map(c => c.capital)))
          .filter(cap => cap && cap !== triviaCorrectAnswer);
        const shuffledDistractors = otherCapitals.sort(() => 0.5 - Math.random()).slice(0, 3);
        const options = [triviaCorrectAnswer, ...shuffledDistractors].sort(() => 0.5 - Math.random());
        renderTriviaOptions(options);
      }
    }

    function renderTriviaOptions(options: string[]) {
      if (!triviaOptionsGrid) return;
      triviaOptionsGrid.innerHTML = '';

      options.forEach(opt => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'py-3 px-3 border border-rule bg-canvas hover:border-ink font-mono font-medium text-[13px] text-ink transition-colors shadow-sm text-left truncate';
        btn.textContent = opt;
        btn.title = opt;

        btn.addEventListener('click', () => {
          const allBtns = triviaOptionsGrid.querySelectorAll('button');
          allBtns.forEach(b => (b.disabled = true));

          if (opt === triviaCorrectAnswer) {
            btn.classList.remove('border-rule', 'bg-canvas');
            btn.classList.add('border-ok', 'bg-ok/20', 'text-ok', 'font-bold');
            if (triviaFeedback) {
              triviaFeedback.textContent = '✓ BENAR!';
              triviaFeedback.className = 'h-6 text-xs font-mono font-bold text-center text-ok';
            }
            triviaScore += 10;
            triviaStreak += 1;
          } else {
            btn.classList.remove('border-rule', 'bg-canvas');
            btn.classList.add('border-red-500', 'bg-red-500/10', 'text-red-500');
            allBtns.forEach(b => {
              if (b.textContent === triviaCorrectAnswer) {
                b.classList.remove('border-rule');
                b.classList.add('border-ok', 'bg-ok/20', 'text-ok', 'font-bold');
              }
            });
            if (triviaFeedback) {
              triviaFeedback.textContent = `SALAH! Jawaban: "${triviaCorrectAnswer}".`;
              triviaFeedback.className = 'h-6 text-xs font-mono font-bold text-center text-red-500';
            }
            triviaStreak = 0;
          }

          if (triviaScoreLabel) triviaScoreLabel.textContent = `Skor: ${triviaScore}`;
          if (triviaStreakLabel) triviaStreakLabel.textContent = `🔥 Streak: ${triviaStreak}`;
          if (btnNextTrivia) btnNextTrivia.classList.remove('hidden');
        });

        triviaOptionsGrid.appendChild(btn);
      });
    }

    btnNextTrivia?.addEventListener('click', nextTriviaQuestion);

    // Check auth on load to fetch Supabase targets & notes
    async function initUserTargets() {
      try {
        currentUser = await getCurrentUser();
        if (currentUser) {
          const cloudTargets = await fetchUserTargetsFromCloud(currentUser.id);
          if (cloudTargets && cloudTargets.length > 0) {
            targetCountryIds = Array.from(new Set([...targetCountryIds, ...cloudTargets]));
            saveTargetsToStorage();
          }

          const cloudNotes = await fetchUserTargetsWithNotesFromCloud(currentUser.id);
          if (cloudNotes && Object.keys(cloudNotes).length > 0) {
            Object.assign(userNotesMap, cloudNotes);
            localStorage.setItem('user_target_notes', JSON.stringify(userNotesMap));
          }

          renderCountries();
        }
      } catch (err) {
        console.warn('Init user targets error:', err);
      }
    }

    // Sync button highlight with initial URL filter
    if (countryFilter !== 'all') {
      filterButtons.forEach(b => {
        const f = b.getAttribute('data-filter');
        if (f === countryFilter) {
          b.className = 'px-3.5 py-1.5 font-mono border border-ink bg-ink text-canvas font-bold';
        } else {
          b.className = 'px-3.5 py-1.5 font-mono border border-rule bg-canvas text-steel hover:text-ink hover:border-ink';
        }
      });
    }

    // Initial render
    renderCountries();
    initUserTargets();
  }
</script>
