---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import StatusLog from '../components/StatusLog.astro';
---

<Base title="Halaman Tidak Ditemukan" description="Halaman yang Anda tuju tidak tersedia atau sudah dipindahkan.">
  <Section top={false} inner="px-6 pt-24 pb-[104px] max-md:px-5 max-md:pt-12 max-md:pb-14 overflow-hidden text-center" label="404 Not Found">
    <div class="grid-bg" style="--gx:50%;--gy:30%" aria-hidden="true"></div>
    <div class="relative flex flex-col items-center">
      <p class="label"><b>[404]</b> rute tidak ditemukan</p>
      <h1 class="mt-3 flex items-end gap-2.5 text-[clamp(120px,18vw,220px)] leading-[0.9] font-extrabold tracking-[-0.08em]">404<span class="mb-[0.08em] h-[0.1em] w-[0.44em] bg-cta" aria-hidden="true"></span></h1>
      <p class="mt-6 text-[18px] max-md:text-[15px] text-steel">Halaman yang Anda cari tidak tersedia atau rutenya telah dipindahkan.</p>
      <div class="mt-11 w-full flex justify-center">
        <StatusLog title="app.belajarbahasa/status/404" id="err_404" status="failed" tone="badge" steps={[
          { kind: 'plan', text: `resolve route "${Astro.url.pathname}"`, time: '0.01s', mark: '✓' },
          { kind: 'tool', text: 'router.match()', time: '0.01s', mark: 'x', active: true },
          { kind: 'eval', text: 'mungkin maksud Anda "/belajar" atau "/katalog"?', time: '0.02s', mark: '?' },
        ]} />
      </div>
      <div class="mt-10 flex gap-4 max-md:flex-col max-md:w-full">
        <a href="/" class="btn btn-primary">Kembali ke Beranda -&gt;</a>
        <a href="/belajar" class="btn btn-secondary">Studio Belajar Aksara</a>
        <a href="/katalog" class="btn btn-ghost">Katalog Negara</a>
      </div>
    </div>
  </Section>
</Base>
