---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import MediaWindow from '../components/MediaWindow.astro';
import GuideWindow from '../components/GuideWindow.astro';
import { defaultLanguageTables } from '../data/languages';
import { worldCountries } from '../data/countries';

const sampleTable = defaultLanguageTables[0]; // Jepang Hiragana
const sampleCountries = worldCountries.filter(c => ['JP', 'DE', 'KR', 'SA', 'ES', 'FR'].includes(c.code));
---

<Base title="Belajar Bahasa - Tabel Aksara Interaktif & Katalog 250 Negara" description="Aplikasi tabel belajar aksara bahasa (Jepang, Jerman, Korea, Arab, dll.) dan katalog 250 negara dengan audio pengucapan asli dan integrasi cloud multi-perangkat.">
  
  <!-- [00] HERO: Pengenalan & Panduan Menggunakan Website -->
  <Section id="panduan" top={false} inner="px-6 pt-14 pb-18 lg:pt-20 lg:pb-24 max-md:px-5 overflow-hidden" label="Pengenalan Website">
    <div class="grid-bg" style="--gx:74%;--gy:50%" aria-hidden="true"></div>
    
    <!-- Retro-Tech Graphic Blueprint Background -->
    <svg class="absolute left-0 top-0 max-lg:hidden pointer-events-none" width="1280" height="653" viewBox="0 0 1280 653" fill="none" aria-hidden="true">
      <circle cx="1150" cy="146" r="150" stroke="var(--stone)" />
      <circle cx="1150" cy="146" r="96" stroke="var(--rule)" stroke-dasharray="3 4" />
      <circle cx="612" cy="567" r="58" stroke="var(--stone)" stroke-dasharray="3 4" />
      <polyline points="520,593 612,567 740,589 880,555 1010,581 1130,547" stroke="var(--ink)" stroke-dasharray="4 4" />
      <polyline points="700,122 820,90 960,112 1080,76" stroke="var(--ink)" stroke-dasharray="4 4" />
      {[[520, 593], [612, 567], [740, 589], [880, 555, 1], [1010, 581], [1130, 547], [700, 122], [820, 90, 1], [960, 112], [1080, 76]].map(([x, y, o]) => (
        <rect x={x - 4} y={y - 4} width="8" height="8" fill={o ? 'var(--cta)' : 'var(--canvas)'} stroke="var(--ink)" />
      ))}
      <g fill="var(--smoke)" font-size="11" font-family="inherit">
        <text x="534" y="615">tabel_aksara</text><text x="892" y="535">audio_speech</text><text x="1020" y="606">250_negara</text><text x="832" y="70">integrasi_cloud</text>
      </g>
      <g stroke="var(--ink)"><path d="M580.5 96h11M586 90.5v11M1230.5 537h11M1236 531.5v11M34.5 613h11M40 607.5v11" /></g>
    </svg>

    <div class="relative grid grid-cols-1 lg:grid-cols-[1fr_520px] gap-12 lg:gap-14 items-center">
      <!-- Left: Introduction Text & CTA -->
      <div>
        <p class="label"><b>[00]</b> platform belajar mandiri</p>
        <h1 class="mt-5 text-[clamp(34px,4.8vw,60px)] leading-[1.04] font-bold tracking-[-0.04em] text-ink">
          Belajar Aksara Bahasa &amp; Catat Target Negaramu.
        </h1>
        <p class="mt-6 max-w-[50ch] text-[16px] leading-[1.6] text-steel max-md:text-[15px]">
          Selamat datang di platform belajar bahasa mandiri. Pelajari tabel aksara fonetik (Jepang, Jerman, Korea, Arab, dll.) dengan audio lafal asli, jelajahi katalog 250 negara, dan integrasikan progres Anda ke cloud secara aman.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="/belajar" class="btn btn-primary max-md:w-full font-mono text-[14px]">
            Mulai Belajar Aksara →
          </a>
          <a href="/katalog" class="btn btn-secondary max-md:w-full font-mono text-[14px]">
            Jelajahi 250 Negara →
          </a>
        </div>

        <div class="mt-7 flex items-center w-fit max-w-full border border-rule bg-canvas text-[13px] font-mono shadow-sm">
          <code class="px-4 py-2.5 text-ink truncate"><span class="text-smoke select-none">fitur: </span>audio native · 250 negara · integrasi cloud</code>
          <span class="px-3.5 py-2.5 border-l border-rule text-ok font-bold">100% GRATIS</span>
        </div>
      </div>

      <!-- Right: MediaWindow with Animated Guide Steps -->
      <div>
        <MediaWindow title="app.belajar-bahasa.com/panduan" shadow>
          <GuideWindow />
        </MediaWindow>
      </div>
    </div>
  </Section>

  <!-- [01] SHOWCASE: Pratinjau Interaktif Studio Belajar Aksara -->
  <Section top={true} inner="px-6 pt-14 pb-18 lg:pt-16 lg:pb-22 max-md:px-5">
    <div class="w-full">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-rule">
        <div>
          <p class="label"><b>[01]</b> pratinjau studio belajar</p>
          <h2 class="mt-3 text-[clamp(26px,3.5vw,40px)] leading-[1.1] font-bold tracking-[-0.035em] text-ink">
            Tabel Huruf &amp; Aksara Interaktif
          </h2>
          <p class="mt-2 text-[15px] text-steel max-w-[60ch]">
            Klik kotak karakter di bawah untuk mendengar suara pengucapan audio aslinya dengan suara Google Speech. Tersedia lebih dari 12 aksara bahasa dunia.
          </p>
        </div>
        <a href="/belajar" class="btn btn-primary btn-s shrink-0 font-mono text-[13px]">
          Buka Studio Belajar Lengkap →
        </a>
      </div>

      <!-- Sample Interactive Preview Table -->
      <div class="mt-8 p-5 sm:p-6 border border-rule bg-canvas shadow-sm">
        <div class="flex items-center justify-between gap-3 pb-4 mb-4 border-b border-rule flex-wrap">
          <div class="flex items-center gap-2">
            <span class="text-lg">🇯🇵</span>
            <span class="font-bold text-ink text-[16px]">Pratinjau Aksara Hiragana (5 Baris Pertama)</span>
          </div>
          <span class="text-smoke font-mono text-[12px]">🔊 Suara Asli Google Speech · Klik sel untuk mendengarkan</span>
        </div>

        <div class="overflow-x-auto pb-2">
          <table class="w-full border-collapse border border-ink text-center bg-canvas font-mono" id="hero-preview-table">
            <tbody>
              {sampleTable.grid.slice(0, 5).map((row) => (
                <tr>
                  {row.map((cell) => (
                    cell ? (
                      <td 
                        class="border border-ink p-3 sm:p-4 hover:bg-tint cursor-pointer transition-colors min-w-[70px] sm:min-w-[90px] h-16 sm:h-20"
                        data-char={cell.char}
                        data-lang="ja-JP"
                        data-romaji={cell.romaji}
                        title={`Klik untuk dengar suara '${cell.char}' (${cell.romaji})`}
                      >
                        <div class="flex items-center justify-center gap-1.5 sm:gap-2 text-[15px] sm:text-[18px]">
                          <span class="text-steel font-normal">{cell.romaji}</span>
                          <span class="text-smoke select-none">=</span>
                          <span class="text-ink font-bold text-[18px] sm:text-[22px]">{cell.char}</span>
                        </div>
                      </td>
                    ) : (
                      <td class="border border-ink p-3 sm:p-4 bg-tint/40 min-w-[70px] sm:min-w-[90px] h-16 sm:h-20"></td>
                    )
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="mt-6 flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-rule text-[13px]">
          <span class="text-steel">Termasuk: Katakana, Hangul Korea, Hijaiyah Arab, Hanzi Mandarin, Thai, Jerman, Rusia, dll.</span>
          <a href="/belajar" class="btn btn-secondary btn-s font-mono text-[13px] shrink-0">
            Pilih Bahasa Lain di Studio →
          </a>
        </div>
      </div>
    </div>
  </Section>

  <!-- [02] SHOWCASE: Katalog 250 Negara di Dunia -->
  <Section top={true} inner="px-6 pt-14 pb-18 lg:pt-16 lg:pb-22 max-md:px-5">
    <div class="w-full">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-rule">
        <div>
          <p class="label"><b>[02]</b> katalog target belajar</p>
          <h2 class="mt-3 text-[clamp(26px,3.5vw,40px)] leading-[1.1] font-bold tracking-[-0.035em] text-ink">
            Katalog 250 Negara di Dunia
          </h2>
          <p class="mt-2 text-[15px] text-steel max-w-[60ch]">
            Pantau dan tandai bintang ⭐ pada negara tujuan belajar bahasa Anda. Dilengkapi data kawasan, ibukota, dan bahasa resmi.
          </p>
        </div>
        <a href="/katalog" class="btn btn-secondary btn-s shrink-0 font-mono text-[13px]">
          Buka Katalog 250 Negara Lengkap →
        </a>
      </div>

      <!-- Country Cards Preview Grid -->
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {sampleCountries.map((c) => (
          <div class="border border-rule bg-canvas p-5 flex flex-col justify-between hover:border-ink transition-colors shadow-sm">
            <div>
              <div class="flex items-start justify-between gap-2 border-b border-rule pb-3">
                <div class="flex items-center gap-2.5">
                  <span class="text-2xl leading-none" aria-hidden="true">{c.flag}</span>
                  <div>
                    <span class="font-bold text-[15px] text-ink">{c.name}</span>
                    <div class="text-[12px] text-smoke">{c.nativeName}</div>
                  </div>
                </div>
                <span class="text-badge text-base">★</span>
              </div>
              <div class="mt-3 space-y-1.5 text-[12px] font-mono">
                <div class="flex justify-between"><span class="text-smoke">Kawasan:</span><span class="text-steel">{c.region}</span></div>
                <div class="flex justify-between"><span class="text-smoke">Ibukota:</span><span class="text-steel">{c.capital}</span></div>
                <div class="flex justify-between"><span class="text-smoke">Bahasa:</span><span class="text-ink font-semibold">{c.language}</span></div>
              </div>
            </div>
            <div class="mt-4 pt-3 border-t border-rule">
              <a href={`/belajar?lang=${c.tableId}`} class="btn btn-primary btn-s text-[12px] w-full justify-center text-center font-mono">
                📖 Pelajari Aksara {c.name}
              </a>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-8 text-center">
        <a href="/katalog" class="btn btn-secondary px-8 py-3 text-[14px] font-mono">
          Lihat Semua 250 Negara di Halaman Katalog →
        </a>
      </div>
    </div>
  </Section>

  <!-- [03] FITUR UTAMA & INTEGRASI CLOUD -->
  <Section top={true} inner="px-6 pt-14 pb-18 lg:pt-16 lg:pb-22 max-md:px-5">
    <div class="w-full">
      <div class="pb-6 border-b border-rule">
        <p class="label"><b>[03]</b> arsitektur &amp; keunggulan</p>
        <h2 class="mt-3 text-[clamp(26px,3.5vw,40px)] leading-[1.1] font-bold tracking-[-0.035em] text-ink">
          Dirancang Cepat, Mandiri, &amp; Terhubung Cloud
        </h2>
      </div>

      <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Fitur 1 -->
        <div class="border border-rule bg-canvas p-6 space-y-3">
          <span class="text-[28px]">🔊</span>
          <h3 class="text-[17px] font-bold text-ink">Pelafalan Audio Suara Google</h3>
          <p class="text-[13px] text-steel leading-relaxed">
            Terintegrasi dengan mesin suara Google Speech &amp; Google Translate TTS untuk menghasilkan pengucapan fonetik aksara yang jernih dan akurat.
          </p>
        </div>

        <!-- Fitur 2 -->
        <div class="border border-rule bg-canvas p-6 space-y-3">
          <span class="text-[28px]">📊</span>
          <h3 class="text-[17px] font-bold text-ink">Impor dari File Excel</h3>
          <p class="text-[13px] text-steel leading-relaxed">
            Punya catatan kosakata atau aksara di Excel? Cukup upload file .xlsx atau copy-paste tabel Anda langsung ke aplikasi.
          </p>
        </div>

        <!-- Fitur 3 -->
        <div class="border border-rule bg-canvas p-6 space-y-3">
          <span class="text-[28px]">☁️</span>
          <h3 class="text-[17px] font-bold text-ink">Integrasi Cloud Otomatis</h3>
          <p class="text-[13px] text-steel leading-relaxed">
            Daftar akun gratis untuk menyimpan target negara dan materi tabel kustom Anda secara otomatis di penyimpanan cloud.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- [04] CTA BANNER -->
  <Section top={true} inner="px-6 py-16 lg:py-20 max-md:px-5">
    <div class="max-w-3xl mx-auto text-center border-2 border-ink p-8 sm:p-12 bg-canvas shadow-xl space-y-6">
      <p class="label"><b>[04]</b> mulai langkah pertama</p>
      <h2 class="text-[clamp(28px,4vw,44px)] font-bold tracking-tight text-ink leading-tight">
        Siap Menguasai Aksara &amp; Bahasa Baru?
      </h2>
      <p class="text-[15px] text-steel max-w-[55ch] mx-auto leading-relaxed">
        Gunakan studio belajar tanpa dipungut biaya. Buat akun jika ingin menyinkronkan progres Anda di seluruh perangkat.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a href="/belajar" class="btn btn-primary px-7 py-3 text-[14px] font-mono">
          Mulai Belajar Aksara →
        </a>
        <button type="button" id="cta-auth-trigger" class="btn btn-secondary px-7 py-3 text-[14px] font-mono">
          Masuk / Daftar Akun
        </button>
      </div>
    </div>
  </Section>

</Base>

<script>
  document.getElementById("cta-auth-trigger")?.addEventListener("click", () => {
    const authModal = document.getElementById("auth-modal");
    if (authModal && typeof authModal.showModal === "function") {
      authModal.showModal();
    }
  });

  // Google Speech Synthesizer engine dengan Fallback Audio Stream
  let cachedVoices = [];
  function loadVoices() {
    if ('speechSynthesis' in window) {
      cachedVoices = window.speechSynthesis.getVoices();
    }
  }
  if ('speechSynthesis' in window) {
    loadVoices();
    window.speechSynthesis.onvoiceschanged = loadVoices;
  }

  function playGoogleSpeech(text, lang) {
    if (!text) return;
    const langCode = lang ? lang.split('-')[0].toLowerCase() : 'ja';

    if ('speechSynthesis' in window) {
      try {
        window.speechSynthesis.cancel();
        const utter = new SpeechSynthesisUtterance(text);
        if (lang) utter.lang = lang;
        utter.rate = 0.85;

        const voices = cachedVoices.length ? cachedVoices : window.speechSynthesis.getVoices();
        
        // Prioritaskan suara resmi Google untuk bahasa ini
        const googleVoice = voices.find(v => 
          (v.lang.toLowerCase().startsWith(langCode) || v.lang.toLowerCase() === (lang || '').toLowerCase()) && 
          v.name.toLowerCase().includes('google')
        );

        const naturalVoice = voices.find(v => 
          (v.lang.toLowerCase().startsWith(langCode) || v.lang.toLowerCase() === (lang || '').toLowerCase()) && 
          (v.name.toLowerCase().includes('natural') || v.name.toLowerCase().includes('online'))
        );

        const matchedVoice = voices.find(v => 
          v.lang.toLowerCase().startsWith(langCode) || v.lang.toLowerCase() === (lang || '').toLowerCase()
        );

        if (googleVoice) {
          utter.voice = googleVoice;
        } else if (naturalVoice) {
          utter.voice = naturalVoice;
        } else if (matchedVoice) {
          utter.voice = matchedVoice;
        }

        window.speechSynthesis.speak(utter);
        return;
      } catch (e) {
        console.warn('SpeechSynthesis error, falling back:', e);
      }
    }

    // Fallback: Google Translate TTS audio stream
    try {
      const audioUrl = `https://translate.google.com/translate_tts?ie=UTF-8&client=tw-ob&tl=${langCode}&q=${encodeURIComponent(text)}`;
      const audio = new Audio(audioUrl);
      audio.play().catch(() => {});
    } catch {}
  }

  // Audio listener for hero sample table
  const heroTable = document.getElementById('hero-preview-table');
  if (heroTable) {
    heroTable.querySelectorAll('td[data-char]').forEach(td => {
      td.addEventListener('click', () => {
        const char = td.getAttribute('data-char');
        const lang = td.getAttribute('data-lang');
        if (char) {
          playGoogleSpeech(char, lang);
        }
      });
    });
  }
</script>
