<script>
  document.getElementById("cta-auth-trigger")?.addEventListener("click", () => {
    const authModal = document.getElementById("auth-modal");
    if (authModal && typeof authModal.showModal === "function") {
      authModal.showModal();
    }
  });

  // Google Speech Synthesizer engine dengan Fallback Audio Stream
  let cachedVoices = [];
  function loadVoices() {
    if ('speechSynthesis' in window) {
      cachedVoices = window.speechSynthesis.getVoices();
    }
  }
  if ('speechSynthesis' in window) {
    loadVoices();
    window.speechSynthesis.onvoiceschanged = loadVoices;
  }

  function playGoogleSpeech(text, lang) {
    if (!text) return;
    const langCode = lang ? lang.split('-')[0].toLowerCase() : 'ja';

    if ('speechSynthesis' in window) {
      try {
        window.speechSynthesis.cancel();
        const utter = new SpeechSynthesisUtterance(text);
        if (lang) utter.lang = lang;
        utter.rate = 0.85;

        const voices = cachedVoices.length ? cachedVoices : window.speechSynthesis.getVoices();
        
        // Prioritaskan suara resmi Google untuk bahasa ini
        const googleVoice = voices.find(v => 
          (v.lang.toLowerCase().startsWith(langCode) || v.lang.toLowerCase() === (lang || '').toLowerCase()) && 
          v.name.toLowerCase().includes('google')
        );

        const naturalVoice = voices.find(v => 
          (v.lang.toLowerCase().startsWith(langCode) || v.lang.toLowerCase() === (lang || '').toLowerCase()) && 
          (v.name.toLowerCase().includes('natural') || v.name.toLowerCase().includes('online'))
        );

        const matchedVoice = voices.find(v => 
          v.lang.toLowerCase().startsWith(langCode) || v.lang.toLowerCase() === (lang || '').toLowerCase()
        );

        if (googleVoice) {
          utter.voice = googleVoice;
        } else if (naturalVoice) {
          utter.voice = naturalVoice;
        } else if (matchedVoice) {
          utter.voice = matchedVoice;
        }

        window.speechSynthesis.speak(utter);
        return;
      } catch (e) {
        console.warn('SpeechSynthesis error, falling back:', e);
      }
    }

    // Fallback: Google Translate TTS audio stream
    try {
      const audioUrl = `https://translate.google.com/translate_tts?ie=UTF-8&client=tw-ob&tl=${langCode}&q=${encodeURIComponent(text)}`;
      const audio = new Audio(audioUrl);
      audio.play().catch(() => {});
    } catch {}
  }

  // Audio listener for hero sample table
  const heroTable = document.getElementById('hero-preview-table');
  if (heroTable) {
    heroTable.querySelectorAll('td[data-char]').forEach(td => {
      td.addEventListener('click', () => {
        const char = td.getAttribute('data-char');
        const lang = td.getAttribute('data-lang');
        if (char) {
          playGoogleSpeech(char, lang);
        }
      });
    });
  }
</script>
