---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import MediaWindow from '../components/MediaWindow.astro';
import GuideWindow from '../components/GuideWindow.astro';
import { defaultLanguageTables } from '../data/languages';
import { worldCountries } from '../data/countries';
---

<Base title="Belajar Bahasa - Tabel Aksara & Katalog 250 Negara" description="Aplikasi tabel belajar aksara bahasa dan database 250 negara dunia dengan panduan cara belajar interaktif.">
  
  <!-- [00] HERO: Pengenalan & Panduan Menggunakan Website (Menggunakan MediaWindow seperti Gambar 2) -->
  <Section id="panduan" top={false} inner="px-6 pt-14 pb-18 lg:pt-20 lg:pb-24 max-md:px-5 overflow-hidden" label="Pengenalan Website">
    <div class="grid-bg" style="--gx:74%;--gy:50%" aria-hidden="true"></div>
    
    <!-- Retro-Tech Graphic Blueprint Background -->
    <svg class="absolute left-0 top-0 max-lg:hidden pointer-events-none" width="1280" height="653" viewBox="0 0 1280 653" fill="none" aria-hidden="true">
      <circle cx="1150" cy="146" r="150" stroke="var(--stone)" />
      <circle cx="1150" cy="146" r="96" stroke="var(--rule)" stroke-dasharray="3 4" />
      <circle cx="612" cy="567" r="58" stroke="var(--stone)" stroke-dasharray="3 4" />
      <polyline points="520,593 612,567 740,589 880,555 1010,581 1130,547" stroke="var(--ink)" stroke-dasharray="4 4" />
      <polyline points="700,122 820,90 960,112 1080,76" stroke="var(--ink)" stroke-dasharray="4 4" />
      {[[520, 593], [612, 567], [740, 589], [880, 555, 1], [1010, 581], [1130, 547], [700, 122], [820, 90, 1], [960, 112], [1080, 76]].map(([x, y, o]) => (
        <rect x={x - 4} y={y - 4} width="8" height="8" fill={o ? 'var(--cta)' : 'var(--canvas)'} stroke="var(--ink)" />
      ))}
      <g fill="var(--smoke)" font-size="11" font-family="inherit">
        <text x="534" y="615">tabel_aksara</text><text x="892" y="535">audio_speech</text><text x="1020" y="606">250_negara</text><text x="832" y="70">tanpa_login</text>
      </g>
      <g stroke="var(--ink)"><path d="M580.5 96h11M586 90.5v11M1230.5 537h11M1236 531.5v11M34.5 613h11M40 607.5v11" /></g>
    </svg>

    <div class="relative grid grid-cols-1 lg:grid-cols-[1fr_520px] gap-12 lg:gap-14 items-center">
      <!-- Left: Introduction Text & CTA -->
      <div>
        <p class="label"><b>[00]</b> pengenalan & cara menggunakan</p>
        <h1 class="mt-5 text-[clamp(36px,5vw,62px)] leading-[1.04] font-bold tracking-[-0.04em]">
          Belajar Aksara Bahasa & Catat Target Negaramu.
        </h1>
        <p class="mt-6 max-w-[50ch] text-[16px] leading-[1.6] text-steel max-md:text-[15px]">
          Selamat datang di platform belajar bahasa mandiri. Anda bisa mempelajari tabel aksara teks (Jepang, Jerman, Korea, Arab, dll.) dengan audio lafal asli, serta menandai target negara yang ingin dipelajari tanpa harus mendaftar akun.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a href="#area-belajar" class="btn btn-primary max-md:w-full">
            Mulai Belajar Aksara ↓
          </a>
          <a href="#area-belajar" id="hero-goto-countries" class="link text-[15px]">
            Jelajahi 250 Negara -&gt;
          </a>
        </div>

        <div class="mt-7 flex items-center w-fit max-w-full border border-rule bg-canvas text-[13px] font-mono">
          <code class="px-4 py-2.5 text-ink truncate"><span class="text-smoke select-none">fitur: </span>audio otomatis · 250 negara · tanpa login</code>
          <span class="px-3 py-2.5 border-l border-rule text-ok font-bold">100% GRATIS</span>
        </div>
      </div>

      <!-- Right: MediaWindow with Animated Guide Steps (Matches Image 2) -->
      <div>
        <MediaWindow title="app.belajar-bahasa.com/panduan" shadow>
          <GuideWindow />
        </MediaWindow>
      </div>
    </div>
  </Section>

  <!-- [01] MAIN APP: Area Belajar Aksara -->
  <Section id="area-belajar" top={true} inner="px-6 pt-14 pb-18 lg:pt-16 lg:pb-22 max-md:px-5">
    <div class="max-w-4xl">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <p class="label"><b>[01]</b> area belajar interaktif</p>
          <h2 class="mt-4 text-[clamp(28px,3.8vw,44px)] leading-[1.1] font-bold tracking-[-0.035em]">
            Tabel Huruf & Aksara Bahasa
          </h2>
          <p class="mt-3 max-w-[65ch] text-[15px] leading-[1.6] text-steel">
            Pilih aksara bahasa di bawah ini. Klik tiap kotak karakter untuk mendengarkan lafal audio aslinya.
          </p>
        </div>
        <a href="#katalog-section" class="btn btn-secondary btn-s shrink-0 font-mono text-[13px]">
          🌍 Jelajahi 250 Negara ↓
        </a>
      </div>
    </div>

    <!-- App Data Container -->
    <div 
      id="main-app" 
      class="mt-8"
      data-defaults={JSON.stringify(defaultLanguageTables)}
      data-countries={JSON.stringify(worldCountries)}
    >

      <!-- Notification Toast -->
      <div id="toast" class="hidden mb-6 px-4 py-2 text-[13px] border border-ok text-ok bg-canvas flex items-center justify-between">
        <span id="toast-message">Berhasil disimpan!</span>
        <button type="button" id="toast-close" class="text-smoke hover:text-ink font-bold ml-4">✕</button>
      </div>

      <!-- ========================================== -->
      <!-- SECTION TABEL AKSARA & HURUF -->
      <!-- ========================================== -->
      <div id="section-tables" class="space-y-8">
        
        <!-- Language Switcher Bar -->
        <div>
          <span class="label block mb-2">Pilih Aksara Bahasa:</span>
          <div class="border-b border-rule flex flex-wrap items-center gap-2 pb-3" id="tab-bar">
            <!-- Rendered by client script -->
          </div>
        </div>

        <!-- Action & Search Toolbar -->
        <div class="flex flex-wrap items-center justify-between gap-4 p-4 border border-rule bg-canvas">
          <div class="flex items-center gap-3 flex-1 min-w-[240px]">
            <span class="text-smoke text-[13px] font-mono select-none">CARI:</span>
            <input 
              type="text" 
              id="search-input" 
              placeholder="Cari huruf atau romaji (misal: Ka, あ, Ä, ㄱ)..." 
              class="w-full max-w-sm px-3 py-1.5 text-[14px] bg-tint border border-rule text-ink outline-none focus:border-ink font-mono"
            />
          </div>
          <div class="flex items-center gap-2 flex-wrap text-[13px]">
            <button 
              type="button" 
              id="toggle-audio-btn" 
              class="btn btn-secondary btn-s"
              title="Aktifkan/Nonaktifkan Suara Pengucapan saat kotak diklik"
            >
              🔊 Suara: <span id="audio-status-label" class="text-ok font-bold">AKTIF</span>
            </button>
            <button 
              type="button" 
              id="copy-all-btn" 
              class="btn btn-secondary btn-s"
              title="Salin seluruh isi tabel ke clipboard"
            >
              📋 Salin Teks
            </button>
            <button 
              type="button" 
              id="open-creator-btn" 
              class="btn btn-primary btn-s"
            >
              + Buat Tabel Sendiri
            </button>
          </div>
        </div>

        <!-- Main Viewer Table Card -->
        <div id="viewer-container">
          <!-- Table Title & Description -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-rule pb-4 mb-6">
            <div>
              <div class="flex items-center gap-3 flex-wrap">
                <span id="table-badge" class="px-2 py-0.5 text-[11px] font-mono border border-rule text-smoke uppercase tracking-wider">Hiragana Dasar</span>
                <h2 id="table-title" class="text-[22px] sm:text-[26px] font-bold text-ink tracking-tight">
                  A. Tabel Huruf Hiragana Dasar
                </h2>
              </div>
              <p id="table-description" class="mt-1 text-[14px] text-steel">
                Aksara fonetik utama dalam bahasa Jepang.
              </p>
            </div>
            <div id="custom-table-actions" class="hidden items-center gap-2">
              <button type="button" id="delete-table-btn" class="px-3 py-1 text-[12px] border border-rule text-smoke hover:text-ink hover:border-ink">
                Hapus Tabel Kustom Ini
              </button>
            </div>
          </div>

          <!-- The Text Grid / Table (Formatted exact to user's image) -->
          <div class="w-full overflow-x-auto pb-4">
            <div id="table-grid-wrapper" class="inline-block min-w-full align-middle">
              <!-- Table will be rendered here -->
            </div>
          </div>

          <!-- Instructions footer -->
          <div class="mt-6 p-4 border border-dashed border-rule text-[13px] text-smoke flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <span>💡 <strong>Tips:</strong> Klik kotak huruf untuk mendengarkan pengucapan audio aslinya.</span>
            <span class="font-mono text-[12px]">Format: [Romaji/Cara Baca] = [Aksara]</span>
          </div>
        </div>

      </div>
    </div>
  </Section>

  <!-- ======================================================== -->
  <!-- [02] KATALOG 250 NEGARA & TARGET BELAJAR (SELALU AKTIF)  -->
  <!-- ======================================================== -->
  <Section id="katalog-section" top={true} inner="px-6 pt-14 pb-18 lg:pt-16 lg:pb-22 max-md:px-5">
    <div class="max-w-4xl">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <p class="label"><b>[02]</b> database 250 negara & target belajar</p>
          <h2 class="mt-4 text-[clamp(28px,3.8vw,44px)] leading-[1.1] font-bold tracking-[-0.035em]">
            Katalog 250 Negara di Dunia
          </h2>
          <p class="mt-3 max-w-[65ch] text-[15px] leading-[1.6] text-steel">
            Tandai bintang ⭐ pada negara yang ingin Anda pelajari atau klik "Buka Tabel Aksara" untuk belajar langsung.
          </p>
        </div>
        <div class="flex items-center gap-2">
          <button type="button" id="btn-cloud-sync-trigger" class="btn btn-secondary btn-s text-[12px]" title="Masuk untuk sinkronisasi materi ke smartphone & laptop lain">
            ☁️ Sinkron Akun
          </button>
          <button type="button" id="btn-export-backup" class="btn btn-secondary btn-s text-[12px]" title="Simpan file cadangan target belajar & tabel kustom">
            📥 Backup JSON
          </button>
          <label class="btn btn-secondary btn-s text-[12px] cursor-pointer" title="Pulihkan cadangan dari file JSON">
            📤 Import JSON
            <input type="file" id="input-import-file" accept=".json" class="hidden" />
          </label>
        </div>
      </div>
    </div>

    <!-- Country Catalog Content (Always Visible) -->
    <div id="section-countries" class="mt-8 space-y-6">
        
      <!-- Filter Pills & Search -->
      <div class="p-5 border border-rule bg-canvas space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap items-center gap-1.5 text-[13px]" id="country-region-filters">
            <button type="button" data-filter="all" class="px-3 py-1 font-mono border border-ink bg-ink text-canvas font-bold">
              Semua (<span id="total-country-count">250</span>)
            </button>
            <button type="button" data-filter="targets" class="px-3 py-1 font-mono border border-rule bg-canvas text-steel hover:text-ink">
              ⭐ Target Saya (<span id="filter-target-count">0</span>)
            </button>
            <button type="button" data-filter="Asia" class="px-3 py-1 font-mono border border-rule bg-canvas text-steel hover:text-ink">Asia</button>
            <button type="button" data-filter="Eropa" class="px-3 py-1 font-mono border border-rule bg-canvas text-steel hover:text-ink">Eropa</button>
            <button type="button" data-filter="Timur Tengah" class="px-3 py-1 font-mono border border-rule bg-canvas text-steel hover:text-ink">Timur Tengah</button>
            <button type="button" data-filter="Amerika" class="px-3 py-1 font-mono border border-rule bg-canvas text-steel hover:text-ink">Amerika</button>
            <button type="button" data-filter="Afrika" class="px-3 py-1 font-mono border border-rule bg-canvas text-steel hover:text-ink">Afrika</button>
            <button type="button" data-filter="Oseania" class="px-3 py-1 font-mono border border-rule bg-canvas text-steel hover:text-ink">Oseania</button>
          </div>

          <div class="w-full sm:w-72">
            <input 
              type="text" 
              id="country-search-input" 
              placeholder="Cari negara / bahasa / ibukota..." 
              class="w-full px-3 py-1.5 text-[13px] bg-tint border border-rule text-ink outline-none focus:border-ink font-mono"
            />
          </div>
        </div>

        <!-- Showing count status -->
        <div class="flex items-center justify-between text-[12px] text-smoke pt-1 border-t border-rule">
          <span id="country-results-info">Menampilkan negara...</span>
        </div>
      </div>

      <!-- Country Cards Grid -->
      <div id="countries-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- Rendered dynamically by client script -->
      </div>

      <!-- Load More Button -->
      <div id="load-more-wrapper" class="hidden text-center pt-4">
        <button type="button" id="btn-load-more" class="btn btn-secondary px-8 py-2 text-[13px]">
          Tampilkan Lebih Banyak Negara (+36) ↓
        </button>
      </div>

    </div>
  </Section>

  <!-- ========================================== -->
  <!-- CUSTOM TABLE CREATOR MODAL (DENGAN DUKUNGAN EXCEL & CSV) -->
  <!-- ========================================== -->
  <div id="buat-tabel" class="frame px-6 max-md:px-5">
    <div id="creator-modal" class="hidden my-8 p-6 border-2 border-ink bg-canvas shadow-2xl">
          <div class="flex items-center justify-between border-b border-rule pb-4 mb-6">
            <div>
              <h3 class="text-[20px] font-bold text-ink">Buat Tabel / Halaman Bahasa Sendiri</h3>
              <p class="text-[13px] text-steel mt-1">
                Tambahkan materi atau bahasa apa saja dengan format teks bebas, atau <strong>impor langsung dari file Excel/Spreadsheet</strong> Anda.
              </p>
            </div>
            <button type="button" id="close-creator-btn" class="btn btn-secondary btn-s">✕ Tutup</button>
          </div>

          <form id="creator-form" class="space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="form-name" class="block text-[13px] font-mono text-steel mb-1.5">Nama Bahasa / Kategori *</label>
                <input 
                  type="text" 
                  id="form-name" 
                  required 
                  placeholder="Misal: Mandarin (Hanzi), Jerman, dll." 
                  class="w-full px-3 py-2 text-[14px] bg-tint border border-rule text-ink outline-none focus:border-ink"
                />
              </div>
              <div>
                <label for="form-title" class="block text-[13px] font-mono text-steel mb-1.5">Judul Tabel *</label>
                <input 
                  type="text" 
                  id="form-title" 
                  required 
                  placeholder="Misal: Tabel Angka 1-10, Tabel Aksara Khusus" 
                  class="w-full px-3 py-2 text-[14px] bg-tint border border-rule text-ink outline-none focus:border-ink"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="form-desc" class="block text-[13px] font-mono text-steel mb-1.5">Keterangan Singkat</label>
                <input 
                  type="text" 
                  id="form-desc" 
                  placeholder="Keterangan singkat materi belajar ini..." 
                  class="w-full px-3 py-2 text-[14px] bg-tint border border-rule text-ink outline-none focus:border-ink"
                />
              </div>
              <div>
                <label for="form-voice" class="block text-[13px] font-mono text-steel mb-1.5">Kode Suara Audio (Opsional)</label>
                <select id="form-voice" class="w-full px-3 py-2 text-[14px] bg-tint border border-rule text-ink outline-none focus:border-ink">
                  <option value="ja-JP">Jepang (ja-JP)</option>
                  <option value="de-DE">Jerman (de-DE)</option>
                  <option value="ko-KR">Korea (ko-KR)</option>
                  <option value="zh-CN">Mandarin (zh-CN)</option>
                  <option value="th-TH">Thailand (th-TH)</option>
                  <option value="ar-SA">Arab (ar-SA)</option>
                  <option value="ru-RU">Rusia (ru-RU)</option>
                  <option value="fr-FR">Prancis (fr-FR)</option>
                  <option value="es-ES">Spanyol (es-ES)</option>
                  <option value="it-IT">Italia (it-IT)</option>
                  <option value="pt-PT">Portugis (pt-PT)</option>
                  <option value="nl-NL">Belanda (nl-NL)</option>
                  <option value="en-US">Inggris (en-US)</option>
                  <option value="id-ID">Indonesia (id-ID)</option>
                </select>
              </div>
            </div>

            <!-- Content Area with Excel Import Toolbar -->
            <div>
              <div class="flex items-center justify-between mb-2 flex-wrap gap-2">
                <label for="form-text" class="block text-[13px] font-mono text-steel">
                  Isi Tabel * (Bisa copy-paste langsung dari Excel atau upload file)
                </label>
                <div class="flex items-center gap-3">
                  <!-- Excel Upload Button -->
                  <label class="btn btn-secondary btn-s text-[12px] cursor-pointer flex items-center gap-1.5 font-bold hover:border-ink">
                    <span>📊 Import Excel / CSV</span>
                    <input type="file" id="form-excel-input" accept=".xlsx, .xls, .csv, .tsv, .txt" class="hidden" />
                  </label>
                  <button type="button" id="load-sample-btn" class="text-[12px] text-smoke hover:text-ink">
                    Contoh Data
                  </button>
                </div>
              </div>
              <textarea 
                id="form-text" 
                rows="8" 
                required
                placeholder={"Bisa paste langsung dari Excel (Ctrl+V) atau ketik:\nA = あ | I = い | U = う | E = え | O = お\nKa = か | Ki = き | Ku = く | Ke = け | Ko = こ\natau format kolom: Romaji [TAB] Karakter"}
                class="w-full px-3 py-2.5 text-[14px] font-mono bg-tint border border-rule text-ink outline-none focus:border-ink leading-relaxed"
              ></textarea>
              <div class="mt-2 text-[12px] text-smoke flex items-center justify-between flex-wrap gap-2">
                <span>💡 <strong>Tips Excel:</strong> Cukup blok sel di Excel/Google Sheets, tekan <code>Ctrl+C</code>, lalu paste <code>Ctrl+V</code> di sini!</span>
                <span class="text-ok font-bold">Mendukung .xlsx, .csv, &amp; Copy-Paste Excel ✓</span>
              </div>
            </div>

            <!-- Realtime Preview inside Creator -->
            <div class="border-t border-rule pt-4">
              <span class="label">Live Preview Tabel:</span>
              <div id="creator-preview" class="mt-3 p-3 bg-tint border border-rule min-h-[80px] overflow-x-auto text-[13px]">
                <span class="text-smoke italic">Ketik atau paste dari Excel di kotak atas untuk melihat pratinjau tabel...</span>
              </div>
            </div>

            <div class="flex items-center gap-3 pt-2">
              <button type="submit" class="btn btn-primary">
                💾 Simpan & Tampilkan Tabel
              </button>
              <button type="button" id="cancel-creator-btn" class="btn btn-secondary">
                Batal
              </button>
            </div>
          </form>
        </div>
      </div>

  <!-- Client-side Interactive Application Script -->
  <script is:inline>
    (function () {
      const appEl = document.getElementById('main-app');
      if (!appEl) return;

      const defaultTables = JSON.parse(appEl.dataset.defaults || '[]');
      const allCountries = JSON.parse(appEl.dataset.countries || '[]');

      const STORAGE_CUSTOM_TABLES = 'belajar_bahasa_custom_tables_v1';
      const STORAGE_TARGET_COUNTRIES = 'belajar_bahasa_target_countries_v1';

      let customTables = [];
      let targetCountryIds = [];

      try {
        const storedTables = localStorage.getItem(STORAGE_CUSTOM_TABLES);
        if (storedTables) customTables = JSON.parse(storedTables);

        const storedTargets = localStorage.getItem(STORAGE_TARGET_COUNTRIES);
        if (storedTargets) {
          targetCountryIds = JSON.parse(storedTargets);
        } else {
          // Default initial targets (Japan, Germany, South Korea)
          targetCountryIds = ['jp', 'de', 'kr'];
          localStorage.setItem(STORAGE_TARGET_COUNTRIES, JSON.stringify(targetCountryIds));
        }
      } catch (e) {
        console.error(e);
      }

      function getAllTables() {
        return [...defaultTables, ...customTables];
      }

      let activeView = 'tables'; // 'tables' or 'countries'
      let currentTableId = defaultTables[0]?.id || '';
      let isAudioEnabled = true;
      let tableSearchQuery = '';
      let countryFilter = 'all'; // 'targets', 'all', 'Asia', 'Eropa', etc.
      let countrySearchQuery = '';
      let countryDisplayLimit = 36;

      // DOM Elements
      const btnViewTables = document.getElementById('btn-view-tables');
      const btnViewCountries = document.getElementById('btn-view-countries');
      const heroGotoCountries = document.getElementById('hero-goto-countries');
      const sectionTables = document.getElementById('section-tables');
      const sectionCountries = document.getElementById('section-countries');
      const targetCountBadge = document.getElementById('target-count-badge');
      const filterTargetCount = document.getElementById('filter-target-count');
      const totalCountryCount = document.getElementById('total-country-count');

      // Table DOM
      const tabBar = document.getElementById('tab-bar');
      const tableTitle = document.getElementById('table-title');
      const tableBadge = document.getElementById('table-badge');
      const tableDescription = document.getElementById('table-description');
      const gridWrapper = document.getElementById('table-grid-wrapper');
      const searchInput = document.getElementById('search-input');
      const toggleAudioBtn = document.getElementById('toggle-audio-btn');
      const audioStatusLabel = document.getElementById('audio-status-label');
      const copyAllBtn = document.getElementById('copy-all-btn');
      const openCreatorBtn = document.getElementById('open-creator-btn');
      const closeCreatorBtn = document.getElementById('close-creator-btn');
      const cancelCreatorBtn = document.getElementById('cancel-creator-btn');
      const creatorModal = document.getElementById('creator-modal');
      const creatorForm = document.getElementById('creator-form');
      const formText = document.getElementById('form-text');
      const formExcelInput = document.getElementById('form-excel-input');
      const creatorPreview = document.getElementById('creator-preview');
      const loadSampleBtn = document.getElementById('load-sample-btn');
      const customActions = document.getElementById('custom-table-actions');
      const deleteTableBtn = document.getElementById('delete-table-btn');

      // Country DOM
      const countriesGrid = document.getElementById('countries-grid');
      const countrySearchInput = document.getElementById('country-search-input');
      const countryFilterButtons = document.querySelectorAll('#country-region-filters button');
      const countryResultsInfo = document.getElementById('country-results-info');
      const loadMoreWrapper = document.getElementById('load-more-wrapper');
      const btnLoadMore = document.getElementById('btn-load-more');
      const btnExportBackup = document.getElementById('btn-export-backup');
      const inputImportFile = document.getElementById('input-import-file');

      // Toast
      const toast = document.getElementById('toast');
      const toastMessage = document.getElementById('toast-message');
      const toastClose = document.getElementById('toast-close');

      function showToast(msg) {
        if (!toast || !toastMessage) return;
        toastMessage.textContent = msg;
        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 3500);
      }
      if (toastClose) toastClose.addEventListener('click', () => toast.classList.add('hidden'));

      function updateBadges() {
        if (targetCountBadge) targetCountBadge.textContent = targetCountryIds.length;
        if (filterTargetCount) filterTargetCount.textContent = targetCountryIds.length;
        if (totalCountryCount) totalCountryCount.textContent = allCountries.length;
      }

      if (heroGotoCountries) {
        heroGotoCountries.addEventListener('click', (e) => {
          e.preventDefault();
          const target = document.getElementById('katalog-section');
          target?.scrollIntoView({ behavior: 'smooth' });
        });
      }

      // Speech Synthesizer
      function speakText(text, lang) {
        if (!isAudioEnabled) return;
        if (!('speechSynthesis' in window)) return;
        window.speechSynthesis.cancel();
        const utter = new SpeechSynthesisUtterance(text);
        if (lang) utter.lang = lang;
        utter.rate = 0.85;
        window.speechSynthesis.speak(utter);
      }

      // Parse text into table grid (Mendukung format pipa |, koma ,, dan TAB dari Excel)
      function parseTextToGrid(text) {
        const lines = text.split('\n').map(l => l.trim()).filter(Boolean);
        const grid = [];
        for (const line of lines) {
          let parts = [];
          
          if (line.includes('\t')) {
            // Langsung dari copy-paste Excel (Tab Separated)
            parts = line.split('\t').map(p => p.trim());
            if (parts.length === 2 && !parts[0].includes('=') && !parts[1].includes('=')) {
              grid.push([{ romaji: parts[0], char: parts[1] }]);
              continue;
            }
            if (parts.length > 2 && parts.length % 2 === 0) {
              const row = [];
              for (let i = 0; i < parts.length; i += 2) {
                row.push({ romaji: parts[i], char: parts[i+1] });
              }
              grid.push(row);
              continue;
            }
          } else if (line.includes('|')) {
            parts = line.split('|').map(p => p.trim());
          } else if (line.includes(';')) {
            parts = line.split(';').map(p => p.trim());
          } else if (line.includes(',')) {
            parts = line.split(',').map(p => p.trim());
          } else {
            parts = [line];
          }

          const row = [];
          for (const part of parts) {
            if (!part || part === '-' || part.toLowerCase() === 'null') {
              row.push(null);
              continue;
            }
            if (part.includes('=')) {
              const [romaji, char] = part.split('=').map(s => s.trim());
              row.push({ romaji: romaji || '', char: char || '' });
            } else if (part.includes(':')) {
              const [romaji, char] = part.split(':').map(s => s.trim());
              row.push({ romaji: romaji || '', char: char || '' });
            } else {
              row.push({ romaji: '', char: part });
            }
          }
          if (row.length > 0) grid.push(row);
        }
        return grid;
      }

      // Excel / CSV File Import Handler
      if (formExcelInput && formText) {
        formExcelInput.addEventListener('change', (e) => {
          const file = e.target.files?.[0];
          if (!file) return;

          const fileName = file.name.toLowerCase();
          const isExcel = fileName.endsWith('.xlsx') || fileName.endsWith('.xls');

          if (isExcel) {
            showToast(`Membaca file Excel "${file.name}"...`);
            
            function readWorkbook() {
              const reader = new FileReader();
              reader.onload = (evt) => {
                try {
                  const data = new Uint8Array(evt.target.result);
                  const workbook = window.XLSX.read(data, { type: 'array' });
                  const sheetName = workbook.SheetNames[0];
                  const worksheet = workbook.Sheets[sheetName];
                  const jsonRows = window.XLSX.utils.sheet_to_json(worksheet, { header: 1 });

                  const formattedLines = [];
                  for (const row of jsonRows) {
                    if (!row || row.length === 0) continue;
                    if (row.length === 2) {
                      formattedLines.push(`${row[0]} = ${row[1]}`);
                    } else {
                      const rowItems = [];
                      for (let i = 0; i < row.length; i += 2) {
                        if (row[i] !== undefined && row[i+1] !== undefined) {
                          rowItems.push(`${row[i]} = ${row[i+1]}`);
                        } else if (row[i] !== undefined) {
                          rowItems.push(`${row[i]}`);
                        }
                      }
                      if (rowItems.length > 0) formattedLines.push(rowItems.join(' | '));
                    }
                  }

                  formText.value = formattedLines.join('\n');
                  updateLivePreview();
                  
                  // Auto suggest title if blank
                  const titleInput = document.getElementById('form-title');
                  if (titleInput && !titleInput.value) {
                    const cleanName = file.name.replace(/\.[^/.]+$/, '').replace(/[-_]/g, ' ');
                    titleInput.value = 'Tabel ' + cleanName;
                  }

                  showToast(`File Excel "${file.name}" berhasil diimpor (${formattedLines.length} baris)!`);
                } catch (err) {
                  console.error(err);
                  alert('Gagal membaca file Excel. Pastikan format valid.');
                }
              };
              reader.readAsArrayBuffer(file);
            }

            if (!window.XLSX) {
              const s = document.createElement('script');
              s.src = 'https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js';
              s.onload = readWorkbook;
              document.head.appendChild(s);
            } else {
              readWorkbook();
            }
          } else {
            // CSV / TSV / TXT
            const reader = new FileReader();
            reader.onload = (evt) => {
              const text = evt.target.result;
              formText.value = text;
              updateLivePreview();
              showToast(`File "${file.name}" berhasil diimpor!`);
            };
            reader.readAsText(file);
          }
        });
      }

      // Render Language Tabs
      function renderTabs() {
        if (!tabBar) return;
        tabBar.innerHTML = '';
        const allTables = getAllTables();

        allTables.forEach(t => {
          const isCustom = customTables.some(c => c.id === t.id);
          const btn = document.createElement('button');
          btn.type = 'button';
          const isActive = t.id === currentTableId;
          btn.className = `px-3.5 py-1.5 text-[13px] font-mono border transition-colors ${
            isActive 
              ? 'bg-ink text-canvas border-ink font-bold' 
              : 'bg-canvas text-steel border-rule hover:text-ink hover:border-ink'
          }`;
          btn.innerHTML = `${t.name} ${isCustom ? '<span class="text-[10px] opacity-75 font-sans">[Custom]</span>' : ''}`;
          btn.addEventListener('click', () => {
            currentTableId = t.id;
            tableSearchQuery = '';
            if (searchInput) searchInput.value = '';
            renderTabs();
            renderCurrentTable();
          });
          tabBar.appendChild(btn);
        });
      }

      // Render Table Grid
      function renderCurrentTable() {
        const allTables = getAllTables();
        const currentTable = allTables.find(t => t.id === currentTableId) || allTables[0];
        if (!currentTable) return;

        const isCustom = customTables.some(c => c.id === currentTable.id);
        if (customActions) {
          if (isCustom) {
            customActions.classList.remove('hidden');
            customActions.classList.add('flex');
          } else {
            customActions.classList.add('hidden');
            customActions.classList.remove('flex');
          }
        }

        if (tableTitle) tableTitle.textContent = currentTable.title;
        if (tableBadge) tableBadge.textContent = currentTable.badge || currentTable.name;
        if (tableDescription) tableDescription.textContent = currentTable.description || '';

        let html = '<table class="w-full border-collapse border border-ink text-center bg-canvas select-text font-mono">';
        html += '<tbody>';

        const filter = tableSearchQuery.trim().toLowerCase();

        currentTable.grid.forEach((row) => {
          html += '<tr>';
          row.forEach((cell) => {
            if (!cell) {
              html += '<td class="border border-ink p-3 sm:p-4 bg-tint/40 min-w-[70px] sm:min-w-[90px] h-16 sm:h-20"></td>';
              return;
            }

            const matches = !filter || 
              cell.romaji.toLowerCase().includes(filter) || 
              cell.char.toLowerCase().includes(filter);

            const highlightClass = filter && matches ? 'bg-badge/20 font-bold ring-2 ring-badge' : '';
            const dimClass = filter && !matches ? 'opacity-25' : '';

            html += `<td 
              class="border border-ink p-2 sm:p-4 hover:bg-tint cursor-pointer transition-colors min-w-[70px] sm:min-w-[100px] h-16 sm:h-20 ${highlightClass} ${dimClass}"
              data-char="${cell.char}"
              data-romaji="${cell.romaji}"
              data-lang="${currentTable.voiceLang || ''}"
              title="Klik untuk dengar suara atau salin '${cell.char}'"
            >`;
            html += `<div class="flex items-center justify-center gap-1.5 sm:gap-2 text-[15px] sm:text-[18px]">`;
            if (cell.romaji) {
              html += `<span class="text-steel font-normal">${cell.romaji}</span>`;
              html += `<span class="text-smoke select-none">=</span>`;
            }
            html += `<span class="text-ink font-bold text-[18px] sm:text-[22px] tracking-wide">${cell.char}</span>`;
            html += `</div>`;
            html += `</td>`;
          });
          html += '</tr>';
        });

        html += '</tbody></table>';
        if (gridWrapper) gridWrapper.innerHTML = html;

        const cells = gridWrapper.querySelectorAll('td[data-char]');
        cells.forEach(td => {
          td.addEventListener('click', () => {
            const char = td.getAttribute('data-char');
            const lang = td.getAttribute('data-lang');
            const romaji = td.getAttribute('data-romaji');
            speakText(char, lang);
            navigator.clipboard?.writeText(char);
            showToast(`Karakter "${char}" (${romaji}) disalin ke clipboard! 🔊`);
          });
        });
      }

      // Render Countries
      function renderCountries() {
        if (!countriesGrid) return;
        updateBadges();

        const query = countrySearchQuery.trim().toLowerCase();

        let filtered = allCountries.filter(c => {
          if (countryFilter === 'targets') {
            return targetCountryIds.includes(c.id);
          }
          if (countryFilter === 'all') return true;
          return c.region === countryFilter;
        });

        if (query) {
          filtered = filtered.filter(c => 
            c.name.toLowerCase().includes(query) || 
            (c.nativeName && c.nativeName.toLowerCase().includes(query)) || 
            (c.capital && c.capital.toLowerCase().includes(query)) || 
            (c.language && c.language.toLowerCase().includes(query))
          );
        }

        const totalFiltered = filtered.length;
        if (countryResultsInfo) {
          countryResultsInfo.textContent = `Menampilkan ${Math.min(filtered.length, countryDisplayLimit)} dari ${totalFiltered} negara (${countryFilter === 'targets' ? 'Target Saya' : countryFilter})`;
        }

        if (filtered.length === 0) {
          countriesGrid.innerHTML = `
            <div class="col-span-full p-8 text-center border border-rule bg-canvas text-smoke font-mono text-[14px]">
              Tidak ada negara yang cocok dengan kriteria pencarian.
              ${countryFilter === 'targets' ? '<br><span class="text-[12px] text-steel">Pilih filter "Semua (250)" lalu klik tombol bintang ⭐ untuk menambah target belajar Anda!</span>' : ''}
            </div>
