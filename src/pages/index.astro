      if (loadSampleBtn && formText) {
        loadSampleBtn.addEventListener('click', () => {
          document.getElementById('form-name').value = 'Jerman (Umlaut & Sapaan)';
          document.getElementById('form-title').value = 'Tabel Huruf Khusus Bahasa Jerman';
          document.getElementById('form-desc').value = 'Aksara Ä, Ö, Ü, ß dan contoh kata dasar.';
          document.getElementById('form-voice').value = 'de-DE';
          formText.value = 
`Ä = ä | Ö = ö | Ü = ü | Eszett = ß | Ai = ei
Oi = eu | Ie = ie | Kh = ch | Sy = sch | Ts = z`;
          updateLivePreview();
        });
      }

      function updateLivePreview() {
        if (!creatorPreview || !formText) return;
        const grid = parseTextToGrid(formText.value);
        if (grid.length === 0) {
          creatorPreview.innerHTML = '<span class="text-smoke italic">Ketik atau paste dari Excel di kotak atas untuk melihat pratinjau tabel...</span>';
          return;
        }

        let html = '<table class="w-full border-collapse border border-rule text-center bg-canvas">';
        html += '<tbody>';
        grid.forEach(row => {
          html += '<tr>';
          row.forEach(cell => {
            if (!cell) {
              html += '<td class="border border-rule p-2 bg-tint/40"></td>';
              return;
            }
            html += '<td class="border border-rule p-2">';
            html += `<span class="text-steel">${cell.romaji || ''}</span> ${cell.romaji ? '=' : ''} <span class="text-ink font-bold">${cell.char}</span>`;
            html += '</td>';
          });
          html += '</tr>';
        });
        html += '</tbody></table>';
        creatorPreview.innerHTML = html;
      }

      if (formText) formText.addEventListener('input', updateLivePreview);

      // Submit new table
      if (creatorForm) {
        creatorForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const name = document.getElementById('form-name').value.trim();
          const title = document.getElementById('form-title').value.trim();
          const desc = document.getElementById('form-desc').value.trim();
          const voice = document.getElementById('form-voice').value;
          const text = formText.value.trim();

          const grid = parseTextToGrid(text);
          if (grid.length === 0) {
            alert('Harap masukkan isi tabel terlebih dahulu.');
            return;
          }

          const newTable = {
            id: 'custom-' + Date.now(),
            name: name,
            badge: 'Tabel Kustom',
            title: title,
            description: desc,
            voiceLang: voice,
            grid: grid
          };

          customTables.push(newTable);
          try {
            localStorage.setItem(STORAGE_CUSTOM_TABLES, JSON.stringify(customTables));
          } catch (err) {
            console.error(err);
          }

          // Trigger simpan ke Supabase jika sedang login
          window.dispatchEvent(new CustomEvent('custom-table-saved', {
            detail: { table: newTable }
          }));

          creatorForm.reset();
          if (creatorPreview) {
            creatorPreview.innerHTML = '<span class="text-smoke italic">Ketik di kotak atas untuk melihat pratinjau tabel...</span>';
          }
          creatorModal.classList.add('hidden');

          currentTableId = newTable.id;
          renderTabs();
          renderCurrentTable();
          showToast(`Tabel baru "${title}" berhasil dibuat dan disimpan!`);
          const area = document.getElementById('area-belajar');
          if (area) area.scrollIntoView({ behavior: 'smooth' });
        });
      }

      // Supabase Cloud Sync trigger button in Katalog
      const btnCloudSyncTrigger = document.getElementById('btn-cloud-sync-trigger');
      if (btnCloudSyncTrigger) {
        btnCloudSyncTrigger.addEventListener('click', () => {
          const authModal = document.getElementById('auth-modal');
          if (authModal && typeof authModal.showModal === 'function') {
            authModal.showModal();
          }
        });
      }

      // Listen data loaded dari Supabase (sinkronisasi antar laptop / HP)
      window.addEventListener('supabase-data-loaded', (e) => {
        const { targets, tables } = e.detail || {};
        let needRerender = false;

        // 1. Sinkronkan target negara dari cloud
        if (Array.isArray(targets) && targets.length > 0) {
          const mergedTargets = Array.from(new Set([...targetCountryIds, ...targets]));
          if (mergedTargets.length !== targetCountryIds.length) {
            targetCountryIds = mergedTargets;
            try {
              localStorage.setItem(STORAGE_TARGET_COUNTRIES, JSON.stringify(targetCountryIds));
            } catch (err) {}
            needRerender = true;
          }
        }

        // 2. Sinkronkan tabel kustom dari cloud
        if (Array.isArray(tables) && tables.length > 0) {
          const existingIds = new Set(customTables.map(t => t.id));
          let tableAdded = false;

          tables.forEach((t) => {
            if (!existingIds.has(t.id)) {
              customTables.push({
                id: t.id,
                name: t.name,
                badge: 'Tabel Cloud',
                title: t.name,
                description: t.description || '',
                voiceLang: t.voiceLang || 'en-US',
                grid: t.rows || []
              });
              tableAdded = true;
            }
          });

          if (tableAdded) {
            try {
              localStorage.setItem(STORAGE_CUSTOM_TABLES, JSON.stringify(customTables));
            } catch (err) {}
            needRerender = true;
          }
        }

        if (needRerender) {
          updateBadges();
          renderTabs();
          renderCurrentTable();
          renderCountries();
        }
      });

      // Initial Renders
      updateBadges();
      renderTabs();
      renderCurrentTable();
      renderCountries();
    })();
  </script>
</Base>
