---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import MediaWindow from '../components/MediaWindow.astro';
import GuideWindow from '../components/GuideWindow.astro';
import AdNative from '../components/AdNative.astro';
import { defaultLanguageTables } from '../data/languages';
import { worldCountries } from '../data/countries';
import { 
  Volume2, 
  FileSpreadsheet, 
  Cloud, 
  Star, 
  BookOpen, 
  HelpCircle, 
  ChevronDown, 
  Sparkles, 
  Layers, 
  Flame, 
  Upload, 
  Download, 
  Plus, 
  Edit3, 
  CheckCircle2, 
  Globe 
} from 'lucide-astro';

const sampleTable = defaultLanguageTables[0]; // Jepang Hiragana
const sampleCountries = worldCountries.filter(c => ['JP', 'DE', 'KR', 'SA', 'ES', 'FR'].includes(c.code));
---

<Base title="Belajar Bahasa - Tabel Aksara Interaktif & Katalog Negara Dunia" description="Aplikasi tabel belajar aksara bahasa (Jepang, Jerman, Korea, Arab, dll.) dan katalog negara dunia dengan audio pengucapan asli dan integrasi cloud multi-perangkat.">
  
  <!-- [00] HERO: Pengenalan & Panduan Menggunakan Website -->
  <Section id="panduan" top={false} inner="px-6 pt-14 pb-18 lg:pt-20 lg:pb-24 max-md:px-5 overflow-hidden" label="Pengenalan Website">
    <div class="grid-bg" style="--gx:74%;--gy:50%" aria-hidden="true"></div>
    
    <!-- Retro-Tech Graphic Blueprint Background -->
    <svg class="absolute left-0 top-0 max-lg:hidden pointer-events-none" width="1280" height="653" viewBox="0 0 1280 653" fill="none" aria-hidden="true">
      <circle cx="1150" cy="146" r="150" stroke="var(--stone)" />
      <circle cx="1150" cy="146" r="96" stroke="var(--rule)" stroke-dasharray="3 4" />
      <circle cx="612" cy="567" r="58" stroke="var(--stone)" stroke-dasharray="3 4" />
      <polyline points="520,593 612,567 740,589 880,555 1010,581 1130,547" stroke="var(--ink)" stroke-dasharray="4 4" />
      <polyline points="700,122 820,90 960,112 1080,76" stroke="var(--ink)" stroke-dasharray="4 4" />
      {[[520, 593], [612, 567], [740, 589], [880, 555, 1], [1010, 581], [1130, 547], [700, 122], [820, 90, 1], [960, 112], [1080, 76]].map(([x, y, o]) => (
        <rect x={x - 4} y={y - 4} width="8" height="8" fill={o ? 'var(--cta)' : 'var(--canvas)'} stroke="var(--ink)" />
      ))}
      <g fill="var(--smoke)" font-size="11" font-family="inherit">
        <text x="534" y="615">tabel_aksara</text><text x="892" y="535">audio_speech</text><text x="1020" y="606">semua_negara</text><text x="832" y="70">integrasi_cloud</text>
      </g>
      <g stroke="var(--ink)"><path d="M580.5 96h11M586 90.5v11M1230.5 537h11M1236 531.5v11M34.5 613h11M40 607.5v11" /></g>
    </svg>

    <div class="relative grid grid-cols-1 lg:grid-cols-[1fr_520px] gap-12 lg:gap-14 items-center">
      <!-- Left: Introduction Text & CTA -->
      <div>
        <p class="label"><b>[00]</b> platform belajar mandiri</p>
        <h1 class="mt-5 text-[clamp(34px,4.8vw,60px)] leading-[1.04] font-bold tracking-[-0.04em] text-ink">
          Belajar Aksara Bahasa &amp; Catat Target Negaramu.
        </h1>
        <p class="mt-6 max-w-[50ch] text-[16px] leading-[1.6] text-steel max-md:text-[15px]">
          Selamat datang di platform belajar bahasa mandiri. Pelajari tabel aksara fonetik (Jepang, Jerman, Korea, Arab, dll.) dengan audio lafal asli, jelajahi katalog negara di dunia, dan integrasikan progres Anda ke cloud secara aman.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="/belajar" class="btn btn-primary max-md:w-full font-mono text-[14px]">
            Mulai Belajar Aksara →
          </a>
          <a href="/katalog" class="btn btn-secondary max-md:w-full font-mono text-[14px]">
            Jelajahi Semua Negara →
          </a>
        </div>

        <div class="mt-7 flex items-center w-fit max-w-full border border-rule bg-canvas text-[13px] font-mono shadow-sm">
          <code class="min-w-0 flex-1 px-3 sm:px-4 py-2 sm:py-2.5 text-ink truncate text-xs sm:text-[13px]"><span class="text-smoke select-none">fitur: </span>audio native · semua negara · integrasi cloud</code>
          <span class="shrink-0 px-3 sm:px-3.5 py-2 sm:py-2.5 border-l border-rule text-ok font-bold text-xs sm:text-[13px]">100% GRATIS</span>
        </div>
      </div>

      <!-- Right: MediaWindow with Animated Guide Steps -->
      <div>
        <MediaWindow title="app.belajar-bahasa.com/panduan" shadow>
          <GuideWindow />
        </MediaWindow>
      </div>
    </div>
  </Section>

  <!-- [01] SHOWCASE: Pratinjau Interaktif Studio Belajar Aksara -->
  <Section top={true} inner="px-6 pt-14 pb-18 lg:pt-16 lg:pb-22 max-md:px-5">
    <div class="w-full">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-rule">
        <div>
          <p class="label"><b>[01]</b> pratinjau studio belajar</p>
          <h2 class="mt-3 text-[clamp(26px,3.5vw,40px)] leading-[1.1] font-bold tracking-[-0.035em] text-ink">
            Tabel Huruf &amp; Aksara Interaktif
          </h2>
          <p class="mt-2 text-[15px] text-steel max-w-[60ch]">
            Klik kotak karakter di bawah untuk mendengar suara pengucapan audio aslinya dengan suara Google Speech. Tersedia lebih dari 12 aksara bahasa dunia.
          </p>
        </div>
        <a href="/belajar" class="btn btn-primary btn-s shrink-0 font-mono text-[13px]">
          Buka Studio Belajar Lengkap →
        </a>
      </div>

      <!-- Sample Interactive Preview Table -->
      <div class="mt-8 p-5 sm:p-6 border border-rule bg-canvas shadow-sm">
        <div class="flex items-center justify-between gap-3 pb-4 mb-4 border-b border-rule flex-wrap">
          <div class="flex items-center gap-2">
            <span class="text-lg">🇯🇵</span>
            <span class="font-bold text-ink text-[16px]">Pratinjau Aksara Hiragana (5 Baris Pertama)</span>
          </div>
          <span class="text-smoke font-mono text-[12px] flex items-center gap-1.5"><Volume2 class="size-3.5 text-steel inline" /> Suara Asli Google Speech · Klik sel untuk mendengarkan</span>
        </div>

        <div class="overflow-x-auto pb-2">
          <table class="w-full border-collapse border border-ink text-center bg-canvas font-mono" id="hero-preview-table">
            <tbody>
              {sampleTable.grid.slice(0, 5).map((row) => (
                <tr>
                  {row.map((cell) => (
                    cell ? (
                      <td 
                        class="border border-ink p-3 sm:p-4 hover:bg-tint cursor-pointer transition-colors min-w-[70px] sm:min-w-[90px] h-16 sm:h-20"
                        data-char={cell.char}
                        data-lang="ja-JP"
                        data-romaji={cell.romaji}
                        title={`Klik untuk dengar suara '${cell.char}' (${cell.romaji})`}
                      >
                        <div class="flex items-center justify-center gap-1.5 sm:gap-2 text-[15px] sm:text-[18px]">
                          <span class="text-steel font-normal">{cell.romaji}</span>
                          <span class="text-smoke select-none">=</span>
                          <span class="text-ink font-bold text-[18px] sm:text-[22px]">{cell.char}</span>
                        </div>
                      </td>
                    ) : (
                      <td class="border border-ink p-3 sm:p-4 bg-tint/40 min-w-[70px] sm:min-w-[90px] h-16 sm:h-20"></td>
                    )
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="mt-6 flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-rule text-[13px]">
          <span class="text-steel">Termasuk: Katakana, Hangul Korea, Hijaiyah Arab, Hanzi Mandarin, Thai, Jerman, Rusia, dll.</span>
          <a href="/belajar" class="btn btn-secondary btn-s font-mono text-[13px] shrink-0">
            Pilih Bahasa Lain di Studio →
          </a>
        </div>
      </div>
    </div>
  </Section>

  <!-- [02] SHOWCASE: Katalog Semua Negara di Dunia -->
  <Section top={true} inner="px-6 pt-14 pb-18 lg:pt-16 lg:pb-22 max-md:px-5">
    <div class="w-full">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-rule">
        <div>
          <p class="label"><b>[02]</b> katalog target belajar</p>
          <h2 class="mt-3 text-[clamp(26px,3.5vw,40px)] leading-[1.1] font-bold tracking-[-0.035em] text-ink">
            Katalog Semua Negara di Dunia
          </h2>
          <p class="mt-2 text-[15px] text-steel max-w-[60ch]">
            Pantau dan tandai bintang ⭐ pada negara tujuan belajar bahasa Anda. Dilengkapi data kawasan, ibukota, dan bahasa resmi.
          </p>
        </div>
        <a href="/katalog" class="btn btn-secondary btn-s shrink-0 font-mono text-[13px]">
          Buka Katalog Negara Lengkap →
        </a>
      </div>

      <!-- Country Cards Preview Grid -->
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {sampleCountries.map((c) => (
          <div class="border border-rule bg-canvas p-5 flex flex-col justify-between hover:border-ink transition-colors shadow-sm">
            <div>
              <div class="flex items-start justify-between gap-2 border-b border-rule pb-3">
                <div class="flex items-center gap-2.5">
                  <span class="text-2xl leading-none" aria-hidden="true">{c.flag}</span>
                  <div>
                    <span class="font-bold text-[15px] text-ink">{c.name}</span>
                    <div class="text-[12px] text-smoke">{c.nativeName}</div>
                  </div>
                </div>
                <Star class="size-4 fill-badge text-badge shrink-0" />
              </div>
              <div class="mt-3 space-y-1.5 text-[12px] font-mono">
                <div class="flex justify-between"><span class="text-smoke">Kawasan:</span><span class="text-steel">{c.region}</span></div>
                <div class="flex justify-between"><span class="text-smoke">Ibukota:</span><span class="text-steel">{c.capital}</span></div>
                <div class="flex justify-between"><span class="text-smoke">Bahasa:</span><span class="text-ink font-semibold">{c.language}</span></div>
              </div>
            </div>
            <div class="mt-4 pt-3 border-t border-rule">
              <a href={`/belajar?lang=${c.tableId}`} class="btn btn-primary btn-s text-[12px] w-full justify-center text-center font-mono">
                <BookOpen class="size-3.5 inline mr-1" /> Pelajari Aksara {c.name}
              </a>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-8 text-center">
        <a href="/katalog" class="btn btn-secondary px-8 py-3 text-[14px] font-mono">
          Lihat Semua Negara di Halaman Katalog →
        </a>
      </div>
    </div>
  </Section>

  <!-- [03] FITUR UTAMA & INTEGRASI CLOUD -->
  <Section top={true} inner="px-6 pt-14 pb-18 lg:pt-16 lg:pb-22 max-md:px-5">
    <div class="w-full">
      <div class="pb-6 border-b border-rule">
        <p class="label"><b>[03]</b> arsitektur &amp; keunggulan</p>
        <h2 class="mt-3 text-[clamp(26px,3.5vw,40px)] leading-[1.1] font-bold tracking-[-0.035em] text-ink">
          Dirancang Cepat, Mandiri, &amp; Terhubung Cloud
        </h2>
      </div>

      <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Fitur 1 -->
        <div class="border border-rule bg-canvas p-6 space-y-3">
          <div class="size-10 rounded-none bg-tint flex items-center justify-center border border-rule text-ink">
            <Volume2 class="size-5" />
          </div>
          <h3 class="text-[17px] font-bold text-ink">Pelafalan Audio Suara Google</h3>
          <p class="text-[13px] text-steel leading-relaxed">
            Terintegrasi dengan mesin suara Google Speech &amp; Google Translate TTS untuk menghasilkan pengucapan fonetik aksara yang jernih dan akurat.
          </p>
        </div>

        <!-- Fitur 2 -->
        <div class="border border-rule bg-canvas p-6 space-y-3">
          <div class="size-10 rounded-none bg-tint flex items-center justify-center border border-rule text-ink">
            <FileSpreadsheet class="size-5" />
          </div>
          <h3 class="text-[17px] font-bold text-ink">Impor dari File Excel</h3>
          <p class="text-[13px] text-steel leading-relaxed">
            Punya catatan kosakata atau aksara di Excel? Cukup upload file .xlsx atau copy-paste tabel Anda langsung ke aplikasi.
          </p>
        </div>

        <!-- Fitur 3 -->
        <div class="border border-rule bg-canvas p-6 space-y-3">
          <div class="size-10 rounded-none bg-tint flex items-center justify-center border border-rule text-ink">
            <Cloud class="size-5" />
          </div>
          <h3 class="text-[17px] font-bold text-ink">Integrasi Cloud Otomatis</h3>
          <p class="text-[13px] text-steel leading-relaxed">
            Daftar akun gratis untuk menyimpan target negara dan materi tabel kustom Anda secara otomatis di penyimpanan cloud.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- [04] FAQ: TATA CARA PENGGUNAAN FITUR & BANTUAN SISTEM -->
  <Section id="faq" top={true} inner="px-6 pt-14 pb-18 lg:pt-16 lg:pb-22 max-md:px-5">
    <div class="w-full">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-rule">
        <div>
          <p class="label"><b>[04]</b> panduan fitur &amp; bantuan</p>
          <h2 class="mt-3 text-[clamp(26px,3.5vw,40px)] leading-[1.1] font-bold tracking-[-0.035em] text-ink">
            Pertanyaan Umum (FAQ) &amp; Tata Cara Penggunaan
          </h2>
          <p class="mt-2 text-[15px] text-steel max-w-[65ch]">
            Panduan komprehensif mengoperasikan seluruh fitur platform - mulai dari impor/ekspor file Excel, pembuatan materi tabel kustom bahasa global, hingga sinkronisasi data cloud.
          </p>
        </div>
        <div class="flex items-center gap-2 shrink-0 flex-wrap">
          <a href="/panduan" class="btn btn-primary btn-s font-mono text-[12px] inline-flex items-center gap-1.5">
            <HelpCircle class="size-3.5 inline" /> Buka Panduan Lengkap &amp; Template →
          </a>
          <a href="/belajar#buat-tabel" class="btn btn-secondary btn-s font-mono text-[12px] inline-flex items-center gap-1.5">
            <Plus class="size-3.5 inline" /> Buat Tabel
          </a>
        </div>
      </div>

      <!-- FAQ Accordion List -->
      <div class="mt-8 space-y-3.5 w-full">
        <!-- FAQ Item 1: Excel Import & Export -->
        <details id="faq-excel" class="group border border-rule bg-canvas open:border-ink transition-colors shadow-xs">
          <summary class="p-4 sm:p-5 cursor-pointer list-none flex items-center justify-between gap-3 select-none font-bold text-[15px] sm:text-[16px] text-ink hover:bg-tint/40">
            <span class="flex items-center gap-2.5">
              <span class="size-7 rounded-none bg-tint border border-rule flex items-center justify-center text-cta shrink-0 font-mono text-xs">
                <FileSpreadsheet class="size-4" />
              </span>
              <span>1. Bagaimana format file dan tata cara Impor / Ekspor Excel (.xlsx, .csv)?</span>
            </span>
            <ChevronDown class="size-4 text-smoke shrink-0 transition-transform duration-200 group-open:rotate-180" />
          </summary>
          <div class="px-5 pb-5 pt-1 text-[13px] sm:text-[14px] text-steel border-t border-rule/50 space-y-3.5 leading-relaxed font-sans">
            <p>
              Platform mendukung manipulasi spreadsheet dua arah (impor massal dan ekspor data) untuk tabel aksara, kamus frasa, maupun data katalog negara:
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 font-mono text-xs text-ink">
              <div class="p-3 border border-rule bg-tint/30">
                <span class="font-bold text-badge block mb-1">A. Format Tabel Aksara (2 Kolom):</span>
                <span class="text-steel block mb-1">Kolom A: Cara Baca / Romaji<br/>Kolom B: Aksara / Simbol Asli</span>
                <code class="text-[11px] bg-canvas px-1.5 py-0.5 border border-rule block">Contoh: Ka | か atau Alif | ا</code>
              </div>
              <div class="p-3 border border-rule bg-tint/30">
                <span class="font-bold text-badge block mb-1">B. Format Kumpulan Frasa (3 Kolom):</span>
                <span class="text-steel block mb-1">Kolom A: Frasa Asli<br/>Kolom B: Cara Baca<br/>Kolom C: Terjemahan Indonesia</span>
                <code class="text-[11px] bg-canvas px-1.5 py-0.5 border border-rule block">Arigatou | Arigatou | Terima kasih</code>
              </div>
            </div>
            <ul class="list-disc pl-5 space-y-1.5 text-steel">
              <li><strong>Cara Impor Tabel Aksara:</strong> Buka formulir <em>"+ Buat Tabel Kustom"</em> di Studio Belajar, klik <strong>"Pilih File Excel / CSV"</strong>, dan sistem akan langsung membaca seluruh baris menjadi grid aksara interaktif.</li>
              <li><strong>Cara Impor Frasa:</strong> Pada tab Frasa Sehari-hari, klik tombol <strong>"Impor Excel"</strong> untuk memasukkan ratusan frasa sekaligus ke dalam kategori pilihan.</li>
              <li><strong>Cara Ekspor Data:</strong> Di halaman Katalog Negara atau Studio Belajar, klik tombol <strong>"Ekspor (.xlsx)"</strong> untuk mengunduh salinan data lengkap ke komputer atau smartphone Anda.</li>
            </ul>
          </div>
        </details>

        <!-- FAQ Item 2: Custom Table Creation & Global Languages -->
        <details class="group border border-rule bg-canvas open:border-ink transition-colors shadow-xs">
          <summary class="p-4 sm:p-5 cursor-pointer list-none flex items-center justify-between gap-3 select-none font-bold text-[15px] sm:text-[16px] text-ink hover:bg-tint/40">
            <span class="flex items-center gap-2.5">
              <span class="size-7 rounded-none bg-tint border border-rule flex items-center justify-center text-ink shrink-0 font-mono text-xs">
                <Plus class="size-4" />
              </span>
              <span>2. Bagaimana cara membuat tabel materi kustom untuk bahasa dunia apa saja?</span>
            </span>
            <ChevronDown class="size-4 text-smoke shrink-0 transition-transform duration-200 group-open:rotate-180" />
          </summary>
          <div class="px-5 pb-5 pt-1 text-[13px] sm:text-[14px] text-steel border-t border-rule/50 space-y-3 leading-relaxed">
            <p>
              Anda tidak terbatas pada aksara bawaan. Anda dapat menambahkan materi bahasa apa saja di dunia (misal: Aksara Jawa Hanacaraka, Sunda, Batak, Sanskerta/Hindi, Cyrillic Rusia, Yunani, Ibrani, dll.):
            </p>
            <ol class="list-decimal pl-5 space-y-1.5 text-steel">
              <li>Klik tombol <strong>"+ Buat Tabel Kustom"</strong> di navigasi utama atau di halaman Studio Belajar.</li>
              <li>Isi nama bahasa dan judul tabel (misal: <em>"Aksara Jawa - Sandhangan Swara"</em>).</li>
              <li>Pilih bahasa suara TTS dari 35+ bahasa dunia atau masukkan kode bahasa kustom (BCP-47) seperti <code>jv-ID</code> (Jawa) atau <code>su-ID</code> (Sunda). Anda dapat menguji lafalnya dengan tombol <strong>"Coba Dengar"</strong>.</li>
              <li>Ketik data materi dengan format <code>Romaji = Karakter</code> dipisahkan tanda garis lurus (<code>|</code>) atau unggah file spreadsheet Excel Anda.</li>
              <li>Klik <strong>"Simpan &amp; Tampilkan Tabel"</strong>. Tabel kustom baru Anda akan langsung tampil dan dapat dipelajari dengan suara asli!</li>
            </ol>
          </div>
        </details>

        <!-- FAQ Item 3: Audio TTS & Pronunciation -->
        <details id="faq-audio" class="group border border-rule bg-canvas open:border-ink transition-colors shadow-xs">
          <summary class="p-4 sm:p-5 cursor-pointer list-none flex items-center justify-between gap-3 select-none font-bold text-[15px] sm:text-[16px] text-ink hover:bg-tint/40">
            <span class="flex items-center gap-2.5">
              <span class="size-7 rounded-none bg-tint border border-rule flex items-center justify-center text-ok shrink-0 font-mono text-xs">
                <Volume2 class="size-4" />
              </span>
              <span>3. Bagaimana cara mendengarkan audio pengucapan asli dan mengatur kecepatan suara?</span>
            </span>
            <ChevronDown class="size-4 text-smoke shrink-0 transition-transform duration-200 group-open:rotate-180" />
          </summary>
          <div class="px-5 pb-5 pt-1 text-[13px] sm:text-[14px] text-steel border-t border-rule/50 space-y-3 leading-relaxed">
            <p>
              Studio Belajar dilengkapi integrasi suara sintesis standar web (Web Speech API) yang memprioritaskan suara resmi Google TTS dan mesin suara bawaan perangkat Anda:
            </p>
            <ul class="list-disc pl-5 space-y-1.5 text-steel">
              <li><strong>Mendengar Huruf:</strong> Cukup klik atau ketuk kotak aksara mana saja di tabel untuk mendengar suara pengucapan audio aslinya secara instan.</li>
              <li><strong>Pengatur Kecepatan (Speed):</strong> Klik tombol <em>"Speed"</em> di toolbar atas untuk mengubah tempo suara antara <code>0.5x</code> (sangat lambat untuk melatih telinga pemula), <code>0.75x</code>, <code>1.0x</code> (normal), hingga <code>2.0x</code>.</li>
              <li><strong>Fitur Putar Urut Otomatis:</strong> Klik tombol <em>"Putar Urut"</em> untuk mendengarkan seluruh abjad dalam tabel diputar berurutan dari awal sampai akhir tanpa harus Anda klik satu per satu.</li>
            </ul>
          </div>
        </details>

        <!-- FAQ Item 4: Flashcard & Quiz -->
        <details class="group border border-rule bg-canvas open:border-ink transition-colors shadow-xs">
          <summary class="p-4 sm:p-5 cursor-pointer list-none flex items-center justify-between gap-3 select-none font-bold text-[15px] sm:text-[16px] text-ink hover:bg-tint/40">
            <span class="flex items-center gap-2.5">
              <span class="size-7 rounded-none bg-tint border border-rule flex items-center justify-center text-badge shrink-0 font-mono text-xs">
                <Layers class="size-4" />
              </span>
              <span>4. Bagaimana cara menggunakan Mode Latihan Flashcard &amp; Kuis Pilihan Ganda?</span>
            </span>
            <ChevronDown class="size-4 text-smoke shrink-0 transition-transform duration-200 group-open:rotate-180" />
          </summary>
          <div class="px-5 pb-5 pt-1 text-[13px] sm:text-[14px] text-steel border-t border-rule/50 space-y-3 leading-relaxed">
            <p>
